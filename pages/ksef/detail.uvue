<template>
	<view class="page">
		<lili-universal-filter :title="pageTitle" :showBack="true" :showSearch="false" :showHome="true" homePath="/pages/ksef/index" backgroundColor="#EEF2F7" />

		<!-- #ifdef APP -->
		<scroll-view style="flex:1" class="page-scroll">
		<!-- #endif -->
			<view class="page-content">
				<view v-if="errorMessage != '' && !isLoading" class="error-card">
					<text class="error-title">加载失败</text>
					<text class="error-desc">{{ errorMessage }}</text>
					<view class="retry-btn" @click="loadInvoice">
						<text class="retry-btn-text">重新加载</text>
					</view>
				</view>

				<view v-if="isLoading" class="loading-card">
					<text class="loading-text">正在加载 KSeF 发票</text>
				</view>

				<view v-if="invoice != null && !isLoading" class="summary-card">
					<view class="summary-head">
						<view class="summary-main">
							<text class="summary-title">{{ invoiceNumberText }}</text>
							<text class="summary-subtitle">{{ sellerNameText }}</text>
						</view>
						<view :class="isInvoicePaid ? 'status-pill status-pill-paid' : 'status-pill status-pill-open'">
							<text :class="isInvoicePaid ? 'status-pill-text status-pill-text-paid' : 'status-pill-text status-pill-text-open'">{{ isInvoicePaid ? '已付款' : '未付款' }}</text>
						</view>
					</view>
					<view class="amount-row">
						<view class="amount-cell">
							<text class="amount-label">待付金额</text>
							<text class="amount-value">{{ amountDueText }}</text>
						</view>
						<view class="amount-cell">
							<text class="amount-label">税额</text>
							<text class="amount-value small">{{ taxText }}</text>
						</view>
					</view>
				</view>

				<view v-if="invoice != null && !isLoading" class="section">
					<view class="section-head">
						<text class="section-title">操作</text>
						<text class="section-note">{{ operationNote }}</text>
					</view>
					<view class="action-grid">
						<view class="action-tile" @click="openInvoiceInfoPopup">
							<text class="action-title">发票资料</text>
							<text class="action-desc">{{ invoiceInfoActionText }}</text>
						</view>
						<view class="action-tile" @click="openPaymentInfoPopup">
							<text class="action-title">付款信息</text>
							<text class="action-desc">{{ paymentInfoActionText }}</text>
						</view>
						<view class="action-tile" @click="openPaymentEditPopup">
							<text class="action-title">付款登记</text>
							<text class="action-desc">{{ paymentEditActionText }}</text>
						</view>
						<view class="action-tile" @click="openSupplierPopup">
							<text class="action-title">供应商</text>
							<text class="action-desc">{{ supplierActionText }}</text>
						</view>
						<view class="action-tile" @click="openPdfPopup">
							<text class="action-title">官方PDF</text>
							<text class="action-desc">{{ pdfActionText }}</text>
						</view>
						<view class="action-tile" @click="openAttachmentPopup">
							<text class="action-title">附件</text>
							<text class="action-desc">{{ attachmentActionText }}</text>
						</view>
					</view>
				</view>
			</view>
		<!-- #ifdef APP -->
		</scroll-view>
		<!-- #endif -->

		<page-container :show="invoiceInfoPopupVisible" position="bottom" :round="true" :overlay="true" :duration="240" overlay-style="background-color: rgba(15, 23, 42, 0.42);" custom-style="background-color: #FFFFFF;" @clickoverlay="closeInvoiceInfoPopup">
			<view class="popup-panel" :style="popupPanelStyle">
				<view class="popup-handle"></view>
				<view class="popup-head">
					<view class="popup-title-wrap">
						<text class="popup-title">发票资料</text>
						<text class="popup-subtitle">{{ invoiceNumberText }}</text>
					</view>
					<view class="popup-close" @click="closeInvoiceInfoPopup"><text class="popup-close-text">关闭</text></view>
				</view>
				<scroll-view class="popup-scroll" scroll-y="true" :style="popupScrollStyle">
					<view class="info-row" v-for="row in invoiceRows" :key="row['key']">
						<text class="info-label">{{ row['label'] }}</text>
						<text class="info-value">{{ row['value'] }}</text>
					</view>
					<view class="copy-grid">
						<view class="copy-btn" @click="copyKsefNumber"><text class="copy-btn-text">复制KSeF号</text></view>
						<view class="copy-btn" @click="copySellerNip"><text class="copy-btn-text">复制卖方NIP</text></view>
					</view>
				</scroll-view>
			</view>
		</page-container>

		<page-container :show="paymentInfoPopupVisible" position="bottom" :round="true" :overlay="true" :duration="240" overlay-style="background-color: rgba(15, 23, 42, 0.42);" custom-style="background-color: #FFFFFF;" @clickoverlay="closePaymentInfoPopup">
			<view class="popup-panel" :style="popupPanelStyle">
				<view class="popup-handle"></view>
				<view class="popup-head">
					<view class="popup-title-wrap">
						<text class="popup-title">付款信息</text>
						<text class="popup-subtitle">{{ amountDueText }}</text>
					</view>
					<view class="popup-close" @click="closePaymentInfoPopup"><text class="popup-close-text">关闭</text></view>
				</view>
				<scroll-view class="popup-scroll" scroll-y="true" :style="popupScrollStyle">
					<view class="info-row clickable" @click="copyText(normalizedAccount, '账号已复制', '暂无银行账号')">
						<text class="info-label">银行账号</text>
						<text class="info-value">{{ displayText(normalizedAccount) }}</text>
					</view>
					<view class="info-row">
						<text class="info-label">银行</text>
						<text class="info-value">{{ bankNameText }}</text>
					</view>
					<view class="info-row">
						<text class="info-label">方式</text>
						<text class="info-value">{{ paymentMethodText }}</text>
					</view>
					<view class="info-row">
						<text class="info-label">到期日</text>
						<text class="info-value">{{ paymentDueText }}</text>
					</view>
					<view class="info-row">
						<text class="info-label">付款数据</text>
						<text class="info-value">{{ paymentDataStatusText }}</text>
					</view>
					<view class="copy-grid">
						<view class="copy-btn" @click="copyTransferTitle"><text class="copy-btn-text">复制标题</text></view>
						<view class="copy-btn" @click="copyTransferSummary"><text class="copy-btn-text">复制转账信息</text></view>
					</view>
					<view v-if="paymentQrUrl != ''" class="qr-box qr-inline">
						<image class="qr-image" :src="paymentQrUrl" mode="aspectFit"></image>
						<text class="qr-title">{{ transferTitle }}</text>
						<text class="qr-desc">{{ amountDueText }} · {{ displayText(normalizedAccount) }}</text>
						<view class="qr-action" @click="copyText(paymentQrPayload, '二维码内容已复制', '暂无二维码内容')"><text class="qr-action-text">复制二维码内容</text></view>
					</view>
					<view v-if="paymentQrUrl == ''" class="qr-empty qr-inline"><text class="qr-empty-text">{{ qrUnavailableText }}</text></view>
				</scroll-view>
			</view>
		</page-container>

		<page-container :show="paymentEditPopupVisible" position="bottom" :round="true" :overlay="true" :duration="240" overlay-style="background-color: rgba(15, 23, 42, 0.42);" custom-style="background-color: #FFFFFF;" @clickoverlay="closePaymentEditPopup">
			<view class="popup-panel" :style="popupPanelStyle">
				<view class="popup-handle"></view>
				<view class="popup-head">
					<view class="popup-title-wrap">
						<text class="popup-title">付款登记</text>
						<text class="popup-subtitle">{{ paymentEditActionText }}</text>
					</view>
					<view class="popup-close" @click="closePaymentEditPopup"><text class="popup-close-text">关闭</text></view>
				</view>
				<scroll-view class="popup-scroll" scroll-y="true" :style="popupScrollStyle">
					<view class="switch-line">
						<view class="switch-copy">
							<text class="switch-title">已付款</text>
							<text class="switch-desc">保存后同步更新后端付款状态</text>
						</view>
						<switch :checked="isPaidDraft" color="#111827" @change="handlePaidChange" />
					</view>
					<view class="field-block">
						<text class="field-label">已付金额</text>
						<input class="field-input" type="digit" :value="paidAmountDraft" placeholder="0.00" @input="handlePaidAmountInput" />
					</view>
					<view class="field-block">
						<text class="field-label">付款时间</text>
						<input class="field-input" :value="paidAtDraft" placeholder="YYYY-MM-DD HH:mm" @input="handlePaidAtInput" />
					</view>
					<view class="field-block">
						<text class="field-label">付款说明</text>
						<textarea class="field-textarea" :value="paymentNoteDraft" placeholder="付款说明、流水号等" @input="handlePaymentNoteInput"></textarea>
					</view>
					<view class="field-block">
						<text class="field-label">备注</text>
						<textarea class="field-textarea" :value="remarkDraft" placeholder="内部备注" @input="handleRemarkInput"></textarea>
					</view>
					<view class="field-block">
						<text class="field-label">付款凭证</text>
						<view class="voucher-upload" @click="chooseVoucherFiles">
							<text class="voucher-upload-text">{{ voucherUploadText }}</text>
						</view>
						<view v-if="mediaRows.length == 0" class="voucher-empty"><text class="voucher-empty-text">暂无付款凭证</text></view>
						<view v-for="file in mediaRows" :key="file['key']" class="voucher-row" @click="openAttachment(file)">
							<view class="voucher-main">
								<text class="voucher-name">{{ file['name'] }}</text>
								<text class="voucher-meta">{{ file['meta'] }}</text>
							</view>
							<text class="voucher-open">查看</text>
						</view>
					</view>
					<view class="form-actions">
						<view class="form-btn form-btn-light" @click="fillPaidNow"><text class="form-btn-light-text">填为已付</text></view>
						<view class="form-btn form-btn-primary" @click="savePayment"><text class="form-btn-primary-text">{{ saving ? '保存中' : '保存付款' }}</text></view>
					</view>
				</scroll-view>
			</view>
		</page-container>

		<page-container :show="supplierPopupVisible" position="bottom" :round="true" :overlay="true" :duration="240" overlay-style="background-color: rgba(15, 23, 42, 0.42);" custom-style="background-color: #FFFFFF;" @clickoverlay="closeSupplierPopup">
			<view class="popup-panel" :style="popupPanelStyle">
				<view class="popup-handle"></view>
				<view class="popup-head">
					<view class="popup-title-wrap">
						<text class="popup-title">对应供应商</text>
						<text class="popup-subtitle">{{ supplierLinkNote }}</text>
					</view>
					<view class="popup-close" @click="closeSupplierPopup"><text class="popup-close-text">关闭</text></view>
				</view>
				<scroll-view class="popup-scroll" scroll-y="true" :style="popupScrollStyle">
					<view class="supplier-context">
						<text class="supplier-context-label">KSeF 销售方</text>
						<text class="supplier-context-value">{{ sellerNameText }} / {{ sellerNipText }}</text>
					</view>
					<view class="supplier-picker">
						<liliBottomSelect
							:value="supplierDraftValue"
							:valueText="supplierDraftText"
							title="选择供应商"
							placeholder="请选择对应供应商"
							searchPlaceholder="搜索名称、NIP、电话"
							subtitleKey="subtitle"
							:fetchData="fetchSupplierOptions"
							:showAddAction="true"
							:showEditAction="true"
							addPath="/pages/suppliers/from"
							editPath="/pages/suppliers/from"
							@change="handleSupplierChange"
						/>
					</view>
					<view class="form-actions">
						<view class="form-btn form-btn-light" @click="clearSupplierLink"><text class="form-btn-light-text">清除关联</text></view>
						<view class="form-btn form-btn-primary" @click="saveSupplierLink"><text class="form-btn-primary-text">{{ supplierSaving ? '保存中' : '保存供应商' }}</text></view>
					</view>
				</scroll-view>
			</view>
		</page-container>

		<page-container :show="attachmentPopupVisible" position="bottom" :round="true" :overlay="true" :duration="240" overlay-style="background-color: rgba(15, 23, 42, 0.42);" custom-style="background-color: #FFFFFF;" @clickoverlay="closeAttachmentPopup">
			<view class="popup-panel" :style="popupPanelStyle">
				<view class="popup-handle"></view>
				<view class="popup-head">
					<view class="popup-title-wrap">
						<text class="popup-title">付款凭证</text>
						<text class="popup-subtitle">{{ attachmentActionText }}</text>
					</view>
					<view class="popup-close" @click="closeAttachmentPopup"><text class="popup-close-text">关闭</text></view>
				</view>
				<scroll-view class="popup-scroll" scroll-y="true" :style="popupScrollStyle">
					<view class="voucher-upload" @click="chooseVoucherFiles">
						<text class="voucher-upload-text">{{ voucherUploadText }}</text>
					</view>
					<view v-if="mediaRows.length == 0" class="attachment-empty"><text class="attachment-empty-text">暂无付款凭证</text></view>
					<view v-for="file in mediaRows" :key="file['key']" class="attachment-row" @click="openAttachment(file)">
						<view class="attachment-main">
							<text class="attachment-name">{{ file['name'] }}</text>
							<text class="attachment-meta">{{ file['meta'] }}</text>
						</view>
						<text class="attachment-open">查看</text>
					</view>
				</scroll-view>
			</view>
		</page-container>

		<page-container :show="pdfPopupVisible" position="bottom" :round="true" :overlay="true" :duration="240" overlay-style="background-color: rgba(15, 23, 42, 0.42);" custom-style="background-color: #FFFFFF;" @clickoverlay="closePdfPopup">
			<view class="popup-panel pdf-popup-panel" :style="popupPanelStyle">
				<view class="popup-handle"></view>
				<view class="popup-head">
					<view class="popup-title-wrap">
						<text class="popup-title">官方PDF</text>
						<text class="popup-subtitle">{{ pdfPopupSubtitle }}</text>
					</view>
					<view class="popup-close" @click="closePdfPopup"><text class="popup-close-text">关闭</text></view>
				</view>
				<view v-if="pdfLoading" class="pdf-loading" :style="pdfPreviewFrameStyle"><text class="pdf-loading-text">{{ pdfLoadingText }}</text></view>
				<view v-if="!pdfLoading && pdfErrorMessage != ''" class="pdf-loading" :style="pdfPreviewFrameStyle">
					<text class="pdf-loading-text">{{ pdfErrorMessage }}</text>
					<view class="retry-btn" @click="loadPdfPreview"><text class="retry-btn-text">重新加载</text></view>
				</view>
				<view v-if="!pdfLoading && pdfErrorMessage == '' && pdfPreviewSrc != ''" class="pdf-preview-frame" :style="pdfPreviewFrameStyle">
					<web-view id="ksef-pdf-webview" class="pdf-webview" :src="pdfPreviewSrc"></web-view>
				</view>
				<view v-if="!pdfLoading && pdfPreviewSrc != ''" class="pdf-actions">
					<view class="form-btn form-btn-light" @click="loadPdfPreview"><text class="form-btn-light-text">重新获取</text></view>
					<view class="form-btn form-btn-primary" @click="openPdfDocument"><text class="form-btn-primary-text">系统打开</text></view>
				</view>
			</view>
		</page-container>
	</view>
</template>

<script setup lang="uts">
import { computed, watch } from 'vue'
import { takeLatestResponseMessage } from '@/pkg/api/index.uts'
import liliBottomSelect from '@/uni_modules/lili_bottom-select/components/lili_bottom-select/lili_bottom-select.uvue'
import { downloadKsefInvoicePdfFile, downloadKsefInvoiceXml, getKsefInvoiceDetail, KsefInvoiceDetail, linkKsefInvoiceSupplier, updateKsefInvoicePayment, uploadKsefInvoiceVouchers } from '@/pkg/api/modules/ksef'
import { getSupplierList, SupplierItem } from '@/pkg/api/modules/suppliers'
import { createQRCode, type CreateQRCodeOptions } from '@/uni_modules/lime-scan'
import { showErrorToast } from '@/pkg/util/toast.uts'

const refreshStorageKey = 'refresh:pages:ksef:index'
const invoiceId = ref('')
const invoice = ref<KsefInvoiceDetail | null>(null)
const isLoading = ref(false)
const saving = ref(false)
const supplierSaving = ref(false)
const voucherUploading = ref(false)
const pdfLoading = ref(false)
const errorMessage = ref('')
const pdfErrorMessage = ref('')
const pdfLoadingText = ref('正在生成PDF')
const isPaidDraft = ref(false)
const paidAmountDraft = ref('')
const paidAtDraft = ref('')
const paymentNoteDraft = ref('')
const remarkDraft = ref('')
const supplierDraftValue = ref('')
const supplierDraftText = ref('')
const qrImageSrc = ref('')
const qrGenerating = ref(false)
const invoiceInfoPopupVisible = ref(false)
const paymentInfoPopupVisible = ref(false)
const paymentEditPopupVisible = ref(false)
const supplierPopupVisible = ref(false)
const attachmentPopupVisible = ref(false)
const pdfPopupVisible = ref(false)
const pdfPreviewSrc = ref('')
const popupPanelHeight = ref(620)
const popupScrollHeight = ref(500)

function stringValue(value: any | null, fallback: string = ''): string {
	if (value == null) return fallback
	const text = '' + value
	return text == '' ? fallback : text
}

function intValue(value: any | null, fallback: number): number {
	if (value == null) return fallback
	if (typeof value == 'number') return value as number
	const parsed = parseInt('' + value)
	if (isNaN(parsed)) return fallback
	return parsed
}

function parseErrorMessage(error: any, fallback: string = '操作失败'): string {
	let message = fallback
	if (error != null) {
		const text = JSON.stringify(error)
		if (text != null && text != '') {
			message = text
		}
	}
	return message
}

function readEventValue(event: any): string {
	if (event == null) return ''
	const inputEvent = event as UniInputEvent
	const detail = inputEvent.detail
	if (detail == null) return ''
	return detail.value
}

function updatePopupLayout() {
	const info = uni.getWindowInfo()
	let panelHeight = info.windowHeight - 96
	if (panelHeight > 680) panelHeight = 680
	if (panelHeight < 500) panelHeight = 500
	let scrollHeight = panelHeight - 118
	if (scrollHeight < 320) scrollHeight = 320
	popupPanelHeight.value = panelHeight
	popupScrollHeight.value = scrollHeight
}

function displayText(value: string): string {
	if (value == '') return '-'
	return value
}

function compactDate(value: string): string {
	if (value == '') return '-'
	if (value.length >= 16) return value.substring(0, 16)
	return value
}

function normalizeAccount(value: string): string {
	let result = ''
	let source = value
	if (source.length >= 2 && source.substring(0, 2).toUpperCase() == 'PL') {
		source = source.substring(2)
	}
	for (let index = 0; index < source.length; index += 1) {
		const char = source.substring(index, index + 1)
		if (char >= '0' && char <= '9') {
			result += char
		}
	}
	return result
}

function sanitizeQrPart(value: string): string {
	let result = ''
	for (let index = 0; index < value.length; index += 1) {
		const char = value.substring(index, index + 1)
		if (char == '|' || char == '/' || char == '\\' || char == '\n' || char == '\r' || char == '\t') {
			result += ' '
		} else {
			result += char
		}
	}
	return result
}

function objectStringValue(obj: UTSJSONObject, key: string): string {
	const value = obj[key]
	if (value == null) return ''
	return '' + value
}

function firstCompanyInfoNip(item: SupplierItem): string {
	for (let index = 0; index < item.company_infos.length; index += 1) {
		const info = item.company_infos[index]
		const nip = objectStringValue(info, 'nip')
		if (nip != '') return nip
	}
	return ''
}

function supplierOptionSubtitle(item: SupplierItem): string {
	const parts: string[] = []
	if (item.code != '') parts.push(item.code)
	const nip = firstCompanyInfoNip(item)
	if (nip != '') parts.push('NIP ' + nip)
	if (item.phone != '') parts.push(item.phone)
	return parts.join(' · ')
}

function supplierToOption(item: SupplierItem): UTSJSONObject {
	return {
		value: item.id.toString(),
		text: item.name,
		subtitle: supplierOptionSubtitle(item),
	} as UTSJSONObject
}

async function fetchSupplierOptions(params: UTSJSONObject): Promise<UTSJSONObject> {
	const keyword = stringValue(params['keyword'])
	const page = intValue(params['page'], 1)
	const pageSize = intValue(params['pageSize'], 20)
	const response = await getSupplierList({
		search: keyword == '' ? null : keyword,
		page: page,
		page_size: pageSize,
		is_active: null,
		has_arrears: null,
	})
	const rows: UTSJSONObject[] = []
	for (let index = 0; index < response.results.length; index += 1) {
		rows.push(supplierToOption(response.results[index]))
	}
	return {
		data: rows,
		results: rows,
		total: response.total_count,
		total_count: response.total_count,
	} as UTSJSONObject
}

function amountNumber(value: string): number {
	if (value == '') return 0
	const normalized = value.replace(',', '.')
	const parsed = parseFloat(normalized)
	return isNaN(parsed) ? 0 : parsed
}

function centsText(amount: number): string {
	let cents = Math.round(amount * 100).toString()
	while (cents.length < 6) {
		cents = '0' + cents
	}
	return cents
}

function nowText(): string {
	const value = new Date()
	const year = value.getFullYear().toString()
	const month = (value.getMonth() + 1).toString()
	const day = value.getDate().toString()
	const hour = value.getHours().toString()
	const minute = value.getMinutes().toString()
	return year + '-' + (month.length == 1 ? '0' + month : month) + '-' + (day.length == 1 ? '0' + day : day) + ' ' + (hour.length == 1 ? '0' + hour : hour) + ':' + (minute.length == 1 ? '0' + minute : minute)
}

function applyDraft(data: KsefInvoiceDetail) {
	isPaidDraft.value = data.is_paid
	paidAmountDraft.value = data.paid_amount == '' || data.paid_amount == '0.00' ? data.amount_due : data.paid_amount
	paidAtDraft.value = compactDate(data.paid_at) == '-' ? '' : compactDate(data.paid_at)
	paymentNoteDraft.value = data.payment_note
	remarkDraft.value = data.remark
	supplierDraftValue.value = data.supplier > 0 ? data.supplier.toString() : ''
	supplierDraftText.value = data.supplier_name
}

async function loadInvoice() {
	if (invoiceId.value == '' || isLoading.value) return
	isLoading.value = true
	errorMessage.value = ''
	try {
		const data = await getKsefInvoiceDetail(invoiceId.value)
		invoice.value = data
		applyDraft(data)
	} catch (error) {
		invoice.value = null
		errorMessage.value = parseErrorMessage(error, 'KSeF 发票详情加载失败')
	} finally {
		isLoading.value = false
	}
}

function copyText(text: string, successTitle: string, emptyTitle: string) {
	if (text == '' || text == '-') {
		uni.showToast({ title: emptyTitle, icon: 'none', duration: 3500 })
		return
	}
	uni.setClipboardData({
		data: text,
		success: () => {
			uni.showToast({ title: successTitle, icon: 'success' })
		},
	})
}

function transferTitleText(): string {
	if (invoice.value == null) return ''
	if (invoice.value.invoice_number != '') return invoice.value.invoice_number
	if (invoice.value.ksef_number != '') return 'KSeF ' + invoice.value.ksef_number
	return ''
}

function normalizedAccountText(): string {
	if (invoice.value == null) return ''
	return normalizeAccount(invoice.value.bank_account_number)
}

function transferAmountText(): string {
	if (invoice.value == null) return ''
	const due = amountNumber(invoice.value.amount_due)
	if (due > 0) return invoice.value.amount_due
	return invoice.value.gross_amount
}

function amountDueDisplayText(): string {
	if (invoice.value == null) return '-'
	return displayText(transferAmountText()) + ' ' + displayText(invoice.value.currency)
}

function transferSummaryText(): string {
	if (invoice.value == null) return ''
	return 'Odbiorca: ' + displayText(invoice.value.seller_name) + '\nKonto: ' + displayText(normalizedAccountText()) + '\nKwota: ' + amountDueDisplayText() + '\nTytul: ' + displayText(transferTitleText())
}

function hasParsedPaymentInfo(): boolean {
	if (invoice.value == null) return false
	return invoice.value.payment_due_date != '' || invoice.value.payment_method != '' || invoice.value.bank_account_number != '' || invoice.value.bank_name != ''
}

function xmlSummaryIntValue(key: string): number {
	if (invoice.value == null) return 0
	return intValue(invoice.value.xml_summary[key], 0)
}

function copyTransferTitle() {
	copyText(transferTitleText(), '标题已复制', '暂无标题')
}

function copyTransferSummary() {
	copyText(transferSummaryText(), '转账信息已复制', '暂无转账信息')
}

function copyKsefNumber() {
	if (invoice.value == null) {
		copyText('', 'KSeF号已复制', '暂无KSeF号')
		return
	}
	copyText(invoice.value.ksef_number, 'KSeF号已复制', '暂无KSeF号')
}

function copySellerNip() {
	if (invoice.value == null) {
		copyText('', '卖方NIP已复制', '暂无卖方NIP')
		return
	}
	copyText(invoice.value.seller_nip, '卖方NIP已复制', '暂无卖方NIP')
}

function openInvoiceInfoPopup() {
	if (invoice.value == null) return
	invoiceInfoPopupVisible.value = true
}

function closeInvoiceInfoPopup() {
	invoiceInfoPopupVisible.value = false
}

function openPaymentInfoPopup() {
	if (invoice.value == null) return
	paymentInfoPopupVisible.value = true
}

function closePaymentInfoPopup() {
	paymentInfoPopupVisible.value = false
}

function openPaymentEditPopup() {
	if (invoice.value == null) return
	applyDraft(invoice.value as KsefInvoiceDetail)
	paymentEditPopupVisible.value = true
}

function closePaymentEditPopup() {
	if (saving.value || voucherUploading.value) return
	paymentEditPopupVisible.value = false
}

function openSupplierPopup() {
	if (invoice.value == null) return
	applyDraft(invoice.value as KsefInvoiceDetail)
	supplierPopupVisible.value = true
}

function closeSupplierPopup() {
	if (supplierSaving.value) return
	supplierPopupVisible.value = false
}

function openAttachmentPopup() {
	if (invoice.value == null) return
	attachmentPopupVisible.value = true
}

function closeAttachmentPopup() {
	if (voucherUploading.value) return
	attachmentPopupVisible.value = false
}

async function loadPdfPreview() {
	if (invoiceId.value == '' || pdfLoading.value) return
	pdfLoading.value = true
	pdfErrorMessage.value = ''
	try {
		if (invoice.value != null && invoice.value.raw_xml == '') {
			pdfLoadingText.value = '正在同步XML'
			await downloadKsefInvoiceXml(invoiceId.value)
			const refreshed = await getKsefInvoiceDetail(invoiceId.value)
			invoice.value = refreshed
			applyDraft(refreshed)
			uni.setStorageSync(refreshStorageKey, '1')
			if (refreshed.raw_xml == '') {
				throw new Error('XML同步后仍为空，无法生成PDF')
			}
		}
		pdfLoadingText.value = '正在生成PDF'
		const result = await downloadKsefInvoicePdfFile(invoiceId.value)
		pdfPreviewSrc.value = result.tempFilePath
	} catch (error) {
		pdfPreviewSrc.value = ''
		pdfErrorMessage.value = parseErrorMessage(error, 'PDF加载失败')
	} finally {
		pdfLoading.value = false
	}
}

function openPdfPopup() {
	if (invoice.value == null) return
	pdfPopupVisible.value = true
	if (pdfPreviewSrc.value == '' && !pdfLoading.value) {
		loadPdfPreview()
	}
}

function closePdfPopup() {
	pdfPopupVisible.value = false
}

function openPdfDocument() {
	if (pdfPreviewSrc.value == '') {
		loadPdfPreview()
		return
	}
	uni.openDocument({
		filePath: pdfPreviewSrc.value,
		fileType: 'pdf',
		fail: (error) => {
			showErrorToast(parseErrorMessage(error, 'PDF打开失败'))
		},
	})
}

function openAttachment(file: UTSJSONObject) {
	const url = objectStringValue(file, 'url')
	if (url == '') {
		uni.showToast({ title: '暂无文件地址', icon: 'none', duration: 3500 })
		return
	}
	uni.navigateTo({ url: '/pages/webview/webview?url=' + encodeURIComponent(url) })
}

function handleSupplierChange(payload: UTSJSONObject) {
	supplierDraftValue.value = stringValue(payload['value'])
	supplierDraftText.value = stringValue(payload['text'])
}

function handlePaidChange(event: any) {
	const switchEvent = event as UniSwitchChangeEvent
	const detail = switchEvent.detail
	if (detail == null) return
	isPaidDraft.value = detail.value
}

function handlePaidAmountInput(event: any) { paidAmountDraft.value = readEventValue(event) }
function handlePaidAtInput(event: any) { paidAtDraft.value = readEventValue(event) }
function handlePaymentNoteInput(event: any) { paymentNoteDraft.value = readEventValue(event) }
function handleRemarkInput(event: any) { remarkDraft.value = readEventValue(event) }

function fillPaidNow() {
	isPaidDraft.value = true
	if (invoice.value != null) {
		paidAmountDraft.value = invoice.value.amount_due == '' ? invoice.value.gross_amount : invoice.value.amount_due
	}
	paidAtDraft.value = nowText()
}

async function uploadVoucherFiles(paths: string[]) {
	if (paths.length == 0 || invoiceId.value == '' || voucherUploading.value) return
	voucherUploading.value = true
	try {
		const response = await uploadKsefInvoiceVouchers(invoiceId.value, paths)
		if (invoice.value != null) {
			invoice.value.media_files = response.media_files
			invoice.value.files_count = response.files_count
		}
		uni.setStorageSync(refreshStorageKey, '1')
		uni.showToast({ title: takeLatestResponseMessage('凭证已上传'), icon: 'success' })
	} catch (error) {
		showErrorToast(parseErrorMessage(error, '凭证上传失败'))
	} finally {
		voucherUploading.value = false
	}
}

function chooseVoucherFiles() {
	if (invoiceId.value == '' || voucherUploading.value) return
	uni.chooseImage({
		count: 6,
		sizeType: ['compressed'],
		sourceType: ['camera', 'album'],
		success: (res) => {
			const selectedPaths = res.tempFilePaths
			const paths: string[] = []
			for (let index = 0; index < selectedPaths.length; index += 1) {
				paths.push(selectedPaths[index])
			}
			uploadVoucherFiles(paths)
		},
		fail: () => {},
	})
}

async function savePayment() {
	if (invoiceId.value == '' || saving.value) return
	saving.value = true
	try {
		const data = await updateKsefInvoicePayment(invoiceId.value, {
			is_paid: isPaidDraft.value,
			paid_amount: paidAmountDraft.value,
			paid_at: paidAtDraft.value == '' ? null : paidAtDraft.value,
			payment_note: paymentNoteDraft.value,
			remark: remarkDraft.value,
		})
		invoice.value = data
		applyDraft(data)
		uni.setStorageSync(refreshStorageKey, '1')
		paymentEditPopupVisible.value = false
		uni.showToast({ title: takeLatestResponseMessage('付款已保存'), icon: 'success' })
	} catch (error) {
		showErrorToast(parseErrorMessage(error, '付款保存失败'))
	} finally {
		saving.value = false
	}
}

async function persistSupplierLink(nextSupplierId: string | null) {
	if (invoiceId.value == '' || supplierSaving.value) return
	supplierSaving.value = true
	try {
		const data = await linkKsefInvoiceSupplier(invoiceId.value, nextSupplierId)
		invoice.value = data
		applyDraft(data)
		uni.setStorageSync(refreshStorageKey, '1')
		supplierPopupVisible.value = false
		uni.showToast({ title: takeLatestResponseMessage('供应商已保存'), icon: 'success' })
	} catch (error) {
		showErrorToast(parseErrorMessage(error, '供应商保存失败'))
	} finally {
		supplierSaving.value = false
	}
}

function saveSupplierLink() {
	if (supplierDraftValue.value == '') {
		uni.showToast({ title: '请选择供应商', icon: 'none', duration: 3500 })
		return
	}
	persistSupplierLink(supplierDraftValue.value)
}

function clearSupplierLink() {
	persistSupplierLink(null)
}

const pageTitle = computed((): string => {
	if (invoice.value == null || invoice.value.invoice_number == '') return 'KSeF 付款'
	return invoice.value.invoice_number
})

const popupPanelStyle = computed((): string => {
	return 'height:' + popupPanelHeight.value.toString() + 'px;'
})

const popupScrollStyle = computed((): string => {
	return 'height:' + popupScrollHeight.value.toString() + 'px;'
})

const pdfPreviewFrameStyle = computed((): string => {
	let height = popupPanelHeight.value - 112
	if (height < 360) height = 360
	return 'height:' + height.toString() + 'px;'
})

const invoiceNumberText = computed((): string => {
	if (invoice.value == null) return '-'
	return displayText(invoice.value.invoice_number)
})

const sellerNameText = computed((): string => {
	if (invoice.value == null) return '-'
	return displayText(invoice.value.seller_name)
})

const sellerNipText = computed((): string => {
	if (invoice.value == null) return '-'
	return displayText(invoice.value.seller_nip)
})

const supplierLinkNote = computed((): string => {
	if (invoice.value == null) return ''
	return invoice.value.supplier > 0 ? '已关联' : '未关联'
})

const isInvoicePaid = computed((): boolean => {
	if (invoice.value == null) return false
	return invoice.value.is_paid
})

const bankNameText = computed((): string => {
	if (invoice.value == null) return '-'
	return displayText(invoice.value.bank_name)
})

const paymentMethodText = computed((): string => {
	if (invoice.value == null) return '-'
	if (invoice.value.payment_method_display != '') return displayText(invoice.value.payment_method_display)
	return displayText(invoice.value.payment_method)
})

const paymentDueText = computed((): string => {
	if (invoice.value == null) return '-'
	return compactDate(invoice.value.payment_due_date)
})

const normalizedAccount = computed((): string => {
	return normalizedAccountText()
})

const transferAmount = computed((): string => {
	return transferAmountText()
})

const amountDueText = computed((): string => {
	return amountDueDisplayText()
})

const taxText = computed((): string => {
	if (invoice.value == null) return '-'
	return displayText(invoice.value.tax_amount) + ' ' + displayText(invoice.value.currency)
})

const transferTitle = computed((): string => {
	return transferTitleText()
})

const transferSummary = computed((): string => {
	return transferSummaryText()
})

const paymentQrPayload = computed((): string => {
	if (invoice.value == null) return ''
	if (invoice.value.currency != '' && invoice.value.currency != 'PLN') return ''
	if (normalizedAccount.value.length < 26) return ''
	const amount = amountNumber(transferAmount.value)
	if (amount <= 0) return ''
	const receiverId = invoice.value.seller_nip == '' ? '0000000000' : invoice.value.seller_nip
	return sanitizeQrPart(receiverId) + '|PL|' + normalizedAccount.value + '|' + centsText(amount) + '|' + sanitizeQrPart(invoice.value.seller_name) + '|' + sanitizeQrPart(transferTitle.value) + '|||'
})

function refreshQrCode() {
	qrImageSrc.value = ''
	const payload = paymentQrPayload.value
	if (payload == '') {
		qrGenerating.value = false
		return
	}
	qrGenerating.value = true
	// #ifdef APP-ANDROID || APP-IOS
	try {
		createQRCode({
			width: 280,
			height: 280,
			content: payload,
			success(src: string) {
				qrImageSrc.value = src
				qrGenerating.value = false
			},
			fail(error: any) {
				console.log('KSeF QR生成失败', error)
				qrImageSrc.value = ''
				qrGenerating.value = false
			}
		} as CreateQRCodeOptions)
	} catch (error) {
		console.log('KSeF QR生成异常', error)
		qrImageSrc.value = ''
		qrGenerating.value = false
	}
	// #endif
	// #ifndef APP-ANDROID || APP-IOS
	qrGenerating.value = false
	// #endif
}

const paymentQrUrl = computed((): string => {
	return qrImageSrc.value
})

const qrUnavailableText = computed((): string => {
	if (invoice.value == null) return '暂无发票数据'
	if (invoice.value.currency != '' && invoice.value.currency != 'PLN') return '当前币种不是 PLN，暂不生成波兰转账二维码'
	if (normalizedAccount.value.length < 26) return '缺少有效银行账号，无法生成二维码'
	if (qrGenerating.value) return '二维码生成中'
	if (paymentQrPayload.value != '') return '当前平台未返回二维码图片'
	return '缺少付款金额，无法生成二维码'
})

const operationNote = computed((): string => {
	if (invoice.value == null) return ''
	return (invoice.value.is_paid ? '已付款' : '待付款') + ' · ' + amountDueText.value
})

const invoiceInfoActionText = computed((): string => {
	if (invoice.value == null) return '-'
	return compactDate(invoice.value.issue_date)
})

const supplierActionText = computed((): string => {
	if (invoice.value == null) return '-'
	return invoice.value.supplier_name == '' ? '未关联' : invoice.value.supplier_name
})

const paymentDataStatusText = computed((): string => {
	if (invoice.value == null) return '-'
	if (hasParsedPaymentInfo()) return '已解析'
	if (invoice.value.raw_xml == '') return '未下载XML'
	return 'XML未提供付款节点'
})

const paymentInfoActionText = computed((): string => {
	if (invoice.value == null) return '-'
	return normalizedAccount.value == '' ? paymentDataStatusText.value : displayText(normalizedAccount.value)
})

const paymentEditActionText = computed((): string => {
	if (invoice.value == null) return '-'
	return invoice.value.is_paid ? '已登记' : '待登记'
})

const attachmentActionText = computed((): string => {
	if (invoice.value == null) return '-'
	return invoice.value.files_count.toString() + ' 个文件'
})

const voucherUploadText = computed((): string => {
	return voucherUploading.value ? '上传中' : '上传付款凭证'
})

const pdfActionText = computed((): string => {
	if (invoice.value == null) return '-'
	if (invoice.value.raw_xml == '') return '需先同步XML'
	return pdfPreviewSrc.value == '' ? '底部预览' : '继续查看'
})

const pdfPopupSubtitle = computed((): string => {
	if (pdfLoading.value) return '正在调用官方PDF解析'
	if (pdfErrorMessage.value != '') return '官方PDF生成失败'
	if (pdfPreviewSrc.value != '') return '来自后端官方解析插件'
	return pdfActionText.value
})

const xmlLineItemsCountText = computed((): string => {
	if (invoice.value == null) return '-'
	const count = xmlSummaryIntValue('line_items_count')
	if (count > 0) return count.toString() + ' 行'
	return invoice.value.raw_xml == '' ? '未下载XML' : '未解析到商品行'
})

const invoiceRows = computed((): UTSJSONObject[] => {
	if (invoice.value == null) return [] as UTSJSONObject[]
	return [
		{ key: 'ksef', label: 'KSeF号', value: displayText(invoice.value.ksef_number) } as UTSJSONObject,
		{ key: 'seller_nip', label: '卖方NIP', value: displayText(invoice.value.seller_nip) } as UTSJSONObject,
		{ key: 'supplier', label: '供应商', value: invoice.value.supplier_name == '' ? '未关联供应商' : invoice.value.supplier_name } as UTSJSONObject,
		{ key: 'buyer', label: '买方', value: displayText(invoice.value.buyer_name) } as UTSJSONObject,
		{ key: 'buyer_nip', label: '买方NIP', value: displayText(invoice.value.buyer_nip) } as UTSJSONObject,
		{ key: 'issue', label: '开票日期', value: compactDate(invoice.value.issue_date) } as UTSJSONObject,
		{ key: 'sale', label: '销售日期', value: compactDate(invoice.value.sale_date) } as UTSJSONObject,
		{ key: 'net', label: '净额', value: displayText(invoice.value.net_amount) + ' ' + displayText(invoice.value.currency) } as UTSJSONObject,
		{ key: 'gross', label: '总额', value: displayText(invoice.value.gross_amount) + ' ' + displayText(invoice.value.currency) } as UTSJSONObject,
		{ key: 'files', label: '附件数', value: invoice.value.files_count.toString() } as UTSJSONObject,
		{ key: 'xml_lines', label: 'XML商品行', value: xmlLineItemsCountText.value } as UTSJSONObject,
		{ key: 'payment_source', label: '付款数据', value: paymentDataStatusText.value } as UTSJSONObject,
		{ key: 'sync', label: '详情状态', value: invoice.value.raw_xml_downloaded_at == '' ? '未下载XML' : compactDate(invoice.value.raw_xml_downloaded_at) } as UTSJSONObject,
	]
})

const mediaRows = computed((): UTSJSONObject[] => {
	if (invoice.value == null) return [] as UTSJSONObject[]
	const result: UTSJSONObject[] = []
	for (let index = 0; index < invoice.value.media_files.length; index += 1) {
		const file = invoice.value.media_files[index]
		const name = objectStringValue(file, 'original_filename')
		const typeText = objectStringValue(file, 'file_type_display')
		const sizeText = objectStringValue(file, 'file_size_display')
		let url = objectStringValue(file, 'signed_url')
		if (url == '') url = objectStringValue(file, 'file_url')
		result.push({
			key: objectStringValue(file, 'id') == '' ? index.toString() : objectStringValue(file, 'id'),
			name: name == '' ? '未命名文件' : name,
			meta: (typeText == '' ? '文件' : typeText) + (sizeText == '' ? '' : ' · ' + sizeText),
			url: url,
		} as UTSJSONObject)
	}
	return result
})

watch(paymentQrPayload, () => {
	refreshQrCode()
})

onLoad((event: OnLoadOptions) => {
	updatePopupLayout()
	const idValue = event['id']
	invoiceId.value = stringValue(idValue)
	loadInvoice()
})
</script>

<style>
.page {
	flex: 1;
	background-color: #F6F7FB;
}

.page-scroll {
	flex: 1;
	background-color: #F6F7FB;
}

.page-content {
	padding: 10px;
	padding-bottom: 96px;
}

.summary-card,
.section,
.error-card,
.loading-card {
	background-color: #FFFFFF;
	border-radius: 8px;
	border-width: 1px;
	border-style: solid;
	border-color: #E5EAF1;
	padding: 14px;
	margin-bottom: 10px;
}

.summary-head,
.amount-row,
.section-head,
.popup-head,
.copy-grid,
.form-actions,
.switch-line {
	flex-direction: row;
	align-items: center;
}

.summary-head {
	justify-content: space-between;
}

.summary-main {
	flex: 1;
	padding-right: 10px;
}

.summary-title {
	font-size: 20px;
	line-height: 26px;
	font-weight: bold;
	color: #0F172A;
}

.summary-subtitle {
	font-size: 13px;
	line-height: 18px;
	color: #475569;
	margin-top: 4px;
}

.status-pill {
	height: 30px;
	border-radius: 8px;
	padding-left: 10px;
	padding-right: 10px;
	align-items: center;
	justify-content: center;
}

.status-pill-paid {
	background-color: #DCFCE7;
}

.status-pill-open {
	background-color: #FEF3C7;
}

.status-pill-text {
	font-size: 12px;
	line-height: 12px;
	font-weight: bold;
}

.status-pill-text-paid {
	color: #166534;
}

.status-pill-text-open {
	color: #92400E;
}

.amount-row {
	margin-top: 14px;
}

.amount-cell {
	flex: 1;
	background-color: #F8FAFC;
	border-radius: 8px;
	padding: 10px;
	margin-right: 8px;
}

.amount-label,
.info-label,
.field-label,
.section-note {
	font-size: 12px;
	line-height: 17px;
	color: #64748B;
}

.amount-value {
	font-size: 18px;
	line-height: 24px;
	color: #0F172A;
	font-weight: bold;
	margin-top: 4px;
}

.small {
	font-size: 15px;
}

.section-title {
	font-size: 16px;
	line-height: 22px;
	font-weight: bold;
	color: #0F172A;
}

.section-head {
	justify-content: space-between;
	margin-bottom: 10px;
}

.action-grid {
	flex-direction: row;
	flex-wrap: wrap;
	margin-top: 4px;
}

.action-tile {
	width: 48%;
	min-height: 72px;
	border-radius: 8px;
	background-color: #F8FAFC;
	border-width: 1px;
	border-style: solid;
	border-color: #E2E8F0;
	padding: 10px;
	margin-right: 6px;
	margin-bottom: 8px;
	justify-content: center;
}

.action-title {
	font-size: 14px;
	line-height: 20px;
	color: #0F172A;
	font-weight: bold;
}

.action-desc {
	font-size: 12px;
	line-height: 17px;
	color: #64748B;
	margin-top: 4px;
}

.popup-panel {
	background-color: #FFFFFF;
	border-top-left-radius: 14px;
	border-top-right-radius: 14px;
	padding: 12px;
}

.popup-handle {
	width: 36px;
	height: 4px;
	border-radius: 2px;
	background-color: #CBD5E1;
	align-self: center;
	margin-bottom: 10px;
}

.popup-head {
	justify-content: space-between;
	margin-bottom: 8px;
}

.popup-title-wrap {
	flex: 1;
	padding-right: 10px;
}

.popup-title {
	font-size: 18px;
