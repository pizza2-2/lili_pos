<template>
	<view class="page">
		<lili-universal-filter title="标签打印" :showBack="true" :showSearch="false" :showHome="true" homePath="/pages/tabbar/settings" backgroundColor="#EEF2F7" />

		<scroll-view scroll-y="true" class="page-scroll">
			<view class="content">
				<view class="section">
					<text class="section-title">数据源</text>
					<view class="select-wrap">
						<liliBottomSelect
							:value="productId"
							:valueText="productText"
							title="选择商品"
							placeholder="请选择商品"
							searchPlaceholder="输入商品名称、SKU、条码"
							emptyText="暂无商品"
							:showAddAction="true"
							:showEditAction="true"
							addPath="/pages/products/from"
							editPath="/pages/products/from"
							:fetchData="fetchProductOptions"
							@change="handleProductChange($event)"
						/>
					</view>

					<view class="field-grid">
						<view class="field">
							<text class="field-label">条目</text>
							<input class="field-input" v-model="labelName" placeholder="商品名称" @input="syncBoundElements()" />
						</view>
						<view class="field">
							<text class="field-label">价格</text>
							<input class="field-input" v-model="labelPrice" type="digit" placeholder="0.00" @input="syncBoundElements()" />
						</view>
						<view class="field">
							<text class="field-label">KOD</text>
							<input class="field-input" v-model="labelKod" placeholder="SKU / KOD" @input="syncBoundElements()" />
						</view>
						<view class="field">
							<text class="field-label">条码</text>
							<view class="field-input-wrap">
								<view class="field-scan-btn" @click="scanLabelBarcode()">
									<image class="field-scan-icon" src="/static/menu-icons/barcode.svg" mode="aspectFit"></image>
								</view>
								<input class="field-input field-input-with-icon" v-model="labelBarcode" placeholder="EAN13 / CODE128" @input="syncBoundElements()" />
							</view>
						</view>
					</view>

					<view class="custom-field-panel">
						<view class="field-grid">
							<view class="field">
								<text class="field-label">自定义字段</text>
								<input class="field-input" v-model="customFieldLabel" placeholder="字段名" />
							</view>
							<view class="field">
								<text class="field-label">字段内容</text>
								<input class="field-input" v-model="customFieldContent" placeholder="打印内容" />
							</view>
						</view>
						<view class="custom-actions">
							<view class="custom-btn" @click="addCustomTextElement()"><text class="custom-btn-text">添加文本字段</text></view>
							<view class="custom-btn" @click="addCustomBarcodeElement()"><text class="custom-btn-text">添加条码字段</text></view>
						</view>
					</view>
				</view>

				<view class="section preview-section">
					<view class="section-head">
						<text class="section-title">32mm x 20mm 预览</text>
						<text class="section-subtitle">{{ selectedElementLabel }}</text>
					</view>

					<view
						class="board-shell"
						@touchstart="handleCanvasTouchStart($event)"
						@touchmove.stop.prevent="handleCanvasTouchMove($event)"
						@touchend="handleCanvasTouchEnd($event)"
						@touchcancel="handleCanvasTouchEnd($event)"
					>
						<view
							ref="canvasRef"
							class="label-canvas"
							:style="boardStyle"
						></view>
					</view>

					<view class="element-tabs">
						<view v-for="element in elements" :key="element.key" :class="selectedKey == element.key ? 'element-tab element-tab-active' : 'element-tab'" @click="selectElement(element.key)">
							<text :class="selectedKey == element.key ? 'element-tab-text element-tab-text-active' : 'element-tab-text'">{{ element.label }}</text>
						</view>
					</view>

					<view class="nudge-grid">
						<view class="nudge-btn" @click="moveSelected(0, -0.5)"><text class="nudge-text">上</text></view>
						<view class="nudge-btn" @click="moveSelected(-0.5, 0)"><text class="nudge-text">左</text></view>
						<view class="nudge-btn" @click="moveSelected(0.5, 0)"><text class="nudge-text">右</text></view>
						<view class="nudge-btn" @click="moveSelected(0, 0.5)"><text class="nudge-text">下</text></view>
					</view>
					<view class="quick-grid">
						<view class="quick-btn" @click="resizeSelected(-1)"><text class="quick-text">缩小</text></view>
						<view class="quick-btn" @click="resizeSelected(1)"><text class="quick-text">放大</text></view>
						<view class="quick-btn quick-btn-danger" @click="deleteSelectedElement()"><text class="quick-text quick-text-danger">删除字段</text></view>
					</view>
				</view>

				<view class="section">
					<view class="section-head">
						<text class="section-title">元素编辑</text>
						<text class="section-subtitle">{{ elements.length.toString() }} 个元素</text>
					</view>

					<view class="add-row">
						<view class="add-btn" @click="addTextElement()"><text class="add-btn-text">文本</text></view>
						<view class="add-btn" @click="addPriceElement()"><text class="add-btn-text">价格</text></view>
						<view class="add-btn" @click="addBarcodeElement()"><text class="add-btn-text">条码</text></view>
						<view class="add-btn" @click="addKodElement()"><text class="add-btn-text">KOD</text></view>
						<view class="add-btn" @click="duplicateSelectedElement()"><text class="add-btn-text">复制</text></view>
					</view>

					<view class="field-grid">
						<view class="field">
							<text class="field-label">名称</text>
							<input class="field-input" v-model="editorLabel" placeholder="元素名称" />
						</view>
						<view class="field">
							<text class="field-label">类型</text>
							<view class="segmented">
								<view :class="editorType == 'text' ? 'segment segment-active' : 'segment'" @click="setEditorType('text')">
									<text :class="editorType == 'text' ? 'segment-text segment-text-active' : 'segment-text'">文本</text>
								</view>
								<view :class="editorType == 'barcode' ? 'segment segment-active' : 'segment'" @click="setEditorType('barcode')">
									<text :class="editorType == 'barcode' ? 'segment-text segment-text-active' : 'segment-text'">条码</text>
								</view>
							</view>
						</view>
						<view class="field field-full">
							<text class="field-label">内容</text>
							<input class="field-input" v-model="editorContent" placeholder="打印内容" />
						</view>
						<view class="field">
							<text class="field-label">X mm</text>
							<input class="field-input" v-model="editorX" type="digit" />
						</view>
						<view class="field">
							<text class="field-label">Y mm</text>
							<input class="field-input" v-model="editorY" type="digit" />
						</view>
						<view class="field">
							<text class="field-label">宽 mm</text>
							<input class="field-input" v-model="editorWidth" type="digit" />
						</view>
						<view class="field">
							<text class="field-label">高 mm</text>
							<input class="field-input" v-model="editorHeight" type="digit" />
						</view>
						<view class="field">
							<text class="field-label">字号</text>
							<input class="field-input" v-model="editorFontSize" type="number" />
						</view>
					</view>

					<view class="editor-actions">
						<view class="editor-btn editor-btn-light" @click="deleteSelectedElement()"><text class="editor-btn-light-text">删除</text></view>
						<view class="editor-btn editor-btn-light" @click="duplicateSelectedElement()"><text class="editor-btn-light-text">复制</text></view>
						<view class="editor-btn editor-btn-primary" @click="applyEditor()"><text class="editor-btn-primary-text">应用</text></view>
					</view>
				</view>

				<view class="section">
					<text class="section-title">打印参数</text>
					<view class="field-grid">
						<view class="field">
							<text class="field-label">DPI</text>
							<view class="segmented">
								<view :class="dotsPerMm == 8 ? 'segment segment-active' : 'segment'" @click="setDpi(8)">
									<text :class="dotsPerMm == 8 ? 'segment-text segment-text-active' : 'segment-text'">203</text>
								</view>
								<view :class="dotsPerMm == 12 ? 'segment segment-active' : 'segment'" @click="setDpi(12)">
									<text :class="dotsPerMm == 12 ? 'segment-text segment-text-active' : 'segment-text'">300</text>
								</view>
							</view>
						</view>
						<view class="field">
							<text class="field-label">份数</text>
							<input class="field-input" v-model="copiesText" type="number" placeholder="1" />
						</view>
					</view>

					<view class="printer-card">
						<view class="printer-info">
							<text class="printer-title">{{ printerTitle }}</text>
							<text class="printer-subtitle">{{ printerSubtitle }}</text>
							<text class="printer-status">{{ bluetoothMessage }}</text>
							<text v-if="printerDebugText != ''" class="printer-debug">{{ printerDebugText }}</text>
						</view>
						<view class="printer-actions">
							<view class="small-btn small-btn-light" @click="checkPrinterEnvironment()">
								<text class="small-btn-light-text">检查</text>
							</view>
							<view class="small-btn small-btn-light" @click="refreshPrinters()">
								<text class="small-btn-light-text">{{ searchingPrinters ? '搜索中' : '搜索' }}</text>
							</view>
							<view class="small-btn small-btn-light" @click="disconnectCurrentPrinter()">
								<text class="small-btn-light-text">断开</text>
							</view>
							<view class="small-btn small-btn-primary" @click="printLabel()">
								<text class="small-btn-primary-text">打印</text>
							</view>
						</view>
					</view>

					<view v-if="printers.length > 0" class="printer-list">
						<view v-for="printer in printers" :key="printer.address" :class="selectedPrinterAddress == printer.address ? 'printer-row printer-row-active' : 'printer-row'" @click="selectPrinter(printer)">
							<view class="printer-row-main">
								<text :class="selectedPrinterAddress == printer.address ? 'printer-row-name printer-row-name-active' : 'printer-row-name'">{{ printer.name }}</text>
								<text class="printer-row-address">{{ printer.address }} / {{ printer.type }} / {{ printer.bondState }} / RSSI {{ printer.rssi }}</text>
							</view>
							<text :class="selectedPrinterAddress == printer.address ? 'printer-row-action printer-row-action-active' : 'printer-row-action'">{{ selectedPrinterAddress == printer.address ? '已连接' : '连接' }}</text>
						</view>
					</view>
				</view>

				<view class="section">
					<text class="section-title">TSPL</text>
					<text class="tspl-preview">{{ tsplPreview }}</text>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
import { computed, nextTick } from 'vue'
import liliBottomSelect from '@/uni_modules/lili_bottom-select/components/lili_bottom-select/lili_bottom-select.uvue'
import { getProductList, ProductItem, ProductSelectedFilter } from '@/pkg/api/modules/products.uts'
import { checkBluetoothEnvironment, requestBluetoothEnable, requestLocationPermission, openLocationSettings, searchBluetoothPrinters, connectPrinter, disconnectPrinter, getConnectedPrinter, printTspl, LabelPrinterDevice, LabelPrinterResult } from '@/uni_modules/lili-label-printer/index.uts'
import { scanCode, type ScanCodeOption } from '@/uni_modules/lime-scan'

type LabelElement = {
	key: string
	label: string
	type: string
	source: string
	content: string
	x: number
	y: number
	width: number
	height: number
	fontSize: number
}

type BarcodeBar = {
	key: string
	style: string
}

const labelWidthMm = 32
const labelHeightMm = 20
const previewScale = 10
let labelCanvasContext: DrawableContext | null = null
let canvasLeftPx = 0
let canvasTopPx = 0
const canvasRef = ref<UniElement | null>(null)
const productId = ref('')
const productText = ref('')
const labelName = ref('ITEM')
const labelPrice = ref('0.00')
const labelKod = ref('KOD')
const labelBarcode = ref('5901234123457')
const customFieldLabel = ref('自定义')
const customFieldContent = ref('TEXT')
const selectedKey = ref('price')
const dragStartX = ref(0)
const dragStartY = ref(0)
const dragElementX = ref(0)
const dragElementY = ref(0)
const dragging = ref(false)
const resizing = ref(false)
const scanningBarcode = ref(false)
const resizeStartWidth = ref(0)
const resizeStartHeight = ref(0)
const resizeStartFontSize = ref(0)
const dotsPerMm = ref(8)
const copiesText = ref('1')
const editorLabel = ref('价格')
const editorType = ref('text')
const editorContent = ref('0.00')
const editorX = ref('2')
const editorY = ref('4.7')
const editorWidth = ref('28')
const editorHeight = ref('7')
const editorFontSize = ref('52')
const nextElementIndex = ref(5)
const printers = ref<LabelPrinterDevice[]>([])
const selectedPrinterAddress = ref('')
const selectedPrinterName = ref('')
const bluetoothMessage = ref('请先检查蓝牙环境')
const printerDebugText = ref('')
const searchingPrinters = ref(false)
const connectingPrinter = ref(false)
const defaultPrinterStorageKey = 'label-print:default-printer'

const elements = ref<LabelElement[]>([
	{ key: 'name', label: '条目', type: 'text', source: 'name', content: 'ITEM', x: 2, y: 1.2, width: 28, height: 3.5, fontSize: 16 } as LabelElement,
	{ key: 'price', label: '价格', type: 'text', source: 'price', content: '0.00', x: 2, y: 4.7, width: 28, height: 7, fontSize: 52 } as LabelElement,
	{ key: 'barcode', label: '条码', type: 'barcode', source: 'barcode', content: '5901234123457', x: 2, y: 12.3, width: 28, height: 4.1, fontSize: 12 } as LabelElement,
	{ key: 'kod', label: 'KOD', type: 'text', source: 'kod', content: 'KOD', x: 2, y: 16.6, width: 28, height: 2.3, fontSize: 14 } as LabelElement,
])

function canvasWidthPx(): number {
	return labelWidthMm * previewScale
}

function canvasHeightPx(): number {
	return labelHeightMm * previewScale
}

function drawCanvasText(context: DrawableContext, element: LabelElement) {
	const x = element.x * previewScale
	const y = element.y * previewScale
	const width = element.width * previewScale
	const height = element.height * previewScale
	context.fillStyle = '#111827'
	context.strokeStyle = '#111827'
	context.font = element.fontSize.toString() + 'px'
	context.textAlign = 'center'
	context.fillText(element.content, x + width / 2, y + height / 2 + element.fontSize * 0.35)
	if (element.fontSize >= 32) context.strokeText(element.content, x + width / 2, y + height / 2 + element.fontSize * 0.35)
}

function drawCanvasBarcode(context: DrawableContext, element: LabelElement) {
	const x = element.x * previewScale
	const y = element.y * previewScale
	const width = element.width * previewScale
	const height = element.height * previewScale
	context.fillStyle = '#111827'
	const count = 38
	const barWidth = width / count
	for (let index = 0; index < count; index += 1) {
		if (index % 3 != 1) context.fillRect(x + index * barWidth, y, Math.max(1, barWidth * 0.65), height)
	}
}

function drawCanvasElement(context: DrawableContext, element: LabelElement) {
	const x = element.x * previewScale
	const y = element.y * previewScale
	const width = element.width * previewScale
	const height = element.height * previewScale
	context.strokeStyle = selectedKey.value == element.key ? '#2563EB' : '#CBD5E1'
	context.lineWidth = selectedKey.value == element.key ? 2 : 1
	if (selectedKey.value == element.key) {
		context.fillStyle = 'rgba(37,99,235,0.05)'
		context.fillRect(x, y, width, height)
	}
	context.strokeRect(x + 0.5, y + 0.5, Math.max(1, width - 1), Math.max(1, height - 1))
	if (selectedKey.value == element.key) {
		const handleSize = 12
		context.fillStyle = '#2563EB'
		context.fillRect(x + width - handleSize, y + height - handleSize, handleSize, handleSize)
		context.fillStyle = '#FFFFFF'
		context.fillRect(x + width - 8, y + height - 8, 4, 4)
	}
	if (element.type == 'barcode') {
		drawCanvasBarcode(context, element)
	} else {
		drawCanvasText(context, element)
	}
}

function renderCanvas() {
	if (labelCanvasContext == null) return
	const context = labelCanvasContext as DrawableContext
	const width = canvasWidthPx()
	const height = canvasHeightPx()
	context.reset()
	context.fillStyle = '#FFFFFF'
	context.fillRect(0, 0, width, height)
	context.strokeStyle = '#CBD5E1'
	context.lineWidth = 1
	context.strokeRect(0.5, 0.5, width - 1, height - 1)
	for (let index = 0; index < elements.value.length; index += 1) {
		drawCanvasElement(context, elements.value[index])
	}
	context.update()
}

function renderSoon() {
	nextTick(() => {
		renderCanvas()
	})
}

function initCanvas() {
	if (canvasRef.value == null) return
	const canvas = canvasRef.value as UniElement
	const context = canvas.getDrawableContext()
	if (context == null) return
	labelCanvasContext = context as DrawableContext
	canvas.getBoundingClientRectAsync()?.then((rect) => {
		canvasLeftPx = rect.left
		canvasTopPx = rect.top
	})
	renderCanvas()
}

onReady(() => {
	initCanvas()
})

const boardStyle = computed((): string => {
	return 'width:' + (labelWidthMm * previewScale).toString() + 'px;height:' + (labelHeightMm * previewScale).toString() + 'px;'
})

const printerTitle = computed((): string => {
	if (selectedPrinterName.value != '') return selectedPrinterName.value
	return '未选择标签打印机'
})

const printerSubtitle = computed((): string => {
	if (selectedPrinterAddress.value != '') return selectedPrinterAddress.value
	return '搜索附近蓝牙标签打印机，选择后自动连接'
})

function stringValue(value: any | null, fallback: string = ''): string {
	if (value == null) return fallback
	return '' + value
}

function numberValue(value: string, fallback: number = 0): number {
	const parsed = parseFloat(value)
	if (isNaN(parsed)) return fallback
	return parsed
}

function intValue(value: string, fallback: number = 1): number {
	const parsed = parseInt(value)
	if (isNaN(parsed)) return fallback
	return parsed
}

function formatNumber(value: number): string {
	return (Math.round(value * 10) / 10).toString()
}

function safeText(value: string): string {
	return value.replace('"', "'").replace('\r', ' ').replace('\n', ' ')
}

function onlyDigits(value: string): string {
	let result = ''
	for (let index = 0; index < value.length; index += 1) {
		const char = value.substring(index, index + 1)
		if (char == '0' || char == '1' || char == '2' || char == '3' || char == '4' || char == '5' || char == '6' || char == '7' || char == '8' || char == '9') result = result + char
	}
	return result
}

function calculateEan13CheckDigit(value: string): string {
	let sum = 0
	for (let index = 0; index < value.length; index += 1) {
		const digit = parseInt(value.substring(index, index + 1))
		sum = sum + digit * (index % 2 == 0 ? 1 : 3)
	}
	const check = (10 - (sum % 10)) % 10
	return check.toString()
}

function dot(valueMm: number): number {
	return Math.round(valueMm * dotsPerMm.value)
}

function getElement(key: string): LabelElement | null {
	for (let index = 0; index < elements.value.length; index += 1) {
		if (elements.value[index].key == key) return elements.value[index]
	}
	return null
}

function getSelectedElement(): LabelElement | null {
	return getElement(selectedKey.value)
}

function clampElement(element: LabelElement) {
	if (element.width < 1) element.width = 1
	if (element.height < 1) element.height = 1
	if (element.x < 0) element.x = 0
	if (element.y < 0) element.y = 0
	if (element.x + element.width > labelWidthMm) element.x = labelWidthMm - element.width
	if (element.y + element.height > labelHeightMm) element.y = labelHeightMm - element.height
	if (element.x < 0) element.x = 0
	if (element.y < 0) element.y = 0
}

function boundContent(source: string): string {
	if (source == 'name') return labelName.value
	if (source == 'price') return labelPrice.value
	if (source == 'barcode') return labelBarcode.value
	if (source == 'kod') return labelKod.value
	return ''
}

function syncBoundElements(payload: any | null = null) {
	for (let index = 0; index < elements.value.length; index += 1) {
		const element = elements.value[index]
		if (element.source != 'custom') {
			element.content = boundContent(element.source)
		}
	}
	renderSoon()
}

function scanLabelBarcode() {
	if (scanningBarcode.value) return
	scanningBarcode.value = true
	scanCode({
		success(res) {
			if (res.result == '') return
			labelBarcode.value = res.result
			syncBoundElements()
		},
		fail(err) {
			const message = err.errMsg == '' ? '扫码失败' : err.errMsg
			uni.showToast({ title: message, icon: 'none' })
		},
		complete() {
			scanningBarcode.value = false
		},
	} as ScanCodeOption)
}

function loadEditorFromElement(element: LabelElement) {
	editorLabel.value = element.label
	editorType.value = element.type
	editorContent.value = element.content
	editorX.value = formatNumber(element.x)
	editorY.value = formatNumber(element.y)
	editorWidth.value = formatNumber(element.width)
	editorHeight.value = formatNumber(element.height)
	editorFontSize.value = element.fontSize.toString()
}

function selectElement(key: any) {
	selectedKey.value = stringValue(key)
	const element = getSelectedElement()
	if (element == null) return
	loadEditorFromElement(element as LabelElement)
	renderCanvas()
}

function moveSelected(dx: number, dy: number) {
	const element = getSelectedElement()
	if (element == null) return
	const current = element as LabelElement
	current.x = current.x + dx
	current.y = current.y + dy
	clampElement(current)
	loadEditorFromElement(current)
	renderCanvas()
}

function resizeSelected(delta: number) {
	const element = getSelectedElement()
	if (element == null) return
	const current = element as LabelElement
	current.width = current.width + delta * 2
	current.height = current.height + delta
	if (current.type == 'text') current.fontSize = current.fontSize + delta * 4
	if (current.width < 4) current.width = 4
	if (current.height < 2) current.height = 2
	if (current.type == 'barcode' && current.height < 3) current.height = 3
	if (current.fontSize < 8) current.fontSize = 8
	clampElement(current)
	loadEditorFromElement(current)
	renderCanvas()
}

function setDpi(value: number) {
	dotsPerMm.value = value
}

function setEditorType(value: string) {
	editorType.value = value
}

function getProductName(item: ProductItem): string {
	if (item.name_cn != '') return item.name_cn
	if (item.name_en != '') return item.name_en
	if (item.name_other != '') return item.name_other
	if (item.sku != '') return item.sku
	return '商品 #' + item.id.toString()
}

function productToOption(item: ProductItem): UTSJSONObject {
	let title = getProductName(item)
	if (item.barcode != '') title = title + ' / ' + item.barcode
	return {
		value: item.id.toString(),
		text: title,
		name: getProductName(item),
		price: item.base_sales_price,
		barcode: item.barcode,
		kod: item.sku,
	} as UTSJSONObject
}

async function fetchProductOptions(params: UTSJSONObject): Promise<UTSJSONObject> {
	const keyword = stringValue(params['keyword'])
	const id = stringValue(params['id'])
	const response = await getProductList({
		search: keyword == '' ? null : keyword,
		page: 1,
		page_size: 20,
		filters: [] as ProductSelectedFilter[],
	})
	const result: UTSJSONObject[] = []
	for (let index = 0; index < response.results.length; index += 1) {
		const item = response.results[index]
		if (id != '' && item.id.toString() != id) continue
		result.push(productToOption(item))
	}
	return { data: result, results: result, total: result.length, total_count: result.length } as UTSJSONObject
}

function handleProductChange(payload: any) {
	const currentPayload = payload as UTSJSONObject
	productId.value = stringValue(currentPayload['value'])
	productText.value = stringValue(currentPayload['text'])
	const item = currentPayload['item'] == null ? ({} as UTSJSONObject) : (currentPayload['item'] as UTSJSONObject)
	labelName.value = stringValue(item['name'], productText.value)
	labelPrice.value = stringValue(item['price'], labelPrice.value)
	labelBarcode.value = stringValue(item['barcode'], labelBarcode.value)
	labelKod.value = stringValue(item['kod'], labelKod.value)
	syncBoundElements()
	const selected = getSelectedElement()
	if (selected != null) loadEditorFromElement(selected as LabelElement)
}

function elementStyle(element: any): string {
	const current = element as LabelElement
	return 'left:' + (current.x * previewScale).toString() + 'px;top:' + (current.y * previewScale).toString() + 'px;width:' + (current.width * previewScale).toString() + 'px;height:' + (current.height * previewScale).toString() + 'px;'
}

function elementTextClass(element: any): string {
	const current = element as LabelElement
	if (current.fontSize >= 32) return 'label-text label-text-large'
	return 'label-text'
}

function elementTextStyle(element: any): string {
	const current = element as LabelElement
	return 'font-size:' + current.fontSize.toString() + 'px;'
}

function ean13Pattern(value: string): string {
	const digits = onlyDigits(value)
	const source = digits.length == 12 ? digits + calculateEan13CheckDigit(digits) : digits
	if (source.length != 13) return ''
	const leftOdd = ['0001101', '0011001', '0010011', '0111101', '0100011', '0110001', '0101111', '0111011', '0110111', '0001011']
	const leftEven = ['0100111', '0110011', '0011011', '0100001', '0011101', '0111001', '0000101', '0010001', '0001001', '0010111']
	const right = ['1110010', '1100110', '1101100', '1000010', '1011100', '1001110', '1010000', '1000100', '1001000', '1110100']
	const parity = ['OOOOOO', 'OOEOEE', 'OOEEOE', 'OOEEEO', 'OEOOEE', 'OEEOOE', 'OEEEOO', 'OEOEOE', 'OEOEEO', 'OEEOEO']
	let result = '101'
	const first = parseInt(source.substring(0, 1))
	const parityValue = parity[first]
	for (let index = 1; index <= 6; index += 1) {
		const digit = parseInt(source.substring(index, index + 1))
		result = result + (parityValue.substring(index - 1, index) == 'O' ? leftOdd[digit] : leftEven[digit])
	}
	result = result + '01010'
	for (let index = 7; index <= 12; index += 1) {
		const digit = parseInt(source.substring(index, index + 1))
		result = result + right[digit]
	}
	return result + '101'
}

function barcodeBarsFor(element: any): BarcodeBar[] {
	const current = element as LabelElement
	const pattern = ean13Pattern(current.content)
	const result: BarcodeBar[] = []
	if (pattern != '') {
		const moduleWidth = current.width * previewScale / pattern.length
		for (let index = 0; index < pattern.length; index += 1) {
			if (pattern.substring(index, index + 1) == '1') {
				result.push({ key: current.key + '-' + index.toString(), style: 'left:' + (index * moduleWidth).toString() + 'px;width:' + Math.max(1, moduleWidth).toString() + 'px;' } as BarcodeBar)
			}
		}
		return result
	}
	const count = 38
	const barWidth = current.width * previewScale / count
	for (let index = 0; index < count; index += 1) {
		if (index % 3 != 1) result.push({ key: current.key + '-' + index.toString(), style: 'left:' + (index * barWidth).toString() + 'px;width:' + Math.max(1, barWidth * 0.65).toString() + 'px;' } as BarcodeBar)
	}
	return result
}

function touchPoint(event: any): UTSJSONObject {
	const touchEvent = event as TouchEvent
	if (touchEvent.touches.length > 0) {
		const touch = touchEvent.touches[0]
		return { x: touch.clientX, y: touch.clientY, pageX: touch.pageX, pageY: touch.pageY } as UTSJSONObject
	}
	if (touchEvent.changedTouches.length > 0) {
		const touch = touchEvent.changedTouches[0]
		return { x: touch.clientX, y: touch.clientY, pageX: touch.pageX, pageY: touch.pageY } as UTSJSONObject
	}
	const text = JSON.stringify(event)
	if (text == null || text == '') return {} as UTSJSONObject
	const object = JSON.parseObject<UTSJSONObject>(text)
	if (object == null) return {} as UTSJSONObject
	const currentObject = object as UTSJSONObject
	let touches = JSON.parseArray<UTSJSONObject>(JSON.stringify(currentObject['touches']))
	if (touches == null) touches = JSON.parseArray<UTSJSONObject>(JSON.stringify(currentObject['changedTouches']))
	if (touches == null) return {} as UTSJSONObject
	const touchList = touches as UTSJSONObject[]
	if (touchList.length == 0) return {} as UTSJSONObject
	return touchList[0]
}

function canvasTouchPx(event: any): UTSJSONObject {
	const point = touchPoint(event)
	let x = numberValue(stringValue(point['x'], stringValue(point['clientX'], stringValue(point['pageX'], stringValue(point['offsetX'])))), 0)
	let y = numberValue(stringValue(point['y'], stringValue(point['clientY'], stringValue(point['pageY'], stringValue(point['offsetY'])))), 0)
	if (canvasRef.value != null) {
		const canvas = canvasRef.value as UniElement
		canvas.getBoundingClientRectAsync()?.then((rect) => {
			canvasLeftPx = rect.left
			canvasTopPx = rect.top
		})
	}
	if (x > canvasWidthPx() || y > canvasHeightPx() || canvasLeftPx > 0 || canvasTopPx > 0) {
		x = x - canvasLeftPx
		y = y - canvasTopPx
	}
	if (x > canvasWidthPx()) x = canvasWidthPx()
	if (y > canvasHeightPx()) y = canvasHeightPx()
	if (x < 0) x = 0
	if (y < 0) y = 0
	return { x: x, y: y } as UTSJSONObject
}

function hitElement(xMm: number, yMm: number): LabelElement | null {
	for (let index = elements.value.length - 1; index >= 0; index -= 1) {
		const element = elements.value[index]
		if (xMm >= element.x && xMm <= element.x + element.width && yMm >= element.y && yMm <= element.y + element.height) return element
	}
	return null
}

function isResizeHandle(element: LabelElement, xMm: number, yMm: number): boolean {
	const handleMm = 2
	return xMm >= element.x + element.width - handleMm && xMm <= element.x + element.width + handleMm && yMm >= element.y + element.height - handleMm && yMm <= element.y + element.height + handleMm
}

function handleCanvasTouchStart(event: any) {
	const point = canvasTouchPx(event)
	const xMm = numberValue(stringValue(point['x']), 0) / previewScale
	const yMm = numberValue(stringValue(point['y']), 0) / previewScale
	const element = hitElement(xMm, yMm)
	if (element == null) return
	selectedKey.value = element.key
	loadEditorFromElement(element)
	resizing.value = isResizeHandle(element, xMm, yMm)
	dragging.value = !resizing.value
	dragStartX.value = numberValue(stringValue(point['x']), 0)
	dragStartY.value = numberValue(stringValue(point['y']), 0)
	dragElementX.value = element.x
	dragElementY.value = element.y
	resizeStartWidth.value = element.width
	resizeStartHeight.value = element.height
	resizeStartFontSize.value = element.fontSize
	renderCanvas()
}

function handleCanvasTouchMove(event: any) {
	if (!dragging.value && !resizing.value) return
	const element = getSelectedElement()
	if (element == null) return
	const current = element as LabelElement
	const point = canvasTouchPx(event)
	const x = numberValue(stringValue(point['x']), dragStartX.value)
	const y = numberValue(stringValue(point['y']), dragStartY.value)
	const dxMm = (x - dragStartX.value) / previewScale
	const dyMm = (y - dragStartY.value) / previewScale
	if (resizing.value) {
		current.width = resizeStartWidth.value + dxMm
		current.height = resizeStartHeight.value + dyMm
		if (current.type == 'text') current.fontSize = resizeStartFontSize.value + Math.round(dyMm * 4)
		if (current.width < 4) current.width = 4
		if (current.height < 2) current.height = 2
		if (current.type == 'barcode' && current.height < 3) current.height = 3
		if (current.fontSize < 8) current.fontSize = 8
	} else {
		current.x = dragElementX.value + dxMm
		current.y = dragElementY.value + dyMm
	}
	clampElement(current)
	loadEditorFromElement(current)
	renderCanvas()
}

function handleCanvasTouchEnd(event: any) {
	dragging.value = false
	resizing.value = false
}

function handleTouchStart(key: any, event: any) {
	selectElement(key)
	const element = getSelectedElement()
	if (element == null) return
	const point = touchPoint(event)
	const current = element as LabelElement
	dragging.value = true
	dragStartX.value = numberValue(stringValue(point['x'], stringValue(point['clientX'])), 0)
	dragStartY.value = numberValue(stringValue(point['y'], stringValue(point['clientY'])), 0)
	dragElementX.value = current.x
	dragElementY.value = current.y
}

function handleTouchMove(event: any) {
	if (!dragging.value) return
	const element = getSelectedElement()
	if (element == null) return
	const current = element as LabelElement
	const point = touchPoint(event)
	const x = numberValue(stringValue(point['x'], stringValue(point['clientX'])), dragStartX.value)
	const y = numberValue(stringValue(point['y'], stringValue(point['clientY'])), dragStartY.value)
	current.x = dragElementX.value + (x - dragStartX.value) / previewScale
	current.y = dragElementY.value + (y - dragStartY.value) / previewScale
	clampElement(current)
	loadEditorFromElement(current)
}

function handleTouchEnd(event: any) {
	dragging.value = false
	resizing.value = false
}

function makeElement(type: string, label: string, content: string, x: number, y: number, width: number, height: number, fontSize: number, source: string = 'custom'): LabelElement {
	const key = 'custom-' + nextElementIndex.value.toString()
	nextElementIndex.value = nextElementIndex.value + 1
	return { key: key, label: label, type: type, source: source, content: content, x: x, y: y, width: width, height: height, fontSize: fontSize } as LabelElement
}

function addElement(element: LabelElement) {
	elements.value.push(element)
	selectedKey.value = element.key
	loadEditorFromElement(element)
	renderSoon()
}

function addTextElement() {
	addElement(makeElement('text', '文本', 'TEXT', 2, 2, 16, 4, 16))
}

function addPriceElement() {
	addElement(makeElement('text', '价格', labelPrice.value, 2, 5, 20, 6, 36, 'price'))
}

function addBarcodeElement() {
	addElement(makeElement('barcode', '条码', labelBarcode.value, 2, 12, 24, 4, 12, 'barcode'))
}

function addKodElement() {
	addElement(makeElement('text', 'KOD', labelKod.value, 2, 16, 18, 3, 14, 'kod'))
}

function nextCustomLabel(): string {
	if (customFieldLabel.value != '') return customFieldLabel.value
	return '自定义'
}

function nextCustomContent(): string {
	if (customFieldContent.value != '') return customFieldContent.value
	return 'TEXT'
}

function addCustomTextElement() {
	addElement(makeElement('text', nextCustomLabel(), nextCustomContent(), 2, 2, 18, 4, 18))
}

function addCustomBarcodeElement() {
	addElement(makeElement('barcode', nextCustomLabel(), nextCustomContent(), 2, 12, 24, 4, 12))
}

function duplicateSelectedElement() {
	const element = getSelectedElement()
	if (element == null) return
	const current = element as LabelElement
	const copy = makeElement(current.type, current.label + ' 副本', current.content, current.x + 1, current.y + 1, current.width, current.height, current.fontSize)
	copy.source = 'custom'
	clampElement(copy)
	addElement(copy)
}

function applyEditor() {
	const element = getSelectedElement()
	if (element == null) return
	const current = element as LabelElement
	current.label = editorLabel.value == '' ? current.label : editorLabel.value
	current.type = editorType.value == 'barcode' ? 'barcode' : 'text'
	current.source = 'custom'
	current.content = editorContent.value
	current.x = numberValue(editorX.value, current.x)
	current.y = numberValue(editorY.value, current.y)
	current.width = numberValue(editorWidth.value, current.width)
	current.height = numberValue(editorHeight.value, current.height)
	current.fontSize = intValue(editorFontSize.value, current.fontSize)
	clampElement(current)
	loadEditorFromElement(current)
	renderCanvas()
}

function deleteSelectedElement() {
	if (elements.value.length <= 1) {
		uni.showToast({ title: '至少保留一个元素', icon: 'none' })
		return
	}
	const next: LabelElement[] = []
	for (let index = 0; index < elements.value.length; index += 1) {
		if (elements.value[index].key != selectedKey.value) next.push(elements.value[index])
	}
	elements.value = next
	selectedKey.value = elements.value[0].key
	loadEditorFromElement(elements.value[0])
	renderSoon()
}

function tsplScale(fontSize: number): number {
	if (fontSize >= 46) return 3
	if (fontSize >= 28) return 2
	return 1
}

function normalizeBarcode(value: string): string {
	const digits = onlyDigits(value)
	if (digits.length == 12) return digits + calculateEan13CheckDigit(digits)
	return value.replace(' ', '')
}

function barcodeType(value: string): string {
	const digits = onlyDigits(value)
	if (digits.length == 12 || digits.length == 13) return 'EAN13'
	return '128'
}

function buildTspl(includePrint: boolean): string {
	const parsedCopies = parseInt(copiesText.value)
	const copies = isNaN(parsedCopies) ? 1 : Math.max(1, parsedCopies)
	let command = ''
	command = command + 'SIZE 32 mm,20 mm\r\n'
	command = command + 'GAP 1 mm,0 mm\r\n'
	command = command + 'DIRECTION 1\r\n'
	command = command + 'REFERENCE 0,0\r\n'
	command = command + 'CLS\r\n'
	command = command + 'SPEED 4\r\n'
	command = command + 'DENSITY 12\r\n'
	for (let index = 0; index < elements.value.length; index += 1) {
		const element = elements.value[index]
		if (element.type == 'barcode') {
			command = command + 'BARCODE ' + dot(element.x).toString() + ',' + dot(element.y).toString() + ',"' + barcodeType(element.content) + '",' + dot(element.height).toString() + ',0,0,2,3,"' + safeText(normalizeBarcode(element.content)) + '"\r\n'
		} else {
			const scale = tsplScale(element.fontSize)
			command = command + 'TEXT ' + dot(element.x).toString() + ',' + dot(element.y).toString() + ',"TSS24.BF2",0,' + scale.toString() + ',' + scale.toString() + ',"' + safeText(element.content) + '"\r\n'
		}
	}
	if (includePrint) command = command + 'PRINT ' + copies.toString() + ',1\r\n'
	return command
}

const selectedElementLabel = computed((): string => {
	const element = getSelectedElement()
	if (element == null) return '未选择'
	const current = element as LabelElement
	return current.label + '  x:' + formatNumber(current.x) + 'mm y:' + formatNumber(current.y) + 'mm'
})

const tsplPreview = computed((): string => {
	return buildTspl(true)
})

function buildDebugTspl(): string {
	let command = ''
	command = command + 'SIZE 40 mm,30 mm\r\n'
	command = command + 'GAP 2 mm,0 mm\r\n'
	command = command + 'DIRECTION 1\r\n'
	command = command + 'REFERENCE 0,0\r\n'
	command = command + 'CLS\r\n'
	command = command + 'SPEED 4\r\n'
	command = command + 'DENSITY 12\r\n'
	command = command + 'TEXT 24,24,"TSS24.BF2",0,1,1,"LILI TEST"\r\n'
	command = command + 'TEXT 24,64,"TSS24.BF2",0,1,1,"TSPL OK"\r\n'
	command = command + 'BARCODE 24,110,"128",60,1,0,2,2,"1234567890"\r\n'
	command = command + 'PRINT 1,1\r\n'
	return command
}

function resultMessage(result: LabelPrinterResult, fallback: string): string {
	if (result.message != '') return result.message
	return fallback
}

function resultStringData(result: LabelPrinterResult, key: string): string {
	if (result.data == null) return ''
	const value = result.data![key]
	if (value == null) return ''
	return value.toString()
}

function showActionMessage(result: LabelPrinterResult, fallback: string) {
	uni.showToast({ title: resultMessage(result, fallback), icon: result.success ? 'success' : 'none' })
}

function saveDefaultPrinter(name: string, address: string) {
	if (address == '') return
	const payload = { name: name, address: address } as UTSJSONObject
	uni.setStorageSync(defaultPrinterStorageKey, JSON.stringify(payload))
}

function loadDefaultPrinterInfo() {
	const stored = uni.getStorageSync(defaultPrinterStorageKey)
	if (stored == null || stored == '') return
	try {
		const data = JSON.parse(stored as string) as UTSJSONObject
		const name = data['name']
		const address = data['address']
		if (address != null && address.toString() != '') {
			selectedPrinterAddress.value = address.toString()
			selectedPrinterName.value = name == null ? '默认标签打印机' : name.toString()
			bluetoothMessage.value = '已读取上次连接的打印机，请重新连接后打印'
		}
	} catch (error) {}
}

onLoad(() => {
	loadDefaultPrinterInfo()
})

function updateConnectedFromResult(result: LabelPrinterResult) {
	const name = resultStringData(result, 'name')
	const address = resultStringData(result, 'address')
	if (address == '') return
	selectedPrinterAddress.value = address
	selectedPrinterName.value = name == '' ? '标签打印机' : name
	saveDefaultPrinter(selectedPrinterName.value, selectedPrinterAddress.value)
}

function checkPrinterEnvironment() {
	const result = checkBluetoothEnvironment()
	bluetoothMessage.value = resultMessage(result, '蓝牙环境检查完成')
	showActionMessage(result, '蓝牙环境检查完成')
	const connected = getConnectedPrinter()
	if (connected.success) updateConnectedFromResult(connected)
}

function ensurePrinterEnvironment(done: (ready: boolean) => void) {
	const result = checkBluetoothEnvironment()
	bluetoothMessage.value = resultMessage(result, '蓝牙环境检查完成')
	if (result.success) {
		done(true)
		return
	}
	if (result.code == 'BLUETOOTH_DISABLED') {
		uni.showModal({
			title: '需要开启蓝牙',
			content: '搜索和连接标签打印机需要先开启系统蓝牙。',
			confirmText: '打开蓝牙',
			cancelText: '取消',
			success: (modal) => {
				if (modal.confirm) {
					const openResult = requestBluetoothEnable()
					bluetoothMessage.value = resultMessage(openResult, '已请求开启蓝牙')
					showActionMessage(openResult, '已请求开启蓝牙')
				}
				done(false)
			}
		})
		return
	}
	if (result.code == 'LOCATION_PERMISSION_REQUIRED') {
		uni.showModal({
			title: '需要位置权限',
			content: 'Android 搜索蓝牙设备需要蓝牙和位置权限，请允许后再搜索打印机。',
			confirmText: '去授权',
			cancelText: '取消',
			success: (modal) => {
				if (!modal.confirm) {
					done(false)
					return
				}
				requestLocationPermission().then((permissionResult) => {
					bluetoothMessage.value = resultMessage(permissionResult, '权限请求完成')
					showActionMessage(permissionResult, '权限请求完成')
					done(permissionResult.success)
				})
			}
		})
		return
	}
	if (result.code == 'LOCATION_SERVICE_DISABLED') {
		uni.showModal({
			title: '需要开启位置服务',
			content: '系统位置服务关闭时可能无法搜索蓝牙设备，请开启后返回继续搜索。',
			confirmText: '去开启',
			cancelText: '继续',
			success: (modal) => {
				if (modal.confirm) {
					const openResult = openLocationSettings()
					bluetoothMessage.value = resultMessage(openResult, '已打开位置设置')
					showActionMessage(openResult, '已打开位置设置')
					done(false)
					return
				}
				done(true)
			}
		})
		return
	}
	showActionMessage(result, '蓝牙环境异常')
	done(false)
}

function printLabel() {
	if (selectedPrinterAddress.value == '') {
		uni.showToast({ title: '请先选择打印机', icon: 'none' })
		return
	}
	const response = printTspl({
		address: selectedPrinterAddress.value,
		tspl: buildDebugTspl(),
		charset: 'GBK',
		chunkSize: 256,
		delayMs: 20,
	})
	bluetoothMessage.value = resultMessage(response, '打印完成')
	if (response.success) {
		const connected = getConnectedPrinter()
		if (connected.success) updateConnectedFromResult(connected)
	}
	showActionMessage(response, '打印完成')
}

function refreshPrinters() {
	if (searchingPrinters.value) return
	ensurePrinterEnvironment((ready) => {
		if (!ready) return
		searchingPrinters.value = true
		bluetoothMessage.value = '正在搜索附近蓝牙打印机...'
		printerDebugText.value = '开始搜索：只显示本次扫描发现的蓝牙设备'
		console.log('[label-print] start search bluetooth printers')
		searchBluetoothPrinters(10000).then((devices) => {
			printers.value = devices
			searchingPrinters.value = false
			if (devices.length == 0) {
				bluetoothMessage.value = '未找到蓝牙打印机，请确认打印机已开机'
				printerDebugText.value = '搜索结束：0 台设备。本次不会回退显示历史已配对设备。'
				console.log('[label-print] search finished, count=0')
				uni.showToast({ title: '未找到打印机', icon: 'none' })
				return
			}
			bluetoothMessage.value = '已发现 ' + devices.length.toString() + ' 台蓝牙设备'
			let debugText = '搜索结束：' + devices.length.toString() + ' 台。'
			for (let i = 0; i < devices.length; i++) {
				const item = devices[i]
				debugText = debugText + ' #' + (i + 1).toString() + ' ' + item.name + ' ' + item.address + ' RSSI ' + item.rssi.toString()
				console.log('[label-print] device #' + (i + 1).toString() + ': ' + item.name + ', ' + item.address + ', ' + item.type + ', ' + item.bondState + ', rssi=' + item.rssi.toString())
			}
			printerDebugText.value = debugText
		})
	})
}

function selectPrinter(printer: any) {
	if (connectingPrinter.value) return
	const current = printer as LabelPrinterDevice
	connectingPrinter.value = true
	bluetoothMessage.value = '正在连接 ' + current.name
	selectedPrinterAddress.value = current.address
	selectedPrinterName.value = current.name
	const result = connectPrinter(current.address)
	connectingPrinter.value = false
	bluetoothMessage.value = resultMessage(result, '连接完成')
	if (result.success) {
		updateConnectedFromResult(result)
	}
	showActionMessage(result, '连接完成')
}

function disconnectCurrentPrinter() {
	const result = disconnectPrinter()
	bluetoothMessage.value = resultMessage(result, '已断开打印机')
	showActionMessage(result, '已断开打印机')
}
</script>

