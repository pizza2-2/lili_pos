<template>
	<view class="page">
		<lili-universal-filter
			:title="pageTitle"
			searchPlaceholder="商品名、SKU、条码"
			:searchValue="keyword"
			:filterVisible="filterVisible"
			:showBack="true"
			:showSearch="true"
			:showFilter="true"
			:showScan="true"
			:showHome="true"
			:filterActive="hasActiveFilter"
			filterText="重置"
			homePath="/pages/purchases/index"
			@searchInput="handleSearchInput"
			@searchConfirm="handleSearchConfirm"
			@searchClear="handleSearchClear"
			@scan="handleScanSearch"
			@update:filterVisible="handleFilterVisibleChange"
			@filter-open="handleFilterOpen"
		>
			<template #filter-panel>
				<view class="purchase-filter-panel" :style="filterPanelStyle">
					<scroll-view scroll-y="true" class="purchase-filter-content-scroll" :style="filterContentScrollStyle">
						<view class="purchase-filter-scroll-inner">
							<view v-if="filterOptionsLoading" class="purchase-filter-state">
								<text class="purchase-filter-state-text">筛选选项加载中...</text>
							</view>

							<view v-else-if="filterOptionsError != ''" class="purchase-filter-state">
								<text class="purchase-filter-state-text">{{ filterOptionsError }}</text>
							</view>

							<view v-else-if="filterDefinitions.length > 0" class="purchase-filter-groups">
								<view
									v-for="filter in filterDefinitions"
									:key="filter.key"
									class="purchase-filter-group"
								>
									<text class="purchase-filter-group-title">{{ filter.label }}</text>
									<view class="purchase-filter-options">
										<view
											v-for="option in filter.options"
											:key="filter.key + '-' + option.value"
											:class="isFilterOptionSelected(filter.param, option.value) ? 'purchase-filter-option purchase-filter-option-active' : 'purchase-filter-option'"
											@click="toggleFilterOption(filter.param, option.value, filter.multiple)"
										>
											<text :class="isFilterOptionSelected(filter.param, option.value) ? 'purchase-filter-option-text purchase-filter-option-text-active' : 'purchase-filter-option-text'">{{ option.label }}</text>
										</view>
									</view>
								</view>
							</view>
						</view>
					</scroll-view>

					<view class="purchase-filter-actions">
						<view class="purchase-filter-btn purchase-filter-btn-light" @click="handleFilterReset">
							<text class="purchase-filter-btn-light-text">重置</text>
						</view>
						<view class="purchase-filter-btn purchase-filter-btn-primary" @click="applySelectedFilters">
							<text class="purchase-filter-btn-primary-text">应用</text>
						</view>
					</view>
				</view>
			</template>
		</lili-universal-filter>

		<!-- #ifdef APP -->
		<scroll-view style="flex:1" class="page-scroll">
		<!-- #endif -->
			<view class="page-content">
				<view v-if="errorMessage != '' && !isLoading" class="error-card">
					<text class="error-title">加载失败</text>
					<text class="error-desc">{{ errorMessage }}</text>
					<view class="retry-btn" @click="loadDetails()"><text class="retry-btn-text">重新加载</text></view>
				</view>

				<!-- 收货即归类：在治理债的源头处理未分类商品 -->
				<view v-if="uncategorizedProductIds().length > 0" class="classify-card">
					<view class="classify-main">
						<text class="classify-title">本页 {{ uncategorizedProductIds().length.toString() }} 个商品未分类</text>
						<text class="classify-desc">未分类商品不继承税率 / 打印模板等分类规则</text>
					</view>
					<view class="classify-btn" @click="confirmAutoClassifyUncategorized">
						<text class="classify-btn-text">智能归类</text>
					</view>
				</view>

				<lili-UniversalList
					:items="listItems"
					keyField="id"
					titleField="title"
					subtitleField="subtitle"
					metaField="amountText"
					tagField="tags"
					:fields="fieldConfig"
					:loading="isLoading"
					loadingText="正在加载采购明细"
					:keepContentOnLoading="true"
					inlineLoadingText="采购明细刷新中..."
					:emptyText="emptyText"
					emptyIcon="◎"
					:showMenu="true"
					:menuActions="menuActions"
					:showChevron="false"
					:showPagination="true"
					:currentPage="currentPage"
					:totalPages="totalPages"
					:totalCount="totalCount"
					:selectionMode="selectionMode"
					:selectedItems="selectedDetailIds"
					:batchActions="batchToolbarActions"
					:batchInfoText="batchInfoText"
					summaryTitle="明细概览"
					:summaryItems="summaryItems"
					:showFloatingAdd="true"
					floatingAddText="新增明细"
					@update:selectionMode="handleSelectionModeChange"
					@update:selectedItems="handleSelectedDetailIdsChange"
					@selection-exit="handleSelectionExit"
					@batch-action="handleBatchToolbarAction"
					@item-click="handleItemClick"
					@menu="handleMenu"
					@page-change="handlePageChange"
					@floating-add="handleCreate"
				/>
			</view>
		<!-- #ifdef APP -->
		</scroll-view>
		<!-- #endif -->

		<page-container
			:show="batchCategoryVisible"
			position="bottom"
			:round="true"
			:overlay="true"
			:duration="240"
			overlay-style="background-color: rgba(15, 23, 42, 0.42);"
			custom-style="background-color: #FFFFFF;"
			@clickoverlay="closeBatchCategoryPopup"
		>
			<view class="batch-panel">
				<view class="batch-handle"></view>
				<view class="batch-head">
					<view>
						<text class="batch-title">批量修改分类</text>
						<text class="batch-subtitle">{{ batchInfoText }}</text>
					</view>
					<view class="batch-close" @click="closeBatchCategoryPopup">
						<text class="batch-close-text">关闭</text>
					</view>
				</view>

				<view class="batch-field">
					<text class="batch-label">目标分类</text>
					<liliBottomSelect
						:value="batchCategoryValue"
						:valueText="batchCategoryText"
						title="选择分类"
						placeholder="请选择分类"
						searchPlaceholder="请输入分类名称"
						emptyText="暂无分类"
						:tree="true"
						:checkStrictly="false"
						:expandOnClickNode="true"
						:selectableLevel="2"
						selectableLevelMessage="只能选择二级分类"
						:showAddAction="false"
						:showEditAction="false"
						:fetchData="fetchCategoryOptions"
						@change="handleBatchCategoryChange"
					/>
				</view>

				<view class="batch-actions">
					<view class="batch-secondary-btn" @click="closeBatchCategoryPopup">
						<text class="batch-secondary-text">取消</text>
					</view>
					<view class="batch-primary-btn" @click="confirmBatchUpdateCategory">
						<text class="batch-primary-text">{{ batchSubmitting ? '处理中...' : '确认修改' }}</text>
					</view>
				</view>
			</view>
		</page-container>
	</view>
</template>

<script setup lang="uts">
import { computed } from 'vue'
import { getListPageSize } from '@/pkg/util/settings.uts'
import liliBottomSelect from '@/uni_modules/lili_bottom-select/components/lili_bottom-select/lili_bottom-select.uvue'
import { request, takeLatestResponseMessage } from '@/pkg/api/index.uts'
import { batchAutoClassifyProductCategory, batchUpdateProductCategory, ProductBatchActionResponse } from '@/pkg/api/modules/products.uts'
import { showErrorToast } from '@/pkg/util/toast.uts'
import { formatMoney } from '@/pkg/util/format.uts'
import { checkPurchaseProduct, deletePurchaseDetail, getPurchaseDetailList, getPurchaseDetail, getPurchaseDetailFilterOptions, PurchaseDetailFilterDefinition, PurchaseDetailFilterOptionsResponse, PurchaseDetailItem, PurchaseDetailListResponse, PurchaseItem, receivePurchaseDetail } from '@/pkg/api/modules/purchases.uts'
// #ifdef APP-ANDROID
import { scanCode, type GeneralCallbackResult, type ScanCodeOption, type ScanCodeSuccessCallbackResult } from '@/uni_modules/lime-scan'
// #endif
// #ifdef APP-ANDROID
import { startVolumeKeyListener, stopVolumeKeyListener, VolumeKeyEvent } from '@/uni_modules/lili-key'
// #endif

type PurchaseDetailSelectedFilter = {
	param: string
	value: string
}

const refreshStorageKey = 'refresh:pages:purchases:details:index'
const purchaseListRefreshStorageKey = 'refresh:pages:purchases:index'
const purchaseId = ref('')
const purchaseInfo = ref<PurchaseItem | null>(null)
const keyword = ref('')
const filterVisible = ref(false)
const details = ref<PurchaseDetailItem[]>([])
const isLoading = ref(false)
const errorMessage = ref('')
const currentPage = ref(1)
const totalPages = ref(1)
const totalCount = ref(0)
const pageSize = ref(getListPageSize())
const pageTotalAmount = ref('0.00')
const filterOptionsLoading = ref(false)
const filterOptionsError = ref('')
const filterOptions = ref<PurchaseDetailFilterOptionsResponse | null>(null)
const selectedFilters = ref<PurchaseDetailSelectedFilter[]>([])
const filterPanelHeight = ref(420)
const filterContentHeight = ref(356)
const volumeScanLocked = ref(false)
const scanLookupRunning = ref(false)
const selectionMode = ref(false)
const selectedDetailIds = ref<string[]>([])
const batchCategoryVisible = ref(false)
const batchSubmitting = ref(false)
const batchCategoryValue = ref('')
const batchCategoryText = ref('')
let volumeKeyStartTimer = 0

const fieldConfig = ref<UTSJSONObject[]>([
	{ key: 'skuText', label: 'SKU:' } as UTSJSONObject,
	{ key: 'quantityText', label: '数量:' } as UTSJSONObject,
	{ key: 'progressText', label: '收货:' } as UTSJSONObject,
])

const menuActions = ref<UTSJSONObject[]>([
	{ key: 'edit', text: '编辑' } as UTSJSONObject,
	{ key: 'receive', text: '收货' } as UTSJSONObject,
	{ key: 'delete', text: '删除' } as UTSJSONObject,
])

const batchToolbarActions = ref<UTSJSONObject[]>([
	{ key: 'update-category', text: '改分类' } as UTSJSONObject,
])

function stringValue(value: any | null, fallback: string = ''): string {
	if (value == null) return fallback
	const text = '' + value
	if (text == '') return fallback
	return text
}

function booleanValue(value: any | null): boolean {
	if (value == null) return false
	const text = ('' + value).toLowerCase()
	return text == 'true' || text == '1' || text == 'yes'
}

function numberValue(value: any | null): number {
	if (value == null) return 0
	const parsed = parseInt('' + value)
	if (isNaN(parsed)) return 0
	return parsed
}

function parseObject(value: any | null): UTSJSONObject | null {
	if (value == null) return null
	const text = JSON.stringify(value)
	if (text == null || text == '') return null
	return JSON.parseObject<UTSJSONObject>(text)
}

function parseObjectArray(value: any | null): UTSJSONObject[] {
	if (value == null) return [] as UTSJSONObject[]
	const text = JSON.stringify(value)
	if (text == null || text == '') return [] as UTSJSONObject[]
	const parsed = JSON.parseArray<UTSJSONObject>(text)
	if (parsed == null) return [] as UTSJSONObject[]
	return parsed!
}

function normalizeErrorText(text: string): string {
	if (text.startsWith('Error: ')) return text.substring(7)
	return text
}

function readErrorMessageFromObject(errorObject: UTSJSONObject): string {
	const keys: string[] = ['message', 'detail', 'error', 'errMsg', 'msg']
	for (let index = 0; index < keys.length; index += 1) {
		const rawMessage = errorObject[keys[index]]
		if (rawMessage != null) {
			const message = normalizeErrorText(stringValue(rawMessage))
			if (message != '') return message
		}
	}
	return ''
}

function parseErrorMessage(error: any, fallback: string): string {
	if (error == null) return fallback
	const directText = normalizeErrorText(stringValue(error))
	if (directText != '' && directText != '[object Object]' && directText != '{}') return directText
	const errorText = JSON.stringify(error)
	if (errorText == null || errorText == '' || errorText == '{}') return fallback
	const parsedError = JSON.parseObject<UTSJSONObject>(errorText)
	if (parsedError != null) {
		const parsedMessage = readErrorMessageFromObject(parsedError)
		if (parsedMessage != '') return parsedMessage
	}
	return errorText
}

function updateFilterPanelLayout() {
	const info = uni.getWindowInfo()
	let nextPanelHeight = info.windowHeight - 168
	if (nextPanelHeight > 420) nextPanelHeight = 420
	if (nextPanelHeight < 320) nextPanelHeight = 320
	let nextContentHeight = nextPanelHeight - 64
	if (nextContentHeight < 240) nextContentHeight = 240
	filterPanelHeight.value = nextPanelHeight
	filterContentHeight.value = nextContentHeight
}

function closeFilterDrawer() {
	filterVisible.value = false
}

function handleFilterVisibleChange(value: boolean) {
	filterVisible.value = value
}

function setSelectedFilterValue(param: string, value: string) {
	const nextFilters: PurchaseDetailSelectedFilter[] = []
	let updated = false
	for (let index = 0; index < selectedFilters.value.length; index += 1) {
		const filter = selectedFilters.value[index]
		if (filter.param == param) {
			if (value != '') {
				nextFilters.push({ param: param, value: value } as PurchaseDetailSelectedFilter)
			}
			updated = true
			continue
		}
		nextFilters.push(filter)
	}
	if (!updated && value != '') {
		nextFilters.push({ param: param, value: value } as PurchaseDetailSelectedFilter)
	}
	selectedFilters.value = nextFilters
}

function selectedFilterValue(param: string): string {
	for (let index = 0; index < selectedFilters.value.length; index += 1) {
		const filter = selectedFilters.value[index]
		if (filter.param == param) return filter.value
	}
	return ''
}

function splitSelectedValues(value: string): string[] {
	if (value == '') return [] as string[]
	const parts = value.split(',')
	const result: string[] = []
	for (let index = 0; index < parts.length; index += 1) {
		const text = parts[index].trim()
		if (text != '') result.push(text)
	}
	return result
}

function extractCategoryTreeSource(value: any | null): UTSJSONObject[] {
	const rawObject = parseObject(value)
	if (rawObject == null) return [] as UTSJSONObject[]

	const groups = parseObjectArray(rawObject['groups'])
	for (let index = 0; index < groups.length; index += 1) {
		const group = groups[index]
		if (stringValue(group['key']) == 'parent') {
			return parseObjectArray(group['items'])
		}
	}
	if (groups.length > 0) {
		return parseObjectArray(groups[0]['items'])
	}
	return parseObjectArray(rawObject['items'])
}

function buildOptionValue(item: UTSJSONObject): string {
	const directValue = stringValue(item['value'])
	if (directValue != '') return directValue
	const idValue = stringValue(item['id'])
	if (idValue != '') return idValue
	const codeValue = stringValue(item['code'])
	if (codeValue != '') return codeValue
	return stringValue(item['key'])
}

function buildOptionText(item: UTSJSONObject): string {
	const textValue = stringValue(item['text'])
	if (textValue != '') return textValue
	const labelValue = stringValue(item['label'])
	if (labelValue != '') return labelValue
	const fullNameValue = stringValue(item['full_name'])
	if (fullNameValue != '') return fullNameValue
	const nameValue = stringValue(item['name'])
	if (nameValue != '') return nameValue
	const nameCn = stringValue(item['name_cn'])
	if (nameCn != '') return nameCn
	return buildOptionValue(item)
}

function buildTreeSelectItem(item: UTSJSONObject): UTSJSONObject {
	const rawChildren = parseObjectArray(item['children'])
	const children: UTSJSONObject[] = []
	for (let index = 0; index < rawChildren.length; index += 1) {
		children.push(buildTreeSelectItem(rawChildren[index]))
	}
	const label = stringValue(item['label'], buildOptionText(item))
	const fullName = stringValue(item['full_name'])
	return {
		value: buildOptionValue(item),
		text: label,
		label: label,
		full_name: fullName == '' ? label : fullName,
		code: stringValue(item['code']),
		level: stringValue(item['level']),
		parent_value: stringValue(item['parent_value']),
		disabled: booleanValue(item['disabled']),
		has_children: booleanValue(item['has_children']) || children.length > 0,
		children: children,
	} as UTSJSONObject
}

function buildCategoryTreeResponse(raw: any): UTSJSONObject {
	let source = extractCategoryTreeSource(raw)
	if (source.length == 0) {
		const rawObject = parseObject(raw)
		if (rawObject != null) {
			let items = parseObjectArray(rawObject['items'])
			if (items.length == 0) items = parseObjectArray(rawObject['results'])
			if (items.length == 0) items = parseObjectArray(rawObject['data'])
			source = items
		}
	}
	const result: UTSJSONObject[] = []
	for (let index = 0; index < source.length; index += 1) {
		result.push(buildTreeSelectItem(source[index]))
	}
	return {
		data: result,
		total: result.length,
	} as UTSJSONObject
}

async function fetchCategoryOptions(params: UTSJSONObject): Promise<UTSJSONObject> {
	const keywordValue = stringValue(params['keyword'])
	const pageValue = stringValue(params['page'], '1')
	const parentValue = stringValue(params['parent'])
	const pageSizeValue = stringValue(params['pageSize'], '20')
	const queryParams: UTSJSONObject = {
		key: 'parent',
		page: parseInt(pageValue == '' ? '1' : pageValue),
		page_size: parseInt(pageSizeValue),
	} as UTSJSONObject
	if (keywordValue != '') {
		queryParams['search'] = keywordValue
	}
	if (parentValue != '') {
		queryParams['parent'] = parentValue
	}
	const raw = await request('/api/categories/categories/options/', 'GET', queryParams, true)
	return buildCategoryTreeResponse(raw)
}

function applyResponse(response: PurchaseDetailListResponse) {
	details.value = response.results
	currentPage.value = response.current_page
	totalPages.value = response.total_pages
	totalCount.value = response.total_count
	pageSize.value = response.page_size
	let total = 0.0
	for (let index = 0; index < response.results.length; index += 1) {
		const amount = parseFloat(response.results[index].amount)
		if (!isNaN(amount)) total = total + amount
	}
	pageTotalAmount.value = total.toFixed(2)
}

function clearSelectionState() {
	selectionMode.value = false
	selectedDetailIds.value = [] as string[]
}

function handleSelectionModeChange(value: boolean) {
	selectionMode.value = value
	if (!value) {
		selectedDetailIds.value = [] as string[]
	}
}

function handleSelectedDetailIdsChange(value: string[]) {
	const nextIds: string[] = []
	for (let index = 0; index < value.length; index += 1) {
		nextIds.push(value[index])
	}
	selectedDetailIds.value = nextIds
}

function handleSelectionExit(payload: UTSJSONObject) {
	clearSelectionState()
}

function selectedProductIds(): string[] {
	const result: string[] = []
	for (let detailIndex = 0; detailIndex < details.value.length; detailIndex += 1) {
		const detail = details.value[detailIndex]
		const detailId = detail.id.toString()
		if (selectedDetailIds.value.includes(detailId)) {
			const productId = detail.product.toString()
			if (productId != '' && !result.includes(productId)) {
				result.push(productId)
			}
		}
	}
	return result
}

function ensureBatchSelection(): boolean {
	if (selectedDetailIds.value.length > 0 && selectedProductIds().length > 0) {
		return true
	}
	uni.showToast({ title: '请先选择采购明细', icon: 'none', duration: 3500 })
	return false
}

async function loadPurchaseInfo() {
	if (purchaseId.value == '') return
	try {
		purchaseInfo.value = await getPurchaseDetail(purchaseId.value)
	} catch (error) {
	}
}

function openDetailForm(id: string) {
	if (id == '') return
	uni.navigateTo({ url: '/pages/purchases/details/from?purchase=' + purchaseId.value + '&id=' + id })
}

function openUniqueSearchResult(response: PurchaseDetailListResponse, autoOpenUnique: boolean) {
	if (!autoOpenUnique) return
	if (response.total_count != 1 || response.results.length != 1) return
	const detail = response.results[0]
	openDetailForm(detail.id.toString())
}

// 加载请求序号：并发时只应用最新一次请求的结果，新请求不再被在途请求拦截（修复返回页面后扫码搜索被静默丢弃）
let detailsRequestSeq = 0

async function loadDetails(autoOpenUnique: boolean = false) {
	if (purchaseId.value == '') {
		errorMessage.value = '缺少采购单 ID'
		return
	}
	detailsRequestSeq += 1
	const requestSeq = detailsRequestSeq
	isLoading.value = true
	errorMessage.value = ''
	try {
		const response = await getPurchaseDetailList({
			search: keyword.value == '' ? null : keyword.value,
			page: currentPage.value,
			page_size: pageSize.value,
			purchase: purchaseId.value,
			product: null,
			is_fully_received: selectedFilterValue('is_fully_received') == '' ? null : selectedFilterValue('is_fully_received'),
		})
		if (requestSeq != detailsRequestSeq) return
		applyResponse(response)
		await loadPurchaseInfo()
		if (requestSeq != detailsRequestSeq) return
		openUniqueSearchResult(response, autoOpenUnique)
	} catch (error) {
		if (requestSeq != detailsRequestSeq) return
		details.value = []
		currentPage.value = 1
		totalPages.value = 1
		totalCount.value = 0
		pageTotalAmount.value = '0.00'
		errorMessage.value = parseErrorMessage(error, '采购明细加载失败')
	} finally {
		if (requestSeq == detailsRequestSeq) isLoading.value = false
	}
}

function markRefreshNeeded() {
	uni.setStorageSync(refreshStorageKey + ':' + purchaseId.value, '1')
}

function markPurchaseListRefreshNeeded() {
	uni.setStorageSync(purchaseListRefreshStorageKey, '1')
}

function consumeRefreshNeeded(): boolean {
	const storedValue = uni.getStorageSync(refreshStorageKey + ':' + purchaseId.value)
	if (storedValue == null || ('' + storedValue) == '') return false
	uni.removeStorageSync(refreshStorageKey + ':' + purchaseId.value)
	return true
}

function detailToListItem(item: PurchaseDetailItem): UTSJSONObject {
	const statusText = item.is_fully_received ? '已收齐' : '待收货'
	// 变体明细：标题带上属性组合，条码优先显示变体条码
	let title = stringValue(item.product_name, '商品 #' + item.product.toString())
	if (item.variant_text != '') title = title + ' - ' + item.variant_text
	const barcodeText = item.variant_barcode != '' ? item.variant_barcode : stringValue(item.product_barcode, '-')
	return {
		id: item.id.toString(),
		rawId: item.id.toString(),
		title: title,
		subtitle: '条码：' + barcodeText,
		image: item.product_image,
		images: item.product_images,
		previewCover: item.product_preview_images.length > 0 ? item.product_preview_images[0] : item.product_image,
		previewImages: item.product_preview_images,
		mediaIds: item.product_media_ids,
		amountText: formatMoney(stringValue(item.amount, '0.00')),
		skuText: stringValue(item.product_sku, '-'),
		quantityText: item.received_quantity.toString() + '/' + item.quantity.toString() + '，剩余 ' + item.remaining_quantity.toString(),
		progressText: stringValue(item.receive_progress, '0') + '%',
		notesText: stringValue(item.notes, '-'),
		tags: [statusText, '单价 ' + formatMoney(stringValue(item.unit_price, '0.00'))] as string[],
	} as UTSJSONObject
}

function handleSearchInput(value: string) { keyword.value = value }
function handleSearchConfirm(value: string) { keyword.value = value; currentPage.value = 1; loadDetails(value.trim() != '') }
function handleSearchClear() { keyword.value = ''; currentPage.value = 1; loadDetails() }

function searchByScannedBarcode(barcode: string) {
	keyword.value = barcode
	currentPage.value = 1
	closeFilterDrawer()
	loadDetails(barcode.trim() != '')
}
async function handleFilterOpen() {
	if (filterOptions.value != null || filterOptionsLoading.value) return
	filterOptionsLoading.value = true
	filterOptionsError.value = ''
	try {
		filterOptions.value = await getPurchaseDetailFilterOptions(purchaseId.value == '' ? null : purchaseId.value)
	} catch (error) {
		filterOptionsError.value = parseErrorMessage(error, '筛选选项加载失败')
	} finally {
		filterOptionsLoading.value = false
	}
}

function isFilterOptionSelected(param: string, value: string): boolean {
	return splitSelectedValues(selectedFilterValue(param)).includes(value)
}

function toggleFilterOption(param: string, value: string, multiple: boolean) {
	const currentValues = splitSelectedValues(selectedFilterValue(param))
	if (!multiple) {
		setSelectedFilterValue(param, currentValues.includes(value) ? '' : value)
		return
	}
	const nextValues: string[] = []
	let alreadySelected = false
	for (let index = 0; index < currentValues.length; index += 1) {
		const currentValue = currentValues[index]
		if (currentValue == value) {
			alreadySelected = true
			continue
		}
		nextValues.push(currentValue)
	}
	if (!alreadySelected) nextValues.push(value)
	setSelectedFilterValue(param, nextValues.join(','))
}

function handleFilterReset() {
	selectedFilters.value = [] as PurchaseDetailSelectedFilter[]
	keyword.value = ''
	currentPage.value = 1
	closeFilterDrawer()
	loadDetails()
}

function applySelectedFilters() {
	currentPage.value = 1
	closeFilterDrawer()
	loadDetails()
}

async function handleScannedBarcode(scanResult: string) {
	const barcode = scanResult.trim()
	if (barcode == '') return
	if (scanLookupRunning.value) {
		uni.showToast({ title: '上一次扫码还在处理中', icon: 'none', duration: 2000 })
		return
	}
	if (purchaseId.value == '') {
		searchByScannedBarcode(barcode)
		return
	}
	scanLookupRunning.value = true
	try {
		const result = await checkPurchaseProduct(purchaseId.value, barcode, '')
		if (result.exists && result.purchase_detail_id > 0) {
			closeFilterDrawer()
			openDetailForm(result.purchase_detail_id.toString())
			return
		}
		searchByScannedBarcode(barcode)
	} catch (error) {
		searchByScannedBarcode(barcode)
	} finally {
		scanLookupRunning.value = false
	}
}

function handleScanSearch() {
	// #ifndef APP-ANDROID
	uni.showToast({ title: '网页版暂不支持扫码', icon: 'none', duration: 3500 })
	// #endif
	// #ifdef APP-ANDROID
	scanCode({
		onlyFromCamera: true,
		success: (res: ScanCodeSuccessCallbackResult) => {
			const scanResult = res.result
			if (scanResult == '') return
			handleScannedBarcode(scanResult)
		},
		fail: (res: GeneralCallbackResult) => {
			const message = res.errMsg == '' ? '扫码失败' : res.errMsg
			uni.showToast({ title: message, icon: 'none', duration: 3500 })
		},
	} as ScanCodeOption)
	// #endif
}

function unlockVolumeScanSoon() {
	setTimeout(() => {
		volumeScanLocked.value = false
	}, 1200)
}

// #ifdef APP-ANDROID
function handleVolumeKeyEvent(event: VolumeKeyEvent) {
	if (event.key != 'VOLUME_UP' && event.key != 'VOLUME_DOWN') {
		return
	}
	if (volumeScanLocked.value) {
		return
	}
	volumeScanLocked.value = true
	closeFilterDrawer()
	handleScanSearch()
	unlockVolumeScanSoon()
}

function startPurchaseDetailVolumeKeyListener() {
	startVolumeKeyListener((event: VolumeKeyEvent) => {
		handleVolumeKeyEvent(event)
	})
}
// #endif

function schedulePurchaseDetailVolumeKeyListener() {
	// #ifdef APP-ANDROID
	if (volumeKeyStartTimer != 0) {
		clearTimeout(volumeKeyStartTimer)
	}
	volumeKeyStartTimer = setTimeout(() => {
		volumeKeyStartTimer = 0
		startPurchaseDetailVolumeKeyListener()
	}, 260)
	// #endif
}

function stopPurchaseDetailVolumeKeyListener() {
	// #ifdef APP-ANDROID
	if (volumeKeyStartTimer != 0) {
		clearTimeout(volumeKeyStartTimer)
		volumeKeyStartTimer = 0
	}
	stopVolumeKeyListener()
	volumeScanLocked.value = false
	// #endif
}
function handleCreate() { uni.navigateTo({ url: '/pages/purchases/details/from?purchase=' + purchaseId.value }) }

function handleItemClick(payload: UTSJSONObject) {
	const id = stringValue(payload['rawId'], stringValue(payload['id']))
	openDetailForm(id)
}

function handlePageChange(payload: UTSJSONObject) {
	const pageValue = payload['page']
	if (pageValue == null) return
	const nextPage = parseInt('' + pageValue)
	if (isNaN(nextPage) || nextPage <= 0 || nextPage == currentPage.value) return
	currentPage.value = nextPage
	loadDetails()
}

async function runDelete(id: string) {
	try {
		await deletePurchaseDetail(id)
		markPurchaseListRefreshNeeded()
		uni.showToast({ title: takeLatestResponseMessage('删除成功'), icon: 'success' })
		loadDetails()
	} catch (error) {
		showErrorToast(parseErrorMessage(error, '删除失败'))
	}
}

function confirmDelete(id: string) {
	uni.showModal({ title: '删除明细', content: '确定删除这条采购明细吗？', success: (res) => { if (res.confirm) runDelete(id) } })
}

async function runReceive(id: string, quantity: number) {
	try {
		await receivePurchaseDetail(id, quantity, '前端收货')
		markPurchaseListRefreshNeeded()
		uni.showToast({ title: takeLatestResponseMessage('收货成功'), icon: 'success' })
		loadDetails()
	} catch (error) {
		showErrorToast(parseErrorMessage(error, '收货失败'))
	}
}

function handleBatchCategoryChange(payload: UTSJSONObject) {
	batchCategoryValue.value = stringValue(payload['value'])
	batchCategoryText.value = stringValue(payload['text'])
}

function openBatchCategoryPopup() {
	if (!ensureBatchSelection()) return
	batchCategoryValue.value = ''
	batchCategoryText.value = ''
	batchCategoryVisible.value = true
}

function closeBatchCategoryPopup() {
	if (batchSubmitting.value) return
	batchCategoryVisible.value = false
	batchCategoryValue.value = ''
	batchCategoryText.value = ''
}

function batchResultMessage(response: ProductBatchActionResponse, fallback: string): string {
	let message = takeLatestResponseMessage(fallback)
	if (message == '') message = fallback
	const summaryObject = parseObject(response.data['summary'])
	if (summaryObject == null) return message
	const successCount = numberValue(summaryObject['success_count'])
	const failureCount = numberValue(summaryObject['failure_count'])
	const skippedCount = numberValue(summaryObject['skipped_count'])
	if (failureCount > 0) return '成功' + successCount.toString() + '，失败' + failureCount.toString()
	if (skippedCount > 0) return '成功' + successCount.toString() + '，跳过' + skippedCount.toString()
	return message
}

function batchResultHasIssue(response: ProductBatchActionResponse): boolean {
	const summaryObject = parseObject(response.data['summary'])
	if (summaryObject == null) return false
	return numberValue(summaryObject['failure_count']) > 0 || numberValue(summaryObject['skipped_count']) > 0
}

async function executeBatchUpdateCategory() {
	if (batchSubmitting.value) return
	if (!ensureBatchSelection()) return
	if (batchCategoryValue.value == '') {
		uni.showToast({ title: '请选择分类', icon: 'none', duration: 3500 })
		return
	}
	const productIds = selectedProductIds()
	batchSubmitting.value = true
	try {
		const response = await batchUpdateProductCategory(productIds, batchCategoryValue.value)
		const message = batchResultMessage(response, '批量修改分类成功')
		const hasIssue = batchResultHasIssue(response)
		if (hasIssue) {
			showErrorToast(message)
		} else {
			uni.showToast({ title: message, icon: 'success', duration: 1500 })
		}
		batchCategoryVisible.value = false
		batchCategoryValue.value = ''
		batchCategoryText.value = ''
		clearSelectionState()
		loadDetails()
	} catch (error) {
		showErrorToast(parseErrorMessage(error, '批量修改分类失败'))
	} finally {
		batchSubmitting.value = false
	}
}

function confirmBatchUpdateCategory() {
	if (!ensureBatchSelection()) return
	if (batchCategoryValue.value == '') {
		uni.showToast({ title: '请选择分类', icon: 'none', duration: 3500 })
		return
	}
	uni.showModal({
		title: '批量修改分类',
		content: '确定将选中的 ' + selectedDetailIds.value.length.toString() + ' 条采购明细对应商品修改到该分类吗？',
		success: (res) => {
			if (!res.confirm) return
			executeBatchUpdateCategory()
		},
	})
}

function handleBatchToolbarAction(payload: UTSJSONObject) {
	const actionValue = payload['action']
	if (actionValue == null) return
	const actionKey = stringValue((actionValue as UTSJSONObject)['key'])
	if (actionKey == 'update-category') {
		openBatchCategoryPopup()
	}
}

// ── 收货即归类：处理本单未分类商品 ──────────────────────────────

function uncategorizedProductIds(): string[] {
	const result: string[] = []
	for (let index = 0; index < details.value.length; index += 1) {
		const detail = details.value[index]
		if (detail.product > 0 && detail.product_category <= 0) {
			const idText = detail.product.toString()
			if (!result.includes(idText)) {
				result.push(idText)
			}
		}
	}
	return result
}

async function executeAutoClassifyUncategorized(): Promise<void> {
	if (batchSubmitting.value) return
	const ids = uncategorizedProductIds()
	if (ids.length == 0) return
	batchSubmitting.value = true
	let successCount = 0
	let failureCount = 0
	let skippedCount = 0
	try {
		// 分片提交，避免单次处理过多商品触发请求超时
		const chunkSize = 10
		for (let start = 0; start < ids.length; start += chunkSize) {
			const chunk: string[] = []
			for (let index = start; index < ids.length && index < start + chunkSize; index += 1) {
				chunk.push(ids[index])
			}
			try {
				const response = await batchAutoClassifyProductCategory(chunk, 'auto', 10)
				const summaryObject = parseObject(response.data['summary'])
				if (summaryObject != null) {
					successCount += numberValue(summaryObject['success_count'])
					failureCount += numberValue(summaryObject['failure_count'])
					skippedCount += numberValue(summaryObject['skipped_count'])
				}
			} catch (error) {
				failureCount += chunk.length
			}
		}
		let message = '归类成功 ' + successCount.toString()
		if (failureCount > 0) message = message + '，失败 ' + failureCount.toString()
		if (skippedCount > 0) message = message + '，无推荐 ' + skippedCount.toString()
		uni.showToast({ title: message, icon: 'none', duration: 3500 })
		loadDetails()
	} finally {
		batchSubmitting.value = false
	}
}

function confirmAutoClassifyUncategorized() {
	const count = uncategorizedProductIds().length
	if (count == 0) return
	uni.showModal({
		title: '智能归类',
		content: '将按名称/供应商/条码为本页 ' + count.toString() + ' 个未分类商品推荐并设置分类，无可靠推荐的商品会跳过。确定执行吗？',
		success: (res) => {
			if (!res.confirm) return
			executeAutoClassifyUncategorized()
		},
	})
}

function promptReceive(item: UTSJSONObject) {
	const id = stringValue(item['rawId'])
	const defaultValue = stringValue(item['remainingValue'], '1')
	uni.showModal({
		title: '采购收货',
		editable: true,
		placeholderText: '请输入本次数量',
		content: defaultValue,
		success: (res) => {
			if (!res.confirm) return
			const inputText = res.content == null ? defaultValue : ('' + res.content)
			const quantity = parseInt(inputText)
			if (isNaN(quantity) || quantity <= 0) {
				uni.showToast({ title: '请输入有效收货数量', icon: 'none', duration: 3500 })
				return
			}
			runReceive(id, quantity)
		},
	})
}

function handleMenu(payload: UTSJSONObject) {
	const action = payload['action']
	const item = payload['item']
	if (action == null || item == null) return
	const actionKey = stringValue((action as UTSJSONObject)['key'])
	const itemObject = item as UTSJSONObject
	const id = stringValue(itemObject['rawId'])
	if (id == '') return
	if (actionKey == 'edit') {
		openDetailForm(id)
		return
	}
	if (actionKey == 'receive') promptReceive(itemObject)
	if (actionKey == 'delete') confirmDelete(id)
}

const pageTitle = computed((): string => {
	if (purchaseInfo.value == null) return '采购单明细'
	const info = purchaseInfo.value as PurchaseItem
	return '明细 ' + info.purchase_number
})

const listItems = computed((): UTSJSONObject[] => {
	const result: UTSJSONObject[] = []
	for (let index = 0; index < details.value.length; index += 1) {
		const row = detailToListItem(details.value[index])
		row['remainingValue'] = details.value[index].remaining_quantity.toString()
		result.push(row)
	}
	return result
})

const batchInfoText = computed((): string => {
	return '已选 ' + selectedDetailIds.value.length.toString() + ' 条明细'
})

const hasActiveFilter = computed((): boolean => {
	return keyword.value != '' || selectedFilters.value.length > 0
})

const emptyText = computed((): string => {
	if (isLoading.value) return '正在加载'
	if (hasActiveFilter.value) return '没有匹配的采购明细'
	return '暂无采购明细'
})

const summaryItems = computed((): UTSJSONObject[] => {
	return [
		{ key: 'total', label: '明细数', value: totalCount.value.toString() } as UTSJSONObject,
		{ key: 'amount', label: '本页金额', value: formatMoney(pageTotalAmount.value) } as UTSJSONObject,
		{ key: 'page', label: '页码', value: currentPage.value.toString() + '/' + totalPages.value.toString() } as UTSJSONObject,
	]
})

const filterPanelStyle = computed((): string => {
	return 'height:' + filterPanelHeight.value.toString() + 'px;'
})

const filterContentScrollStyle = computed((): string => {
	return 'height:' + filterContentHeight.value.toString() + 'px;'
})

const filterDefinitions = computed((): PurchaseDetailFilterDefinition[] => {
	if (filterOptions.value == null) return [] as PurchaseDetailFilterDefinition[]
	const result: PurchaseDetailFilterDefinition[] = []
	for (let index = 0; index < filterOptions.value.filters.length; index += 1) {
		const filter = filterOptions.value.filters[index]
		if (filter.param != 'product' && filter.key != 'product') {
			result.push(filter)
		}
	}
	return result
})

onLoad((query: OnLoadOptions) => {
	updateFilterPanelLayout()
	const purchaseValue = query['purchase']
	purchaseId.value = purchaseValue == null ? '' : ('' + purchaseValue)
	loadDetails()
})

onShow(() => {
	schedulePurchaseDetailVolumeKeyListener()
	updateFilterPanelLayout()
	if (consumeRefreshNeeded()) loadDetails()
})

onHide(() => {
	stopPurchaseDetailVolumeKeyListener()
})

onUnload(() => {
	stopPurchaseDetailVolumeKeyListener()
})
</script>

