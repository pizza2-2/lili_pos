<template>
	<view class="page">
		<lili-universal-filter :title="pageTitle" :showBack="true" :showSearch="false" :showHome="true" :homePath="homePath" backgroundColor="#EEF2F7" />
		<view class="page-content">
			<view v-if="productInfoVisible" class="product-card">
				<view class="product-card-head">
					<text class="product-card-title">{{ productInfoTitle }}</text>
					<text v-if="productInfoLoading" class="product-card-state">刷新中</text>
					<text v-else-if="productInfoError != ''" class="product-card-state product-card-state-error">加载失败</text>
				</view>
				<view class="product-info-row">
					<view class="product-info-cell">
						<text class="product-info-label">销售价</text>
						<text class="product-info-value product-info-price">{{ productInfoSalesPrice }}</text>
					</view>
					<view class="product-info-cell product-info-cell-right">
						<text class="product-info-label">KASA编码</text>
						<text class="product-info-value">{{ productInfoKasaCode }}</text>
					</view>
				</view>
				<view class="product-info-row">
					<view class="product-info-cell">
						<text class="product-info-label">分类</text>
						<text class="product-info-value">{{ productInfoCategoryName }}</text>
					</view>
					<view class="product-info-cell product-info-cell-right">
						<text class="product-info-label">KOD/条码</text>
						<text class="product-info-value">{{ productInfoBarcode }}</text>
					</view>
				</view>
			</view>
			<lili-UniversaForm
				ref="detailFormRef"
				:mode="formMode"
				:formSections="formSections"
				:initialData="initialData"
				:leaveSignal="leaveSignal"
				:dirtySignal="dirtySignal"
				:showFloatingAction="formMode == 'edit'"
				:floatingActionText="quickPrintLoading ? '准备中' : '快速打印'"
				:floatingActionDisabled="quickPrintLoading"
				leaveConfirmContent="是否已收到全部数量"
				leaveConfirmConfirmText="确认"
				@submit="handleSubmit"
				@cancel="handleCancel"
				@discard-leave="handleDiscardLeave"
				@save-request="handleSaveRequest"
				@dirty-change="handleDirtyChange"
				@field-change="handleFieldChange"
				@input-add="handleInputAdd"
				@floating-action="handleQuickPrint"
				@bottom-select-add="handleBottomSelectAdd"
				@bottom-select-edit="handleBottomSelectEdit"
			/>
		</view>

		<lili-print-confirm-popup
			:visible="printPopupVisible"
			templateType="product_label"
			:defaultCopies="quickPrintCopiesText"
			copiesTitle="打印数量"
			copiesDesc="默认按当前采购数量打印，可手动调整"
			:printData="purchasePrintData"
			@update:visible="handlePrintPopupVisibleChange"
		/>
	</view>
</template>

<script setup lang="uts">
import { computed } from 'vue'
import { request, takeLatestResponseMessage } from '@/pkg/api/index.uts'
import { createPurchaseDetail, getPurchaseDetailItem, PurchaseDetailItem, PurchaseDetailMutationData, updatePurchaseDetail } from '@/pkg/api/modules/purchases.uts'
import { ProductItem, PrintTemplateItem, getProductDetail, getPrintTemplateList } from '@/pkg/api/modules/products.uts'
// #ifdef APP-ANDROID
import { getPreferredPrinterAddress, printLabelBitmapAsync } from '@/uni_modules/lili-label-printer/index.uts'
// #endif
import { showErrorToast } from '@/pkg/util/toast.uts'

type ProductOption = {
	value: string
	text: string
	image: string
	subtitle: string
}

type PrintPreviewField = {
	key: string
	label: string
	value: string
	emphasis: boolean
}

type ProductCategoryQuickInfo = {
	id: string
	name: string
	kasaCode: string
	kasaText: string
}

const refreshStorageKey = 'refresh:pages:purchases:details:index'
const purchaseListRefreshStorageKey = 'refresh:pages:purchases:index'
const formMode = ref('create')
const purchaseId = ref('')
const detailId = ref('')
const leaveSignal = ref(0)
const dirtySignal = ref(0)
const submitting = ref(false)
const initialData = ref<UTSJSONObject>({} as UTSJSONObject)
const currentDetail = ref<PurchaseDetailItem | null>(null)
const detailFormRef = ref<ComponentPublicInstance | null>(null)
// 变体选项需要按当前选中的商品过滤
const currentProductId = ref('')
const printProduct = ref<ProductItem | null>(null)
const printProductId = ref('')
const printPopupVisible = ref(false)
const selectedPrintTemplate = ref<PrintTemplateItem | null>(null)
const printing = ref(false)
const printCopiesText = ref('1')
const quickPrintLoading = ref(false)
const printPayloadData = ref<UTSJSONObject>({} as UTSJSONObject)
const productCategoryInfo = ref<ProductCategoryQuickInfo>({ id: '', name: '', kasaCode: '', kasaText: '' } as ProductCategoryQuickInfo)
const productInfoLoading = ref(false)
const productInfoError = ref('')
let productInfoRequestSeq = 0

function getStringField(obj: UTSJSONObject, key: string, fallback: string = ''): string {
	const value = obj[key]
	if (value == null) return fallback
	return '' + value
}

function stringValue(value: any | null, fallback: string = ''): string {
	if (value == null) return fallback
	const text = '' + value
	if (text == '') return fallback
	return text
}

function parseErrorMessage(error: any, fallback: string): string {
	if (error == null) return fallback
	const errorText = JSON.stringify(error)
	if (errorText == null || errorText == '') return fallback
	const parsedError = JSON.parseObject<UTSJSONObject>(errorText)
	if (parsedError == null) return errorText
	const rawMessage = parsedError['message']
	if (rawMessage == null) return errorText
	const message = '' + rawMessage
	return message == '' ? fallback : message
}

function parseObject(value: any | null): UTSJSONObject | null {
	if (value == null) return null
	if (typeof value != 'object') return null
	const text = JSON.stringify(value)
	if (text == null || text == '') return null
	if (text.indexOf('{') != 0) return null
	return JSON.parseObject<UTSJSONObject>(text)
}

function parseObjectArray(value: any | null): UTSJSONObject[] {
	if (value == null) return [] as UTSJSONObject[]
	const text = JSON.stringify(value)
	if (text == null || text == '') return [] as UTSJSONObject[]
	const parsed = JSON.parseArray<UTSJSONObject>(text)
	if (parsed == null) return [] as UTSJSONObject[]
	return parsed!
}

function intValue(value: any | null): number {
	if (value == null) return 0
	const parsed = parseInt('' + value)
	if (isNaN(parsed)) return 0
	return parsed
}

function firstStringField(obj: UTSJSONObject, keys: string[]): string {
	for (let i = 0; i < keys.length; i++) {
		const text = getStringField(obj, keys[i])
		if (text != '') return text
	}
	return ''
}

function numberValue(value: any | null, fallback: number): number {
	if (value == null) return fallback
	const parsed = parseFloat('' + value)
	if (isNaN(parsed)) return fallback
	return parsed
}

function boolValue(value: any | null, fallback: boolean): boolean {
	if (value == null) return fallback
	const text = ('' + value).toLowerCase()
	if (text == 'true' || text == '1' || text == 'yes') return true
	if (text == 'false' || text == '0' || text == 'no') return false
	return fallback
}

function extractRows(raw: any | null): UTSJSONObject[] {
	const rawObject = parseObject(raw)
	if (rawObject == null) return parseObjectArray(raw)
	const results = parseObjectArray(rawObject['results'])
	if (results.length > 0) return results
	const dataRows = parseObjectArray(rawObject['data'])
	if (dataRows.length > 0) return dataRows
	const dataObject = parseObject(rawObject['data'])
	if (dataObject != null) {
		const nestedResults = parseObjectArray(dataObject!['results'])
		if (nestedResults.length > 0) return nestedResults
	}
	return parseObjectArray(raw)
}

function productImageFromRow(row: UTSJSONObject): string {
	const direct = firstStringField(row, ['image', 'product_image', 'cover_image'])
	if (direct != '') return direct
	const mediaFiles = parseObjectArray(row['media_files'])
	for (let i = 0; i < mediaFiles.length; i++) {
		const image = firstStringField(mediaFiles[i], ['signed_thumbnail_url', 'signed_download_url', 'file_url', 'url', 'image'])
		if (image != '') return image
	}
	const productMediaFiles = parseObjectArray(row['product_media_files'])
	for (let j = 0; j < productMediaFiles.length; j++) {
		const image = firstStringField(productMediaFiles[j], ['signed_thumbnail_url', 'signed_download_url', 'file_url', 'url', 'image'])
		if (image != '') return image
	}
	return ''
}

function buildSelectResponse(source: ProductOption[], params: UTSJSONObject): UTSJSONObject {
	const id = getStringField(params, 'id')
	const result: UTSJSONObject[] = []
	for (let index = 0; index < source.length; index += 1) {
		const option = source[index]
		if (id != '' && option.value != id) continue
		result.push({ value: option.value, text: option.text, image: option.image, subtitle: option.subtitle } as UTSJSONObject)
	}
	return { data: result, results: result, total: result.length, total_count: result.length } as UTSJSONObject
}

async function fetchProductOptions(params: UTSJSONObject): Promise<UTSJSONObject> {
	const keyword = getStringField(params, 'keyword')
	const id = getStringField(params, 'id')
	const query = {
		page: intValue(params['page']) <= 0 ? 1 : intValue(params['page']),
		page_size: intValue(params['pageSize']) <= 0 ? 20 : intValue(params['pageSize']),
	} as UTSJSONObject
	if (keyword != '') {
		query['search'] = keyword
		query['keyword'] = keyword
	}
	if (id != '') query['id'] = id
	const raw = await request('/api/products/products/', 'GET', query, true)
	const rows = extractRows(raw)
	const options: ProductOption[] = []
	for (let i = 0; i < rows.length; i++) {
		const row = rows[i]
		const value = getStringField(row, 'id')
		let text = getStringField(row, 'name_cn')
		const barcode = getStringField(row, 'barcode')
		if (barcode != '') text = text + ' / ' + barcode
		const subtitle = firstStringField(row, ['sku', 'barcode'])
		options.push({ value: value, text: text, image: productImageFromRow(row), subtitle: subtitle } as ProductOption)
	}
	return buildSelectResponse(options, { keyword: keyword, id: id } as UTSJSONObject)
}

function variantComboTextFromRow(row: UTSJSONObject): string {
	const displayItems = parseObjectArray(row['attribute_values_display'])
	const parts: string[] = []
	for (let i = 0; i < displayItems.length; i++) {
		const value = getStringField(displayItems[i], 'value')
		if (value != '') parts.push(value)
	}
	return parts.join(' / ')
}

async function fetchVariantOptions(params: UTSJSONObject): Promise<UTSJSONObject> {
	if (currentProductId.value == '') {
		return buildSelectResponse([] as ProductOption[], params)
	}
	const keyword = getStringField(params, 'keyword')
	const id = getStringField(params, 'id')
	const query = {
		page: intValue(params['page']) <= 0 ? 1 : intValue(params['page']),
		page_size: intValue(params['pageSize']) <= 0 ? 20 : intValue(params['pageSize']),
		product: currentProductId.value,
	} as UTSJSONObject
	if (keyword != '') {
		query['search'] = keyword
	}
	const raw = await request('/api/products/variants/', 'GET', query, true)
	const rows = extractRows(raw)
	const options: ProductOption[] = []
	for (let i = 0; i < rows.length; i++) {
		const row = rows[i]
		const value = getStringField(row, 'id')
		let text = variantComboTextFromRow(row)
		if (text == '') text = getStringField(row, 'sku')
		const barcode = getStringField(row, 'barcode')
		if (barcode != '') text = text + ' / ' + barcode
		options.push({ value: value, text: text, image: '', subtitle: getStringField(row, 'sku') } as ProductOption)
	}
	return buildSelectResponse(options, { keyword: keyword, id: id } as UTSJSONObject)
}

function categoryDisplayName(row: UTSJSONObject): string {
	let text = getStringField(row, 'text')
	if (text == '') text = getStringField(row, 'label')
	if (text == '') text = getStringField(row, 'full_name')
	if (text == '') text = getStringField(row, 'path')
	if (text == '') text = getStringField(row, 'name')
	if (text == '') text = getStringField(row, 'name_cn')
	if (text == '') text = getStringField(row, 'code')
	return text
}

function categoryKasaCode(row: UTSJSONObject): string {
	const info = parseObject(row['kasa_category_info'])
	if (info != null) {
		const infoCode = getStringField(info!, 'unique_kod')
		if (infoCode != '') return infoCode
	}
	let code = getStringField(row, 'kasa_unique_kod')
	if (code == '') code = getStringField(row, 'kasa_category_unique_kod')
	if (code == '') code = getStringField(row, 'unique_kod')
	return code
}

function categoryKasaText(row: UTSJSONObject): string {
	const code = categoryKasaCode(row)
	if (code != '') return 'KASA ' + code
	const kasaId = getStringField(row, 'kasa_category')
	if (kasaId != '') return 'KASA #' + kasaId
	return '未关联 KASA'
}

function initialCreateData(): UTSJSONObject {
	return {
		product: '',
		product_text: '',
		product_image: '',
		variant: '',
		variant_text: '',
		quantity: '',
		received_quantity: '0',
		notes: '',
	} as UTSJSONObject
}

function buildInitialDataFromDetail(item: PurchaseDetailItem): UTSJSONObject {
	let productText = item.product_name
	if (item.product_barcode != '') productText = productText + ' / ' + item.product_barcode
	const itemObject = parseObject(item)
	const productImage = itemObject == null ? '' : productImageFromRow(itemObject!)
	let variantText = item.variant_text
	if (variantText == '') variantText = item.variant_sku
	if (variantText != '' && item.variant_barcode != '') variantText = variantText + ' / ' + item.variant_barcode
	return {
		product: item.product.toString(),
		product_text: productText,
		product_image: productImage,
		variant: item.variant > 0 ? item.variant.toString() : '',
		variant_text: variantText,
		quantity: item.quantity.toString(),
		received_quantity: item.received_quantity.toString(),
		notes: item.notes,
	} as UTSJSONObject
}

const formSections = ref<UTSJSONObject[]>([
	{
		key: 'base',
		title: '明细信息',
		description: '',
		defaultOpen: true,
		fields: [
			{ key: 'product', textKey: 'product_text', imageValueKey: 'product_image', label: '商品', type: 'bottomSelect', required: true, title: '选择商品', placeholder: '请选择商品', searchPlaceholder: '扫码或输入商品名/条码', imageKey: 'image', subtitleKey: 'subtitle', showScan: true, autoSelectUnique: true, showAddAction: true, showEditAction: true, addPath: '/pages/products/from', editPath: '/pages/products/from', fetchData: fetchProductOptions } as UTSJSONObject,
			{ key: 'variant', textKey: 'variant_text', label: '规格变体', type: 'bottomSelect', title: '选择规格变体', placeholder: '无变体可留空', searchPlaceholder: '输入变体SKU/条码', subtitleKey: 'subtitle', showScan: true, showAddAction: false, showEditAction: false, fetchData: fetchVariantOptions } as UTSJSONObject,
			{ key: 'quantity', label: '采购数量', type: 'number', required: true, placeholder: '请输入采购数量' } as UTSJSONObject,
			{ key: 'received_quantity', label: '已收货数量', type: 'number', showStepper: false, placeholder: '通常由收货操作更新', showAdd: true, addText: '全部收货', fillFromKey: 'quantity' } as UTSJSONObject,
			{ key: 'notes', label: '备注', type: 'textarea', placeholder: '请输入备注' } as UTSJSONObject,
		] as UTSJSONObject[],
	} as UTSJSONObject,
])

const homePath = computed((): string => '/pages/purchases/details/index?purchase=' + purchaseId.value)
const pageTitle = computed((): string => formMode.value == 'edit' ? '编辑采购明细' : '新建采购明细')
const selectedTemplateName = computed((): string => {
	const item = selectedPrintTemplate.value
	if (item == null) return '未选择模板'
	return item.name
})

function markRefresh() {
	uni.setStorageSync(refreshStorageKey + ':' + purchaseId.value, '1')
	uni.setStorageSync(purchaseListRefreshStorageKey, '1')
}

function goBackToList() {
	leaveSignal.value = leaveSignal.value + 1
	setTimeout(() => { uni.navigateBack({ delta: 1, fail: () => { uni.navigateTo({ url: homePath.value }) } }) }, 16)
}

function markLeaveConfirmRequired() {
	setTimeout(() => {
		dirtySignal.value = dirtySignal.value + 1
	}, 50)
}

function categoryQuickInfoFromRow(row: UTSJSONObject): ProductCategoryQuickInfo {
	const id = getStringField(row, 'value', getStringField(row, 'id'))
	const name = categoryDisplayName(row)
	const kasaCode = categoryKasaCode(row)
	const kasaText = categoryKasaText(row)
	return {
		id: id,
		name: name,
		kasaCode: kasaCode,
		kasaText: kasaText,
	} as ProductCategoryQuickInfo
}

async function resolveProductCategoryQuickInfo(product: ProductItem): Promise<ProductCategoryQuickInfo> {
	const categoryObject = parseObject(product.category)
	if (categoryObject != null) return categoryQuickInfoFromRow(categoryObject!)
	const categoryId = product.category == null ? '' : stringValue(product.category)
	if (categoryId == '') {
		return { id: '', name: '', kasaCode: '', kasaText: '' } as ProductCategoryQuickInfo
	}
	const raw = await request('/api/categories/categories/' + categoryId + '/', 'GET', {} as UTSJSONObject, true)
	const rawObject = parseObject(raw)
	if (rawObject == null) {
		return { id: categoryId, name: categoryId, kasaCode: '', kasaText: '' } as ProductCategoryQuickInfo
	}
	return categoryQuickInfoFromRow(rawObject!)
}

function emptyProductCategoryInfo(): ProductCategoryQuickInfo {
	return { id: '', name: '', kasaCode: '', kasaText: '' } as ProductCategoryQuickInfo
}

function resetProductInfo(productIdText: string = '') {
	printProduct.value = null
	printProductId.value = productIdText
	productCategoryInfo.value = emptyProductCategoryInfo()
	productInfoError.value = ''
}

async function loadProductInfo(productIdText: string) {
	const resolvedProductId = productIdText.trim()
	productInfoRequestSeq = productInfoRequestSeq + 1
	const seq = productInfoRequestSeq
	if (resolvedProductId == '') {
		resetProductInfo()
		return
	}
	const currentProduct = printProduct.value
	if (currentProduct == null || currentProduct.id.toString() != resolvedProductId) {
		printProduct.value = null
		productCategoryInfo.value = emptyProductCategoryInfo()
	}
	printProductId.value = resolvedProductId
	productInfoLoading.value = true
	productInfoError.value = ''
	try {
		const product = await getProductDetail(resolvedProductId)
		if (seq != productInfoRequestSeq) return
		printProduct.value = product
		let categoryInfo = emptyProductCategoryInfo()
		try {
			categoryInfo = await resolveProductCategoryQuickInfo(product)
		} catch (categoryError) {
		}
		if (seq != productInfoRequestSeq) return
		productCategoryInfo.value = categoryInfo
	} catch (error) {
		if (seq != productInfoRequestSeq) return
		printProduct.value = null
		productCategoryInfo.value = emptyProductCategoryInfo()
		productInfoError.value = parseErrorMessage(error, '商品信息加载失败')
	} finally {
		if (seq == productInfoRequestSeq) productInfoLoading.value = false
	}
}

async function buildInitialDataWithProductInfo(detail: PurchaseDetailItem): Promise<UTSJSONObject> {
	const data = buildInitialDataFromDetail(detail)
	await loadProductInfo(detail.product.toString())
	return data
}

async function loadDetail(idText: string) {
	if (idText == '') return
	try {
		const detail = await getPurchaseDetailItem(idText)
		currentDetail.value = detail
		currentProductId.value = detail.product > 0 ? detail.product.toString() : ''
		initialData.value = await buildInitialDataWithProductInfo(detail)
		markLeaveConfirmRequired()
	} catch (error) {
		showErrorToast(parseErrorMessage(error, '采购明细加载失败'))
	}
}

function activePrintProduct(): ProductItem | null {
	return printProduct.value
}

function productNameText(): string {
	const product = activePrintProduct()
	if (product == null) return '-'
	if (product.name_cn != '') return product.name_cn
	if (product.name_en != '') return product.name_en
	if (product.name_other != '') return product.name_other
	return '未命名商品'
}

function productNameCnText(): string {
	const product = activePrintProduct()
	if (product == null) return ''
	return product.name_cn
}

function productNameEnText(): string {
	const product = activePrintProduct()
	if (product == null) return ''
	return product.name_en
}

function productNameOtherText(): string {
	const product = activePrintProduct()
	if (product == null) return ''
	return product.name_other
}

function productOriginalPriceText(): string {
	const product = activePrintProduct()
	if (product == null) return '0.00'
	return product.base_sales_price == '' ? '0.00' : product.base_sales_price
}

function productDiscountPriceText(): string {
	const product = activePrintProduct()
	if (product == null) return '0.00'
	const discount = product.discount_info
	if (discount != null && discount.has_discount && discount.final_price != '') return discount.final_price
	return product.base_sales_price == '' ? '0.00' : product.base_sales_price
}

function productBarcodeText(): string {
	const product = activePrintProduct()
	if (product == null) return '-'
	if (product.barcode != '') return product.barcode
	if (product.sku != '') return product.sku
	return '-'
}

function productSkuText(): string {
	const product = activePrintProduct()
	if (product == null) return '-'
	return product.sku == '' ? '-' : product.sku
}

function productKodText(): string {
	const product = activePrintProduct()
	if (product != null && product.category_kasa_kod != '') return product.category_kasa_kod
	const code = productCategoryInfo.value.kasaCode
	return code == '' ? '-' : code
}

const productInfoVisible = computed((): boolean => {
	return productInfoLoading.value || productInfoError.value != '' || printProduct.value != null || printProductId.value != ''
})

const productInfoTitle = computed((): string => {
	const product = activePrintProduct()
	if (product == null) return '商品信息'
	return productNameText()
})

const productInfoSalesPrice = computed((): string => productOriginalPriceText())
const productInfoBarcode = computed((): string => productBarcodeText())
const productInfoCategoryName = computed((): string => {
	const name = productCategoryInfo.value.name
	return name == '' ? '未分类' : name
})
const productInfoKasaCode = computed((): string => {
	const code = productCategoryInfo.value.kasaCode
	return code == '' ? '未关联' : code
})

function payloadFieldValue(key: string): string {
	return getStringField(printPayloadData.value, key)
}

function purchaseQuantityText(): string {
	const payloadQuantity = payloadFieldValue('quantity')
	if (payloadQuantity != '') return payloadQuantity
	const initialQuantity = getStringField(initialData.value, 'quantity')
	if (initialQuantity != '') return initialQuantity
	const detail = currentDetail.value
	if (detail != null) return detail.quantity.toString()
	return '-'
}

function receivedQuantityText(): string {
	const payloadQuantity = payloadFieldValue('received_quantity')
	if (payloadQuantity != '') return payloadQuantity
	const initialQuantity = getStringField(initialData.value, 'received_quantity')
	if (initialQuantity != '') return initialQuantity
	const detail = currentDetail.value
	if (detail != null) return detail.received_quantity.toString()
	return '-'
}

function normalizedPrintCopiesText(value: string): string {
	const copies = parseInt(value)
	if (isNaN(copies) || copies <= 0) return '1'
	if (copies > 999) return '999'
	return copies.toString()
}

const quickPrintCopiesText = computed((): string => {
	return normalizedPrintCopiesText(purchaseQuantityText())
})

function purchaseVariantText(): string {
	const detail = currentDetail.value
	if (detail == null) return ''
	if (detail.variant_text != '') return detail.variant_text
	return detail.variant_sku
}

const purchasePrintData = computed((): UTSJSONObject => {
	const data = {} as UTSJSONObject
	data['name'] = productNameText()
	data['name_cn'] = productNameCnText()
	data['name_en'] = productNameEnText()
	data['name_other'] = productNameOtherText()
	data['price'] = productDiscountPriceText()
	data['base_sales_price'] = productOriginalPriceText()
	data['discount_price'] = productDiscountPriceText()
	data['barcode'] = productBarcodeText()
	data['sku'] = productSkuText()
	data['kod'] = productKodText()
	data['category_kasa_kod'] = productKodText()
	data['quantity'] = purchaseQuantityText()
	data['purchase_quantity'] = purchaseQuantityText()
	data['received_quantity'] = receivedQuantityText()
	data['specification'] = purchaseVariantText()
	return data
})

function printValueForSource(source: string, fallback: string): string {
	if (source == 'name') return productNameText()
	if (source == 'name_cn') return productNameCnText()
	if (source == 'name_en') return productNameEnText()
	if (source == 'name_other') return productNameOtherText()
	if (source == 'price') return productDiscountPriceText()
	if (source == 'base_sales_price') return productOriginalPriceText()
	if (source == 'discount_price') return productDiscountPriceText()
	if (source == 'barcode') return productBarcodeText()
	if (source == 'sku') return productSkuText()
	if (source == 'kod') return productKodText()
	if (source == 'quantity' || source == 'purchase_quantity') return purchaseQuantityText()
	if (source == 'received_quantity') return receivedQuantityText()
	// 变体属性组合：无变体明细返回空串，标签该区域留空
	if (source == 'specification') return purchaseVariantText()
	return fallback
}

function resolvePurchaseDetailPrintValue(source: string, fallback: string): string {
	return printValueForSource(source, fallback)
}

function handlePrintPopupVisibleChange(value: boolean) {
	printPopupVisible.value = value
}

function printLabelForSource(source: UTSJSONObject, index: number): string {
	const elementLabel = getStringField(source, 'label')
	if (elementLabel != '') return elementLabel
	const elementSource = getStringField(source, 'source')
	if (elementSource == 'name') return '商品名称'
	if (elementSource == 'name_cn') return '中文名'
	if (elementSource == 'name_en') return '英文名'
	if (elementSource == 'name_other') return '其他名'
	if (elementSource == 'price') return '打印价格'
	if (elementSource == 'base_sales_price') return '原价'
	if (elementSource == 'discount_price') return '折扣价'
	if (elementSource == 'barcode') return '条码'
	if (elementSource == 'sku' || elementSource == 'kod') return 'KOD'
	if (elementSource == 'specification') return '属性'
	return '字段 ' + (index + 1).toString()
}

function printFieldKey(source: UTSJSONObject, index: number): string {
	const elementSource = getStringField(source, 'source')
	if (elementSource != '' && elementSource != 'custom') return elementSource
	const elementKey = getStringField(source, 'key')
	return elementKey == '' ? ('custom-' + index.toString()) : elementKey
}

function isEmphasisPrintSource(source: string): boolean {
	return source == 'price' || source == 'discount_price' || source == 'base_sales_price'
}

function hasPreviewField(fields: PrintPreviewField[], key: string): boolean {
	for (let index = 0; index < fields.length; index += 1) {
		if (fields[index].key == key) return true
	}
	return false
}

function buildPrintPreviewFields(): PrintPreviewField[] {
	const item = selectedPrintTemplate.value
	if (item == null) return [] as PrintPreviewField[]
	const result: PrintPreviewField[] = []
	for (let index = 0; index < item.elements.length; index += 1) {
		const source = item.elements[index]
		const type = getStringField(source, 'type')
		if (type == 'hline' || type == 'vline' || type == 'rect' || type == 'dline') continue
		const key = printFieldKey(source, index)
		if (hasPreviewField(result, key)) continue
		const elementSource = getStringField(source, 'source')
		const fallbackContent = getStringField(source, 'content')
		result.push({
			key: key,
			label: printLabelForSource(source, index),
			value: printValueForSource(elementSource, fallbackContent),
			emphasis: isEmphasisPrintSource(elementSource),
		} as PrintPreviewField)
	}
	return result
}

const printPreviewFields = computed((): PrintPreviewField[] => {
	return buildPrintPreviewFields()
})

function mappedPrintElement(source: UTSJSONObject): UTSJSONObject {
	const elementSource = getStringField(source, 'source')
	const fallbackContent = getStringField(source, 'content')
	const fontWeight = getStringField(source, 'fontWeight', getStringField(source, 'font_weight')).toLowerCase()
	const isBold = boolValue(source['isBold'], boolValue(source['bold'], fontWeight == 'bold' || fontWeight == '700'))
	return {
		type: getStringField(source, 'type', 'text'),
		x: numberValue(source['x'], 0),
		y: numberValue(source['y'], 0),
		width: numberValue(source['width'], 10),
		height: numberValue(source['height'], 6),
		fontSize: numberValue(source['fontSize'], 4),
		content: printValueForSource(elementSource, fallbackContent),
		source: elementSource,
		barcodeType: getStringField(source, 'barcodeType', 'EAN13'),
		showText: boolValue(source['showText'], true),
		lineWidth: numberValue(source['lineWidth'], 1),
		direction: getStringField(source, 'direction', 'down'),
		isBold: isBold,
		fontWeight: isBold ? 'bold' : 'normal',
		textAlign: getStringField(source, 'textAlign', getStringField(source, 'text_align', 'left')),
	} as UTSJSONObject
}

function buildProductPrintElements(item: PrintTemplateItem): UTSJSONObject[] {
	const result: UTSJSONObject[] = []
	for (let index = 0; index < item.elements.length; index += 1) {
		result.push(mappedPrintElement(item.elements[index]))
	}
	return result
}

function handlePrintCopiesChange(value: string) {
	printCopiesText.value = value
}

function printCopiesValue(): number {
	const copies = intValue(printCopiesText.value)
	if (copies <= 0) return 1
	if (copies > 999) return 999
	return copies
}

function connectedPrinterAddress(): string {
	// #ifdef APP-ANDROID
	return getPreferredPrinterAddress()
	// #endif
	// #ifndef APP-ANDROID
	return ''
	// #endif
}

function goPrinterSettings() {
	// #ifdef APP-ANDROID
	uni.showToast({ title: '请先连接打印机', icon: 'none', duration: 3500 })
	setTimeout(() => {
		uni.navigateTo({ url: '/pages/printer-settings/index' })
	}, 450)
	// #endif
	// #ifndef APP-ANDROID
	uni.showToast({ title: '网页版不支持标签打印', icon: 'none', duration: 3500 })
	// #endif
}

function closePrintPopup() {
	if (printing.value) return
	printPopupVisible.value = false
}

function promptChoosePrinterAfterPrintFailure(message: string) {
	const detail = message == '' ? '打印机连接失败，请确认打印机在附近并已开机。' : message
	uni.showModal({
		title: '打印失败',
		content: detail + '\n是否选择新的打印机？',
		confirmText: '选择打印机',
		cancelText: '取消',
		success: (modal) => {
			if (modal.confirm) {
				closePrintPopup()
				uni.navigateTo({ url: '/pages/printer-settings/index' })
			}
		}
	})
}

async function confirmPrintProduct() {
	if (printing.value) return
	const item = selectedPrintTemplate.value
	if (item == null) return
	const address = connectedPrinterAddress()
	if (address == '') {
		closePrintPopup()
		goPrinterSettings()
		return
	}
	printing.value = true
	let shouldClose = false
	let responseSuccess = false
	let responseMessage = ''
	uni.showLoading({ title: '打印中', mask: true })
	try {
		// #ifdef APP-ANDROID
		const response = await printLabelBitmapAsync({
			address: address,
			paperWidthMm: numberValue(item.paper_width_mm, 30),
			paperHeightMm: numberValue(item.paper_height_mm, 20),
			dotsPerMm: item.dots_per_mm,
			elements: buildProductPrintElements(item),
			chunkSize: 1024,
			delayMs: 20,
			copies: printCopiesValue(),
		} as UTSJSONObject)
		responseSuccess = response.success
		responseMessage = response.message
		// #endif
	} finally {
		printing.value = false
		uni.hideLoading()
	}
	if (responseSuccess) {
		uni.showToast({ title: responseMessage == '' ? '已发送打印' : responseMessage, icon: 'success' })
		shouldClose = true
	} else {
		promptChoosePrinterAfterPrintFailure(responseMessage)
	}
	if (shouldClose) closePrintPopup()
}

function productIdFromPayload(payload: UTSJSONObject): string {
	const rawData = payload['formData']
	if (rawData != null) {
		const data = rawData as UTSJSONObject
		const product = getStringField(data, 'product')
		if (product != '') return product
	}
	const initialProduct = getStringField(initialData.value, 'product')
	if (initialProduct != '') return initialProduct
	const detail = currentDetail.value
	if (detail != null) return detail.product.toString()
	return ''
}

async function resolveProductIdForPrint(payload: UTSJSONObject): Promise<string> {
	const currentProductId = productIdFromPayload(payload)
	if (currentProductId != '') return currentProductId
	return ''
}

async function ensurePrintProduct(productIdText: string): Promise<boolean> {
	if (productIdText == '') return false
	const product = printProduct.value
	return product != null && product.id.toString() == productIdText
}

function firstUsableDefaultTemplate(items: PrintTemplateItem[]): PrintTemplateItem | null {
	for (let index = 0; index < items.length; index += 1) {
		const item = items[index]
		if (item.is_default && item.is_active) return item
	}
	if (items.length > 0) return items[0]
	return null
}

async function getDefaultProductPrintTemplate(): Promise<PrintTemplateItem | null> {
	const response = await getPrintTemplateList({
		search: null,
		page: 1,
		page_size: 20,
		template_type: 'product_label',
		is_active: 'true',
		is_default: 'true',
	})
	const productTemplate = firstUsableDefaultTemplate(response.results)
	if (productTemplate != null) return productTemplate
	const fallbackResponse = await getPrintTemplateList({
		search: null,
		page: 1,
		page_size: 20,
		template_type: null,
		is_active: 'true',
		is_default: 'true',
	})
	return firstUsableDefaultTemplate(fallbackResponse.results)
}

async function handleQuickPrint(payload: UTSJSONObject) {
	if (quickPrintLoading.value) return
	quickPrintLoading.value = true
	uni.showLoading({ title: '准备打印...', mask: true })
	try {
		const rawData = payload['formData']
		printPayloadData.value = rawData == null ? ({} as UTSJSONObject) : (rawData as UTSJSONObject)
		const productIdText = await resolveProductIdForPrint(payload)
		if (productIdText == '') {
			uni.showToast({ title: '当前明细缺少商品，无法打印', icon: 'none', duration: 3500 })
			return
		}
		const productReady = await ensurePrintProduct(productIdText)
		if (!productReady) {
			showErrorToast('商品信息加载失败，无法打印')
			return
		}
		printPopupVisible.value = true
	} catch (error) {
		showErrorToast(parseErrorMessage(error, '快速打印准备失败'))
	} finally {
		uni.hideLoading()
		quickPrintLoading.value = false
	}
}

function buildPayload(data: UTSJSONObject): PurchaseDetailMutationData {
	return {
		purchase: purchaseId.value,
		product: getStringField(data, 'product'),
		variant: getStringField(data, 'variant') == '' ? null : getStringField(data, 'variant'),
		quantity: getStringField(data, 'quantity'),
		received_quantity: getStringField(data, 'received_quantity') == '' ? null : getStringField(data, 'received_quantity'),
		notes: getStringField(data, 'notes') == '' ? null : getStringField(data, 'notes'),
	} as PurchaseDetailMutationData
}

async function persistForm(payload: UTSJSONObject) {
	if (submitting.value) return
	const rawData = payload['formData']
	const data = rawData == null ? ({} as UTSJSONObject) : (rawData as UTSJSONObject)
	const body = buildPayload(data)
	const quantity = parseInt(body.quantity)
	if (body.purchase == '' || body.product == '' || isNaN(quantity) || quantity <= 0) {
		uni.showToast({ title: '请填写商品和有效采购数量', icon: 'none', duration: 3500 })
		return
	}
	const actionText = formMode.value == 'edit' ? '保存采购明细' : '创建采购明细'
	submitting.value = true
	uni.showLoading({ title: actionText + '中...', mask: true })
	try {
		if (formMode.value == 'edit' && detailId.value != '') await updatePurchaseDetail(detailId.value, body)
		else await createPurchaseDetail(body)
		markRefresh()
		uni.showToast({ title: takeLatestResponseMessage(actionText + '成功'), icon: 'success' })
		goBackToList()
	} catch (error) {
		showErrorToast(parseErrorMessage(error, actionText + '失败'))
	} finally {
		uni.hideLoading()
		submitting.value = false
	}
}

async function handleSubmit(payload: UTSJSONObject) { await persistForm(payload) }
function fillReceivedQuantityFromQuantity(data: UTSJSONObject): boolean {
	const quantity = getStringField(data, 'quantity')
	const quantityNumber = parseInt(quantity)
	if (quantity == '' || isNaN(quantityNumber) || quantityNumber <= 0) {
		uni.showToast({ title: '请先填写有效采购数量', icon: 'none', duration: 3500 })
		return false
	}
	data['received_quantity'] = quantity
	return true
}

async function handleSaveRequest(payload: UTSJSONObject) {
	const rawData = payload['formData']
	const data = rawData == null ? ({} as UTSJSONObject) : (rawData as UTSJSONObject)
	if (!fillReceivedQuantityFromQuantity(data)) return
	await persistForm({ formData: data } as UTSJSONObject)
}
function handleCancel(payload: UTSJSONObject) { const changed = payload['hasChanges']; if (changed != null && (changed as boolean)) return; goBackToList() }
function handleDiscardLeave(payload: UTSJSONObject) { goBackToList() }
function handleDirtyChange(value: boolean) {}
function handleFieldChange(payload: UTSJSONObject) {
	const key = getStringField(payload, 'key')
	if (key != 'product') return
	const productIdText = getStringField(payload, 'value')
	if (productIdText != currentProductId.value) {
		currentProductId.value = productIdText
		// 商品变了，已选变体随之失效
		detailFormRef.value?.$callMethod('setFieldValue', 'variant', '')
		detailFormRef.value?.$callMethod('setFieldValue', 'variant_text', '')
	}
	loadProductInfo(productIdText)
}
function handleInputAdd(payload: UTSJSONObject) {
	const key = getStringField(payload, 'key')
	if (key != 'received_quantity') return

	const rawData = payload['formData']
	const data = rawData == null ? ({} as UTSJSONObject) : (rawData as UTSJSONObject)
	if (!fillReceivedQuantityFromQuantity(data)) return
	uni.showToast({ title: '已填入采购数量', icon: 'none', duration: 3500 })
}
function handleBottomSelectAdd(payload: UTSJSONObject) { uni.showToast({ title: '请在对应模块维护选项', icon: 'none', duration: 3500 }) }
function handleBottomSelectEdit(payload: UTSJSONObject) { uni.showToast({ title: '该字段不支持直接编辑', icon: 'none', duration: 3500 }) }

onLoad((query: OnLoadOptions) => {
	const purchaseValue = query['purchase']
	const idValue = query['id']
	purchaseId.value = purchaseValue == null ? '' : ('' + purchaseValue)
	detailId.value = idValue == null ? '' : ('' + idValue)
	formMode.value = detailId.value == '' ? 'create' : 'edit'
	currentDetail.value = null
	resetProductInfo()
	initialData.value = initialCreateData()
	if (formMode.value == 'edit') {
		loadDetail(detailId.value)
	} else {
		markLeaveConfirmRequired()
	}
})

onShow(() => {
	const productIdText = printProductId.value
	if (productIdText != '') loadProductInfo(productIdText)
})
</script>

<style>
.page { flex: 1; background-color: #EEF2F7; }
.page-content { flex: 1; padding-bottom: 0; }
.product-card { margin: 6px 10px 4px; padding: 7px 10px; border-radius: 8px; border-width: 1px; border-color: #DDE6F2; background-color: #FFFFFF; }
.product-card-head { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 2px; }
.product-card-title { flex: 1; font-size: 14px; line-height: 18px; color: #0F172A; font-weight: 700; }
.product-card-state { margin-left: 6px; font-size: 11px; line-height: 14px; color: #64748B; }
.product-card-state-error { color: #B91C1C; }
.product-info-row { flex-direction: row; margin-top: 3px; }
.product-info-cell { flex: 1; min-height: 24px; padding-right: 6px; flex-direction: row; align-items: center; }
.product-info-cell-right { padding-left: 6px; padding-right: 0; border-left-width: 1px; border-left-color: #E2E8F0; }
.product-info-label { width: 56px; font-size: 10px; line-height: 14px; color: #64748B; }
.product-info-value { flex: 1; font-size: 13px; line-height: 17px; color: #111827; }
.product-info-price { color: #B91C1C; font-weight: 700; }
.print-panel { padding: 12px 14px 22px; background-color: #FFFFFF; }
.print-handle { width: 42px; height: 4px; border-radius: 2px; background-color: #CBD5E1; align-self: center; margin-bottom: 14px; }
.print-head { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 14px; }
.print-title { font-size: 20px; color: #0F172A; font-weight: 700; line-height: 28px; }
.print-subtitle { margin-top: 3px; font-size: 13px; color: #64748B; line-height: 18px; }
.print-close { height: 34px; padding-left: 14px; padding-right: 14px; border-radius: 17px; background-color: #F1F5F9; align-items: center; justify-content: center; }
.print-close-text { font-size: 13px; color: #334155; }
.print-content-card { border-radius: 8px; border-width: 1px; border-color: #DDE6F2; background-color: #F8FAFC; padding: 12px; margin-bottom: 10px; }
.print-row { flex-direction: row; align-items: flex-start; justify-content: space-between; padding-top: 9px; padding-bottom: 9px; border-bottom-width: 1px; border-bottom-color: #E2E8F0; }
.print-empty-row { min-height: 42px; align-items: center; justify-content: center; }
.print-empty-text { font-size: 13px; color: #64748B; }
.print-label { width: 78px; font-size: 13px; color: #64748B; line-height: 20px; }
.print-value { flex: 1; font-size: 14px; color: #0F172A; line-height: 20px; text-align: right; }
.print-value-emphasis { color: #B91C1C; font-weight: 700; }
.print-copies-wrap { margin-bottom: 14px; }
.print-actions { flex-direction: row; }
.print-secondary-btn { flex: 1; height: 44px; border-radius: 14px; background-color: #F1F5F9; align-items: center; justify-content: center; margin-right: 12px; }
.print-secondary-text { font-size: 15px; color: #334155; font-weight: 700; }
.print-primary-btn { flex: 1; height: 44px; border-radius: 14px; background-color: #111827; align-items: center; justify-content: center; }
.print-primary-text { font-size: 15px; color: #FFFFFF; font-weight: 700; }
</style>
