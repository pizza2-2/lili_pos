.ai-modal { width: 100%; height: 680px; border-radius: 8px; background-color: #FFFFFF; overflow: hidden; }
.ai-modal-head { height: 52px; flex-direction: row; align-items: center; padding-left: 14px; padding-right: 10px; border-bottom-width: 1px; border-bottom-style: solid; border-bottom-color: #E2E8F0; }
.ai-modal-title { flex: 1; font-size: 16px; line-height: 22px; color: #0F172A; font-weight: bold; }
.ai-close { height: 34px; min-width: 58px; border-radius: 8px; background-color: #F1F5F9; align-items: center; justify-content: center; padding-left: 10px; padding-right: 10px; }
.ai-close-text { font-size: 13px; color: #475569; }
.ai-modal-scroll { height: 566px; padding-left: 12px; padding-right: 12px; }
