	background-color: #F6F8FB;
	padding-left: 18px;
	padding-right: 18px;
	padding-bottom: 24px;
}

.status-bar-space {
	height: var(--status-bar-height);
}

.topbar {
	height: 52px;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}

.title {
	font-size: 22px;
	line-height: 28px;
	font-weight: 700;
	color: #111827;
}

.back-btn {
	height: 36px;
	padding-left: 16px;
	padding-right: 16px;
	border-radius: 18px;
	align-items: center;
	justify-content: center;
	background-color: #E5E7EB;
}

.back-text {
	font-size: 14px;
	color: #334155;
}

.panel {
	margin-top: 16px;
	padding: 18px;
	border-radius: 10px;
	border-width: 1px;
	border-style: solid;
	border-color: #E2E8F0;
	background-color: #FFFFFF;
}

.label {
	font-size: 13px;
	line-height: 18px;
	color: #64748B;
}

.second-label {
	margin-top: 18px;
}

.result-text {
	margin-top: 8px;
	font-size: 18px;
	line-height: 26px;
	font-weight: 600;
	color: #111827;
}

.type-text {
	margin-top: 8px;
	font-size: 16px;
	line-height: 22px;
	color: #334155;
}

.scan-btn {
	margin-top: 22px;
	height: 48px;
	border-radius: 10px;
	align-items: center;
	justify-content: center;
	background-color: #2563EB;
}

.scan-btn-text {
	font-size: 16px;
	font-weight: 600;
	color: #FFFFFF;
}

.error-box {
	margin-top: 14px;
	padding: 12px;
	border-radius: 8px;
	background-color: #FEF2F2;
}

.error-text {
	font-size: 13px;
	line-height: 18px;
	color: #B91C1C;
}
</style>
