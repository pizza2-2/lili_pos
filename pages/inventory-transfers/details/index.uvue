<template>
	<view class="page">
		<lili-universal-filter
			:title="pageTitle"
			searchPlaceholder="商品名、SKU"
			:searchValue="keyword"
			:showBack="true"
			:showSearch="true"
			:showScan="true"
			:showHome="true"
			homePath="/pages/inventory-transfers/index"
			@searchInput="handleSearchInput"
			@searchConfirm="handleSearchConfirm"
			@searchClear="handleSearchClear"
			@scan="handleScanSearch"
		/>

		<!-- #ifdef APP -->
		<scroll-view style="flex:1" class="page-scroll">
		<!-- #endif -->
			<view class="page-content">
				<view v-if="errorMessage != '' && !isLoading" class="error-card">
					<text class="error-title">加载失败</text>
					<text class="error-desc">{{ errorMessage }}</text>
					<view class="retry-btn" @click="loadItems"><text class="retry-btn-text">重新加载</text></view>
				</view>

				<lili-UniversalList
					:items="listItems"
					keyField="id"
					titleField="title"
					subtitleField="subtitle"
					metaField="quantityText"
					tagField="tags"
					:fields="fieldConfig"
					:loading="isLoading"
					loadingText="正在加载调拨明细"
					:keepContentOnLoading="true"
					inlineLoadingText="调拨明细刷新中..."
					:emptyText="emptyText"
					emptyIcon="◎"
					:showMenu="true"
					:menuActions="menuActions"
					:showChevron="false"
					:showPagination="true"
					:currentPage="currentPage"
					:totalPages="totalPages"
					:totalCount="totalCount"
					summaryTitle="明细概览"
					:summaryItems="summaryItems"
					:showFloatingAdd="true"
					floatingAddText="添加商品"
					@menu="handleMenu"
					@page-change="handlePageChange"
					@floating-add="openAddPopup"
				/>
			</view>
		<!-- #ifdef APP -->
		</scroll-view>
		<!-- #endif -->

		<page-container
			:show="addPopupVisible"
			position="bottom"
			:round="true"
			:overlay="true"
			:duration="240"
			overlay-style="background-color: rgba(15, 23, 42, 0.42);"
			custom-style="background-color: #FFFFFF;"
			@clickoverlay="closeAddPopup"
		>
			<view class="add-panel">
				<view class="add-handle"></view>
				<view class="add-head">
					<view>
						<text class="add-title">添加调拨商品</text>
						<text class="add-subtitle">{{ routeText }}</text>
					</view>
					<view class="add-close" @click="closeAddPopup">
						<text class="add-close-text">关闭</text>
					</view>
				</view>

				<view class="add-field">
					<text class="add-label">商品</text>
					<liliBottomSelect
						:value="draftProductValue"
						:valueText="draftProductText"
						:valueImage="draftProductImage"
						title="选择调拨商品"
						placeholder="请选择商品"
						searchPlaceholder="搜索商品、SKU、条码"
						emptyText="暂无商品"
						imageKey="image"
						subtitleKey="subtitle"
						:fetchData="fetchProductStockOptions"
						:showScan="true"
						:showAddAction="true"
						:showEditAction="true"
						addPath="/pages/products/from"
						editPath="/pages/products/from"
						@change="handleDraftProductChange"
					/>
				</view>

				<view class="add-field">
					<text class="add-label">数量</text>
					<lili-print-copies-stepper
						:value="draftQuantity"
						:min="1"
						:max="999999"
						:step="1"
						:fallback="1"
						:showQuick="false"
						:compact="true"
						@change="handleDraftQuantityChange"
					/>
				</view>

				<view class="add-field">
					<text class="add-label">备注</text>
					<textarea
						class="add-notes"
						:value="draftNotes"
						placeholder="请输入备注"
						@input="handleDraftNotesInput"
					></textarea>
				</view>

				<view class="add-actions">
					<view class="add-secondary-btn" @click="closeAddPopup">
						<text class="add-secondary-text">取消</text>
					</view>
					<view class="add-primary-btn" @click="confirmAddItem">
						<text class="add-primary-text">{{ submitting ? '添加中...' : '确认添加' }}</text>
					</view>
				</view>
			</view>
		</page-container>
	</view>
</template>

<script setup lang="uts">
import { computed } from 'vue'
import liliBottomSelect from '@/uni_modules/lili_bottom-select/components/lili_bottom-select/lili_bottom-select.uvue'
import { request, takeLatestResponseMessage } from '@/pkg/api/index.uts'
import { createInventoryTransferItem, getInventoryStocks, getInventoryTransferDetail, getInventoryTransferItems, InventoryListQuery, InventoryListResponse } from '@/pkg/api/modules/inventory'
import { scanCode, type GeneralCallbackResult, type ScanCodeOption, type ScanCodeSuccessCallbackResult } from '@/uni_modules/lime-scan'
import { startVolumeKeyListener, stopVolumeKeyListener, VolumeKeyEvent } from '@/uni_modules/lili-key'
import { showErrorToast } from '@/pkg/util/toast.uts'

const refreshStorageKey = 'refresh:pages:inventory-transfers:index'
const transferId = ref('')
const keyword = ref('')
const orderInfo = ref<UTSJSONObject | null>(null)
const items = ref<UTSJSONObject[]>([])
const isLoading = ref(false)
const errorMessage = ref('')
const currentPage = ref(1)
const totalPages = ref(1)
const totalCount = ref(0)
const pageSize = ref(20)
const pageTotalQuantity = ref('0')
const pageTransferredQuantity = ref('0')
const addPopupVisible = ref(false)
const submitting = ref(false)
const draftProductValue = ref('')
const draftProductText = ref('')
const draftProductImage = ref('')
const draftProductSubtitle = ref('')
const draftQuantity = ref('1')
const draftNotes = ref('')
const scanLookupRunning = ref(false)
const volumeScanLocked = ref(false)
let volumeKeyStartTimer = 0

const fieldConfig = ref<UTSJSONObject[]>([
	{ key: 'skuText', label: 'SKU:' } as UTSJSONObject,
	{ key: 'quantityText', label: '数量:' } as UTSJSONObject,
	{ key: 'transferredText', label: '已调拨:' } as UTSJSONObject,
])

const menuActions = ref<UTSJSONObject[]>([
	{ key: 'reload', text: '刷新' } as UTSJSONObject,
])

function stringValue(value: any | null, fallback: string = ''): string {
	if (value == null) return fallback
	const text = '' + value
	if (text == '') return fallback
	return text
}

function intValue(value: any | null): number {
	const parsed = parseInt(stringValue(value))
	if (isNaN(parsed)) return 0
	return parsed
}

function parseErrorMessage(error: any, fallback: string): string {
	let message = fallback
	if (error != null) {
		const errorText = JSON.stringify(error)
		if (errorText != null && errorText != '') {
			let parsedError: UTSJSONObject | null = null
			try {
				const trimmedText = errorText.trim()
				if (trimmedText != '' && trimmedText.substring(0, 1) == '{') parsedError = JSON.parseObject<UTSJSONObject>(trimmedText)
			} catch (parseError) {
				parsedError = null
			}
			if (parsedError != null) {
				const rawMessage = parsedError!['message']
				if (rawMessage != null) {
					const parsedMessage = rawMessage as string
					if (parsedMessage != '') message = parsedMessage
				}
			}
			if (message == fallback && errorText != '{}') message = errorText
		}
	}
	return message
}

function parseObject(value: any | null): UTSJSONObject | null {
	if (value == null) return null
	const text = JSON.stringify(value)
	if (text == null || text == '') return null
	const trimmedText = text.trim()
	if (trimmedText == '' || trimmedText.substring(0, 1) != '{') return null
	try {
		return JSON.parseObject<UTSJSONObject>(trimmedText)
	} catch (error) {
		return null
	}
}

function parseObjectArray(value: any | null): UTSJSONObject[] {
	if (value == null) return [] as UTSJSONObject[]
	const text = JSON.stringify(value)
	if (text == null || text == '') return [] as UTSJSONObject[]
	const trimmedText = text.trim()
	if (trimmedText == '' || trimmedText.substring(0, 1) != '[') return [] as UTSJSONObject[]
	let parsed: UTSJSONObject[] | null = null
	try {
		parsed = JSON.parseArray<UTSJSONObject>(trimmedText)
	} catch (error) {
		return [] as UTSJSONObject[]
	}
	if (parsed == null) return [] as UTSJSONObject[]
	return parsed!
}

function extractRows(raw: any | null): UTSJSONObject[] {
	const directArray = parseObjectArray(raw)
	if (directArray.length > 0) return directArray
	const rawObject = parseObject(raw)
	if (rawObject == null) return [] as UTSJSONObject[]
	const dataArray = parseObjectArray(rawObject!['data'])
	if (dataArray.length > 0) return dataArray
	const resultsArray = parseObjectArray(rawObject!['results'])
	if (resultsArray.length > 0) return resultsArray
	const itemsArray = parseObjectArray(rawObject!['items'])
	if (itemsArray.length > 0) return itemsArray
	const dataObject = parseObject(rawObject!['data'])
	if (dataObject != null) {
		const nestedResults = parseObjectArray(dataObject!['results'])
		if (nestedResults.length > 0) return nestedResults
	}
	return [] as UTSJSONObject[]
}

function firstStringField(obj: UTSJSONObject, keys: string[]): string {
	for (let index = 0; index < keys.length; index += 1) {
		const text = stringValue(obj[keys[index]])
		if (text != '') return text
	}
	return ''
}

function firstImageFromStock(stock: UTSJSONObject): string {
	const direct = stringValue(stock['product_image'])
	if (direct != '') return direct
	const mediaFiles = parseObjectArray(stock['product_media_files'])
	for (let index = 0; index < mediaFiles.length; index += 1) {
		const image = firstStringField(mediaFiles[index], ['signed_thumbnail_url', 'signed_download_url', 'file_url', 'url', 'image'])
		if (image != '') return image
	}
	return ''
}

function stockOption(item: UTSJSONObject): UTSJSONObject {
	const productValue = firstStringField(item, ['product', 'product_id'])
	const title = stringValue(item['product_name'], productValue)
	const barcode = stringValue(item['product_barcode'])
	const sku = stringValue(item['product_sku'])
	const location = stringValue(item['location_name'])
	let subtitle = '可用 ' + stringValue(item['available_quantity'], stringValue(item['quantity'], '0'))
	if (location != '') subtitle = '位置 ' + location + ' / ' + subtitle
	if (barcode != '') subtitle = subtitle + ' / 条码 ' + barcode
	else if (sku != '') subtitle = subtitle + ' / SKU ' + sku
	return {
		value: productValue,
		text: title,
		subtitle: subtitle,
		image: firstImageFromStock(item),
	} as UTSJSONObject
}

function fromLocationValue(): string {
	if (orderInfo.value == null) return ''
	return stringValue((orderInfo.value as UTSJSONObject)['from_location'])
}

function buildOptionQuery(params: UTSJSONObject): UTSJSONObject {
	const pageValue = intValue(params['page'])
	const pageSizeValue = intValue(params['pageSize'])
	const query = {
		page: pageValue <= 0 ? 1 : pageValue,
		page_size: pageSizeValue <= 0 ? 50 : pageSizeValue,
	} as UTSJSONObject
	const keywordValue = stringValue(params['keyword'])
	if (keywordValue != '') {
		query['search'] = keywordValue
		query['keyword'] = keywordValue
	}
	const fromLocation = fromLocationValue()
	if (fromLocation != '') query['location'] = fromLocation
	return query
}

function buildSelectResponse(rows: UTSJSONObject[]): UTSJSONObject {
	return {
		data: rows,
		results: rows,
		total: rows.length,
		total_count: rows.length,
	} as UTSJSONObject
}

async function fetchProductStockOptions(params: UTSJSONObject): Promise<UTSJSONObject> {
	const raw = await request('/api/inventory/stocks/', 'GET', buildOptionQuery(params), true)
	const sourceRows = extractRows(raw)
	const rows: UTSJSONObject[] = []
	for (let index = 0; index < sourceRows.length; index += 1) {
		const row = stockOption(sourceRows[index])
		if (stringValue(row['value']) != '') rows.push(row)
	}
	return buildSelectResponse(rows)
}

function buildQuery(): InventoryListQuery {
	return {
		search: keyword.value == '' ? null : keyword.value,
		page: currentPage.value,
		page_size: pageSize.value,
		status: null,
		alert_status: null,
		supplier: null,
		category: null,
		is_listed: null,
		location: null,
		from_location: null,
		to_location: null,
		transfer_order: transferId.value == '' ? null : transferId.value,
		product: null,
		transaction_type: null,
		location_type: null,
		is_active: null,
	} as InventoryListQuery
}

function applyResponse(response: InventoryListResponse) {
	items.value = response.results
	currentPage.value = response.current_page
	totalPages.value = response.total_pages
	totalCount.value = response.total_count
	pageSize.value = response.page_size
	let total = 0
	let transferred = 0
	for (let index = 0; index < response.results.length; index += 1) {
		const row = response.results[index]
		total = total + intValue(row['quantity'])
		transferred = transferred + intValue(row['transferred_quantity'])
	}
	pageTotalQuantity.value = total.toString()
	pageTransferredQuantity.value = transferred.toString()
}

async function loadTransferInfo() {
	if (transferId.value == '') return
	try {
		orderInfo.value = await getInventoryTransferDetail(transferId.value)
	} catch (error) {
	}
}

async function loadItems() {
	if (isLoading.value) return
	if (transferId.value == '') {
		errorMessage.value = '缺少调拨单 ID'
		return
	}
	isLoading.value = true
	errorMessage.value = ''
	try {
		await loadTransferInfo()
		applyResponse(await getInventoryTransferItems(buildQuery()))
	} catch (error) {
		items.value = [] as UTSJSONObject[]
		currentPage.value = 1
		totalPages.value = 1
		totalCount.value = 0
		pageTotalQuantity.value = '0'
		pageTransferredQuantity.value = '0'
		errorMessage.value = parseErrorMessage(error, '调拨明细加载失败')
	} finally {
		isLoading.value = false
	}
}

function itemToListItem(item: UTSJSONObject): UTSJSONObject {
	const sku = stringValue(item['product_sku'])
	return {
		id: stringValue(item['id']),
		rawId: stringValue(item['id']),
		title: stringValue(item['product_name'], '商品 #' + stringValue(item['product'])),
		subtitle: sku == '' ? 'SKU：-' : 'SKU：' + sku,
		quantityText: stringValue(item['quantity'], '0'),
		transferredText: stringValue(item['transferred_quantity'], '0'),
		skuText: sku == '' ? '-' : sku,
		notesText: stringValue(item['notes'], '-'),
		tags: ['调拨商品'] as string[],
	} as UTSJSONObject
}

function resetDraft() {
	draftProductValue.value = ''
	draftProductText.value = ''
	draftProductImage.value = ''
	draftProductSubtitle.value = ''
	draftQuantity.value = '1'
	draftNotes.value = ''
}

function openAddPopup() {
	resetDraft()
	addPopupVisible.value = true
}

function closeAddPopup() {
	if (submitting.value) return
	addPopupVisible.value = false
}

function openPopupWithStock(stock: UTSJSONObject) {
	const option = stockOption(stock)
	draftProductValue.value = stringValue(option['value'])
	draftProductText.value = stringValue(option['text'])
	draftProductImage.value = stringValue(option['image'])
	draftProductSubtitle.value = stringValue(option['subtitle'])
	draftQuantity.value = '1'
	draftNotes.value = ''
	addPopupVisible.value = true
}

function handleDraftProductChange(payload: UTSJSONObject) {
	draftProductValue.value = stringValue(payload['value'])
	draftProductText.value = stringValue(payload['text'])
	draftProductImage.value = stringValue(payload['image'])
	const item = payload['item']
	if (item != null) draftProductSubtitle.value = stringValue((item as UTSJSONObject)['subtitle'])
	else draftProductSubtitle.value = ''
}

function handleDraftQuantityChange(value: any) {
	const quantity = intValue(value)
	draftQuantity.value = quantity <= 0 ? '1' : quantity.toString()
}

function handleDraftNotesInput(event: any) {
	const inputEvent = event as UniInputEvent
	draftNotes.value = inputEvent.detail.value
}

async function confirmAddItem() {
	if (submitting.value) return
	if (transferId.value == '') {
		uni.showToast({ title: '缺少调拨单 ID', icon: 'none', duration: 3500 })
		return
	}
	const productId = intValue(draftProductValue.value)
	const quantity = intValue(draftQuantity.value)
	if (productId <= 0) {
		uni.showToast({ title: '请选择商品', icon: 'none', duration: 3500 })
		return
	}
	if (quantity <= 0) {
		uni.showToast({ title: '请输入有效数量', icon: 'none', duration: 3500 })
		return
	}
	submitting.value = true
	uni.showLoading({ title: '添加商品中...', mask: true })
	try {
		await createInventoryTransferItem({
			payload: {
				transfer_order: intValue(transferId.value),
				product: productId,
				quantity: quantity,
				notes: draftNotes.value,
			} as UTSJSONObject,
		})
		uni.setStorageSync(refreshStorageKey, '1')
		uni.showToast({ title: takeLatestResponseMessage('添加成功'), icon: 'success' })
		addPopupVisible.value = false
		currentPage.value = 1
		loadItems()
	} catch (error) {
		showErrorToast(parseErrorMessage(error, '添加失败'))
	} finally {
		uni.hideLoading()
		submitting.value = false
	}
}

async function handleScannedBarcode(scanResult: string) {
	const barcode = scanResult.trim()
	if (barcode == '' || scanLookupRunning.value) return
	scanLookupRunning.value = true
	try {
		await loadTransferInfo()
		const response = await getInventoryStocks({
			search: barcode,
			page: 1,
			page_size: 10,
			status: null,
			alert_status: null,
			supplier: null,
			category: null,
			is_listed: null,
			location: fromLocationValue() == '' ? null : fromLocationValue(),
			from_location: null,
			to_location: null,
			transfer_order: null,
			product: null,
			transaction_type: null,
			location_type: null,
			is_active: null,
		} as InventoryListQuery)
		if (response.results.length > 0) {
			openPopupWithStock(response.results[0])
			return
		}
		resetDraft()
		addPopupVisible.value = true
		uni.showToast({ title: '未找到匹配商品', icon: 'none', duration: 3500 })
	} catch (error) {
		showErrorToast(parseErrorMessage(error, '扫码查询失败'))
	} finally {
		scanLookupRunning.value = false
	}
}

function handleScanSearch() {
	scanCode({
		onlyFromCamera: true,
		success: (res: ScanCodeSuccessCallbackResult) => {
			const scanResult = res.result
			if (scanResult == '') return
			handleScannedBarcode(scanResult)
		},
		fail: (res: GeneralCallbackResult) => {
			const message = res.errMsg == '' ? '扫码失败' : res.errMsg
			uni.showToast({ title: message, icon: 'none', duration: 3500 })
		},
	} as ScanCodeOption)
}

function handleSearchInput(value: string) { keyword.value = value }
function handleSearchConfirm(value: string) { keyword.value = value; currentPage.value = 1; loadItems() }
function handleSearchClear() { keyword.value = ''; currentPage.value = 1; loadItems() }

function handlePageChange(payload: UTSJSONObject) {
	const pageValue = payload['page']
	if (pageValue == null) return
	const nextPage = parseInt('' + pageValue)
	if (isNaN(nextPage) || nextPage <= 0 || nextPage == currentPage.value) return
	currentPage.value = nextPage
	loadItems()
}

function handleMenu(payload: UTSJSONObject) {
	const action = payload['action']
	const item = payload['item']
	if (action == null || item == null) return
	const actionKey = stringValue((action as UTSJSONObject)['key'])
	const id = stringValue((item as UTSJSONObject)['rawId'])
	if (actionKey == 'reload') {
		loadItems()
		return
	}
}

function unlockVolumeScanSoon() {
	setTimeout(() => {
		volumeScanLocked.value = false
	}, 1200)
}

function handleVolumeKeyEvent(event: VolumeKeyEvent) {
	if (event.key != 'VOLUME_UP' && event.key != 'VOLUME_DOWN') return
	if (volumeScanLocked.value) return
	volumeScanLocked.value = true
	handleScanSearch()
	unlockVolumeScanSoon()
}

function startDetailVolumeKeyListener() {
	startVolumeKeyListener((event: VolumeKeyEvent) => {
		handleVolumeKeyEvent(event)
	})
}

function scheduleDetailVolumeKeyListener() {
	if (volumeKeyStartTimer != 0) clearTimeout(volumeKeyStartTimer)
	volumeKeyStartTimer = setTimeout(() => {
		volumeKeyStartTimer = 0
		startDetailVolumeKeyListener()
	}, 260)
}

function stopDetailVolumeKeyListener() {
	if (volumeKeyStartTimer != 0) {
		clearTimeout(volumeKeyStartTimer)
		volumeKeyStartTimer = 0
	}
	stopVolumeKeyListener()
	volumeScanLocked.value = false
}

const pageTitle = computed((): string => {
	if (orderInfo.value == null) return '调拨单明细'
	return '明细 ' + stringValue((orderInfo.value as UTSJSONObject)['transfer_number'], '')
})

const routeText = computed((): string => {
	if (orderInfo.value == null) return ''
	const order = orderInfo.value as UTSJSONObject
	return stringValue(order['from_location_name'], '-') + ' -> ' + stringValue(order['to_location_name'], '-')
})

const listItems = computed((): UTSJSONObject[] => {
	const result: UTSJSONObject[] = []
	for (let index = 0; index < items.value.length; index += 1) result.push(itemToListItem(items.value[index]))
	return result
})

const hasActiveFilter = computed((): boolean => keyword.value != '')

const emptyText = computed((): string => {
	if (isLoading.value) return '正在加载'
	if (hasActiveFilter.value) return '没有匹配的调拨明细'
	return '暂无调拨明细'
})

const summaryItems = computed((): UTSJSONObject[] => {
	return [
		{ key: 'total', label: '明细数', value: totalCount.value.toString() } as UTSJSONObject,
		{ key: 'quantity', label: '本页数量', value: pageTotalQuantity.value } as UTSJSONObject,
		{ key: 'transferred', label: '本页已调拨', value: pageTransferredQuantity.value } as UTSJSONObject,
		{ key: 'page', label: '页码', value: currentPage.value.toString() + '/' + totalPages.value.toString() } as UTSJSONObject,
	]
})

onLoad((query: OnLoadOptions) => {
	const transferValue = query['transfer']
	transferId.value = transferValue == null ? '' : ('' + transferValue)
	loadItems()
})

onShow(() => {
	scheduleDetailVolumeKeyListener()
})

onHide(() => {
	stopDetailVolumeKeyListener()
})

onUnload(() => {
	stopDetailVolumeKeyListener()
})
</script>

<style>
.page { flex: 1; background-color: #F6F7FB; }
.page-scroll { flex: 1; background-color: #F6F7FB; }
.page-content { padding-top: 6px; padding-right: 6px; padding-bottom: 96px; padding-left: 6px; }
.error-card { background-color: #FFFFFF; border-radius: 8px; padding: 18px; margin-bottom: 10px; border-width: 1px; border-style: solid; border-color: #FECACA; align-items: center; }
.error-title { font-size: 18px; line-height: 24px; color: #B42318; font-weight: bold; }
.error-desc { font-size: 14px; line-height: 20px; color: #7F1D1D; margin-top: 8px; text-align: center; }
.retry-btn { margin-top: 14px; height: 40px; border-radius: 8px; background-color: #0F172A; padding-left: 18px; padding-right: 18px; align-items: center; justify-content: center; }
.retry-btn-text { font-size: 14px; color: #FFFFFF; }
.add-panel { padding-left: 14px; padding-right: 14px; padding-bottom: 24px; background-color: #FFFFFF; }
