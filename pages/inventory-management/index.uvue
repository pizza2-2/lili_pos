<template>
	<view class="page">
		<lili-universal-filter
			title="库存管理"
			searchPlaceholder="搜索商品名称、SKU、条码"
			:searchValue="keyword"
			:filterVisible="filterVisible"
			:showBack="true"
			:showSearch="true"
			:showFilter="true"
			:showScan="true"
			:showHome="true"
			homePath="/pages/tabbar/settings"
			backgroundColor="#EEF2F7"
			@searchInput="handleSearchInput"
			@searchConfirm="handleSearchConfirm"
			@searchClear="handleSearchClear"
			@scan="handleScanSearch"
		>
			<view v-if="filterVisible" class="filter-panel">
				<view class="filter-section">
					<text class="filter-label">供应商</text>
					<liliBottomSelect
						:value="supplierFilterValue"
						:valueText="supplierFilterText"
						title="选择供应商"
						placeholder="全部供应商"
						searchPlaceholder="搜索供应商"
						emptyText="暂无供应商"
						:fetchData="fetchSupplierFilterOptions"
						:showEditAction="false"
						:showAddAction="false"
						@change="handleSupplierFilterChange"
					/>
				</view>

				<view class="filter-section">
					<text class="filter-label">分类</text>
					<liliBottomSelect
						:values="categoryFilterValues"
						title="选择分类"
						placeholder="全部分类"
						searchPlaceholder="搜索分类"
						emptyText="暂无分类"
						:fetchData="fetchCategoryFilterOptions"
						:showEditAction="false"
						:showAddAction="false"
						:tree="true"
						:multiple="true"
						:checkStrictly="false"
						:defaultExpandAll="true"
						childrenKey="children"
						@multiChange="handleCategoryFilterChange"
					/>
				</view>

				<view class="filter-section">
					<text class="filter-label">库存状态</text>
					<view class="status-row">
						<view
							v-for="item in alertStatusOptions"
							:key="getStringField(item, 'value')"
							:class="selectedAlertStatus == getStringField(item, 'value') ? 'status-chip status-chip-active' : 'status-chip'"
							@click="selectAlertStatus(getStringField(item, 'value'))"
						>
							<text :class="selectedAlertStatus == getStringField(item, 'value') ? 'status-chip-text-active' : 'status-chip-text'">{{ getStringField(item, 'text') }}</text>
						</view>
					</view>
				</view>

				<view class="filter-actions">
					<view class="filter-reset" @click="resetFilters">
						<text class="filter-reset-text">重置</text>
					</view>
					<view class="filter-apply" @click="applyFilters">
						<text class="filter-apply-text">应用</text>
					</view>
				</view>
			</view>
		</lili-universal-filter>

		<scroll-view class="content-scroll" scroll-y="true" @scrolltolower="handleLoadMore" :show-scrollbar="false">
			<view class="overview-card">
				<view class="overview-row">
					<text class="overview-label">记录数</text>
					<text class="overview-value">{{ totalCount }}</text>
				</view>
				<view class="overview-row">
					<text class="overview-label">页码</text>
					<text class="overview-value">{{ currentPageDisplay }}</text>
				</view>
			</view>

			<view v-if="loadError != ''" class="error-card">
				<text class="error-title">加载失败</text>
				<text class="error-text">{{ loadError }}</text>
				<view class="retry-btn" @click="reload">
					<text class="retry-text">重新加载</text>
				</view>
			</view>

			<liliUniversalList
				v-if="items.length > 0"
				:items="items"
				:fieldConfig="fieldConfig"
				titleField="name"
				subtitleField="subtitle"
				metaField="meta"
				imageField="image"
				imageListField="images"
				@itemClick="handleItemClick"
			/>

			<view v-else-if="!loading && loadError == ''" class="empty-card">
				<view class="empty-icon">
					<text class="empty-icon-text">□</text>
				</view>
				<text class="empty-title">暂无库存记录</text>
				<text class="empty-text">当前筛选条件下没有可展示的数据。</text>
			</view>

			<view v-if="loading" class="loading-wrap">
				<text class="loading-text">加载中...</text>
			</view>
		</scroll-view>

		<view class="fab" @click="handleAdd">
			<text class="fab-text">新增</text>
		</view>
	</view>
</template>

<script setup lang="uts">
import liliUniversalList from '@/uni_modules/lili-UniversalList/components/lili-UniversalList/lili-UniversalList.uvue'
import liliBottomSelect from '@/uni_modules/lili_bottom-select/components/lili_bottom-select/lili_bottom-select.uvue'
import { request } from '@/pkg/api/index.uts'
import { getInventoryStocks, type InventoryListQuery, type InventoryListResponse } from '@/pkg/api/modules/inventory.uts'

const refreshStorageKey = 'refresh:pages:inventory-management:index'
const keyword = ref<string>('')
const filterVisible = ref<boolean>(false)
const supplierFilterValue = ref<string>('')
const supplierFilterText = ref<string>('')
const categoryFilterValues = ref<string[]>([])
const selectedAlertStatus = ref<string>('')
const items = ref<UTSJSONObject[]>([])
const page = ref<number>(1)
const pageSize = ref<number>(20)
const totalCount = ref<number>(0)
const totalPages = ref<number>(1)
const loading = ref<boolean>(false)
const loadError = ref<string>('')
const hasMore = ref<boolean>(true)
const loadedOnce = ref<boolean>(false)

const alertStatusOptions = [
	{ value: '', text: '全部' },
	{ value: 'NORMAL', text: '正常' },
	{ value: 'LOW', text: '低库存' },
	{ value: 'OUT', text: '缺货' },
] as UTSJSONObject[]

const fieldConfig = [
	{ key: 'quantityText', label: '库存' },
	{ key: 'availableText', label: '可用' },
	{ key: 'barcodeText', label: '条码' },
	{ key: 'supplierText', label: '供应商' },
	{ key: 'categoryText', label: '分类' },
	{ key: 'alertText', label: '状态' },
] as UTSJSONObject[]

const currentPageDisplay = computed<string>(() : string => {
	if (totalPages.value <= 0) return '1/1'
	return '' + page.value + '/' + totalPages.value
})

function stringValue(value: any | null) : string {
	if (value == null) return ''
	return '' + value
}

function intValue(value: any | null) : number {
	if (value == null) return 0
	const parsed = parseInt('' + value)
	if (isNaN(parsed)) return 0
	return parsed
}

function getStringField(obj: UTSJSONObject, key: string, fallback: string = '') : string {
	const value = obj[key]
	if (value == null) return fallback
	const text = '' + value
	if (text == '') return fallback
	return text
}

function parseObject(value: any | null) : UTSJSONObject | null {
	if (value == null) return null
	const text = JSON.stringify(value)
	if (text == null || text == '') return null
	return JSON.parseObject<UTSJSONObject>(text)
}

function parseObjectArray(value: any | null) : UTSJSONObject[] {
	if (value == null) return [] as UTSJSONObject[]
	const text = JSON.stringify(value)
	if (text == null || text == '') return [] as UTSJSONObject[]
	const parsed = JSON.parseArray<UTSJSONObject>(text)
	if (parsed == null) return [] as UTSJSONObject[]
	return parsed!
}

function parseStringArray(value: any | null) : string[] {
	if (value == null) return [] as string[]
	const text = JSON.stringify(value)
	if (text == null || text == '') return [] as string[]
	const parsed = JSON.parseArray<string>(text)
	if (parsed == null) return [] as string[]
	return parsed!
}

function firstStringField(obj: UTSJSONObject, keys: string[]) : string {
	for (let i = 0; i < keys.length; i++) {
		const text = getStringField(obj, keys[i])
		if (text != '') return text
	}
	return ''
}

function extractRows(raw: any | null) : UTSJSONObject[] {
	const directArray = parseObjectArray(raw)
	if (directArray.length > 0) return directArray
	const obj = parseObject(raw)
	if (obj == null) return [] as UTSJSONObject[]
	const dataArray = parseObjectArray(obj['data'])
	if (dataArray.length > 0) return dataArray
	const resultsArray = parseObjectArray(obj['results'])
	if (resultsArray.length > 0) return resultsArray
	const itemsArray = parseObjectArray(obj['items'])
	if (itemsArray.length > 0) return itemsArray
	const dataObject = parseObject(obj['data'])
	if (dataObject != null) {
		const nestedResults = parseObjectArray(dataObject!['results'])
		if (nestedResults.length > 0) return nestedResults
	}
	return [] as UTSJSONObject[]
}

function getChildren(item: UTSJSONObject) : UTSJSONObject[] {
	const children = parseObjectArray(item['children'])
	if (children.length > 0) return children
	const childList = parseObjectArray(item['child_list'])
	if (childList.length > 0) return childList
	return [] as UTSJSONObject[]
}

function normalizeOptionNode(item: UTSJSONObject) : UTSJSONObject {
	const value = firstStringField(item, ['value', 'id', 'pk'])
	let text = firstStringField(item, ['text', 'label', 'name', 'name_cn', 'title'])
	if (text == '') text = value
	const children = getChildren(item)
	const normalizedChildren: UTSJSONObject[] = []
	for (let i = 0; i < children.length; i++) {
		normalizedChildren.push(normalizeOptionNode(children[i]))
	}
	return {
		value: value,
		text: text,
		children: normalizedChildren,
		has_children: normalizedChildren.length > 0,
	} as UTSJSONObject
}

function optionMatches(item: UTSJSONObject, word: string) : boolean {
	if (word == '') return true
	const text = getStringField(item, 'text').toLowerCase()
	const value = getStringField(item, 'value').toLowerCase()
	const keywordLower = word.toLowerCase()
	return text.indexOf(keywordLower) >= 0 || value.indexOf(keywordLower) >= 0
}

function filterOptionTree(list: UTSJSONObject[], word: string) : UTSJSONObject[] {
	if (word == '') return list
	const result: UTSJSONObject[] = []
	for (let i = 0; i < list.length; i++) {
		const item = list[i]
		const children = filterOptionTree(getChildren(item), word)
		if (optionMatches(item, word) || children.length > 0) {
			const cloned = {} as UTSJSONObject
			for (const key in item) {
				cloned[key] = item[key]
			}
			cloned['children'] = children
			cloned['has_children'] = children.length > 0
			result.push(cloned)
		}
	}
	return result
}

function buildBottomSelectResponse(raw: any | null, params: UTSJSONObject) : UTSJSONObject {
	const keywordValue = getStringField(params, 'keyword')
	const rows = extractRows(raw)
	const normalized: UTSJSONObject[] = []
	for (let i = 0; i < rows.length; i++) {
		normalized.push(normalizeOptionNode(rows[i]))
	}
	const filtered = filterOptionTree(normalized, keywordValue)
	return {
		data: filtered,
		results: filtered,
		total: filtered.length,
		total_count: filtered.length,
	} as UTSJSONObject
}

function buildOptionQuery(params: UTSJSONObject) : UTSJSONObject {
	const pageValue = intValue(params['page'])
	const pageSizeValue = intValue(params['pageSize'])
	const query = {
		page: pageValue <= 0 ? 1 : pageValue,
		page_size: pageSizeValue <= 0 ? 50 : pageSizeValue,
	} as UTSJSONObject
	const keywordValue = getStringField(params, 'keyword')
	if (keywordValue != '') {
		query['search'] = keywordValue
		query['keyword'] = keywordValue
	}
	const idValue = getStringField(params, 'id')
	if (idValue != '') query['id'] = idValue
	const parentValue = getStringField(params, 'parent')
	if (parentValue != '') query['parent'] = parentValue
	return query
}

async function fetchSupplierFilterOptions(params: UTSJSONObject) : Promise<UTSJSONObject> {
	const raw = await request('/api/procurement/suppliers/options/', 'GET', buildOptionQuery(params), true)
	return buildBottomSelectResponse(raw, params)
}

async function fetchCategoryFilterOptions(params: UTSJSONObject) : Promise<UTSJSONObject> {
	const raw = await request('/api/categories/categories/options/', 'GET', buildOptionQuery(params), true)
	return buildBottomSelectResponse(raw, params)
}

function numberText(value: any | null) : string {
	const text = stringValue(value)
	if (text == '') return '0'
	return text
}

function statusText(value: string) : string {
	if (value == 'LOW') return '低库存'
	if (value == 'OUT') return '缺货'
	if (value == 'OVER') return '超储'
	if (value == 'NORMAL') return '正常'
	if (value == '') return '正常'
	return value
}

function firstImageFromStock(stock: UTSJSONObject) : string {
	const directImage = getStringField(stock, 'product_image')
	if (directImage != '') return directImage
	const mediaFiles = parseObjectArray(stock['product_media_files'])
	for (let i = 0; i < mediaFiles.length; i++) {
		const image = firstStringField(mediaFiles[i], ['signed_thumbnail_url', 'signed_download_url', 'file_url', 'url', 'image'])
		if (image != '') return image
	}
	return ''
}

function imageListFromStock(stock: UTSJSONObject) : string[] {
	const result: string[] = []
	const directImage = getStringField(stock, 'product_image')
	if (directImage != '') result.push(directImage)
	const mediaFiles = parseObjectArray(stock['product_media_files'])
	for (let i = 0; i < mediaFiles.length; i++) {
		const image = firstStringField(mediaFiles[i], ['signed_thumbnail_url', 'signed_download_url', 'file_url', 'url', 'image'])
		if (image != '') result.push(image)
	}
	return result
}

function stockToListItem(stock: UTSJSONObject) : UTSJSONObject {
	const id = getStringField(stock, 'id')
	const name = getStringField(stock, 'product_name', '未命名商品')
	const sku = getStringField(stock, 'product_sku')
	const barcode = getStringField(stock, 'product_barcode')
	const location = getStringField(stock, 'location_name')
	const supplier = getStringField(stock, 'product_supplier_name', '未设置')
	const category = getStringField(stock, 'product_category_name', '未分类')
	const alertStatus = getStringField(stock, 'alert_status')
	const subtitleParts: string[] = []
	if (sku != '') subtitleParts.push('SKU ' + sku)
	if (barcode != '') subtitleParts.push(barcode)
	return {
		id: id,
		raw: stock,
		name: name,
		subtitle: subtitleParts.join(' / '),
		meta: location == '' ? '未设置库存位置' : location,
		image: firstImageFromStock(stock),
		images: imageListFromStock(stock),
		quantityText: numberText(stock['quantity']),
		availableText: numberText(stock['available_quantity']),
		barcodeText: barcode == '' ? '-' : barcode,
		supplierText: supplier,
		categoryText: category,
		alertText: statusText(alertStatus),
	} as UTSJSONObject
}

function buildQuery(reset: boolean) : InventoryListQuery {
	return {
		search: keyword.value == '' ? null : keyword.value,
		page: reset ? 1 : page.value,
		page_size: pageSize.value,
		status: null,
		alert_status: selectedAlertStatus.value == '' ? null : selectedAlertStatus.value,
		supplier: supplierFilterValue.value == '' ? null : supplierFilterValue.value,
		category: categoryFilterValues.value.length == 0 ? null : categoryFilterValues.value.join(','),
		transaction_type: null,
		location_type: null,
		is_active: null,
	} as InventoryListQuery
}

function applyListResponse(result: InventoryListResponse, reset: boolean) {
	const mapped: UTSJSONObject[] = []
	for (let i = 0; i < result.results.length; i++) {
		mapped.push(stockToListItem(result.results[i]))
	}
	if (reset) {
		items.value = mapped
		page.value = 1
	} else {
		items.value = [...items.value, ...mapped]
	}
	totalCount.value = result.total_count
	totalPages.value = result.total_pages <= 0 ? 1 : result.total_pages
	hasMore.value = page.value < totalPages.value
}

function parseLoadError(error: any | null) : string {
	if (error == null) return '获取库存数据失败'
	const text = '' + error
	if (text == '') return '获取库存数据失败'
	return text
}

async function loadItems(reset: boolean) {
	if (loading.value) return
	loading.value = true
	loadError.value = ''
	try {
		const result = await getInventoryStocks(buildQuery(reset))
		applyListResponse(result, reset)
		loadedOnce.value = true
	} catch (error) {
		loadError.value = parseLoadError(error)
		if (reset) {
			items.value = []
			totalCount.value = 0
			totalPages.value = 1
			hasMore.value = false
		}
	} finally {
		loading.value = false
	}
}

function handleSearchInput(value: string) {
	keyword.value = value
}

function handleSearchConfirm(value: string) {
	keyword.value = value
	loadItems(true)
}

function handleSearchClear() {
	keyword.value = ''
	loadItems(true)
}

function handleScanSearch(payload: any | null) {
	let scanText = stringValue(payload)
	if (scanText == '[object Object]') {
		const objectPayload = parseObject(payload)
		if (objectPayload != null) {
			scanText = firstStringField(objectPayload!, ['result', 'value', 'text', 'code'])
		}
	}
	if (scanText == '') return
	keyword.value = scanText
	loadItems(true)
}

function handleSupplierFilterChange(payload: UTSJSONObject) {
	supplierFilterValue.value = getStringField(payload, 'value')
	supplierFilterText.value = getStringField(payload, 'text')
}

function handleCategoryFilterChange(payload: UTSJSONObject) {
	categoryFilterValues.value = parseStringArray(payload['values'])
}

function selectAlertStatus(value: string) {
	selectedAlertStatus.value = value
}

function resetFilters() {
	supplierFilterValue.value = ''
	supplierFilterText.value = ''
	categoryFilterValues.value = []
	selectedAlertStatus.value = ''
	keyword.value = ''
	filterVisible.value = false
	loadItems(true)
}

function applyFilters() {
	filterVisible.value = false
	loadItems(true)
}

function reload() {
	loadItems(true)
}

function handleLoadMore() {
	if (!hasMore.value || loading.value) return
	page.value = page.value + 1
	loadItems(false)
}

function handleItemClick(payload: UTSJSONObject) {
	let item = payload
	const rawItem = parseObject(payload['item'])
	if (rawItem != null) item = rawItem!
	const id = getStringField(item, 'id')
	if (id == '') return
	uni.navigateTo({
		url: '/pages/inventory-management/from?id=' + id,
	})
}

function handleAdd() {
	uni.navigateTo({
		url: '/pages/inventory-management/from',
	})
}

function consumeRefreshFlag() {
	const flag = uni.getStorageSync(refreshStorageKey)
	if (stringValue(flag) == '1') {
		uni.removeStorageSync(refreshStorageKey)
		loadItems(true)
	}
}

onLoad(() => {
	loadItems(true)
})

onShow(() => {
	if (loadedOnce.value) {
		consumeRefreshFlag()
	}
})
</script>

<style>
.page {
	flex: 1;
	background-color: #EEF2F7;
}

.filter-panel {
	margin-top: 8px;
	padding: 12px;
	border-radius: 18px;
	background-color: #FFFFFF;
	border-width: 1px;
	border-color: #E1E8F2;
	border-style: solid;
}

.filter-section {
	margin-bottom: 12px;
}

.filter-label {
	margin-bottom: 6px;
	font-size: 13px;
	line-height: 20px;
	font-weight: 700;
	color: #111827;
}

.status-row {
	flex-direction: row;
	flex-wrap: wrap;
}

.status-chip {
	min-width: 68px;
	height: 34px;
	margin-right: 8px;
	margin-bottom: 8px;
	border-radius: 17px;
	background-color: #F5F7FA;
	border-width: 1px;
	border-color: #DEE6F1;
	border-style: solid;
	align-items: center;
	justify-content: center;
}

.status-chip-active {
	background-color: #111827;
	border-color: #111827;
}

.status-chip-text {
	font-size: 13px;
	line-height: 19px;
	color: #34465D;
}

.status-chip-text-active {
	font-size: 13px;
	line-height: 19px;
	color: #FFFFFF;
}

.filter-actions {
	flex-direction: row;
	margin-top: 2px;
}

.filter-reset,
.filter-apply {
	flex: 1;
	height: 42px;
	border-radius: 14px;
	align-items: center;
	justify-content: center;
}

.filter-reset {
	margin-right: 8px;
	background-color: #F5F7FA;
	border-width: 1px;
	border-color: #DEE6F1;
	border-style: solid;
}

.filter-apply {
	background-color: #111827;
}

.filter-reset-text {
	font-size: 14px;
	line-height: 20px;
	color: #53657C;
}

.filter-apply-text {
	font-size: 14px;
	line-height: 20px;
	color: #FFFFFF;
}

.content-scroll {
	flex: 1;
}

.overview-card {
	margin: 10px;
	padding: 10px 12px;
	border-radius: 16px;
	background-color: #FFFFFF;
	border-width: 1px;
	border-color: #E1E8F2;
	border-style: solid;
	flex-direction: row;
	justify-content: space-between;
}

.overview-row {
	flex-direction: row;
	align-items: center;
}

.overview-label {
	margin-right: 6px;
	font-size: 12px;
	line-height: 18px;
	color: #738197;
}

.overview-value {
	font-size: 14px;
	line-height: 20px;
	font-weight: 700;
	color: #111827;
}

.error-card,
.empty-card {
	margin: 10px;
	padding: 26px 14px;
	border-radius: 20px;
	background-color: #FFFFFF;
	border-width: 1px;
	border-style: solid;
	align-items: center;
}

.error-card {
	border-color: #FEB2B2;
}

.empty-card {
	border-color: #E1E8F2;
}

.error-title {
	font-size: 18px;
	line-height: 26px;
	font-weight: 700;
	color: #B91C1C;
}

.error-text {
	margin-top: 8px;
	font-size: 13px;
	line-height: 20px;
	color: #8A1C1C;
	text-align: center;
}

.retry-btn {
	margin-top: 14px;
	height: 38px;
	padding-left: 20px;
	padding-right: 20px;
	border-radius: 14px;
	background-color: #111827;
	align-items: center;
	justify-content: center;
}

.retry-text {
	font-size: 14px;
	line-height: 20px;
	color: #FFFFFF;
}

.empty-icon {
	width: 64px;
	height: 64px;
	border-radius: 32px;
	background-color: #EEF2F7;
	align-items: center;
	justify-content: center;
}

.empty-icon-text {
	font-size: 26px;
	line-height: 34px;
	color: #6B7C93;
}

.empty-title {
	margin-top: 16px;
	font-size: 18px;
	line-height: 26px;
	font-weight: 700;
	color: #111827;
}

.empty-text {
	margin-top: 6px;
	font-size: 13px;
	line-height: 20px;
	color: #6B7C93;
}

.loading-wrap {
	align-items: center;
	padding-top: 14px;
	padding-bottom: 88px;
}

.loading-text {
	font-size: 13px;
	line-height: 20px;
	color: #6B7C93;
}

.fab {
	position: fixed;
	right: 14px;
	bottom: 24px;
