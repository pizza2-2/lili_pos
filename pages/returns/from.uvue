	font-weight: bold;
}

.info-row {
	padding-top: 10px;
	padding-bottom: 10px;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: #EEF2F7;
}

.info-label {
	width: 96px;
}

.info-value {
	flex: 1;
	font-size: 13px;
