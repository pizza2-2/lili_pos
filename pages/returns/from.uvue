	font-size: 13px;
	line-height: 18px;
	color: #0F172A;
	font-weight: bold;
}

.page-content {
	padding: 10px;
	padding-bottom: 96px;
}

.summary-card,
.section-card,
.state-card,
.error-card {
	background-color: #FFFFFF;
	border-radius: 8px;
	border-width: 1px;
	border-style: solid;
	border-color: #E5EAF1;
	padding: 14px;
	margin-bottom: 10px;
}

.summary-head,
.amount-line,
.action-row,
.info-row {
	flex-direction: row;
	align-items: center;
}

.summary-head,
.info-row {
	justify-content: space-between;
}

.summary-main {
	flex: 1;
	padding-right: 10px;
}

.summary-title {
	font-size: 20px;
	line-height: 26px;
	font-weight: bold;
	color: #0F172A;
}

.summary-subtitle {
	font-size: 13px;
	line-height: 18px;
	color: #64748B;
	margin-top: 4px;
}

.status-pill {
	min-width: 62px;
	height: 30px;
	border-radius: 8px;
	padding-left: 10px;
	padding-right: 10px;
	align-items: center;
	justify-content: center;
}

.status-pill-ok {
	background-color: #DCFCE7;
}

.status-pill-warn {
	background-color: #FEF3C7;
}

.status-pill-error {
	background-color: #FEE2E2;
}

.status-pill-text {
	font-size: 12px;
	line-height: 12px;
	font-weight: bold;
}

.status-pill-text-ok {
	color: #166534;
}

.status-pill-text-warn {
	color: #92400E;
}

.status-pill-text-error {
	color: #991B1B;
}

.amount-line {
	margin-top: 14px;
	background-color: #F8FAFC;
	border-radius: 8px;
	padding: 12px;
	justify-content: space-between;
}

.amount-label,
.info-label,
.state-desc {
	font-size: 12px;
	line-height: 17px;
	color: #64748B;
}

.amount-value {
	font-size: 22px;
	line-height: 28px;
	font-weight: bold;
	color: #B42318;
}

.action-row {
	margin-top: 12px;
}

.action-btn {
	flex: 1;
	height: 40px;
	border-radius: 8px;
	align-items: center;
	justify-content: center;
}

.action-btn-primary {
	background-color: #0F172A;
	margin-right: 8px;
}

.action-btn-light {
	background-color: #F3F6FA;
	border-width: 1px;
	border-style: solid;
	border-color: #E2E8F0;
}

.action-btn-primary-text,
.retry-btn-text {
	font-size: 14px;
	line-height: 20px;
	color: #FFFFFF;
}

