<template>
	<view class="page">
		<lili-universal-filter title="公司信息" :showBack="true" :showSearch="false" :showHome="true" homePath="/pages/tabbar/mine" backgroundColor="#EEF2F7" />
		<!-- #ifdef APP -->
		<scroll-view style="flex:1" class="page-scroll">
		<!-- #endif -->
			<view class="page-content">
				<view v-if="loadError != ''" class="error-card">
					<text class="error-title">加载失败</text>
					<text class="error-desc">{{ loadError }}</text>
					<view class="retry-btn" @click="loadSettings"><text class="retry-btn-text">重新加载</text></view>
				</view>

				<view class="card">
					<text class="card-title">基本资料</text>
					<view class="field-row">
						<text class="field-label">公司名称</text>
						<input class="field-input" :value="companyName" placeholder="公司名称" @input="onNameInput" />
					</view>
					<view class="field-row">
						<text class="field-label">公司编码</text>
						<text class="field-static">{{ companyCode }}</text>
					</view>
					<view class="field-row">
						<text class="field-label">NIP</text>
						<input class="field-input" :value="nip" placeholder="10 位数字或带连字符格式" @input="onNipInput" />
					</view>
					<view class="field-row">
						<text class="field-label">街道地址</text>
						<input class="field-input" :value="address" placeholder="街道地址" @input="onAddressInput" />
					</view>
					<view class="field-row">
						<text class="field-label">邮编</text>
						<input class="field-input" :value="postalCode" placeholder="例如 00-001" @input="onPostalInput" />
					</view>
					<view class="field-row">
						<text class="field-label">城市</text>
						<input class="field-input" :value="city" placeholder="城市" @input="onCityInput" />
					</view>
				</view>

				<view class="card">
					<text class="card-title">KSeF / 财政部凭据</text>
					<text class="card-hint">{{ hasMinistryToken ? '已配置 Token（出于安全不回显）。输入新值保存即可覆盖。' : '尚未配置财政部 Token。' }}</text>
					<view class="field-row">
						<text class="field-label">Token</text>
						<input class="field-input" :value="ministryToken" placeholder="输入新 Token 覆盖，留空保持不变" :password="true" @input="onTokenInput" />
					</view>
				</view>

				<view class="card">
					<text class="card-title">名称翻译</text>
					<view class="field-row">
						<text class="field-label">启用翻译</text>
						<switch :checked="translationEnabled" @change="onTranslationToggle" />
					</view>
					<view class="field-row">
						<text class="field-label">服务商</text>
						<view class="backend-options">
							<view
								v-for="backend in translationBackends"
								:key="backendValue(backend)"
								:class="translationBackend == backendValue(backend) ? 'backend-chip backend-chip-active' : 'backend-chip'"
								@click="selectBackend(backendValue(backend))"
							>
								<text :class="translationBackend == backendValue(backend) ? 'backend-chip-text backend-chip-text-active' : 'backend-chip-text'">{{ backendLabel(backend) }}</text>
							</view>
						</view>
					</view>
					<text class="card-hint">{{ hasTranslationKey ? '已配置翻译 API Key（不回显）。输入新值保存即可覆盖。' : '尚未配置翻译 API Key。' }}</text>
					<view class="field-row">
						<text class="field-label">API Key</text>
						<input class="field-input" :value="translationApiKey" placeholder="输入新 Key 覆盖，留空保持不变" :password="true" @input="onTranslationKeyInput" />
					</view>
				</view>

				<view class="card">
					<text class="card-title">POS 收银配置</text>
					<view class="field-row">
						<text class="field-label">名称来源</text>
						<view class="backend-options">
							<view
								v-for="source in posNameSources"
								:key="backendValue(source)"
								:class="posNameSource == backendValue(source) ? 'backend-chip backend-chip-active' : 'backend-chip'"
								@click="selectPosNameSource(backendValue(source))"
							>
								<text :class="posNameSource == backendValue(source) ? 'backend-chip-text backend-chip-text-active' : 'backend-chip-text'">{{ backendLabel(source) }}</text>
							</view>
						</view>
					</view>
					<text class="card-hint">收银端商品名称（同步与小票）的取值来源；所选来源为空时自动回退到分类英文名、Kasa 分类英文名。保存后收银端会在下次同步时自动刷新全部名称。该配置为公司级设置，全部门店统一生效。</text>
				</view>

				<view class="card">
					<text class="card-title">分类洞察</text>
					<view class="field-row">
						<text class="field-label">无销售天数</text>
						<input class="field-input" type="number" :value="insightNoSalesDays" placeholder="1-90" @input="onInsightDaysInput" />
					</view>
					<text class="card-hint">分类连续无销售达到该天数后，才生成「无销售 / 持续无销售」洞察报告；设为 1 表示当天无销售即报。保存后从下一次洞察生成起生效。洞察设置为公司级配置，全部门店统一生效。</text>

					<!-- 灵敏度阈值：规格（文案/区间/默认值）由后端下发，前端只做单位换算 -->
					<text v-if="insightThresholdSpecs.length > 0" class="threshold-section-title">灵敏度阈值</text>
					<view v-for="(item, tIdx) in insightThresholdSpecs" :key="'threshold-' + thresholdKey(item)" class="threshold-block">
						<view class="field-row">
							<text class="field-label">{{ thresholdLabel(item) }}</text>
							<input class="field-input" type="digit" :value="thresholdInput(item)" :placeholder="thresholdRangeText(item)" @input="onThresholdInput(tIdx, $event as UniInputEvent)" />
							<text class="threshold-unit">{{ thresholdUnit(item) }}</text>
						</view>
						<view class="threshold-desc-row">
							<text class="threshold-desc">{{ thresholdDesc(item) }}</text>
							<text class="threshold-reset" @click="resetThreshold(tIdx)">默认 {{ thresholdDefaultDisplay(item) }}{{ thresholdUnit(item) }}</text>
						</view>
					</view>
					<text v-if="insightThresholdSpecs.length > 0" class="card-hint">点「默认」可恢复该项默认值；留空同样按默认处理。保存后从下一次洞察生成起生效。</text>
				</view>

				<view class="card">
					<text class="card-title">营业日历</text>
					<text class="field-label">每周闭店日</text>
					<view class="backend-options weekday-options">
						<view
							v-for="(label, index) in weekdayLabels"
							:key="'weekday-' + index.toString()"
							:class="isClosedWeekday(index) ? 'backend-chip backend-chip-active' : 'backend-chip'"
							@click="toggleClosedWeekday(index)"
						>
							<text :class="isClosedWeekday(index) ? 'backend-chip-text backend-chip-text-active' : 'backend-chip-text'">{{ label }}</text>
						</view>
					</view>
					<view class="field-row">
						<text class="field-label">假日日期</text>
						<input class="field-input" :value="holidayInput" placeholder="如 2026-12-25，可逗号分隔多个" @input="onHolidayInput" />
						<view class="holiday-add-btn" @click="addHoliday">
							<text class="holiday-add-text">添加</text>
						</view>
					</view>
					<view v-if="holidayDates.length > 0" class="holiday-list">
						<view v-for="item in holidayDates" :key="'holiday-' + item" class="holiday-chip" @click="removeHoliday(item)">
							<text class="holiday-chip-text">{{ item }} ✕</text>
						</view>
					</view>
					<text class="card-hint">闭店日（周日禁售、法定假日）销售归零属正常：系统不会产生销售类误报，也不把闭店日计入连续无销售天数和对比基线。点假日标签可移除。营业日历为公司级设置，全部门店统一生效。</text>
				</view>

				<view v-if="aiCardAvailable" class="card">
					<text class="card-title">AI 经营简报</text>
					<view class="field-row">
						<text class="field-label">启用简报</text>
						<switch :checked="aiEnabled" @change="onAiToggle" />
					</view>
					<view class="ai-context-block">
						<text class="field-label">经营背景</text>
						<textarea
							class="ai-context-input"
							:value="aiBusinessContext"
							placeholder="用一两句话介绍你的店，AI 会据此调整建议。例如：店在学校旁边，9 月开学季文具销量翻倍；周日照常营业。"
							:maxlength="2000"
							@input="onAiContextInput"
						></textarea>
					</view>
					<text class="card-hint">开启后每天早上自动生成一份 AI 经营简报，显示在工作台顶部；AI 服务由平台统一提供，无需配置 Key。</text>
				</view>

				<view class="save-btn" @click="handleSave">
					<text class="save-btn-text">保存设置</text>
				</view>
			</view>
		<!-- #ifdef APP -->
		</scroll-view>
		<!-- #endif -->
	</view>
</template>

<script setup lang="uts">
import { getCompanySettings, updateCompanySettings } from '@/pkg/api/modules/accounts'
import { getAiConfig, updateAiConfig } from '@/pkg/api/modules/ai'
import { showErrorToast } from '@/pkg/util/toast.uts'

const loadError = ref('')
const submitting = ref(false)

const companyName = ref('')
const companyCode = ref('')
const nip = ref('')
const address = ref('')
const postalCode = ref('')
const city = ref('')
const ministryToken = ref('')
const hasMinistryToken = ref(false)
const translationEnabled = ref(false)
const translationBackend = ref('')
const translationApiKey = ref('')
const hasTranslationKey = ref(false)
const translationBackends = ref<UTSJSONObject[]>([] as UTSJSONObject[])
const posNameSource = ref('category')
const posNameSources = ref<UTSJSONObject[]>([] as UTSJSONObject[])
const insightNoSalesDays = ref('1')
// 灵敏度阈值：后端下发规格数组（key/label/description/kind/min/max/default/value），
// 加载时在每项上挂 input 字段（展示单位）作为编辑值
const insightThresholdSpecs = ref<UTSJSONObject[]>([] as UTSJSONObject[])
// 营业日历：闭店星期用字符串键（'0'=周一 … '6'=周日），规避 UTS 数字装箱的集合查找陷阱
const weekdayLabels = ['周一', '周二', '周三', '周四', '周五', '周六', '周日']
const closedWeekdays = ref<string[]>([] as string[])
const holidayDates = ref<string[]>([] as string[])
const holidayInput = ref('')
// AI 简报配置：加载失败（如无 ai_config_manage 权限）时整卡隐藏
const aiCardAvailable = ref(false)
const aiEnabled = ref(false)
const aiBusinessContext = ref('')

function stringField(obj: UTSJSONObject, key: string, fallback: string = ''): string {
	const value = obj[key]
	if (value == null) return fallback
	const text = '' + value
	return text == '' ? fallback : text
}

function parseErrorMessage(error: any, fallback: string): string {
	if (error == null) return fallback
	const text = JSON.stringify(error)
	if (text == null || text == '' || text == '{}') return fallback
	try {
		const parsed = JSON.parseObject<UTSJSONObject>(text)
		if (parsed != null) {
			const message = stringField(parsed!, 'message')
			if (message != '') return message
		}
	} catch (parseError) {
		return text
	}
	return text
}

function toObjectArray(value: any | null): UTSJSONObject[] {
	if (value == null) return [] as UTSJSONObject[]
	const text = JSON.stringify(value)
	if (text == null || !text.startsWith('[')) return [] as UTSJSONObject[]
	const parsed = JSON.parseArray<UTSJSONObject>(text!)
	return parsed == null ? ([] as UTSJSONObject[]) : parsed!
}

function backendValue(backend: UTSJSONObject): string { return stringField(backend, 'value') }
function backendLabel(backend: UTSJSONObject): string { return stringField(backend, 'label') }

function onNameInput(event: UniInputEvent) { companyName.value = event.detail.value }
function onNipInput(event: UniInputEvent) { nip.value = event.detail.value }
function onAddressInput(event: UniInputEvent) { address.value = event.detail.value }
function onPostalInput(event: UniInputEvent) { postalCode.value = event.detail.value }
function onCityInput(event: UniInputEvent) { city.value = event.detail.value }
function onTokenInput(event: UniInputEvent) { ministryToken.value = event.detail.value }
function onTranslationKeyInput(event: UniInputEvent) { translationApiKey.value = event.detail.value }
function onTranslationToggle(event: UniSwitchChangeEvent) { translationEnabled.value = event.detail.value }
function selectBackend(value: string) { translationBackend.value = value }
function selectPosNameSource(value: string) { posNameSource.value = value }
function onInsightDaysInput(event: UniInputEvent) { insightNoSalesDays.value = event.detail.value }
function onHolidayInput(event: UniInputEvent) { holidayInput.value = event.detail.value }
function onAiToggle(event: UniSwitchChangeEvent) { aiEnabled.value = event.detail.value }
function onAiContextInput(event: any) {
	const inputEvent = event as UniInputEvent
	aiBusinessContext.value = inputEvent.detail.value
}

// AI 简报配置独立加载：无权限/接口失败时整卡隐藏，不影响其余设置
function loadAiConfig(): void {
	getAiConfig().then((data: UTSJSONObject) => {
		aiEnabled.value = stringField(data, 'enabled') == 'true'
		aiBusinessContext.value = stringField(data, 'business_context')
		aiCardAvailable.value = true
	}).catch((_err) => {
		aiCardAvailable.value = false
	})
}

// ── 灵敏度阈值 ──────────────────────────────────────────────────

function thresholdKey(item: UTSJSONObject): string { return stringField(item, 'key') }
function thresholdLabel(item: UTSJSONObject): string { return stringField(item, 'label') }
function thresholdDesc(item: UTSJSONObject): string { return stringField(item, 'description') }
function thresholdKind(item: UTSJSONObject): string { return stringField(item, 'kind') }
function thresholdInput(item: UTSJSONObject): string { return stringField(item, 'input') }

function thresholdUnit(item: UTSJSONObject): string {
	const kind = thresholdKind(item)
	if (kind == 'ratio') return '%'
	if (kind == 'days') return '天'
	return 'zł'
}

// 存储层比例是小数（0.50），展示层按百分比；天数/金额原样。最多留 2 位小数并去尾零
function toDisplayValue(kind: string, raw: string): string {
	const parsed = parseFloat(raw)
	if (isNaN(parsed)) return raw
	let value = parsed
	if (kind == 'ratio') {
		value = parsed * 100
	}
	let text = value.toFixed(2)
	while (text.endsWith('0')) {
		text = text.substring(0, text.length - 1)
	}
	if (text.endsWith('.')) {
		text = text.substring(0, text.length - 1)
	}
	return text
}

function thresholdDefaultDisplay(item: UTSJSONObject): string {
	return toDisplayValue(thresholdKind(item), stringField(item, 'default'))
}

function thresholdRangeText(item: UTSJSONObject): string {
	const kind = thresholdKind(item)
	return toDisplayValue(kind, stringField(item, 'min')) + '-' + toDisplayValue(kind, stringField(item, 'max'))
}

function applyThresholdSpecs(raw: any | null): void {
	const specs = toObjectArray(raw)
	for (let i = 0; i < specs.length; i += 1) {
		const spec = specs[i]
		spec['input'] = toDisplayValue(stringField(spec, 'kind'), stringField(spec, 'value'))
	}
	insightThresholdSpecs.value = specs
}

function onThresholdInput(index: number, event: UniInputEvent): void {
	const list = insightThresholdSpecs.value
	if (index < 0 || index >= list.length) return
	// 输入框自身显示用户键入内容，这里只记录值，不整组替换（避免每次键入全列表重渲染）
	list[index]['input'] = event.detail.value
}

function resetThreshold(index: number): void {
	const list = insightThresholdSpecs.value
	if (index < 0 || index >= list.length) return
	list[index]['input'] = thresholdDefaultDisplay(list[index])
	// UTSJSONObject 深层变更不触发渲染，整组替换让输入框回显默认值
	insightThresholdSpecs.value = list.slice(0)
}

// 校验并把展示单位换回存储单位；出错返回 null 并弹提示
function buildThresholdOverrides(): UTSJSONObject | null {
	const overrides = {} as UTSJSONObject
	for (let i = 0; i < insightThresholdSpecs.value.length; i += 1) {
		const spec = insightThresholdSpecs.value[i]
		const kind = thresholdKind(spec)
		const label = thresholdLabel(spec)
		const inputText = thresholdInput(spec).trim()
		if (inputText == '') {
			continue // 留空 = 该项恢复默认
		}
		const parsed = parseFloat(inputText)
		if (isNaN(parsed)) {
			uni.showToast({ title: '「' + label + '」需填写数字', icon: 'none', duration: 3500 })
			return null
		}
		if (kind == 'days' && parsed != Math.round(parsed)) {
			uni.showToast({ title: '「' + label + '」需为整数天数', icon: 'none', duration: 3500 })
			return null
		}
		let stored = parsed
		if (kind == 'ratio') {
			stored = parsed / 100
		}
		const minValue = parseFloat(stringField(spec, 'min'))
		const maxValue = parseFloat(stringField(spec, 'max'))
		if ((!isNaN(minValue) && stored < minValue) || (!isNaN(maxValue) && stored > maxValue)) {
			uni.showToast({
				title: '「' + label + '」需在 ' + thresholdRangeText(spec) + thresholdUnit(spec) + ' 之间',
				icon: 'none',
				duration: 3500,
			})
			return null
		}
		overrides[thresholdKey(spec)] = kind == 'days' ? Math.round(stored).toString() : stored.toString()
	}
	return overrides
}

function isClosedWeekday(index: number): boolean {
	return closedWeekdays.value.includes(index.toString())
}

function toggleClosedWeekday(index: number): void {
	const key = index.toString()
	const next: string[] = []
	let removed = false
	for (let i = 0; i < closedWeekdays.value.length; i += 1) {
		const item = closedWeekdays.value[i]
		if (item == key) {
			removed = true
			continue
		}
		next.push(item)
	}
	if (!removed) {
		next.push(key)
	}
	next.sort()
	closedWeekdays.value = next
}

function addHoliday(): void {
	const raw = holidayInput.value.trim()
	if (raw == '') return
	// 支持一次输入多个日期：中英文逗号、顿号、分号、空格分隔
	let normalized = raw
	const separators = ['，', '、', ';', '；', ' ', '\t', '\n']
	for (let i = 0; i < separators.length; i += 1) {
		normalized = normalized.split(separators[i]).join(',')
	}
	const parts = normalized.split(',')
	const pattern = /^\d{4}-\d{2}-\d{2}$/
	const invalid: string[] = []
	const next = holidayDates.value.slice(0)
	let added = 0
	for (let i = 0; i < parts.length; i += 1) {
		const text = parts[i].trim()
		if (text == '') continue
		if (!pattern.test(text)) {
			invalid.push(text)
			continue
		}
		if (next.includes(text)) continue
		next.push(text)
		added += 1
	}
	if (added > 0) {
		next.sort()
		holidayDates.value = next
	}
	if (invalid.length > 0) {
		// 无效片段留在输入框中供修正，有效的已入列表
		holidayInput.value = invalid.join(',')
		uni.showToast({ title: '格式应为 YYYY-MM-DD，未添加：' + invalid.join('、'), icon: 'none', duration: 3000 })
	} else {
		holidayInput.value = ''
	}
}

function removeHoliday(item: string): void {
	const next: string[] = []
	for (let i = 0; i < holidayDates.value.length; i += 1) {
		if (holidayDates.value[i] != item) {
			next.push(holidayDates.value[i])
		}
	}
	holidayDates.value = next
}

function toStringList(value: any | null): string[] {
	const result: string[] = []
	if (value == null) return result
	const text = JSON.stringify(value)
	if (text == null || !text.startsWith('[')) return result
	try {
		const parsed = JSON.parseArray<any>(text)
		if (parsed == null) return result
		for (let i = 0; i < parsed.length; i += 1) {
			const item = parsed[i]
			if (item == null) continue
			// 数字元素可能以 6.0 形式返回，parseInt 归一
			let itemText = '' + item
			if (itemText.endsWith('.0')) {
				itemText = itemText.substring(0, itemText.length - 2)
			}
			if (itemText != '') {
				result.push(itemText)
			}
		}
	} catch (_error) {
	}
	return result
}

async function loadSettings() {
	loadError.value = ''
	try {
		const data = await getCompanySettings()
		companyName.value = stringField(data, 'name')
		companyCode.value = stringField(data, 'code', '-')
		nip.value = stringField(data, 'nip')
		address.value = stringField(data, 'address')
		postalCode.value = stringField(data, 'postal_code')
		city.value = stringField(data, 'city')
		hasMinistryToken.value = stringField(data, 'has_ministry_of_finance_token') == 'true'
		translationEnabled.value = stringField(data, 'translation_enabled') == 'true'
		translationBackend.value = stringField(data, 'translation_backend')
		hasTranslationKey.value = stringField(data, 'has_translation_api_key') == 'true'
		translationBackends.value = toObjectArray(data['translation_backends'])
		posNameSource.value = stringField(data, 'pos_name_source', 'category')
		posNameSources.value = toObjectArray(data['pos_name_sources'])
		// 数字字段可能以 3.0 形式返回，parseInt 归一为整数展示
		const rawInsightDays = parseInt(stringField(data, 'insight_no_sales_days', '1'))
		insightNoSalesDays.value = isNaN(rawInsightDays) ? '1' : rawInsightDays.toString()
		closedWeekdays.value = toStringList(data['closed_weekdays'])
		holidayDates.value = toStringList(data['holiday_dates'])
		applyThresholdSpecs(data['insight_threshold_specs'])
	} catch (error) {
		loadError.value = parseErrorMessage(error, '公司设置加载失败')
	}
}

async function executeSave() {
	if (submitting.value) return
	if (companyName.value.trim() == '') {
		uni.showToast({ title: '公司名称不能为空', icon: 'none', duration: 3500 })
		return
	}
	const insightDays = parseInt(insightNoSalesDays.value.trim())
	if (isNaN(insightDays) || insightDays < 1 || insightDays > 90) {
		uni.showToast({ title: '无销售天数需为 1-90 的整数', icon: 'none', duration: 3500 })
		return
	}
	// 灵敏度阈值：整体替换提交，与默认一致的项服务端自动丢弃（下滑线须高于骤降线由服务端校验）
	const thresholdOverrides = buildThresholdOverrides()
	if (thresholdOverrides == null) {
		return
	}
	submitting.value = true
	uni.showLoading({ title: '保存中...', mask: true })
	try {
		const body = {
			name: companyName.value.trim(),
			nip: nip.value.trim(),
			address: address.value.trim(),
			postal_code: postalCode.value.trim(),
			city: city.value.trim(),
			translation_enabled: translationEnabled.value,
			translation_backend: translationBackend.value,
			pos_name_source: posNameSource.value,
			insight_no_sales_days: insightDays,
		} as UTSJSONObject
		// 营业日历：闭店星期传数字数组，假日传 ISO 日期字符串数组
		const weekdayNumbers: number[] = []
		for (let i = 0; i < closedWeekdays.value.length; i += 1) {
			const parsed = parseInt(closedWeekdays.value[i])
			if (!isNaN(parsed) && parsed >= 0 && parsed <= 6) {
				weekdayNumbers.push(parsed)
			}
		}
		body['closed_weekdays'] = weekdayNumbers
		body['holiday_dates'] = holidayDates.value
		body['insight_thresholds'] = thresholdOverrides
		// 凭据字段：留空表示保持不变，只有输入了新值才提交
		if (ministryToken.value.trim() != '') {
			body['ministry_of_finance_token'] = ministryToken.value.trim()
		}
		if (translationApiKey.value.trim() != '') {
			body['translation_api_key'] = translationApiKey.value.trim()
		}
		const data = await updateCompanySettings(body)
		hasMinistryToken.value = stringField(data, 'has_ministry_of_finance_token') == 'true'
		hasTranslationKey.value = stringField(data, 'has_translation_api_key') == 'true'
		// 用服务端归一化后的规格回填输入框（如 0.7 → 70%）
		applyThresholdSpecs(data['insight_threshold_specs'])
		ministryToken.value = ''
		translationApiKey.value = ''
		// AI 简报配置随保存按钮一并提交；失败单独提示，不影响公司设置保存结果
		if (aiCardAvailable.value) {
			try {
				await updateAiConfig(aiEnabled.value, aiBusinessContext.value.trim())
			} catch (aiError) {
				showErrorToast(parseErrorMessage(aiError, 'AI 简报配置保存失败'))
			}
		}
		uni.showToast({ title: '公司设置已保存', icon: 'success' })
	} catch (error) {
		showErrorToast(parseErrorMessage(error, '公司设置保存失败'))
	} finally {
		uni.hideLoading()
		submitting.value = false
	}
}

function handleSave() {
	executeSave()
}

onLoad(() => {
	loadSettings()
	loadAiConfig()
})
</script>

