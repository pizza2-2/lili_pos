<template>
	<view class="page">
		<lili-universal-filter
			title="商品"
			searchPlaceholder="输入商品名称、SKU、条码"
			:searchValue="keyword"
			:filterVisible="filterVisible"
			:showBack="true"
			:showSearch="true"
			:showFilter="true"
			:showScan="true"
			:showHome="false"
			homePath="/pages/tabbar/settings"
			:filterActive="hasActiveFilter"
			filterText="重置"
			@searchInput="handleSearchInput"
			@searchConfirm="handleSearchConfirm"
			@searchClear="handleSearchClear"
			@scan="handleScanSearch"
			@update:filterVisible="handleFilterVisibleChange"
			@filter-open="handleFilterOpen"
		>
			<template #filter-panel>
				<view class="product-filter-panel" :style="filterPanelStyle">
					<scroll-view scroll-y="true" class="product-filter-content-scroll" :style="filterContentScrollStyle">
						<view class="product-filter-scroll-inner">
							<view class="product-filter-select-group">
								<text class="product-filter-select-title">供应商</text>
								<view class="product-filter-select-wrap">
									<liliBottomSelect
										:value="supplierFilterValue"
										:valueText="supplierFilterText"
										title="选择供应商"
										placeholder="请选择供应商"
										searchPlaceholder="请输入供应商名称"
										emptyText="暂无供应商"
										:showAddAction="false"
										:showEditAction="false"
										:fetchData="fetchSupplierFilterOptions"
										@change="handleSupplierFilterChange"
									/>
								</view>
							</view>

							<view class="product-filter-select-group">
								<text class="product-filter-select-title">分类</text>
								<view class="product-filter-select-wrap">
								<liliBottomSelect
									:values="categoryFilterValues"
									title="选择分类"
									placeholder="请选择分类"
									searchPlaceholder="请输入分类名称"
									emptyText="暂无分类"
									:tree="true"
									:multiple="true"
									:checkStrictly="false"
									:showAddAction="false"
									:showEditAction="false"
									:fetchData="fetchCategoryFilterOptions"
									@multiChange="handleCategoryMultiChange"
									/>
								</view>
							</view>

							<view class="product-filter-select-group">
								<text class="product-filter-select-title">排序</text>
								<view class="product-filter-options">
									<view
										v-for="option in productSortOptions"
										:key="option.value"
										:class="sortOrdering == option.value ? 'product-filter-option product-filter-option-active' : 'product-filter-option'"
										@click="selectSortOption(option)"
									>
										<text :class="sortOrdering == option.value ? 'product-filter-option-text product-filter-option-text-active' : 'product-filter-option-text'">{{ option.text }}</text>
									</view>
								</view>
							</view>

							<view v-if="filterOptionsLoading" class="product-filter-state">
								<text class="product-filter-state-text">筛选选项加载中...</text>
							</view>

							<view v-else-if="filterOptionsError != ''" class="product-filter-state">
								<text class="product-filter-state-text">{{ filterOptionsError }}</text>
							</view>

							<view v-else-if="filterDefinitions.length > 0" class="product-filter-groups">
								<view
									v-for="filter in filterDefinitions"
									:key="filter.key"
									class="product-filter-group"
								>
									<text class="product-filter-group-title">{{ filter.label }}</text>
									<view class="product-filter-options">
										<view
											v-for="option in filter.options"
											:key="filter.key + '-' + option.value"
											:class="isFilterOptionSelected(filter.param, option.value) ? 'product-filter-option product-filter-option-active' : 'product-filter-option'"
											@click="toggleFilterOption(filter.param, option.value, filter.multiple)"
										>
											<text :class="isFilterOptionSelected(filter.param, option.value) ? 'product-filter-option-text product-filter-option-text-active' : 'product-filter-option-text'">{{ option.label }}</text>
										</view>
									</view>
								</view>
							</view>
						</view>
					</scroll-view>

					<view class="product-filter-actions">
						<view class="product-filter-btn product-filter-btn-light" @click="handleFilterReset">
							<text class="product-filter-btn-light-text">重置</text>
						</view>
						<view class="product-filter-btn product-filter-btn-primary" @click="applySelectedFilters">
							<text class="product-filter-btn-primary-text">应用</text>
						</view>
					</view>
				</view>
			</template>
		</lili-universal-filter>

		<!-- #ifdef APP -->
		<scroll-view style="flex:1" class="page-scroll">
		<!-- #endif -->
			<view class="page-content">
				<!-- 洞察处置闭环：从洞察跳入时显示来源横幅，处理完可就地销案 -->
				<view v-if="insightBannerId > 0" class="insight-banner">
					<view class="insight-banner-main">
						<text class="insight-banner-label">来自洞察</text>
						<text class="insight-banner-title">{{ insightBannerTitle }}</text>
					</view>
					<view class="insight-banner-btn" @click="handleInsightResolved">
						<text class="insight-banner-btn-text">标记已处理</text>
					</view>
					<view class="insight-banner-close" @click="dismissInsightBanner">
						<text class="insight-banner-close-text">✕</text>
					</view>
				</view>

				<view v-if="errorMessage != '' && !isLoading" class="error-card">
					<text class="error-title">加载失败</text>
					<text class="error-desc">{{ errorMessage }}</text>
					<view class="retry-btn" @click="loadProducts">
						<text class="retry-btn-text">重新加载</text>
					</view>
				</view>

				<lili-UniversalList
					:items="listItems"
					keyField="id"
					titleField="name"
					subtitleField="skuText"
					metaField="barcodeText"
					imageField="cover"
					imageListField="images"
					tagField="tags"
					tagPosition="cover"
					:tagColorMap="tagColorMap"
					:fields="fieldConfig"
					:loading="isLoading"
					loadingText="正在加载商品"
					:keepContentOnLoading="true"
					inlineLoadingText="商品数据刷新中..."
					:emptyText="emptyText"
					emptyIcon="◎"
					:showMenu="true"
					:menuActions="menuActions"
					:showChevron="false"
					:showPagination="true"
					:currentPage="currentPage"
					:totalPages="totalPages"
					:totalCount="totalCount"
					:selectionMode="selectionMode"
					:selectedItems="selectedProductIds"
					:batchActions="batchToolbarActions"
					:batchInfoText="batchInfoText"
					summaryTitle="商品概览"
					:summaryItems="summaryItems"
					:summaryCollapsedByDefault="true"
					:showFloatingAdd="true"
					floatingAddText="新增商品"
					@update:selectionMode="handleSelectionModeChange"
					@update:selectedItems="handleSelectedProductIdsChange"
					@selection-exit="handleSelectionExit"
					@batch-action="handleBatchToolbarAction"
					@item-click="handleItemClick"
					@subtitle-click="handleSubtitleClick"
					@meta-click="handleMetaClick"
					@field-click="handleFieldClick"
					@menu="handleMenu"
					@page-change="handlePageChange"
					@floating-add="handleFloatingAdd"
				/>
			</view>
		<!-- #ifdef APP -->
		</scroll-view>
		<!-- #endif -->

		<page-container
			:show="batchEditorVisible"
			position="bottom"
			:round="true"
			:overlay="true"
			:duration="240"
			overlay-style="background-color: rgba(15, 23, 42, 0.42);"
			custom-style="background-color: #FFFFFF;"
			@clickoverlay="closeBatchEditor"
		>
			<view class="batch-panel">
				<view class="batch-handle"></view>
				<view class="batch-head">
					<view>
						<text class="batch-title">{{ batchEditorTitle }}</text>
						<text class="batch-subtitle">{{ batchEditorSubtitle }}</text>
					</view>
					<view class="batch-close" @click="closeBatchEditor">
						<text class="batch-close-text">关闭</text>
					</view>
				</view>

				<view v-if="batchEditorType == 'update-category'" class="batch-field">
					<text class="batch-label">目标分类</text>
					<liliBottomSelect
						:value="batchCategoryValue"
						:valueText="batchCategoryText"
						title="批量修改分类"
						placeholder="请选择分类"
						searchPlaceholder="请输入分类名称"
						emptyText="暂无分类"
						:tree="true"
						:checkStrictly="false"
						:showAddAction="false"
						:showEditAction="false"
						:selectableLeafOnly="true"
						selectableLeafOnlyMessage="只能选择叶子分类"
						:fetchData="fetchCategoryFilterOptions"
						@change="handleBatchCategoryChange"
					/>
				</view>

				<view v-else-if="batchEditorType == 'update-supplier'" class="batch-field">
					<text class="batch-label">目标供应商</text>
					<liliBottomSelect
						:value="batchSupplierValue"
						:valueText="batchSupplierText"
						title="批量修改供应商"
						placeholder="请选择供应商"
						searchPlaceholder="请输入供应商名称"
						emptyText="暂无供应商"
						:showAddAction="false"
						:showEditAction="false"
						:fetchData="fetchSupplierFilterOptions"
						@change="handleBatchSupplierChange"
					/>
				</view>

				<view v-else-if="batchEditorType == 'update-status'" class="batch-field">
					<text class="batch-label">目标状态</text>
					<view class="batch-status-options">
						<view
							v-for="option in productStatusOptions"
							:key="option.value"
							:class="isBatchStatusSelected(option) ? 'batch-status-option batch-status-option-active' : 'batch-status-option'"
							@click="selectBatchStatus(option)"
						>
							<text :class="isBatchStatusSelected(option) ? 'batch-status-option-text batch-status-option-text-active' : 'batch-status-option-text'">{{ option.text }}</text>
						</view>
					</view>
				</view>

				<view class="batch-actions">
					<view class="batch-secondary-btn" @click="closeBatchEditor">
						<text class="batch-secondary-text">取消</text>
					</view>
					<view class="batch-primary-btn" @click="confirmBatchEditor">
						<text class="batch-primary-text">{{ batchSubmitting ? '处理中...' : '确认修改' }}</text>
					</view>
				</view>
			</view>
		</page-container>
	</view>
</template>

<script setup lang="uts">
import { computed } from 'vue'
import { getListPageSize } from '@/pkg/util/settings.uts'
import liliBottomSelect from '@/uni_modules/lili_bottom-select/components/lili_bottom-select/lili_bottom-select.uvue'
import { request, takeLatestResponseMessage } from '@/pkg/api/index.uts'
import { batchAutoClassifyProductCategory, batchDeleteProducts, batchUpdateProductCategory, batchUpdateProductStatus, batchUpdateProductSupplier, getProductFilterOptions, getProductList, ProductBatchActionResponse, ProductFilterDefinition, ProductFilterOptionsResponse, ProductItem, ProductListResponse, ProductMediaFile, ProductSelectedFilter } from '@/pkg/api/modules/products.uts'
// #ifdef APP-ANDROID
import { scanCode, type GeneralCallbackResult, type ScanCodeOption, type ScanCodeSuccessCallbackResult } from '@/uni_modules/lime-scan'
// #endif
// #ifdef APP-ANDROID
import { startVolumeKeyListener, stopVolumeKeyListener, VolumeKeyEvent } from '@/uni_modules/lili-key'
// #endif
import { showErrorToast } from '@/pkg/util/toast.uts'
import { updateCategoryInsightStatus } from '@/pkg/api/modules/category'

type ProductSelectOption = {
	value: string
	text: string
}

type ProductStatusOption = {
	value: string
	text: string
}

type ProductSortOption = {
	value: string
	text: string
}

const keyword = ref('')
const filterVisible = ref(false)
const isLoading = ref(false)
const errorMessage = ref('')
const products = ref<ProductItem[]>([])
const currentPage = ref(1)
const totalPages = ref(1)
const totalCount = ref(0)
const pageSize = ref(getListPageSize())
const filterOptionsLoading = ref(false)
const filterOptionsError = ref('')
const filterOptions = ref<ProductFilterOptionsResponse | null>(null)
const selectedFilters = ref<ProductSelectedFilter[]>([])
// 商品状态默认筛选：只看草稿+启用，停用/停产在筛选面板中按需勾选
const defaultStatusFilterValue = 'DRAFT,ACTIVE'
const supplierFilterValue = ref('')
const supplierFilterText = ref('')
const categoryFilterValues = ref<string[]>([])
const sortOrdering = ref('-updated_at')
const filterPanelHeight = ref(456)
const filterContentHeight = ref(392)
const volumeScanLocked = ref(false)
const selectionMode = ref(false)
const selectedProductIds = ref<string[]>([])
const batchSubmitting = ref(false)
const batchEditorVisible = ref(false)
const batchEditorType = ref('')
const batchCategoryValue = ref('')
const batchCategoryText = ref('')
const batchSupplierValue = ref('')
const batchSupplierText = ref('')
const batchStatusValue = ref('')
const batchStatusText = ref('')

const fieldConfig = ref<UTSJSONObject[]>([
	{ key: 'supplierText', label: '供应商：', hideWhenEmpty: true } as UTSJSONObject,
	{ key: 'stockQuantityText', label: '库存数量：' } as UTSJSONObject,
	{ key: 'purchasePriceText', label: '含税进价：', hideWhenEmpty: true } as UTSJSONObject,
	{ key: 'salesPriceText', label: '售价：' } as UTSJSONObject,
	{ key: 'salesCountText', label: '销量：' } as UTSJSONObject,
	{ key: 'variantCountText', label: '规格：', hideWhenEmpty: true } as UTSJSONObject,
])

const menuActions = ref<UTSJSONObject[]>([
	{ key: 'detail', text: '详情' } as UTSJSONObject,
	{ key: 'variants', text: '规格变体' } as UTSJSONObject,
	{ key: 'copy-product', text: '复制商品' } as UTSJSONObject,
	{ key: 'inventory', text: '查看库存' } as UTSJSONObject,
	{ key: 'reload', text: '刷新' } as UTSJSONObject,
])

const batchToolbarActions = ref<UTSJSONObject[]>([
	{ key: 'delete', text: '删除' } as UTSJSONObject,
	{ key: 'update-category', text: '改分类' } as UTSJSONObject,
	{ key: 'auto-classify', text: '智能归类' } as UTSJSONObject,
	{ key: 'update-supplier', text: '改供应商' } as UTSJSONObject,
	{ key: 'update-status', text: '改状态' } as UTSJSONObject,
])

const productStatusOptions = ref<ProductStatusOption[]>([
	{ value: 'DRAFT', text: '草稿' } as ProductStatusOption,
	{ value: 'ACTIVE', text: '启用' } as ProductStatusOption,
	{ value: 'INACTIVE', text: '停用' } as ProductStatusOption,
	{ value: 'DISCONTINUED', text: '停产' } as ProductStatusOption,
])

const productSortOptions = ref<ProductSortOption[]>([
	{ value: '-updated_at', text: '最近更新' } as ProductSortOption,
	{ value: '-created_at', text: '最新创建' } as ProductSortOption,
	{ value: 'sort_order', text: '手动排序' } as ProductSortOption,
	{ value: 'name_cn', text: '名称正序' } as ProductSortOption,
	{ value: '-total_stock_quantity', text: '库存最多' } as ProductSortOption,
	{ value: '-total_sales_quantity', text: '销量最高' } as ProductSortOption,
	{ value: 'base_sales_price', text: '售价最低' } as ProductSortOption,
	{ value: '-base_sales_price', text: '售价最高' } as ProductSortOption,
])

const tagColorMap = ref<UTSJSONObject>({
	新品: 'violet',
	精选: 'info',
	热销: 'warning',
	草稿: 'info',
	启用: 'success',
	停用: 'danger',
	停产: 'warning',
})

const productListRefreshStorageKey = 'refresh:pages:products:index'

function applyProductResponse(response: ProductListResponse) {
	products.value = response.results
	currentPage.value = response.current_page
	totalPages.value = response.total_pages
	totalCount.value = response.total_count
	pageSize.value = response.page_size
}

function closeFilterDrawer() {
	filterVisible.value = false
}

function handleFilterVisibleChange(value: boolean) {
	filterVisible.value = value
}

function parseErrorMessage(error: any): string {
	let message = '商品列表加载失败'
	if (error != null) {
		const errorText = JSON.stringify(error)
		if (errorText != null && errorText != '') {
			const parsedError = JSON.parseObject<UTSJSONObject>(errorText)
			if (parsedError != null) {
				const rawMessage = parsedError['message']
				if (rawMessage != null) {
					const parsedMessage = rawMessage as string
					if (parsedMessage != '') {
						message = parsedMessage
					}
				}
			}
			if (message == '商品列表加载失败') {
				message = errorText
			}
		}
	}
	return message
}

function numberValue(value: any | null): number {
	if (value == null) {
		return 0
	}
	const parsed = parseInt('' + value)
	if (isNaN(parsed)) {
		return 0
	}
	return parsed
}

function selectedCountText(): string {
	return selectedProductIds.value.length.toString()
}

function clearSelectionState() {
	selectionMode.value = false
	selectedProductIds.value = [] as string[]
}

function handleSelectionModeChange(value: boolean) {
	selectionMode.value = value
	if (!value) {
		selectedProductIds.value = [] as string[]
	}
}

function handleSelectedProductIdsChange(value: string[]) {
	const nextIds: string[] = []
	for (let index = 0; index < value.length; index += 1) {
		nextIds.push(value[index])
	}
	selectedProductIds.value = nextIds
}

function handleSelectionExit(payload: UTSJSONObject) {
	clearSelectionState()
}

function selectedProductIdsSnapshot(): string[] {
	const result: string[] = []
	for (let index = 0; index < selectedProductIds.value.length; index += 1) {
		result.push(selectedProductIds.value[index])
	}
	return result
}

function ensureBatchSelection(): boolean {
	if (selectedProductIds.value.length > 0) {
		return true
	}
	uni.showToast({
		title: '请先选择商品',
		icon: 'none', duration: 3500,
	})
	return false
}

function resetBatchDraft() {
	batchCategoryValue.value = ''
	batchCategoryText.value = ''
	batchSupplierValue.value = ''
	batchSupplierText.value = ''
	batchStatusValue.value = ''
	batchStatusText.value = ''
}

function updateFilterPanelLayout() {
	const info = uni.getWindowInfo()
	let nextPanelHeight = info.windowHeight - 168
	if (nextPanelHeight > 456) {
		nextPanelHeight = 456
	}
	if (nextPanelHeight < 336) {
		nextPanelHeight = 336
	}

	let nextContentHeight = nextPanelHeight - 64
	if (nextContentHeight < 250) {
		nextContentHeight = 250
	}

	filterPanelHeight.value = nextPanelHeight
	filterContentHeight.value = nextContentHeight
}

// 加载请求序号：并发时只应用最新一次请求的结果，新请求不再被在途请求拦截（避免扫码/搜索被静默丢弃）
let productsRequestSeq = 0

async function loadProducts() {
	productsRequestSeq += 1
	const requestSeq = productsRequestSeq
	isLoading.value = true
	errorMessage.value = ''

	try {
		const response = await getProductList({
			search: keyword.value == '' ? null : keyword.value,
			page: currentPage.value,
			page_size: pageSize.value,
			ordering: sortOrdering.value,
			filters: selectedFilters.value,
		})
		if (requestSeq != productsRequestSeq) {
			return
		}
		applyProductResponse(response)
	} catch (error) {
		if (requestSeq != productsRequestSeq) {
			return
		}
		products.value = []
		currentPage.value = 1
		totalPages.value = 1
		totalCount.value = 0
		errorMessage.value = parseErrorMessage(error)
	} finally {
		if (requestSeq == productsRequestSeq) {
			isLoading.value = false
		}
	}
}

function stringValue(value: any | null, fallback: string = ''): string {
	if (value == null) {
		return fallback
	}
	const text = '' + value
	if (text == '') {
		return fallback
	}
	return text
}

function booleanValue(value: any | null): boolean {
	if (value == null) {
		return false
	}
	const text = ('' + value).toLowerCase()
	return text == 'true' || text == '1' || text == 'yes'
}

function parseObject(value: any | null): UTSJSONObject | null {
	if (value == null) {
		return null
	}

	const text = JSON.stringify(value)
	if (text == null || text == '') {
		return null
	}

	return JSON.parseObject<UTSJSONObject>(text)
}

function parseObjectArray(value: any | null): UTSJSONObject[] {
	if (value == null) {
		return []
	}

	const text = JSON.stringify(value)
	if (text == null || text == '') {
		return []
	}

	const parsed = JSON.parseArray<UTSJSONObject>(text)
	if (parsed == null) {
		return []
	}

	return parsed!
}

function getDisplayText(value: string | null, fallback: string = '-'): string {
	if (value == null || value == '') {
		return fallback
	}
	return value
}

function productThumbnailUrl(mediaFile: ProductMediaFile): string {
	if (mediaFile.signed_thumbnail_url != '') {
		return mediaFile.signed_thumbnail_url
	}
	if (mediaFile.thumbnail_url != '') {
		return mediaFile.thumbnail_url
	}
	if (mediaFile.signed_url != '') {
		return mediaFile.signed_url
	}
	return mediaFile.file_url
}

function productFullUrl(mediaFile: ProductMediaFile): string {
	if (mediaFile.signed_url != '') {
		return mediaFile.signed_url
	}
	if (mediaFile.file_url != '') {
		return mediaFile.file_url
	}
	return productThumbnailUrl(mediaFile)
}

function buildImages(item: ProductItem): string[] {
	const result: string[] = []
	for (let index = 0; index < item.media_files.length; index += 1) {
		const mediaFile = item.media_files[index]
		const imageUrl = productThumbnailUrl(mediaFile)
		if (imageUrl != '') {
			result.push(imageUrl)
		}
	}
	return result
}

function buildPreviewImages(item: ProductItem): string[] {
	const result: string[] = []
	for (let index = 0; index < item.media_files.length; index += 1) {
		const imageUrl = productFullUrl(item.media_files[index])
		if (imageUrl != '') {
			result.push(imageUrl)
		}
	}
	return result
}

function buildMediaIds(item: ProductItem): string[] {
	const result: string[] = []
	for (let index = 0; index < item.media_files.length; index += 1) {
		const mediaId = item.media_files[index].id
		if (mediaId != '') {
			result.push(mediaId)
		}
	}
	return result
}

function setSelectedFilterValue(param: string, value: string) {
	const nextFilters: ProductSelectedFilter[] = []
	let updated = false
	for (let index = 0; index < selectedFilters.value.length; index += 1) {
		const filter = selectedFilters.value[index]
		if (filter.param == param) {
			if (value != '') {
				nextFilters.push({
					param: param,
					value: value,
				} as ProductSelectedFilter)
			}
			updated = true
			continue
		}
		nextFilters.push(filter)
	}

	if (!updated && value != '') {
		nextFilters.push({
			param: param,
			value: value,
		} as ProductSelectedFilter)
	}

	selectedFilters.value = nextFilters
}

function splitSelectedValues(value: string): string[] {
	if (value == '') {
		return []
	}

	const parts = value.split(',')
	const result: string[] = []
	for (let index = 0; index < parts.length; index += 1) {
		const text = parts[index].trim()
		if (text != '') {
			result.push(text)
		}
	}
	return result
}

function extractOptionObjects(value: any | null): UTSJSONObject[] {
	const rawObject = parseObject(value)
	if (rawObject != null) {
		let items = parseObjectArray(rawObject['items'])
		if (items.length > 0) {
			return items
		}

		items = parseObjectArray(rawObject['results'])
		if (items.length > 0) {
			return items
		}

		items = parseObjectArray(rawObject['data'])
		if (items.length > 0) {
			return items
		}

		items = parseObjectArray(rawObject['options'])
		if (items.length > 0) {
			return items
		}

		const groups = parseObjectArray(rawObject['groups'])
		for (let groupIndex = 0; groupIndex < groups.length; groupIndex += 1) {
			const groupItems = parseObjectArray(groups[groupIndex]['items'])
			if (groupItems.length > 0) {
				return groupItems
			}
		}

		const optionsObject = parseObject(rawObject['options'])
		if (optionsObject != null) {
			for (const key in optionsObject) {
				const optionItems = parseObjectArray(optionsObject[key])
				if (optionItems.length > 0) {
					return optionItems
				}
			}
		}
	}

	return parseObjectArray(value)
}

function extractCategoryTreeSource(value: any | null): UTSJSONObject[] {
	const rawObject = parseObject(value)
	if (rawObject == null) {
		return []
	}

	const groups = parseObjectArray(rawObject['groups'])
	for (let index = 0; index < groups.length; index += 1) {
		const group = groups[index]
		if (stringValue(group['key']) == 'parent') {
			return parseObjectArray(group['items'])
		}
	}

	if (groups.length > 0) {
		return parseObjectArray(groups[0]['items'])
	}

	return parseObjectArray(rawObject['items'])
}

function buildOptionValue(item: UTSJSONObject): string {
	const directValue = stringValue(item['value'])
	if (directValue != '') {
		return directValue
	}

	const idValue = stringValue(item['id'])
	if (idValue != '') {
		return idValue
	}

	const codeValue = stringValue(item['code'])
	if (codeValue != '') {
		return codeValue
	}

	return stringValue(item['key'])
}

function buildOptionText(item: UTSJSONObject): string {
	const textValue = stringValue(item['text'])
	if (textValue != '') {
		return textValue
	}

	const labelValue = stringValue(item['label'])
	if (labelValue != '') {
		return labelValue
	}

	const fullNameValue = stringValue(item['full_name'])
	if (fullNameValue != '') {
		return fullNameValue
	}

	const nameValue = stringValue(item['name'])
	if (nameValue != '') {
		return nameValue
	}

	const nameCn = stringValue(item['name_cn'])
	if (nameCn != '') {
		return nameCn
	}

	const titleValue = stringValue(item['title'])
	if (titleValue != '') {
		return titleValue
	}

	return buildOptionValue(item)
}

function buildSelectOptions(value: any | null): ProductSelectOption[] {
	const source = extractOptionObjects(value)
	const result: ProductSelectOption[] = []
	for (let index = 0; index < source.length; index += 1) {
		const item = source[index]
		const optionValue = buildOptionValue(item)
		const optionText = buildOptionText(item)
		if (optionValue == '' && optionText == '') {
			continue
		}
		result.push({
			value: optionValue,
			text: optionText == '' ? optionValue : optionText,
		} as ProductSelectOption)
	}
	return result
}

function buildBottomSelectResponse(source: ProductSelectOption[], params: UTSJSONObject): UTSJSONObject {
	const idValue = stringValue(params['id'])
	const result: UTSJSONObject[] = []

	for (let index = 0; index < source.length; index += 1) {
		const option = source[index]
		if (idValue != '' && option.value != idValue) {
			continue
		}

		result.push({
			value: option.value,
			text: option.text,
		} as UTSJSONObject)
	}

	return {
		data: result,
		total: result.length,
	} as UTSJSONObject
}

function buildTreeSelectItem(item: UTSJSONObject): UTSJSONObject {
	const rawChildren = parseObjectArray(item['children'])
	const children: UTSJSONObject[] = []
	for (let index = 0; index < rawChildren.length; index += 1) {
		children.push(buildTreeSelectItem(rawChildren[index]))
	}

	const label = stringValue(item['label'], buildOptionText(item))
	const fullName = stringValue(item['full_name'])
	const hasChildren = booleanValue(item['has_children']) || children.length > 0
	let isLeaf = !hasChildren
	if (item['is_leaf'] != null) {
		isLeaf = booleanValue(item['is_leaf'])
	}
	let canSelectProduct = isLeaf
	if (item['can_select_product'] != null) {
		canSelectProduct = booleanValue(item['can_select_product'])
	}

	return {
		value: buildOptionValue(item),
		text: label,
		label: label,
		full_name: fullName == '' ? label : fullName,
		code: stringValue(item['code']),
		level: stringValue(item['level']),
		parent_value: stringValue(item['parent_value']),
		disabled: booleanValue(item['disabled']),
		has_children: hasChildren,
		is_leaf: isLeaf,
		can_add_child: booleanValue(item['can_add_child']),
		can_select_product: canSelectProduct,
		children: children,
	} as UTSJSONObject
}

function buildCategoryTreeResponse(raw: any): UTSJSONObject {
	let source = extractCategoryTreeSource(raw)

	// 懒加载子节点时，API 返回扁平格式而非 groups 分组结构
	if (source.length == 0) {
		const rawObject = parseObject(raw)
		if (rawObject != null) {
			let items = parseObjectArray(rawObject['items'])
			if (items.length == 0) {
				items = parseObjectArray(rawObject['results'])
			}
			if (items.length == 0) {
				items = parseObjectArray(rawObject['data'])
			}
			source = items
		}
	}

	const result: UTSJSONObject[] = []
	for (let index = 0; index < source.length; index += 1) {
		result.push(buildTreeSelectItem(source[index]))
	}

	return {
		data: result,
		total: result.length,
	} as UTSJSONObject
}

async function fetchSupplierFilterOptions(params: UTSJSONObject): Promise<UTSJSONObject> {
	const keywordValue = stringValue(params['keyword'])
	const query: UTSJSONObject = {
		key: 'supplier',
		limit: 50,
	} as UTSJSONObject
	if (keywordValue != '') {
		query['search'] = keywordValue
		query['keyword'] = keywordValue
	}
	const raw = await request(
		'/api/procurement/suppliers/options/',
		'GET',
		query,
		true
	)
	return buildBottomSelectResponse(buildSelectOptions(raw), { keyword: '', id: stringValue(params['id']) } as UTSJSONObject)
}

async function fetchCategoryFilterOptions(params: UTSJSONObject): Promise<UTSJSONObject> {
	const keywordValue = stringValue(params['keyword'])
	const pageValue = stringValue(params['page'], '1')
	const parentValue = stringValue(params['parent'])
	const pageSizeValue = stringValue(params['pageSize'], '20')

	const queryParams: UTSJSONObject = {
		key: 'parent',
		page: parseInt(pageValue == '' ? '1' : pageValue),
		page_size: parseInt(pageSizeValue),
	} as UTSJSONObject

	if (keywordValue != '') {
		queryParams['search'] = keywordValue
	}
	if (parentValue != '') {
		queryParams['parent'] = parentValue
	}

	const raw = await request(
		'/api/categories/categories/options/',
		'GET',
		queryParams,
		true
	)
	return buildCategoryTreeResponse(raw)
}

function batchActionTitle(actionKey: string): string {
	if (actionKey == 'delete') return '批量删除'
	if (actionKey == 'update-category') return '批量修改分类'
	if (actionKey == 'auto-classify') return '智能归类'
	if (actionKey == 'update-supplier') return '批量修改供应商'
	if (actionKey == 'update-status') return '批量修改状态'
	return '批量操作'
}

function batchActionConfirmText(actionKey: string, count: number): string {
	if (actionKey == 'delete') return '确定删除选中的 ' + count.toString() + ' 个商品吗？'
	if (actionKey == 'update-category') return '确定将选中的 ' + count.toString() + ' 个商品修改到该分类吗？'
	if (actionKey == 'auto-classify') return '将按名称/供应商/条码为选中的 ' + count.toString() + ' 个商品推荐并移动分类，无可靠推荐的商品会跳过。确定执行吗？'
	if (actionKey == 'update-supplier') return '确定将选中的 ' + count.toString() + ' 个商品修改到该供应商吗？'
	if (actionKey == 'update-status') return '确定将选中的 ' + count.toString() + ' 个商品修改为该状态吗？'
	return '确定执行批量操作吗？'
}

function batchResultMessage(response: ProductBatchActionResponse, fallback: string): string {
	let message = takeLatestResponseMessage(fallback)
	if (message == '') {
		message = fallback
	}
	const summaryObject = parseObject(response.data['summary'])
	if (summaryObject == null) {
		return message
	}

	const successCount = numberValue(summaryObject['success_count'])
	const failureCount = numberValue(summaryObject['failure_count'])
	const skippedCount = numberValue(summaryObject['skipped_count'])
	if (failureCount > 0) {
		return '成功' + successCount.toString() + '，失败' + failureCount.toString()
	}
	if (skippedCount > 0) {
		return '成功' + successCount.toString() + '，跳过' + skippedCount.toString()
	}
	return message
}

function batchResultHasIssue(response: ProductBatchActionResponse): boolean {
	const summaryObject = parseObject(response.data['summary'])
	if (summaryObject == null) {
		return false
	}
	return numberValue(summaryObject['failure_count']) > 0 || numberValue(summaryObject['skipped_count']) > 0
}

// 智能归类分片提交：避免单次处理过多商品触发请求超时
async function runAutoClassifyChunks(ids: string[]): Promise<void> {
	let successCount = 0
	let failureCount = 0
	let skippedCount = 0
	const chunkSize = 10
	for (let start = 0; start < ids.length; start += chunkSize) {
		const chunk: string[] = []
		for (let index = start; index < ids.length && index < start + chunkSize; index += 1) {
			chunk.push(ids[index])
		}
		try {
			const response = await batchAutoClassifyProductCategory(chunk, 'auto', 10)
			const summaryObject = parseObject(response.data['summary'])
			if (summaryObject != null) {
				successCount += numberValue(summaryObject['success_count'])
				failureCount += numberValue(summaryObject['failure_count'])
				skippedCount += numberValue(summaryObject['skipped_count'])
			}
		} catch (error) {
			failureCount += chunk.length
		}
	}
	let message = '归类成功 ' + successCount.toString()
	if (failureCount > 0) {
		message = message + '，失败 ' + failureCount.toString()
	}
	if (skippedCount > 0) {
		message = message + '，无推荐 ' + skippedCount.toString()
	}
	uni.showToast({ title: message, icon: 'none', duration: 3500 })
}

async function executeProductBatchAction(actionKey: string) {
	if (batchSubmitting.value || !ensureBatchSelection()) {
		return
	}

	const ids = selectedProductIdsSnapshot()
	batchSubmitting.value = true
	try {
		if (actionKey == 'auto-classify') {
			await runAutoClassifyChunks(ids)
			batchEditorVisible.value = false
			batchEditorType.value = ''
			resetBatchDraft()
			clearSelectionState()
			loadProducts()
			return
		}
		let response: ProductBatchActionResponse | null = null
		if (actionKey == 'delete') {
			response = await batchDeleteProducts(ids)
		} else if (actionKey == 'update-category') {
			response = await batchUpdateProductCategory(ids, batchCategoryValue.value)
		} else if (actionKey == 'update-supplier') {
			response = await batchUpdateProductSupplier(ids, batchSupplierValue.value)
		} else if (actionKey == 'update-status') {
			response = await batchUpdateProductStatus(ids, batchStatusValue.value)
		} else {
			uni.showToast({ title: '暂不支持该操作', icon: 'none', duration: 3500 })
			return
		}

		const fallbackMessage = batchActionTitle(actionKey) + '成功'
		let resultMessage = fallbackMessage
		let resultIcon = 'success'
		if (response != null) {
			const batchResponse = response as ProductBatchActionResponse
			resultMessage = batchResultMessage(batchResponse, fallbackMessage)
			if (batchResultHasIssue(batchResponse)) {
				resultIcon = 'none'
			}
		}
		uni.showToast({
			title: resultMessage,
			icon: resultIcon,
		})
		batchEditorVisible.value = false
		batchEditorType.value = ''
		resetBatchDraft()
		clearSelectionState()
		loadProducts()
	} catch (error) {
		showErrorToast(parseErrorMessage(error))
	} finally {
		batchSubmitting.value = false
	}
}

function confirmProductBatchAction(actionKey: string) {
	if (!ensureBatchSelection()) {
		return
	}
	const count = selectedProductIds.value.length
	uni.showModal({
		title: batchActionTitle(actionKey),
		content: batchActionConfirmText(actionKey, count),
		success: (res) => {
			if (!res.confirm) {
				return
			}
			executeProductBatchAction(actionKey)
		},
	})
}

function openBatchEditor(actionKey: string) {
	if (!ensureBatchSelection()) {
		return
	}
	resetBatchDraft()
	batchEditorType.value = actionKey
	batchEditorVisible.value = true
}

function closeBatchEditor() {
	if (batchSubmitting.value) {
		return
	}
	batchEditorVisible.value = false
	batchEditorType.value = ''
	resetBatchDraft()
}

function handleBatchCategoryChange(payload: UTSJSONObject) {
	batchCategoryValue.value = stringValue(payload['value'])
	batchCategoryText.value = stringValue(payload['text'])
}

function handleBatchSupplierChange(payload: UTSJSONObject) {
	batchSupplierValue.value = stringValue(payload['value'])
	batchSupplierText.value = stringValue(payload['text'])
}

function selectBatchStatus(option: ProductStatusOption) {
	batchStatusValue.value = option.value
	batchStatusText.value = option.text
}

function isBatchStatusSelected(option: ProductStatusOption): boolean {
	return batchStatusValue.value == option.value
}

function validateBatchEditor(): boolean {
	if (batchEditorType.value == 'update-category' && batchCategoryValue.value == '') {
		uni.showToast({ title: '请选择分类', icon: 'none', duration: 3500 })
		return false
	}
	if (batchEditorType.value == 'update-supplier' && batchSupplierValue.value == '') {
		uni.showToast({ title: '请选择供应商', icon: 'none', duration: 3500 })
		return false
	}
	if (batchEditorType.value == 'update-status' && batchStatusValue.value == '') {
		uni.showToast({ title: '请选择状态', icon: 'none', duration: 3500 })
		return false
	}
	return true
}

function confirmBatchEditor() {
	if (batchEditorType.value == '' || !validateBatchEditor()) {
		return
	}
	confirmProductBatchAction(batchEditorType.value)
}

function handleBatchToolbarAction(payload: UTSJSONObject) {
	const actionValue = payload['action']
	if (actionValue == null) {
		return
	}
	const action = actionValue as UTSJSONObject
	const actionKey = stringValue(action['key'])
	if (actionKey == 'delete' || actionKey == 'auto-classify') {
		// 无需取值编辑器的动作：确认后直接执行
		confirmProductBatchAction(actionKey)
		return
	}
	if (actionKey == 'update-category' || actionKey == 'update-supplier' || actionKey == 'update-status') {
		openBatchEditor(actionKey)
	}
}

function productStatusTagText(status: string): string {
	if (status == 'ACTIVE') return '启用'
	if (status == 'INACTIVE') return '停用'
	if (status == 'DISCONTINUED') return '停产'
	return '草稿'
}

function buildProductTags(item: ProductItem): string[] {
	const result: string[] = []
	// 状态徽标放首位：草稿(蓝)/启用(绿)/停用(红)/停产(橙)
	result.push(productStatusTagText(item.status))
	if (item.is_new) {
		result.push('新品')
	}
	if (item.is_featured) {
		result.push('精选')
	}
	if (item.is_bestseller) {
		result.push('热销')
	}
	return result
}

function productDisplayName(item: ProductItem): string {
	const chineseName = getDisplayText(item.name_cn, '')
	if (chineseName != '') {
		return chineseName
	}
	const englishName = getDisplayText(item.name_en, '')
	if (englishName != '') {
		return englishName
	}
	const otherName = getDisplayText(item.name_other, '')
	if (otherName != '') {
		return otherName
	}
	return item.sku == '' ? ('商品 #' + item.id.toString()) : item.sku
}

function productToListItem(item: ProductItem): UTSJSONObject {
	const images = buildImages(item)
	const previewImages = buildPreviewImages(item)
	return {
		id: item.id.toString(),
		name: productDisplayName(item),
		name_en: getDisplayText(item.name_en),
		name_other: getDisplayText(item.name_other),
		sku: getDisplayText(item.sku),
		skuText: 'SKU：' + getDisplayText(item.sku),
		barcode: getDisplayText(item.barcode),
		barcodeText: '条码：' + getDisplayText(item.barcode),
		foreignNameText: getDisplayText(item.name_en),
		otherNameText: getDisplayText(item.name_other),
		supplierText: item.supplier_name,
		stockQuantityText: item.total_stock_quantity.toString(),
		purchasePriceText: item.purchase_price,
		netPurchasePriceText: item.net_purchase_price,
		costPriceText: item.cost_price,
		salesPriceText: getDisplayText(item.base_sales_price),
		salesCountText: item.total_sales_quantity.toString(),
		// 无变体时为空串，配合 hideWhenEmpty 隐藏该行
		variantCountText: item.variant_count > 0 ? item.variant_count.toString() + ' 个' : '',
		baseSalesPrice: getDisplayText(item.base_sales_price, ''),
		updatedText: getDisplayText(item.updated_at),
		cover: images.length > 0 ? images[0] : '',
		images: images,
		previewCover: previewImages.length > 0 ? previewImages[0] : '',
		previewImages: previewImages,
		mediaIds: buildMediaIds(item),
		tags: buildProductTags(item),
		rawId: item.id.toString(),
	} as UTSJSONObject
}

function copyText(text: string, successTitle: string, emptyTitle: string) {
	if (text == '' || text == '-') {
		uni.showToast({
			title: emptyTitle,
			icon: 'none', duration: 3500,
		})
		return
	}

	uni.setClipboardData({
		data: text,
		success: () => {
			uni.showToast({
				title: successTitle,
				icon: 'success',
			})
		},
	})
}

function handleSearchInput(value: string) {
	keyword.value = value
}

function handleSearchConfirm(value: string) {
	keyword.value = value
	currentPage.value = 1
	loadProducts()
}

function handleSearchClear() {
	keyword.value = ''
	currentPage.value = 1
	loadProducts()
}

function handleScanSearch() {
	// #ifndef APP-ANDROID
	uni.showToast({ title: '网页版暂不支持扫码', icon: 'none', duration: 3500 })
	// #endif
	// #ifdef APP-ANDROID
	scanCode({
		onlyFromCamera: true,
		success: (res: ScanCodeSuccessCallbackResult) => {
			const scanResult = res.result
			if (scanResult == '') return
			keyword.value = scanResult
			currentPage.value = 1
			closeFilterDrawer()
			loadProducts()
		},
		fail: (res: GeneralCallbackResult) => {
			const message = res.errMsg == '' ? '扫码失败' : res.errMsg
			uni.showToast({ title: message, icon: 'none', duration: 3500 })
		},
	} as ScanCodeOption)
	// #endif
}

function unlockVolumeScanSoon() {
	setTimeout(() => {
		volumeScanLocked.value = false
	}, 1200)
}

// #ifdef APP-ANDROID
function handleVolumeKeyEvent(event: VolumeKeyEvent) {
	if (event.key != 'VOLUME_UP' && event.key != 'VOLUME_DOWN') {
		return
	}
	if (volumeScanLocked.value) {
		return
	}
	volumeScanLocked.value = true
	closeFilterDrawer()
	handleScanSearch()
	unlockVolumeScanSoon()
}

// #endif

function startProductVolumeKeyListener() {
	// #ifdef APP-ANDROID
	startVolumeKeyListener((event: VolumeKeyEvent) => {
		handleVolumeKeyEvent(event)
	})
	// #endif
}

function stopProductVolumeKeyListener() {
	// #ifdef APP-ANDROID
	stopVolumeKeyListener()
	volumeScanLocked.value = false
	// #endif
}

async function handleFilterOpen() {
	if (filterOptions.value != null || filterOptionsLoading.value) {
		return
	}

	filterOptionsLoading.value = true
	filterOptionsError.value = ''

	try {
		filterOptions.value = await getProductFilterOptions()
	} catch (error) {
		filterOptionsError.value = parseErrorMessage(error)
	} finally {
		filterOptionsLoading.value = false
	}
}

function handleSupplierFilterChange(payload: UTSJSONObject) {
	supplierFilterValue.value = stringValue(payload['value'])
	supplierFilterText.value = stringValue(payload['text'])
	setSelectedFilterValue('supplier', supplierFilterValue.value)
}

function handleCategoryMultiChange(payload: UTSJSONObject) {
	const values = payload['values'] as string[] | null
	const texts = payload['texts'] as string[] | null
	if (values != null && texts != null) {
		categoryFilterValues.value = values
		setSelectedFilterValue('category', values.join(','))
	}
}

function isFilterOptionSelected(param: string, value: string): boolean {
	for (let index = 0; index < selectedFilters.value.length; index += 1) {
		const filter = selectedFilters.value[index]
		if (filter.param != param) {
			continue
		}
		return splitSelectedValues(filter.value).includes(value)
	}
	return false
}

function toggleFilterOption(param: string, value: string, multiple: boolean) {
	let currentValue = ''
	for (let index = 0; index < selectedFilters.value.length; index += 1) {
		const filter = selectedFilters.value[index]
		if (filter.param == param) {
			currentValue = filter.value
			break
		}
	}

	const currentValues = splitSelectedValues(currentValue)
	if (!multiple) {
		setSelectedFilterValue(param, currentValues.includes(value) ? '' : value)
		return
	}

	const nextValues: string[] = []
	let alreadySelected = false
	for (let index = 0; index < currentValues.length; index += 1) {
		const currentItem = currentValues[index]
		if (currentItem == value) {
			alreadySelected = true
			continue
		}
		nextValues.push(currentItem)
	}
	if (!alreadySelected) {
		nextValues.push(value)
	}
	setSelectedFilterValue(param, nextValues.join(','))
}

function selectSortOption(option: ProductSortOption) {
	sortOrdering.value = option.value
}

function handlePageChange(payload: UTSJSONObject) {
	const pageValue = payload['page']
	if (pageValue == null) {
		return
	}

	const nextPage = parseInt('' + pageValue)
	if (isNaN(nextPage) || nextPage <= 0 || nextPage == currentPage.value) {
		return
	}

	currentPage.value = nextPage
	loadProducts()
}

function handleFilterReset() {
	selectedFilters.value = [] as ProductSelectedFilter[]
	// 重置回默认商品状态（草稿+启用），而非完全清空
	setSelectedFilterValue('status', defaultStatusFilterValue)
	supplierFilterValue.value = ''
	supplierFilterText.value = ''
	categoryFilterValues.value = []
	sortOrdering.value = '-updated_at'
	keyword.value = ''
	currentPage.value = 1
	closeFilterDrawer()
	loadProducts()
}

function applySelectedFilters() {
	currentPage.value = 1
	closeFilterDrawer()
	loadProducts()
}

function handleItemClick(payload: UTSJSONObject) {
	const itemName = stringValue(payload['name'], '商品')
	uni.showToast({
		title: itemName,
		icon: 'none', duration: 3500,
	})
}

function handleSubtitleClick(payload: UTSJSONObject) {
	const itemValue = payload['item']
	if (itemValue == null) {
		return
	}
	const item = itemValue as UTSJSONObject
	copyText(stringValue(item['sku']), 'SKU已复制', '暂无SKU')
}

function handleMetaClick(payload: UTSJSONObject) {
	const itemValue = payload['item']
	if (itemValue == null) {
		return
	}
	const item = itemValue as UTSJSONObject
	copyText(stringValue(item['barcode']), '条码已复制', '暂无条码')
}

function navigateToProductVariants(item: UTSJSONObject) {
	const rawId = stringValue(item['rawId'], stringValue(item['id']))
	if (rawId == '') {
		uni.showToast({ title: '缺少商品ID', icon: 'none', duration: 3500 })
		return
	}
	const productName = stringValue(item['name'])
	const basePrice = stringValue(item['baseSalesPrice'])
	let url = '/pages/products/variants?product=' + rawId
	if (productName != '') url = url + '&name=' + encodeURIComponent(productName)
	if (basePrice != '' && basePrice != '-') url = url + '&base_price=' + basePrice
	uni.navigateTo({
		url: url,
	})
}

function handleFieldClick(payload: UTSJSONObject) {
	const keyValue = payload['key']
	const itemValue = payload['item']
	if (keyValue == null || itemValue == null) {
		return
	}

	const key = keyValue as string
	const item = itemValue as UTSJSONObject
	if (key == 'supplierText') {
		copyText(stringValue(item['supplierText']), '供应商已复制', '暂无供应商')
		return
	}
	if (key == 'foreignNameText') {
		copyText(stringValue(item['foreignNameText']), '波兰名已复制', '暂无波兰名')
		return
	}
	if (key == 'otherNameText') {
		copyText(stringValue(item['otherNameText']), '其他名已复制', '暂无其他名')
		return
	}
	if (key == 'purchasePriceText') {
		copyText(stringValue(item['purchasePriceText']), '含税进价已复制', '暂无含税进价')
		return
	}
	if (key == 'netPurchasePriceText') {
		copyText(stringValue(item['netPurchasePriceText']), '不含税进价已复制', '暂无不含税进价')
		return
	}
	if (key == 'costPriceText') {
		copyText(stringValue(item['costPriceText']), '成本已复制', '暂无成本')
		return
	}
	if (key == 'salesPriceText') {
		copyText(stringValue(item['salesPriceText']), '售价已复制', '暂无售价')
		return
	}
	if (key == 'salesCountText') {
		copyText(stringValue(item['salesCountText']), '销量已复制', '暂无销量')
		return
	}
	if (key == 'variantCountText') {
		navigateToProductVariants(item)
	}
}

function navigateToProductInventory(item: UTSJSONObject) {
	const rawId = stringValue(item['rawId'], stringValue(item['id']))
	if (rawId == '') {
		uni.showToast({ title: '缺少商品ID', icon: 'none', duration: 3500 })
		return
	}
	const productName = stringValue(item['name'])
	let url = '/pages/inventory-management/from?product=' + rawId
	if (productName != '') url = url + '&productName=' + encodeURIComponent(productName)
	uni.navigateTo({
		url: url,
	})
}

function handleMenu(payload: UTSJSONObject) {
	const actionValue = payload['action']
	const itemValue = payload['item']
	if (actionValue == null || itemValue == null) {
		return
	}

	const action = actionValue as UTSJSONObject
	const item = itemValue as UTSJSONObject
	const key = stringValue(action['key'])
	if (key == 'copy-sku') {
		copyText(stringValue(item['sku']), 'SKU已复制', '暂无SKU')
		return
	}
	if (key == 'copy-barcode') {
		copyText(stringValue(item['barcode']), '条码已复制', '暂无条码')
		return
	}
	if (key == 'detail') {
		const rawId = stringValue(item['rawId'])
		if (rawId == '') {
			return
		}
		uni.navigateTo({
			url: '/pages/products/from?id=' + rawId,
		})
		return
	}
	if (key == 'copy-product') {
		const rawId = stringValue(item['rawId'])
		if (rawId == '') {
			uni.showToast({ title: '缺少商品ID', icon: 'none', duration: 3500 })
			return
		}
		uni.navigateTo({
			url: '/pages/products/from?copy_id=' + rawId,
		})
		return
	}
	if (key == 'variants') {
		navigateToProductVariants(item)
		return
	}
	if (key == 'inventory') {
		navigateToProductInventory(item)
		return
	}
	if (key == 'reload') {
		loadProducts()
	}
}

function handleFloatingAdd() {
	uni.navigateTo({
		url: '/pages/products/from',
	})
}

function consumeProductListRefreshFlag(): boolean {
	const storedValue = uni.getStorageSync(productListRefreshStorageKey)
	const shouldRefresh = storedValue != null && stringValue(storedValue) == '1'
	if (shouldRefresh) {
		uni.removeStorageSync(productListRefreshStorageKey)
	}
	return shouldRefresh
}

// ── 洞察处置闭环 ────────────────────────────────────────────────

const insightBannerId = ref(0)
const insightBannerTitle = ref('')

function dismissInsightBanner(): void {
	insightBannerId.value = 0
	insightBannerTitle.value = ''
}

function handleInsightResolved(): void {
	const id = insightBannerId.value
	if (id <= 0) {
		return
	}
	uni.showModal({
		title: '标记已处理',
		content: '将该条洞察标记为已处理并从待办中移除，确定吗？',
		success: (res) => {
			if (res.confirm) {
				updateCategoryInsightStatus([id], 'handle')
					.then((_response): void => {
						uni.showToast({ title: '已标记为已处理', icon: 'none', duration: 2000 })
						dismissInsightBanner()
					})
					.catch((_err): void => {
						showErrorToast('标记失败，请稍后重试')
					})
			}
		},
	})
}

// 分类页跳转时通过 storage 传入预置分类筛选（switchTab 无法带参数）
function consumePendingCategoryFilter(): boolean {
	let payloadText = ''
	try {
		payloadText = stringValue(uni.getStorageSync('pending:pages:products:category-filter'))
		if (payloadText != '') {
			uni.removeStorageSync('pending:pages:products:category-filter')
		}
	} catch (error) {
		payloadText = ''
	}
	if (payloadText == '') {
		return false
	}
	const payload = JSON.parseObject<UTSJSONObject>(payloadText)
	if (payload == null) {
		return false
	}
	let applied = false
	let toastText = ''

	// 洞察上下文：显示来源横幅，支持处理完就地标记已处理
	const insightIdText = stringValue(payload['insight_id'])
	const parsedInsightId = parseInt(insightIdText)
	if (insightIdText != '' && !isNaN(parsedInsightId) && parsedInsightId > 0) {
		insightBannerId.value = parsedInsightId
		insightBannerTitle.value = stringValue(payload['insight_title'], '经营洞察')
	} else {
		dismissInsightBanner()
	}

	// category_ids 支持逗号分隔多个 id（父级分类会传全部后代分类）
	let idsText = stringValue(payload['category_ids'])
	if (idsText == '') {
		idsText = stringValue(payload['category_id'])
	}
	if (idsText != '' && idsText != '0') {
		const rawIds = idsText.split(',')
		const idList: string[] = []
		for (let index = 0; index < rawIds.length; index += 1) {
			const idText = rawIds[index].trim()
			if (idText != '' && idText != '0') {
				idList.push(idText)
			}
		}
		if (idList.length > 0) {
			categoryFilterValues.value = idList
			setSelectedFilterValue('category', idList.join(','))
			applied = true
			const categoryName = stringValue(payload['category_name'])
			if (categoryName != '') {
				const suffix = idList.length > 1 ? '（含全部子分类）' : ''
				toastText = '已筛选分类：' + categoryName + suffix
			}
		}
	}

	// 治理跳转的语义筛选：未分类 / 挂在父级分类
	if (stringValue(payload['uncategorized']) == 'true') {
		setSelectedFilterValue('uncategorized', 'true')
		applied = true
	}
	if (stringValue(payload['non_leaf_category']) == 'true') {
		setSelectedFilterValue('non_leaf_category', 'true')
		applied = true
	}

	// 洞察跳转的语义筛选：库存预警 / 无销售 / 缺成本 / 成本倒挂
	if (stringValue(payload['stock_warning']) == 'true') {
		setSelectedFilterValue('stock_warning', 'true')
		applied = true
	}
	if (stringValue(payload['no_sales']) == 'true') {
		setSelectedFilterValue('no_sales', 'true')
		applied = true
	}
	if (stringValue(payload['cost_missing']) == 'true') {
		setSelectedFilterValue('cost_missing', 'true')
		applied = true
	}
	if (stringValue(payload['cost_inversion']) == 'true') {
		setSelectedFilterValue('cost_inversion', 'true')
		applied = true
	}

	// 订单商品行跳转：预置搜索关键词（条码/名称）
	const presetKeyword = stringValue(payload['keyword'])

	if (!applied && presetKeyword == '') {
		return false
	}
	keyword.value = presetKeyword
	currentPage.value = 1
	const label = stringValue(payload['label'])
	if (label != '') {
		toastText = '已筛选：' + label
	}
	if (presetKeyword != '' && toastText == '') {
		toastText = '已搜索：' + presetKeyword
	}
	if (toastText != '') {
		uni.showToast({ title: toastText, icon: 'none', duration: 2000 })
	}
	return true
}

const listItems = computed((): UTSJSONObject[] => {
	const result: UTSJSONObject[] = []
	for (let index = 0; index < products.value.length; index += 1) {
		result.push(productToListItem(products.value[index]))
	}
	return result
})

const batchInfoText = computed((): string => {
	return '已选 ' + selectedCountText() + ' 个商品'
})

const batchEditorTitle = computed((): string => {
	return batchActionTitle(batchEditorType.value)
})

const batchEditorSubtitle = computed((): string => {
	return '当前已选 ' + selectedCountText() + ' 个商品'
})

const summaryItems = computed((): UTSJSONObject[] => {
	return [
		{
			key: 'total',
			label: '商品总数',
			value: totalCount.value.toString(),
		} as UTSJSONObject,
		{
			key: 'page',
			label: '当前页',
			value: currentPage.value.toString() + '/' + totalPages.value.toString(),
		} as UTSJSONObject,
		{
			key: 'loaded',
			label: '当前页条数',
			value: products.value.length.toString(),
		} as UTSJSONObject,
	]
})

const hasActiveFilter = computed((): boolean => {
	if (keyword.value != '' || sortOrdering.value != '-updated_at') {
		return true
	}
	if (selectedFilters.value.length == 0) {
		return false
	}
	// 仅剩默认商品状态筛选（草稿+启用）时不算主动筛选
	if (selectedFilters.value.length == 1) {
		const onlyFilter = selectedFilters.value[0]
		if (onlyFilter.param == 'status' && onlyFilter.value == defaultStatusFilterValue) {
			return false
		}
	}
	return true
})

const emptyText = computed((): string => {
	if (isLoading.value) {
		return '正在加载'
	}
	if (hasActiveFilter.value) {
		return '没有匹配的商品'
	}
	return '暂无商品'
})

const filterPanelStyle = computed((): string => {
	return 'height:' + filterPanelHeight.value.toString() + 'px;'
})

const filterContentScrollStyle = computed((): string => {
	return 'height:' + filterContentHeight.value.toString() + 'px;'
})

function isReservedFilterParam(filter: ProductFilterDefinition): boolean {
	if (filter.param == 'supplier' || filter.param == 'category') {
		return true
	}
	if (filter.key == 'supplier' || filter.key == 'category') {
		return true
	}
	for (let index = 0; index < filter.aliases.length; index += 1) {
		const alias = filter.aliases[index]
		if (alias == 'supplier' || alias == 'category') {
			return true
		}
	}
	return false
}

const filterDefinitions = computed((): ProductFilterDefinition[] => {
	if (filterOptions.value == null) {
		return []
	}

	const result: ProductFilterDefinition[] = []
	for (let index = 0; index < filterOptions.value.filters.length; index += 1) {
		const filter = filterOptions.value.filters[index]
		if (isReservedFilterParam(filter)) {
			continue
		}
		result.push(filter)
	}
	return result
})

onLoad(() => {
	updateFilterPanelLayout()
	// 默认商品状态筛选：草稿+启用（面板中可改选查看停用/停产）
	setSelectedFilterValue('status', defaultStatusFilterValue)
	// navigateTo 打开时 onLoad 先于 onShow：预筛选必须在首次请求前消费，
	// 否则 onShow 里的二次 loadProducts 会被 isLoading 守卫拦下，筛选失效
	consumePendingCategoryFilter()
	loadProducts()
})

onShow(() => {
	startProductVolumeKeyListener()
	updateFilterPanelLayout()
	if (consumePendingCategoryFilter()) {
		loadProducts()
		return
	}
	if (consumeProductListRefreshFlag()) {
		loadProducts()
		return
	}
	if (products.value.length == 0 && !isLoading.value) {
		loadProducts()
	}
})

onHide(() => {
	stopProductVolumeKeyListener()
})

onUnload(() => {
	stopProductVolumeKeyListener()
})
</script>

