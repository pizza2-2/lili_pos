}

.alert-dot {
	width: 7px;
	height: 7px;
	margin-right: 8px;
	border-radius: 4px;
	background-color: #F59E0B;
	animation-name: pulse-dot;
	animation-duration: 1100ms;
	animation-iteration-count: infinite;
}

.alert-dot-danger {
	background-color: #DC2626;
}

.alert-label {
	flex: 1;
}

.loading-mask {
	position: absolute;
	left: 0px;
	top: 0px;
	right: 0px;
	bottom: 0px;
	align-items: center;
	justify-content: center;
	background-color: rgba(15, 23, 42, 0.12);
}

.loading-card {
	padding: 12px 16px;
	border-radius: 8px;
	background-color: #111827;
	animation-name: loading-pop;
	animation-duration: 520ms;
	animation-iteration-count: infinite;
	animation-direction: alternate;
}

.loading-text {
	font-size: 13px;
	font-weight: 600;
	color: #FFFFFF;
}

@keyframes fade-slide-in {
	from {
		opacity: 0;
		transform: translateY(8px);
	}
	to {
		opacity: 1;
		transform: translateY(0px);
	}
}

@keyframes number-pop {
	from {
		opacity: 0.4;
		transform: scale(0.96);
	}
	to {
		opacity: 1;
		transform: scale(1);
	}
}

@keyframes bar-grow {
	from {
		transform: scaleX(0);
	}
	to {
		transform: scaleX(1);
	}
}

@keyframes pulse-dot {
	0% {
		opacity: 0.55;
		transform: scale(0.9);
	}
	50% {
		opacity: 1;
		transform: scale(1.25);
	}
	100% {
		opacity: 0.55;
		transform: scale(0.9);
	}
}

@keyframes loading-pop {
	from {
		transform: scale(0.98);
	}
	to {
		transform: scale(1.02);
	}
}

@keyframes shake-in {
	0% {
		opacity: 0;
		transform: translateX(-6px);
	}
	60% {
		opacity: 1;
		transform: translateX(2px);
	}
	100% {
		opacity: 1;
		transform: translateX(0px);
	}
}
</style>
