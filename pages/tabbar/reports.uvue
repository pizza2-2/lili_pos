	justify-content: center;
}

.empty-text {
	font-size: 12px;
	color: #94A3B8;
}

.trend-row {
	flex-direction: row;
	align-items: center;
	margin-top: 9px;
	animation-name: fade-slide-in;
	animation-duration: 360ms;
}

.trend-date {
	width: 38px;
	font-size: 11px;
	color: #64748B;
}

.trend-bar-track {
	flex: 1;
	height: 8px;
	border-radius: 4px;
	background-color: #E5E7EB;
	overflow: hidden;
}

.trend-bar {
	height: 8px;
	border-radius: 4px;
	background-color: #2563EB;
	animation-name: bar-grow;
	animation-duration: 520ms;
	animation-timing-function: ease-out;
}

.trend-amount {
	width: 74px;
	text-align: right;
	font-size: 11px;
	color: #111827;
}

.list-row,
.alert-row {
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	min-height: 32px;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: #F1F5F9;
}

.list-label,
.alert-label {
	font-size: 13px;
	color: #334155;
}

