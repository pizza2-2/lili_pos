	font-size: 12px;
	color: #64748B;
}

.period-text-active {
	font-weight: 700;
	color: #111827;
}

.notice-card,
.hero-card,
.section,
.metric-card {
	border-radius: 8px;
	border-width: 1px;
	border-style: solid;
	border-color: #E5E7EB;
	background-color: #FFFFFF;
}

