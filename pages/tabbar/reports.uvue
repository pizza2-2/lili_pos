<template>
	<scroll-view class="page-scroll" style="flex:1" direction="vertical">
		<view class="page">
			<view class="status-bar-space"></view>

			<view class="topbar">
				<text class="page-title">报表</text>
				<button class="refresh-btn" @click="loadReport">
					<text class="refresh-text">刷新</text>
				</button>
			</view>

			<view class="period-tabs">
				<view
					v-for="item in periodOptions"
					:key="item.key"
					:class="selectedPeriod == item.key ? 'period-tab period-tab-active' : 'period-tab'"
					@click="changePeriod(item.key)"
				>
					<text :class="selectedPeriod == item.key ? 'period-text period-text-active' : 'period-text'">{{ item.label }}</text>
				</view>
			</view>

			<!-- 多店：店铺口径切换 + 多店对比入口（单店时整行隐藏） -->
			<view v-if="hasMultipleShops" class="shop-strip">
				<view class="shop-strip-switcher">
					<lili-shop-switcher @change="handleShopChange"></lili-shop-switcher>
				</view>
				<view class="compare-entry" @click="openShopComparison">
					<text class="compare-entry-text">多店对比</text>
				</view>
			</view>

			<view v-if="errorMessage != '' && !isLoading" class="notice-card">
				<text class="notice-title">加载失败</text>
				<text class="notice-desc">{{ errorMessage }}</text>
			</view>

			<view v-if="categoryLagText != ''" class="lag-row">
				<text class="lag-text">⚠ {{ categoryLagText }}</text>
			</view>

			<view class="hero-card surface-animate">
				<text class="hero-label">{{ currentPeriodLabel }}销售额</text>
				<text class="hero-value">{{ moneyText(overview.sales_amount) }}</text>
				<text v-if="salesDeltaText != ''" :class="salesDeltaClass">{{ salesDeltaText }}</text>
				<view class="hero-meta">
					<text class="hero-meta-text">订单 {{ overview.order_count.toString() }}</text>
					<text class="hero-meta-text">客单价 {{ moneyText(overview.average_order_value) }}</text>
					<text v-if="overview.return_count > 0" class="hero-meta-text">退货 {{ moneyText(overview.return_amount) }}</text>
				</view>
				<view v-if="overview.gross_profit != ''" class="hero-meta">
					<text class="hero-meta-text">估算毛利 {{ moneyText(overview.gross_profit) }}</text>
					<text class="hero-meta-text">毛利率 {{ overview.gross_margin }}%</text>
					<text v-if="grossDeltaText != ''" :class="grossDeltaClass">{{ grossDeltaText }}</text>
				</view>
			</view>

			<view class="metrics-grid">
				<view class="metric-card surface-animate">
					<text class="metric-label">采购金额</text>
					<text class="metric-value">{{ moneyText(overview.purchase_amount) }}</text>
				</view>
				<view class="metric-card metric-right surface-animate">
					<text class="metric-label">支出金额</text>
					<text class="metric-value">{{ moneyText(overview.expense_amount) }}</text>
				</view>
				<view class="metric-card surface-animate">
					<text class="metric-label">供应商欠款</text>
					<text class="metric-value">{{ moneyText(overview.arrears_amount) }}</text>
				</view>
				<view class="metric-card metric-right surface-animate">
					<text class="metric-label">净现金流</text>
					<text class="metric-value">{{ moneyText(overview.net_cashflow) }}</text>
				</view>
			</view>

			<view class="section surface-animate">
				<text class="section-title">最佳概览</text>
				<view class="best-grid">
					<view class="best-tile">
						<text class="best-label">最佳商品</text>
						<text class="best-title">{{ bestProductTitle }}</text>
						<text class="best-value">{{ bestProductValue }}</text>
					</view>
					<view class="best-tile best-tile-right">
						<text class="best-label">最佳分类</text>
						<text class="best-title">{{ bestCategoryTitle }}</text>
						<text class="best-value">{{ bestCategoryValue }}</text>
					</view>
					<view class="best-tile">
						<text class="best-label">最佳 Kasa 分类</text>
						<text class="best-title">{{ bestKasaCategoryTitle }}</text>
						<text class="best-value">{{ bestKasaCategoryValue }}</text>
					</view>
					<view class="best-tile best-tile-right">
						<text class="best-label">库存价值</text>
						<text class="best-title">{{ moneyText(inventory.inventory_value) }}</text>
						<text class="best-value">可用库存 {{ inventory.available_quantity.toString() }}</text>
					</view>
				</view>
			</view>

			<view class="section surface-animate">
				<view class="section-header">
					<text class="section-title">最佳商品</text>
					<view class="section-action" @click="openProductSalesDetail">
						<text class="section-action-text">查看明细</text>
					</view>
				</view>
				<view v-if="topProducts.length == 0" class="empty-row">
					<text class="empty-text">暂无商品排行</text>
				</view>
				<view v-for="(item, index) in topProducts" :key="item.key" class="rank-row" @click="openProductSalesDetail">
					<view :class="index == 0 ? 'rank-index rank-index-top' : 'rank-index'">
						<text :class="index == 0 ? 'rank-index-text rank-index-text-top' : 'rank-index-text'">{{ (index + 1).toString() }}</text>
					</view>
					<view class="rank-main">
						<view class="rank-title-line">
							<text class="rank-title">{{ item.label }}</text>
							<text class="rank-amount">{{ moneyText(item.amount) }}</text>
						</view>
						<text class="rank-subtitle">{{ rankSubtitle(item) }}</text>
						<view class="rank-bar-track">
							<view class="rank-bar rank-bar-product" :style="'width:' + rankWidth(item.amount, maxProductAmount) + '%'"></view>
						</view>
					</view>
				</view>
			</view>

			<view class="section surface-animate">
				<view class="section-header">
					<text class="section-title">最佳分类</text>
					<text class="section-meta">按销售额</text>
				</view>
				<view v-if="topCategories.length == 0" class="empty-row">
					<text class="empty-text">暂无分类排行</text>
				</view>
				<view v-for="(item, index) in topCategories" :key="item.key" class="rank-row" @click="goCategoryAnalytics(item)">
					<view :class="index == 0 ? 'rank-index rank-index-top' : 'rank-index'">
						<text :class="index == 0 ? 'rank-index-text rank-index-text-top' : 'rank-index-text'">{{ (index + 1).toString() }}</text>
					</view>
					<view class="rank-main">
						<view class="rank-title-line">
							<text class="rank-title">{{ item.label }}</text>
							<text class="rank-amount">{{ moneyText(item.amount) }}</text>
						</view>
						<text class="rank-subtitle">{{ rankSubtitle(item) }}</text>
						<view class="rank-bar-track">
							<view class="rank-bar rank-bar-category" :style="'width:' + rankWidth(item.amount, maxCategoryAmount) + '%'"></view>
						</view>
					</view>
				</view>
			</view>

			<!-- 分类健康：四档计数 + 低分优先 Top5（自问题清单页迁入，报表即排名的家） -->
			<view class="section surface-animate">
				<view class="section-header">
					<text class="section-title">分类健康</text>
					<view class="section-action" @click="openCategoryDashboard">
						<text class="section-action-text">问题清单</text>
					</view>
				</view>
				<view v-if="healthTotalScored == 0" class="empty-row">
					<text class="empty-text">暂无健康评分数据</text>
				</view>
				<view v-else>
					<view class="health-grid">
						<view class="health-cell">
							<text class="health-label">已评分</text>
							<text class="health-value">{{ healthTotalScored.toString() }}</text>
						</view>
						<view class="health-cell">
							<text class="health-label">健康</text>
							<text class="health-value health-value-good">{{ healthGoodCount.toString() }}</text>
						</view>
						<view class="health-cell">
							<text class="health-label">需关注</text>
							<text class="health-value health-value-warn">{{ healthWarnCount.toString() }}</text>
						</view>
						<view class="health-cell">
							<text class="health-label">风险</text>
							<text class="health-value health-value-risk">{{ healthRiskCount.toString() }}</text>
						</view>
					</view>
					<view
						v-for="item in worstHealthItems"
						:key="'health-' + item.id.toString()"
						class="health-row"
						@click="goHealthAnalytics(item)"
					>
						<view class="health-row-main">
							<text class="health-row-name">{{ item.full_name == '' ? item.name : item.full_name }}</text>
							<text class="health-row-meta">{{ healthRowMeta(item) }}</text>
						</view>
						<lili-score-badge :score="item.health_score"></lili-score-badge>
						<text class="health-chevron">›</text>
					</view>
				</view>
				<view class="health-tools-row">
					<view class="health-tool" @click="openCategoryComparison">
						<text class="health-tool-text">分类对比</text>
					</view>
					<view class="health-tool" @click="openCategoryPeriodReport">
						<text class="health-tool-text">周期报告</text>
					</view>
				</view>
			</view>

			<view class="section surface-animate">
				<view class="section-header">
					<text class="section-title">最佳 Kasa 分类</text>
					<text class="section-meta">收银分类</text>
				</view>
				<view v-if="topKasaCategories.length == 0" class="empty-row">
					<text class="empty-text">暂无 Kasa 分类排行</text>
				</view>
				<view v-for="(item, index) in topKasaCategories" :key="item.key" class="rank-row">
					<view :class="index == 0 ? 'rank-index rank-index-top' : 'rank-index'">
						<text :class="index == 0 ? 'rank-index-text rank-index-text-top' : 'rank-index-text'">{{ (index + 1).toString() }}</text>
					</view>
					<view class="rank-main">
						<view class="rank-title-line">
							<text class="rank-title">{{ item.label }}</text>
							<text class="rank-amount">{{ moneyText(item.amount) }}</text>
						</view>
						<text class="rank-subtitle">{{ rankSubtitle(item) }}</text>
						<view class="rank-bar-track">
							<view class="rank-bar rank-bar-kasa" :style="'width:' + rankWidth(item.amount, maxKasaCategoryAmount) + '%'"></view>
						</view>
					</view>
				</view>
			</view>

			<view class="section surface-animate">
				<text class="section-title">销售趋势</text>
				<view v-if="salesTrend.length == 0" class="empty-row">
					<text class="empty-text">暂无销售数据</text>
				</view>
				<view v-for="item in salesTrend" :key="item.date" class="trend-row">
					<text class="trend-date">{{ compactDate(item.date) }}</text>
					<view class="trend-bar-track">
						<view class="trend-bar" :style="'width:' + trendWidth(item.amount) + '%'"></view>
					</view>
					<text class="trend-amount">{{ moneyText(item.amount) }}</text>
				</view>
			</view>

			<view v-if="hourlyTrend.length > 0 && maxHourlyAmount > 0" class="section surface-animate">
				<text class="section-title">分时段销售</text>
				<view class="hourly-chart">
					<view v-for="item in hourlyTrend" :key="'hour-' + item.hour.toString()" class="hourly-col">
						<view class="hourly-bar" :style="'height:' + hourlyHeight(item.amount) + '%'"></view>
					</view>
				</view>
				<view class="hourly-axis">
					<text class="hourly-axis-text">0点</text>
					<text class="hourly-axis-text">6点</text>
					<text class="hourly-axis-text">12点</text>
					<text class="hourly-axis-text">18点</text>
					<text class="hourly-axis-text">23点</text>
				</view>
				<text v-if="peakHourText != ''" class="hourly-peak">{{ peakHourText }}</text>
			</view>

			<view class="section surface-animate">
				<text class="section-title">支付方式</text>
				<view v-for="item in paymentMethods" :key="item.key" class="list-row">
					<text class="list-label">{{ item.label }}</text>
					<text class="list-value">{{ item.count.toString() }} 单 / {{ moneyText(item.amount) }}</text>
				</view>
			</view>

			<view class="section surface-animate">
				<text class="section-title">库存概览</text>
				<view class="inventory-grid">
					<view class="inventory-item">
						<text class="inventory-value">{{ inventory.stock_item_count.toString() }}</text>
						<text class="inventory-label">库存项</text>
					</view>
					<view class="inventory-item">
						<text class="inventory-value">{{ inventory.total_quantity.toString() }}</text>
						<text class="inventory-label">库存总量</text>
					</view>
					<view class="inventory-item">
						<text class="inventory-value">{{ inventory.low_stock_count.toString() }}</text>
						<text class="inventory-label">低库存</text>
					</view>
					<view class="inventory-item">
						<text class="inventory-value">{{ inventory.out_of_stock_count.toString() }}</text>
						<text class="inventory-label">售罄</text>
					</view>
				</view>
			</view>

			<view class="section surface-animate">
				<text class="section-title">提醒</text>
				<view v-if="alerts.length == 0" class="empty-row">
					<text class="empty-text">暂无异常提醒</text>
				</view>
				<view v-for="item in alerts" :key="item.label" class="alert-row">
					<text :class="item.level == 'danger' ? 'alert-dot alert-dot-danger' : 'alert-dot'"></text>
					<text class="alert-label">{{ item.label }}</text>
					<text class="alert-value">{{ item.value.toString() }}</text>
				</view>
			</view>

			<view v-if="isLoading" class="loading-mask">
				<view class="loading-card">
					<text class="loading-text">正在加载报表</text>
				</view>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
import { computed } from 'vue'
import { DashboardReport, ReportAlert, ReportHourlyItem, ReportInventory, ReportOverview, ReportPaymentMethod, ReportPeriod, ReportPrevious, ReportTrendItem, ReportRankItem, getDashboardReport } from '@/pkg/api/modules/reports.uts'
import { getCategoryDailyBrief, getCategoryHealthScores, CategoryHealthScoreItem } from '@/pkg/api/modules/category'
import { shopState } from '@/store/shop.uts'
import { resolveReportStartPeriod, setReportLastPeriod } from '@/pkg/util/settings.uts'
import { formatMoney } from '@/pkg/util/format.uts'

type PeriodOption = {
	key: ReportPeriod
	label: string
}

const periodOptions = [
	{ key: 'today', label: '今日' } as PeriodOption,
	{ key: 'week', label: '本周' } as PeriodOption,
	{ key: 'month', label: '本月' } as PeriodOption,
] as PeriodOption[]

// 初始周期由「应用设置 → 报表默认周期」决定（含「记住上次」模式）
const selectedPeriod = ref<ReportPeriod>(resolveReportStartPeriod())
const isLoading = ref(false)
const errorMessage = ref('')
const overview = ref<ReportOverview>({
	sales_amount: '0.00',
	order_count: 0,
	average_order_value: '0.00',
	purchase_amount: '0.00',
	expense_amount: '0.00',
	arrears_amount: '0.00',
	net_cashflow: '0.00',
	gross_profit: '',
	gross_margin: '',
	cost_missing_amount: '',
	return_amount: '0.00',
	return_count: 0,
	net_sales_amount: '0.00',
} as ReportOverview)
const previous = ref<ReportPrevious>({
	date_from: '',
	date_to: '',
	sales_amount: '',
	order_count: 0,
	average_order_value: '',
	gross_profit: '',
	return_amount: '',
	net_sales_amount: '',
} as ReportPrevious)
const hourlyTrend = ref<ReportHourlyItem[]>([] as ReportHourlyItem[])
const categoryLagText = ref('')
const healthTotalScored = ref(0)
const healthGoodCount = ref(0)
const healthWarnCount = ref(0)
const healthRiskCount = ref(0)
const worstHealthItems = ref<CategoryHealthScoreItem[]>([] as CategoryHealthScoreItem[])
const salesTrend = ref<ReportTrendItem[]>([] as ReportTrendItem[])
const paymentMethods = ref<ReportPaymentMethod[]>([] as ReportPaymentMethod[])
const topProducts = ref<ReportRankItem[]>([] as ReportRankItem[])
const topCategories = ref<ReportRankItem[]>([] as ReportRankItem[])
const topKasaCategories = ref<ReportRankItem[]>([] as ReportRankItem[])
const inventory = ref<ReportInventory>({
	stock_item_count: 0,
	total_quantity: 0,
	available_quantity: 0,
	low_stock_count: 0,
	out_of_stock_count: 0,
	no_movement_count: 0,
	inventory_value: '0.00',
} as ReportInventory)
const alerts = ref<ReportAlert[]>([] as ReportAlert[])

function amountNumber(value: string): number {
	const parsed = parseFloat(value)
	if (isNaN(parsed)) {
		return 0
	}
	return parsed
}

function moneyText(value: string): string {
	return formatMoney(value)
}

function rankMaxAmount(items: ReportRankItem[]): number {
	let maxValue = 0
	for (let index = 0; index < items.length; index += 1) {
		const parsed = amountNumber(items[index].amount)
		if (parsed > maxValue) {
			maxValue = parsed
		}
	}
	return maxValue
}

const currentPeriodLabel = computed(() : string => {
	for (let index = 0; index < periodOptions.length; index += 1) {
		if (periodOptions[index].key == selectedPeriod.value) {
			return periodOptions[index].label
		}
	}
	return '今日'
})

// 多店口径：店铺列表来自全局 store（登录/启动时填充）
const hasMultipleShops = computed(() : boolean => {
	return shopState.shops.length > 1
})

const maxTrendAmount = computed(() : number => {
	let maxValue = 0
	for (let index = 0; index < salesTrend.value.length; index += 1) {
		const parsed = parseFloat(salesTrend.value[index].amount)
		if (!isNaN(parsed) && parsed > maxValue) {
			maxValue = parsed
		}
	}
	return maxValue
})

const maxProductAmount = computed(() : number => {
	return rankMaxAmount(topProducts.value)
})

const maxCategoryAmount = computed(() : number => {
	return rankMaxAmount(topCategories.value)
})

const maxKasaCategoryAmount = computed(() : number => {
	return rankMaxAmount(topKasaCategories.value)
})

const bestProductTitle = computed(() : string => {
	if (topProducts.value.length == 0) return '-'
	return topProducts.value[0].label
})

const bestProductValue = computed(() : string => {
	if (topProducts.value.length == 0) return '暂无销售'
	return moneyText(topProducts.value[0].amount) + ' / ' + topProducts.value[0].quantity + ' 件'
})

const bestCategoryTitle = computed(() : string => {
	if (topCategories.value.length == 0) return '-'
	return topCategories.value[0].label
})

const bestCategoryValue = computed(() : string => {
	if (topCategories.value.length == 0) return '暂无销售'
	return moneyText(topCategories.value[0].amount) + ' / ' + topCategories.value[0].share + '%'
})

const bestKasaCategoryTitle = computed(() : string => {
	if (topKasaCategories.value.length == 0) return '-'
	return topKasaCategories.value[0].label
})

const bestKasaCategoryValue = computed(() : string => {
	if (topKasaCategories.value.length == 0) return '暂无销售'
	return moneyText(topKasaCategories.value[0].amount) + ' / ' + topKasaCategories.value[0].share + '%'
})

function compactDate(value: string): string {
	if (value.length >= 10) {
		return value.substring(5, 10)
	}
	return value
}

function trendWidth(value: string): number {
	const maxValue = maxTrendAmount.value
	if (maxValue <= 0) {
		return 0
	}
	const parsed = parseFloat(value)
	if (isNaN(parsed) || parsed <= 0) {
		return 0
	}
	const width = Math.round((parsed / maxValue) * 100)
	if (width < 8) {
		return 8
	}
	return width
}

function rankWidth(value: string, maxValue: number): number {
	if (maxValue <= 0) {
		return 0
	}
	const parsed = amountNumber(value)
	if (parsed <= 0) {
		return 0
	}
	const width = Math.round((parsed / maxValue) * 100)
	if (width < 10) {
		return 10
	}
	return width
}

function rankSubtitle(item: ReportRankItem): string {
	let text = item.quantity + ' 件 / ' + item.order_count.toString() + ' 单 / 占比 ' + item.share + '%'
	if (item.gross_profit != '') {
		text = text + ' / 毛利 ' + formatMoney(item.gross_profit)
	}
	if (item.subtitle != '') {
		text = item.subtitle + ' · ' + text
	}
	return text
}

// ── 环比 ────────────────────────────────────────────────────────

function deltaPctText(current: number, prev: number): string {
	if (prev <= 0) {
		return ''
	}
	const pct = (current - prev) / prev * 100
	return '较上期 ' + (pct >= 0 ? '+' : '') + pct.toFixed(1) + '%'
}

function deltaPctClass(current: number, prev: number): string {
	if (prev <= 0) {
		return 'delta-text'
	}
	return current >= prev ? 'delta-text delta-up' : 'delta-text delta-down'
}

const salesDeltaText = computed(() : string => {
	return deltaPctText(amountNumber(overview.value.sales_amount), amountNumber(previous.value.sales_amount))
})

const salesDeltaClass = computed(() : string => {
	return deltaPctClass(amountNumber(overview.value.sales_amount), amountNumber(previous.value.sales_amount))
})

const grossDeltaText = computed(() : string => {
	return deltaPctText(amountNumber(overview.value.gross_profit), amountNumber(previous.value.gross_profit))
})

const grossDeltaClass = computed(() : string => {
	return deltaPctClass(amountNumber(overview.value.gross_profit), amountNumber(previous.value.gross_profit))
})

// ── 分时段 ──────────────────────────────────────────────────────

const maxHourlyAmount = computed(() : number => {
	let maxValue = 0
	for (let index = 0; index < hourlyTrend.value.length; index += 1) {
		const parsed = amountNumber(hourlyTrend.value[index].amount)
		if (parsed > maxValue) {
			maxValue = parsed
		}
	}
	return maxValue
})

function hourlyHeight(value: string): number {
	const maxValue = maxHourlyAmount.value
	if (maxValue <= 0) {
		return 0
	}
	const parsed = amountNumber(value)
	if (parsed <= 0) {
		return 0
	}
	const height = Math.round((parsed / maxValue) * 100)
	return height < 4 ? 4 : height
}

const peakHourText = computed(() : string => {
	let peakHour = -1
	let peakAmount = 0
	for (let index = 0; index < hourlyTrend.value.length; index += 1) {
		const parsed = amountNumber(hourlyTrend.value[index].amount)
		if (parsed > peakAmount) {
			peakAmount = parsed
			peakHour = hourlyTrend.value[index].hour
		}
	}
	if (peakHour < 0) {
		return ''
	}
	return '高峰时段 ' + peakHour.toString() + ':00-' + (peakHour + 1).toString() + ':00 · ' + moneyText(peakAmount.toFixed(2))
})

function applyReport(data: DashboardReport) {
	overview.value = data.overview
	previous.value = data.previous
	salesTrend.value = data.sales_trend
	hourlyTrend.value = data.hourly_trend
	paymentMethods.value = data.payment_methods
	topProducts.value = data.top_products
	topCategories.value = data.top_categories
	topKasaCategories.value = data.top_kasa_categories
	inventory.value = data.inventory
	alerts.value = data.alerts
}

// 分类日报滞后提示：无权限或接口失败时静默忽略，不影响报表主体
async function loadCategoryLag() {
	try {
		const brief = await getCategoryDailyBrief(0)
		const lagValue = brief['lag_days']
		const lagDays = lagValue == null ? -1 : parseInt('' + lagValue)
		if (!isNaN(lagDays) && lagDays > 0) {
			categoryLagText.value = '分类日报数据滞后 ' + lagDays.toString() + ' 天，趋势类指标可能不完整'
		} else {
			categoryLagText.value = ''
		}
	} catch (error) {
		categoryLagText.value = ''
	}
}

// 分类健康摘要：低分优先 Top5 + 四档计数；无权限或失败时静默隐藏区块
async function loadCategoryHealth() {
	try {
		const response = await getCategoryHealthScores(5, null)
		healthTotalScored.value = response.summary.total_scored
		healthGoodCount.value = response.summary.healthy_count
		healthWarnCount.value = response.summary.warning_count
		healthRiskCount.value = response.summary.risk_count
		worstHealthItems.value = response.items
	} catch (error) {
		healthTotalScored.value = 0
		worstHealthItems.value = [] as CategoryHealthScoreItem[]
	}
}

function healthRowMeta(item: CategoryHealthScoreItem): string {
	let text = '日销 ' + formatMoney(item.sales_amount)
	if (item.stock_warning_count > 0) {
		text = text + ' · 预警 ' + item.stock_warning_count.toString()
	}
	if (item.lifecycle_stage_label != '') {
		text = text + ' · ' + item.lifecycle_stage_label
	}
	return text
}

function goHealthAnalytics(item: CategoryHealthScoreItem): void {
	uni.navigateTo({ url: '/pages/category/analytics?id=' + item.id.toString() + '&name=' + encodeURIComponent(item.name) })
}

function openCategoryComparison(): void {
	uni.navigateTo({ url: '/pages/category/comparison' })
}

function openCategoryPeriodReport(): void {
	uni.navigateTo({ url: '/pages/category/period-report' })
}

function parseErrorMessage(error: any): string {
	if (error == null) {
		return '报表加载失败'
	}
	const errorText = JSON.stringify(error)
	if (errorText != null && errorText != '') {
		return errorText
	}
	return '报表加载失败'
}

async function loadReport() {
	if (isLoading.value) {
		return
	}
	isLoading.value = true
	errorMessage.value = ''
	try {
		const data = await getDashboardReport(selectedPeriod.value, shopState.selectedShopId)
		applyReport(data)
	} catch (error) {
		errorMessage.value = parseErrorMessage(error)
	} finally {
		isLoading.value = false
	}
}

function changePeriod(period: ReportPeriod) {
	if (selectedPeriod.value == period) {
		return
	}
	selectedPeriod.value = period
	setReportLastPeriod(period)
	loadReport()
}

// 切换店铺口径后重载报表（明细页自行读全局口径，无需传参）
function handleShopChange(_id: number) {
	loadReport()
}

function openShopComparison() {
	uni.navigateTo({ url: '/pages/reports/shop-comparison' })
}

function openProductSalesDetail() {
	uni.navigateTo({ url: '/pages/reports/product-sales?period=' + selectedPeriod.value })
}

function openCategoryDashboard() {
	uni.navigateTo({ url: '/pages/category/dashboard' })
}

function goCategoryAnalytics(item: ReportRankItem) {
	// key 形如 'category:123'
	const parts = item.key.split(':')
	if (parts.length != 2 || parts[0] != 'category') {
		return
	}
	const id = parseInt(parts[1])
	if (isNaN(id) || id <= 0) {
		return
	}
	uni.navigateTo({ url: '/pages/category/analytics?id=' + id.toString() + '&name=' + encodeURIComponent(item.label) })
}

onLoad(() => {
	loadReport()
	loadCategoryLag()
	loadCategoryHealth()
})

onShow(() => {
	loadReport()
})
</script>

