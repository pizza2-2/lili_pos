<template>
	<scroll-view class="page-scroll" style="flex:1" direction="vertical">
		<view class="page">
			<view class="status-bar-space"></view>

			<view class="topbar">
				<text class="page-title">功能菜单</text>
			</view>

			<view class="content">
				<view v-for="group in visibleGroups" :key="group.label" class="group">
					<text class="group-label">{{ group.label }}（{{ getGroupCount(group) }}）</text>

					<view
						v-for="(row, rowIndex) in chunkMenu(group.items)"
						:key="group.label + '-' + rowIndex"
						class="grid-row"
					>
						<view
							v-for="(item, index) in row"
							:key="item.label"
							:class="['grid-item', index !== row.length - 1 ? 'grid-item-gap' : '', item.disabled ? 'grid-item-disabled' : '']"
							@click="handleTap(item)"
						>
							<image
								v-if="item.iconPath != null && item.iconPath != ''"
								class="grid-image-icon"
								:src="item.iconPath"
								mode="aspectFit"
							></image>
							<text v-else class="grid-icon">{{ item.icon }}</text>
							<text class="grid-text">{{ item.label }}</text>
						</view>
					</view>
				</view>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
import { computed } from 'vue'
import { getAuthPermissions, hasPerm } from '@/store/auth'

type MenuItem = {
	label: string
	icon: string
	iconPath: string | null
	path: string | null
	action: string
	disabled: boolean
	// 可选权限码：配置后需拥有该权限才显示；未配置则常显
	perm?: string
}

type MenuGroup = {
	label: string
	items: MenuItem[]
}

// 分组按店主使用频率排列：每日经营 → 采购补货 → 商品分类 → 库存 → 财务 → 店铺设备
const groups = ref<MenuGroup[]>([
	{
		label: '每日经营',
		items: [
			{ label: '订单管理', icon: '', iconPath: '/static/menu-icons/orders.svg', path: '/pages/orders/index', action: 'navigateTo', disabled: false, perm: 'pos_order_view' },
			{ label: '退货记录', icon: '', iconPath: '/static/menu-icons/returns.svg', path: '/pages/returns/index', action: 'navigateTo', disabled: false, perm: 'pos_order_view' },
			{ label: '操作日志', icon: '', iconPath: '/static/menu-icons/logs.svg', path: '/pages/audit-logs/index', action: 'navigateTo', disabled: false, perm: 'pos_audit_view' },
		],
	},
	{
		label: '采购与补货',
		items: [
			// 补货建议入口暂时下线（2026-07-21 用户决定：交互方案再想想）；页面/后端/组件改动全部保留，恢复时取消本行注释即可
			// { label: '补货建议', icon: '', iconPath: '/static/menu-icons/replenishment.svg', path: '/pages/purchases/replenishment', action: 'navigateTo', disabled: false, perm: 'purchase_view' },
			{ label: '采购单', icon: '', iconPath: '/static/menu-icons/purchases.svg', path: '/pages/purchases/index', action: 'navigateTo', disabled: false, perm: 'purchase_view' },
			{ label: '采购汇总', icon: '', iconPath: '/static/menu-icons/procurement-summary.svg', path: '/pages/suppliers_procure/index', action: 'navigateTo', disabled: false, perm: 'purchase_view' },
			{ label: '供应商', icon: '', iconPath: '/static/menu-icons/suppliers.svg', path: '/pages/suppliers/index', action: 'navigateTo', disabled: false, perm: 'supplier_view' },
			{ label: 'KSeF发票', icon: '', iconPath: '/static/menu-icons/ksef-invoice.svg', path: '/pages/ksef/index', action: 'navigateTo', disabled: false },
		],
	},
	{
		label: '商品与分类',
		items: [
			// 分析类入口在「工作台」和「报表」tab；功能菜单只放结构管理入口
			{ label: '商品管理', icon: '', iconPath: '/static/menu-icons/products.svg', path: '/pages/tabbar/products', action: 'navigateTo', disabled: false, perm: 'product_view' },
			{ label: '分类', icon: '', iconPath: '/static/menu-icons/category.svg', path: '/pages/category/index', action: 'navigateTo', disabled: false, perm: 'category_view' },
			{ label: '治理工具', icon: '', iconPath: '/static/menu-icons/governance.svg', path: '/pages/category/tools', action: 'navigateTo', disabled: false, perm: 'category_view' },
			{ label: '收银分类', icon: '', iconPath: '/static/menu-icons/cash-category.svg', path: '/pages/kasa_category/index', action: 'navigateTo', disabled: false, perm: 'kasa_category_view' },
			{ label: '商品属性', icon: '', iconPath: '/static/menu-icons/attributes.svg', path: '/pages/products/config-model/index?resource=attribute-type', action: 'navigateTo', disabled: false, perm: 'product_attribute_view' },
			{ label: '商品折扣', icon: '', iconPath: '/static/menu-icons/discount.svg', path: '/pages/products/config-model/index?resource=discount', action: 'navigateTo', disabled: false, perm: 'discount_view' },
			{ label: '条形码序列', icon: '', iconPath: '/static/menu-icons/barcode.svg', path: '/pages/products/config-model/index?resource=barcode-sequence', action: 'navigateTo', disabled: false, perm: 'barcode_sequence_view' },
		],
	},
	{
		label: '库存与盘点',
		items: [
			{ label: '库存管理', icon: '', iconPath: '/static/menu-icons/inventory.svg', path: '/pages/inventory-management/index', action: 'navigateTo', disabled: false, perm: 'inventory_view' },
			{ label: '盘点单', icon: '', iconPath: '/static/menu-icons/inventory-check.svg', path: '/pages/inventory-checks/index', action: 'navigateTo', disabled: false, perm: 'inventory_view' },
			{ label: '调拨单', icon: '', iconPath: '/static/menu-icons/inventory-transfer.svg', path: '/pages/inventory-transfers/index', action: 'navigateTo', disabled: false, perm: 'inventory_view' },
			{ label: '库存位置', icon: '', iconPath: '/static/menu-icons/inventory-location.svg', path: '/pages/inventory-locations/index', action: 'navigateTo', disabled: false, perm: 'inventory_view' },
		],
	},
	{
		label: '财务与价格',
		items: [
			{ label: '支出管理', icon: '', iconPath: '/static/menu-icons/expenses.svg', path: '/pages/expenses/index', action: 'navigateTo', disabled: false },
			{ label: '支出类型', icon: '', iconPath: '/static/menu-icons/expense-type.svg', path: '/pages/products/config-model/index?resource=expenditure-type', action: 'navigateTo', disabled: false },
			{ label: '价格计算公式', icon: '', iconPath: '/static/menu-icons/pricing-formula.svg', path: '/pages/products/pricing-formula/index', action: 'navigateTo', disabled: false, perm: 'pricing_formula_view' },
		],
	},
	{
		label: '店铺与设备',
		items: [
			{ label: '商店', icon: '', iconPath: '/static/menu-icons/shop.svg', path: '/pages/shop/index', action: 'navigateTo', disabled: false, perm: 'shop_view' },
			{ label: '标签模板', icon: '', iconPath: '/static/menu-icons/label-tag.svg', path: '/pages/label-templates/index', action: 'navigateTo', disabled: false, perm: 'print_template_view' },
			// #ifdef APP-ANDROID
			{ label: '打印机设置', icon: '', iconPath: '/static/menu-icons/printer.svg', path: '/pages/printer-settings/index', action: 'navigateTo', disabled: false },
			{ label: '扫码测试', icon: '', iconPath: '/static/menu-icons/scan.svg', path: '/pages/test/scan', action: 'navigateTo', disabled: false },
			// #endif
			{ label: '收银台', icon: '', iconPath: '/static/menu-icons/cash-register.svg', path: null, action: 'todo', disabled: true },
			{ label: '支付', icon: '', iconPath: '/static/menu-icons/payment.svg', path: null, action: 'todo', disabled: true },
			{ label: '分享', icon: '', iconPath: '/static/menu-icons/share.svg', path: null, action: 'todo', disabled: true },
		],
	},
])

// 按权限码过滤后的菜单：仅体验优化，后端接口才是安全边界
// fail-open：权限集为空（未加载/旧版缓存）时不过滤全部显示，避免把老板的菜单搞成白板
const visibleGroups = computed((): MenuGroup[] => {
	if (getAuthPermissions().length == 0) {
		return groups.value
	}
	const result: MenuGroup[] = []
	for (let groupIndex = 0; groupIndex < groups.value.length; groupIndex += 1) {
		const group = groups.value[groupIndex]
		const visibleItems: MenuItem[] = []
		for (let itemIndex = 0; itemIndex < group.items.length; itemIndex += 1) {
			const item = group.items[itemIndex]
			const perm: string | null = item.perm
			// 未配置权限码的菜单项常显
			if (perm == null || perm == '' || hasPerm(perm)) {
				visibleItems.push(item)
			}
		}
		// 整组条目都被过滤时连组标题一起隐藏
		if (visibleItems.length > 0) {
			result.push({ label: group.label, items: visibleItems } as MenuGroup)
		}
	}
	return result
})

function handleTap(item: MenuItem) {
	if (item.disabled) {
		uni.showToast({
			title: '该功能正在开发中',
			icon: 'none', duration: 3500,
		})
		return
	}

	if (item.action == 'switchTab' && item.path != null) {
		uni.switchTab({
			url: item.path,
		})
		return
	}

	if (item.action == 'navigateTo' && item.path != null) {
		uni.navigateTo({
			url: item.path,
		})
	}
}

function chunkMenu(items: MenuItem[], size: number = 4): MenuItem[][] {
	const rows: MenuItem[][] = []
	for (let i = 0; i < items.length; i += size) {
		rows.push(items.slice(i, i + size))
	}
	return rows
}

function getGroupCount(group: MenuGroup): number {
	return group.items.length
}
</script>

<style>
.page-scroll {
	background-color: #F7F7F7;
}

.page {
	background-color: #F7F7F7;
	padding-bottom: 20px;
}

.status-bar-space {
	height: var(--status-bar-height);
}

.topbar {
	flex-direction: row;
	align-items: center;
	padding-left: 12px;
	padding-right: 12px;
	padding-top: 12px;
	padding-bottom: 12px;
}

.brand-box {
	width: 32px;
	height: 32px;
	border-radius: 8px;
	background-color: #FFFFFF;
	align-items: center;
	justify-content: center;
}

.brand-text {
	font-size: 16px;
	line-height: 16px;
	color: #111827;
	font-weight: bold;
}

.page-title {
	flex: 1;
	font-size: 16px;
	line-height: 20px;
	color: #111827;
	font-weight: bold;
}

.content {
	padding-left: 12px;
	padding-right: 12px;
}

.group {
	margin-bottom: 24px;
}

.group-label {
	font-size: 12px;
	line-height: 18px;
	color: #94A3B8;
	margin-left: 8px;
	margin-bottom: 8px;
}

.grid-row {
	flex-direction: row;
	margin-bottom: 8px;
}

.grid-item {
	width: 23%;
	height: 70px;
	border-radius: 12px;
	background-color: #FFFFFF;
	align-items: center;
	padding-top: 18px;
	opacity: 1;
}

.grid-item-disabled {
	opacity: 0.45;
}

.grid-item-gap {
	margin-right: 2.6666%;
}

.grid-icon {
	font-size: 18px;
	line-height: 18px;
	color: #111827;
}

.grid-image-icon {
	width: 24px;
	height: 24px;
}

.grid-text {
	font-size: 12px;
	line-height: 16px;
	color: #111827;
	text-align: center;
	margin-top: 8px;
}
</style>
