const pageTitle = computed((): string => {
	if (operationMode.value == 'edit') {
		return '编辑分类'
	}
	if (operationMode.value == 'add') {
		return '新增子分类'
	}
	return '新建分类'
})

onLoad((event: OnLoadOptions) => {
	leaveSignal.value = 0
	const modeValue = event['mode']
	const idValue = event['id']
	const parentIdValue = event['parent_id']
	const parentNameValue = event['parent_name']

	const modeText = modeValue == null ? '' : ('' + modeValue)
	categoryId.value = idValue == null ? '' : ('' + idValue)

	if (categoryId.value != '') {
		operationMode.value = 'edit'
		formMode.value = 'edit'
		loadDetailData(categoryId.value)
		return
	}

	if (modeText == 'add' && parentIdValue != null) {
		operationMode.value = 'add'
		formMode.value = 'create'
		const parentIdText = '' + parentIdValue
		const parentNameText = parentNameValue == null ? '' : decodeURIComponent('' + parentNameValue)
		parentInfo.value = {
			id: parentIdText,
			text: parentNameText == '' ? parentIdText : parentNameText,
		} as UTSJSONObject
		setInitialData({
			name: '',
			name_en: '',
			code: '',
			parent_id: parentIdText,
			parent_text: parentNameText == '' ? parentIdText : parentNameText,
			description: '',
			kasa_category_id: '',
			kasa_category_text: '',
			tax_rate: '0.23',
			tax_rate_text: '标准税率 23%',
			default_pricing_formula_id: '',
			default_pricing_formula_text: '',
			default_print_template_id: '',
			default_print_template_text: '',
			pos_sale_enabled: true,
			default_min_stock_level: '0',
			default_reorder_point: '0',
			sort_order: '0',
			is_active: true,
		} as UTSJSONObject)
		return
	}

	operationMode.value = 'create'
	formMode.value = 'create'
	parentInfo.value = {
		id: '',
		text: '根分类（无父分类）',
	} as UTSJSONObject
	setInitialData({
		name: '',
		name_en: '',
		code: '',
		parent_id: '',
		parent_text: '根分类（无父分类）',
		description: '',
		kasa_category_id: '',
		kasa_category_text: '',
		tax_rate: '0.23',
		tax_rate_text: '标准税率 23%',
		sort_order: '0',
		is_active: true,
	} as UTSJSONObject)
})
