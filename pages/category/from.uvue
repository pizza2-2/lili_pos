<template>
	<view class="page">
		<lili-universal-filter
			:title="pageTitle"
			:showBack="true"
			:showSearch="false"
			:showHome="true"
			homePath="/pages/category/index"
			backgroundColor="#EEF2F7"
		/>

		<view class="page-content">
			<lili-UniversaForm
				:mode="formMode"
				:formSections="formSections"
				:initialData="initialData"
				:leaveSignal="leaveSignal"
				@submit="handleSubmit"
				@cancel="handleCancel"
				@discard-leave="handleDiscardLeave"
				@save-request="handleSaveRequest"
				@dirty-change="handleDirtyChange"
				@form-change="handleFormChange"
				@input-action="handleInputAction"
				@bottom-select-add="handleBottomSelectAdd"
				@bottom-select-edit="handleBottomSelectEdit"
			/>
		</view>

		<view v-if="savingVisible" class="page-saving-mask">
			<view class="page-saving-card">
				<text class="page-saving-text">{{ savingText }}</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import { computed } from 'vue'
import { takeLatestResponseMessage } from '@/pkg/api/index.uts'
import { commitCategoryRuleSync, createCategory, getCategoryDetail, getCategoryList, previewCategoryRuleSync, translateCategoryName, updateCategory, CategoryItem, CategoryMutationData } from '@/pkg/api/modules/category'
import { getProductPricingFormulaList, getPrintTemplateList, ProductPricingFormulaItem, PrintTemplateItem } from '@/pkg/api/modules/products.uts'
import { getKasaCategoryOptions } from '@/pkg/api/modules/kasa_category'
import { showErrorToast } from '@/pkg/util/toast.uts'

type RuleFieldChange = {
	field: string
	label: string
	newValue: any | null
}

type SelectOption = {
	value: string
	text: string
}

const categoryListRefreshStorageKey = 'refresh:pages:category:index'
const categoryListRefreshPayloadStorageKey = 'refresh:pages:category:index:payload'

const formMode = ref('create')
const operationMode = ref('create')
const categoryId = ref('')
const leaveSignal = ref(0)
const submitting = ref(false)
const translating = ref(false)
const savingVisible = ref(false)
const savingText = ref('处理中...')

const initialData = ref<UTSJSONObject>({
	name: '',
	name_en: '',
	code: '',
	parent_id: '',
	parent_text: '',
	description: '',
	kasa_category_id: '',
	kasa_category_text: '',
	tax_rate: '0.23',
	tax_rate_text: '标准税率 23%',
	default_pricing_formula_id: '',
	default_pricing_formula_text: '',
	default_print_template_id: '',
	default_print_template_text: '',
	pos_sale_enabled: true,
	default_min_stock_level: '0',
	default_reorder_point: '0',
	sort_order: '0',
	is_active: true,
} as UTSJSONObject)
const currentFormData = ref<UTSJSONObject>({
	name: '',
	name_en: '',
	code: '',
	parent_id: '',
	parent_text: '',
	description: '',
	kasa_category_id: '',
	kasa_category_text: '',
	tax_rate: '0.23',
	tax_rate_text: '标准税率 23%',
	default_pricing_formula_id: '',
	default_pricing_formula_text: '',
	default_print_template_id: '',
	default_print_template_text: '',
	pos_sale_enabled: true,
	default_min_stock_level: '0',
	default_reorder_point: '0',
	sort_order: '0',
	is_active: true,
} as UTSJSONObject)

const parentInfo = ref<UTSJSONObject>({
	id: '',
	text: '根分类（无父分类）',
} as UTSJSONObject)

const taxRateOptions = ref<SelectOption[]>([
	{ value: '0.00', text: '免税 0%' } as SelectOption,
	{ value: '0.05', text: '低税率 5%' } as SelectOption,
	{ value: '0.08', text: '中税率 8%' } as SelectOption,
	{ value: '0.23', text: '标准税率 23%' } as SelectOption,
])

const statusOptions = ref<SelectOption[]>([
	{ value: 'true', text: '启用' } as SelectOption,
	{ value: 'false', text: '停用' } as SelectOption,
])

function stringValue(value: any | null, fallback: string = ''): string {
	if (value == null) {
		return fallback
	}
	const text = '' + value
	return text == '' ? fallback : text
}

function booleanValue(value: any | null, fallback: boolean = false): boolean {
	if (value == null) {
		return fallback
	}
	const text = ('' + value).toLowerCase()
	return text == 'true' || text == '1' || text == 'yes'
}

function intValue(value: any | null, fallback: number = 0): number {
	if (value == null) {
		return fallback
	}
	const text = '' + value
	if (text == '') {
		return fallback
	}
	const parsed = parseInt(text)
	if (isNaN(parsed)) {
		return fallback
	}
	return parsed
}

function parseErrorMessage(error: any, fallback: string): string {
	let message = fallback
	if (error != null) {
		const errorText = JSON.stringify(error)
		if (errorText != null && errorText != '') {
			const parsedError = JSON.parseObject<UTSJSONObject>(errorText)
			if (parsedError != null) {
				const rawMessage = parsedError['message']
				if (rawMessage != null) {
					const parsedMessage = rawMessage as string
					if (parsedMessage != '') {
						message = parsedMessage
					}
				}
			}
		}
	}
	return message
}

function normalizeNullableId(value: any | null): string | null {
	const text = stringValue(value)
	if (text == '' || text == '0' || text == 'null') {
		return null
	}
	return text
}

function findTaxRateText(value: string): string {
	for (let index = 0; index < taxRateOptions.value.length; index += 1) {
		const option = taxRateOptions.value[index]
		if (option.value == value) {
			return option.text
		}
	}
	return value
}

function buildSelectResponse(source: SelectOption[], params: UTSJSONObject): UTSJSONObject {
	const id = stringValue(params['id'])
	const result: UTSJSONObject[] = []
	for (let index = 0; index < source.length; index += 1) {
		const option = source[index]
		if (id != '' && option.value != id) {
			continue
		}
		result.push({
			value: option.value,
			text: option.text,
		} as UTSJSONObject)
	}
	return {
		data: result,
		total: result.length,
	} as UTSJSONObject
}

async function fetchStatusOptions(params: UTSJSONObject): Promise<UTSJSONObject> {
	return buildSelectResponse(statusOptions.value, params)
}

async function fetchTaxRateOptions(params: UTSJSONObject): Promise<UTSJSONObject> {
	return buildSelectResponse(taxRateOptions.value, params)
}

function formulaOptionText(item: ProductPricingFormulaItem): string {
	return item.code == '' ? item.name : item.name + ' / ' + item.code
}

function printTemplateOptionText(item: PrintTemplateItem): string {
	const typeText = item.template_type_display == '' ? item.template_type : item.template_type_display
	return typeText == '' ? item.name : item.name + ' / ' + typeText
}

async function fetchPricingFormulaOptions(params: UTSJSONObject): Promise<UTSJSONObject> {
	const keyword = stringValue(params['keyword'])
	const id = stringValue(params['id'])
	const response = await getProductPricingFormulaList({
		search: keyword == '' ? null : keyword,
		page: 1,
		page_size: 50,
		is_active: 'true',
	})
	const result: UTSJSONObject[] = []
	if (id == '') {
		result.push({ value: '', text: '不设置默认公式' } as UTSJSONObject)
	}
	for (let index = 0; index < response.results.length; index += 1) {
		const item = response.results[index]
		const value = item.id.toString()
		if (id != '' && value != id) continue
		result.push({ value: value, text: formulaOptionText(item) } as UTSJSONObject)
	}
	return { data: result, total: result.length } as UTSJSONObject
}

async function fetchPrintTemplateOptions(params: UTSJSONObject): Promise<UTSJSONObject> {
	const keyword = stringValue(params['keyword'])
	const id = stringValue(params['id'])
	const response = await getPrintTemplateList({
		search: keyword == '' ? null : keyword,
		page: 1,
		page_size: 50,
		template_type: 'product_label',
		is_active: 'true',
		is_default: null,
	})
	const result: UTSJSONObject[] = []
	if (id == '') {
		result.push({ value: '', text: '不设置默认模板' } as UTSJSONObject)
	}
	for (let index = 0; index < response.results.length; index += 1) {
		const item = response.results[index]
		const value = item.id.toString()
		if (id != '' && value != id) continue
		result.push({ value: value, text: printTemplateOptionText(item) } as UTSJSONObject)
	}
	return { data: result, total: result.length } as UTSJSONObject
}

async function resolvePricingFormulaTextByValue(idText: string, fallback: string = ''): Promise<string> {
	if (idText == '') return ''
	try {
		const response = await getProductPricingFormulaList({ search: null, page: 1, page_size: 200, is_active: null })
		for (let index = 0; index < response.results.length; index += 1) {
			const item = response.results[index]
			if (item.id.toString() == idText) return formulaOptionText(item)
		}
	} catch (error) {
	}
	return fallback
}

async function resolvePrintTemplateTextByValue(idText: string, fallback: string = ''): Promise<string> {
	if (idText == '') return ''
	try {
		const response = await getPrintTemplateList({ search: null, page: 1, page_size: 200, template_type: null, is_active: null, is_default: null })
		for (let index = 0; index < response.results.length; index += 1) {
			const item = response.results[index]
			if (item.id.toString() == idText) return printTemplateOptionText(item)
		}
	} catch (error) {
	}
	return fallback
}

async function fetchKasaCategoryOptions(params: UTSJSONObject): Promise<UTSJSONObject> {
	const keyword = stringValue(params['keyword'])
	const id = stringValue(params['id'])
	const response = await getKasaCategoryOptions({
		key: 'kasa_category',
		search: keyword == '' ? null : keyword,
		q: null,
		keyword: null,
		limit: 50,
	})

	const result: UTSJSONObject[] = []
	for (let index = 0; index < response.items.length; index += 1) {
		const item = response.items[index]
		const value = stringValue(item['value'], stringValue(item['id']))
		const text = stringValue(item['text'], stringValue(item['label']))
		if (id != '' && value != id) {
			continue
		}
		result.push({
			value: value,
			text: text,
		} as UTSJSONObject)
	}
	return {
		data: result,
		total: result.length,
	} as UTSJSONObject
}

async function resolveKasaCategoryTextByValue(kasaCategoryIdText: string, fallback: string = ''): Promise<string> {
	if (kasaCategoryIdText == '') {
		return ''
	}
	try {
		const response = await getKasaCategoryOptions({
			key: 'kasa_category',
			search: null,
			q: null,
			keyword: null,
			limit: 200,
		})
		for (let index = 0; index < response.items.length; index += 1) {
			const item = response.items[index]
			const value = stringValue(item['value'], stringValue(item['id']))
			if (value != kasaCategoryIdText) {
				continue
			}
			const text = stringValue(item['text'], stringValue(item['label']))
			if (text != '') {
				return text
			}
		}
	} catch (error) {
	}
	return fallback
}

async function fetchParentOptions(params: UTSJSONObject): Promise<UTSJSONObject> {
	const keyword = stringValue(params['keyword'])
	const id = stringValue(params['id'])
	const response = await getCategoryList({
		search: keyword == '' ? null : keyword,
		page: 1,
		page_size: 50,
		id: id == '' ? null : id,
		is_active: null,
		level: null,
		parent: null,
		parent_id: null,
		code: null,
		tax_rate: null,
		kasa_category: null,
		kasa_category_id: null,
		status: null,
		ordering: 'name',
		simple: true,
	})

	const result: UTSJSONObject[] = []
	if (id == '') {
		result.push({
			value: '',
			text: '根分类（无父分类）',
		} as UTSJSONObject)
	}

	for (let index = 0; index < response.results.length; index += 1) {
		const item = response.results[index]
		if (categoryId.value != '' && item.id.toString() == categoryId.value) {
			continue
		}
		result.push({
			value: item.id.toString(),
			text: item.full_name == '' ? item.name : item.full_name,
		} as UTSJSONObject)
	}

	return {
		data: result,
		total: result.length,
	} as UTSJSONObject
}

async function resolveParentText(parentIdText: string): Promise<string> {
	if (parentIdText == '') {
		return '根分类（无父分类）'
	}
	try {
		const parent = await getCategoryDetail(parentIdText)
		if (parent.full_name != '') {
			return parent.full_name
		}
		return parent.name
	} catch (error) {
		return parentIdText
	}
}

function parseObject(value: any | null): UTSJSONObject | null {
	if (value == null) {
		return null
	}
	const text = JSON.stringify(value)
	if (text == null || text == '') {
		return null
	}
	return JSON.parseObject<UTSJSONObject>(text)
}

function cloneFormData(source: UTSJSONObject): UTSJSONObject {
	const target = {} as UTSJSONObject
	for (const key in source) {
		target[key] = source[key]
	}
	return target
}

function setInitialData(data: UTSJSONObject) {
	initialData.value = data
	currentFormData.value = cloneFormData(data)
}

function getCurrentFormData(): UTSJSONObject {
	return currentFormData.value
}

function setCurrentFormField(key: string, value: any) {
	const nextData = cloneFormData(currentFormData.value)
	nextData[key] = value
	setInitialData(nextData)
}

function buildAiTranslationPrompt(sourceName: string): string {
	return '请把下面的商品分类中文名称翻译成简洁、自然的波兰语分类名称。只输出波兰语名称，不要解释，不要加引号：\n' + sourceName
}

function copyAiTranslationPrompt() {
	const sourceName = stringValue(getCurrentFormData()['name']).trim()
	if (sourceName == '') {
		uni.showToast({
			title: '请先填写分类名称',
			icon: 'none', duration: 3500,
		})
		return
	}
	uni.setClipboardData({
		data: buildAiTranslationPrompt(sourceName),
		success: () => {
			uni.showToast({
				title: 'AI提示词已复制',
				icon: 'success',
			})
		},
	})
}

function extractTranslatedName(response: UTSJSONObject): string {
	let translated = stringValue(response['translated'])
	if (translated != '') return translated
	translated = stringValue(response['name_en'])
	if (translated != '') return translated
	translated = stringValue(response['translation'])
	if (translated != '') return translated
	return stringValue(response['target'])
}

async function fillServerTranslation() {
	if (translating.value) {
		return
	}
	const sourceName = stringValue(getCurrentFormData()['name']).trim()
	if (sourceName == '') {
		uni.showToast({
			title: '请先填写分类名称',
			icon: 'none', duration: 3500,
		})
		return
	}
	translating.value = true
	uni.showLoading({
		title: '翻译中...',
		mask: true,
	})
	try {
		const response = await translateCategoryName(sourceName)
		const translated = extractTranslatedName(response).trim()
		if (translated == '') {
			uni.showToast({
				title: '服务器未返回译文',
				icon: 'none', duration: 3500,
			})
			return
		}
		setCurrentFormField('name_en', translated)
		uni.showToast({
			title: '波兰语名称已填充',
			icon: 'success',
		})
	} catch (error) {
		showErrorToast(parseErrorMessage(error, '服务器翻译失败'))
	} finally {
		uni.hideLoading()
		translating.value = false
	}
}

function buildKasaCategoryTextFromInfo(info: UTSJSONObject | null): string {
	if (info == null) {
		return ''
	}
	const text = stringValue(info['text'])
	if (text != '') {
		return text
	}
	const label = stringValue(info['label'])
	if (label != '') {
		return label
	}
	const name = stringValue(info['name'])
	if (name != '') {
		return name
	}
	const nameCn = stringValue(info['name_cn'])
	const nameEn = stringValue(info['name_en'])
	if (nameCn != '' && nameEn != '') {
		return nameCn + ' / ' + nameEn
	}
	if (nameCn != '') {
		return nameCn
	}
	if (nameEn != '') {
		return nameEn
	}
	return stringValue(info['unique_kod'])
}

function buildInitialDataFromDetail(item: CategoryItem, parentText: string): UTSJSONObject {
	const raw = item.raw
	const rawNameEn = raw['name_en']
	const rawDescription = raw['description']
	const rawKasaCategoryId = raw['kasa_category_id'] != null ? raw['kasa_category_id'] : raw['kasa_category']
	const rawKasaCategoryName = raw['kasa_category_name']
	const rawKasaCategoryInfo = parseObject(raw['kasa_category_info'])
	const fallbackKasaCategoryText = rawKasaCategoryName == null ? buildKasaCategoryTextFromInfo(rawKasaCategoryInfo) : (rawKasaCategoryName as string)
	const rawPricingFormulaId = raw['default_pricing_formula_id'] != null ? raw['default_pricing_formula_id'] : raw['default_pricing_formula']
	const rawPrintTemplateId = raw['default_print_template_id'] != null ? raw['default_print_template_id'] : raw['default_print_template']
	return {
		name: item.name,
		name_en: rawNameEn == null ? '' : (rawNameEn as string),
		code: item.code,
		parent_id: item.parent_id > 0 ? item.parent_id.toString() : '',
		parent_text: parentText,
		description: rawDescription == null ? '' : (rawDescription as string),
		kasa_category_id: rawKasaCategoryId == null ? '' : ('' + rawKasaCategoryId),
		kasa_category_text: fallbackKasaCategoryText,
		tax_rate: item.tax_rate == '' ? '0.23' : item.tax_rate,
		tax_rate_text: item.tax_rate == '' ? '标准税率 23%' : findTaxRateText(item.tax_rate),
		default_pricing_formula_id: rawPricingFormulaId == null || intValue(rawPricingFormulaId, 0) <= 0 ? '' : ('' + rawPricingFormulaId),
		default_pricing_formula_text: stringValue(raw['default_pricing_formula_name']),
		default_print_template_id: rawPrintTemplateId == null || intValue(rawPrintTemplateId, 0) <= 0 ? '' : ('' + rawPrintTemplateId),
		default_print_template_text: stringValue(raw['default_print_template_name']),
		pos_sale_enabled: item.pos_sale_enabled,
		default_min_stock_level: item.default_min_stock_level.toString(),
		default_reorder_point: item.default_reorder_point.toString(),
		sort_order: item.sort_order.toString(),
		is_active: item.is_active,
	} as UTSJSONObject
}

async function loadDetailData(idText: string): Promise<void> {
	try {
		const detail = await getCategoryDetail(idText)
		const parentText = await resolveParentText(detail.parent_id > 0 ? detail.parent_id.toString() : '')
		const detailData = buildInitialDataFromDetail(detail, parentText)
		const kasaCategoryIdText = stringValue(detailData['kasa_category_id'])
		const currentKasaCategoryText = stringValue(detailData['kasa_category_text'])
		if (kasaCategoryIdText != '') {
			detailData['kasa_category_text'] = await resolveKasaCategoryTextByValue(kasaCategoryIdText, currentKasaCategoryText)
		}
		const pricingFormulaIdText = stringValue(detailData['default_pricing_formula_id'])
		if (pricingFormulaIdText != '') {
			detailData['default_pricing_formula_text'] = await resolvePricingFormulaTextByValue(pricingFormulaIdText, stringValue(detailData['default_pricing_formula_text']))
		}
		const printTemplateIdText = stringValue(detailData['default_print_template_id'])
		if (printTemplateIdText != '') {
			detailData['default_print_template_text'] = await resolvePrintTemplateTextByValue(printTemplateIdText, stringValue(detailData['default_print_template_text']))
		}
		setInitialData(detailData)
		parentInfo.value = {
			id: detail.parent_id > 0 ? detail.parent_id.toString() : '',
			text: parentText,
		} as UTSJSONObject
	} catch (error) {
		showErrorToast(parseErrorMessage(error, '分类详情加载失败'))
	}
}

function buildMutationPayload(formDataObject: UTSJSONObject): CategoryMutationData {
	const normalizedParentId = normalizeNullableId(formDataObject['parent_id'])
	const normalizedKasaCategoryId = normalizeNullableId(formDataObject['kasa_category_id'])
	const normalizedPricingFormulaId = normalizeNullableId(formDataObject['default_pricing_formula_id'])
	const normalizedPrintTemplateId = normalizeNullableId(formDataObject['default_print_template_id'])
	const name = stringValue(formDataObject['name'])
	const nameEn = stringValue(formDataObject['name_en'])
	const code = stringValue(formDataObject['code'])
	const description = stringValue(formDataObject['description'])
	const taxRate = stringValue(formDataObject['tax_rate'], '0.23')
	const posSaleEnabled = booleanValue(formDataObject['pos_sale_enabled'], true)
	const defaultMinStockLevel = intValue(formDataObject['default_min_stock_level'], 0)
	const defaultReorderPoint = intValue(formDataObject['default_reorder_point'], 0)
	const sortOrder = intValue(formDataObject['sort_order'], 0)
	const isActive = booleanValue(formDataObject['is_active'], true)
	return {
		name: name,
		name_en: nameEn == '' ? null : nameEn,
		code: code == '' ? null : code,
		parent: normalizedParentId,
		parent_id: normalizedParentId,
		description: description == '' ? null : description,
		kasa_category: normalizedKasaCategoryId,
		kasa_category_id: normalizedKasaCategoryId,
		tax_rate: taxRate == '' ? null : taxRate,
		default_pricing_formula: normalizedPricingFormulaId,
		default_pricing_formula_id: normalizedPricingFormulaId,
		default_print_template: normalizedPrintTemplateId,
		default_print_template_id: normalizedPrintTemplateId,
		pos_sale_enabled: posSaleEnabled,
		default_min_stock_level: defaultMinStockLevel,
		default_reorder_point: defaultReorderPoint,
		sort_order: sortOrder,
		is_active: isActive,
	} as UTSJSONObject
}

function buildRefreshPayload(action: string, item: CategoryItem, previousParentId: string | null, currentParentId: string | null): UTSJSONObject {
	return {
		action: action,
		id: item.id.toString(),
		name: item.name,
		code: item.code,
		level: item.level.toString(),
		parent_id: item.parent_id.toString(),
		sort_order: item.sort_order.toString(),
		tax_rate: item.tax_rate,
		kasa_category_id: item.kasa_category_id.toString(),
		products_count: item.products_count.toString(),
		children_count: item.children_count.toString(),
		is_active: item.is_active,
		is_leaf: item.is_leaf,
		full_name: item.full_name,
		path: item.path,
		created_at: item.created_at,
		updated_at: item.updated_at,
		previous_parent_id: previousParentId == null ? '' : previousParentId,
		current_parent_id: currentParentId == null ? '' : currentParentId,
	} as UTSJSONObject
}

function markListRefreshNeeded(payload: UTSJSONObject | null = null): void {
	uni.setStorageSync(categoryListRefreshStorageKey, '1')
	if (payload == null) {
		uni.removeStorageSync(categoryListRefreshPayloadStorageKey)
		return
	}
	uni.setStorageSync(categoryListRefreshPayloadStorageKey, JSON.stringify(payload))
}

function goBackToList(): void {
	leaveSignal.value = leaveSignal.value + 1
	setTimeout(() => {
		uni.navigateBack({
			delta: 1,
			fail: () => {
				uni.navigateTo({
					url: '/pages/category/index',
				})
			},
		})
	}, 16)
}

function showConfirmDialog(title: string, content: string, confirmText: string, cancelText: string): Promise<boolean> {
	return new Promise<boolean>((resolve) => {
		uni.showModal({
			title: title,
			content: content,
			confirmText: confirmText,
			cancelText: cancelText,
			success: (res) => {
				resolve(res.confirm)
			},
			fail: (_) => {
				resolve(false)
			},
		})
	})
}

// 收集本次编辑改动的分类默认规则字段，用于保存后的规则同步预览
function collectRuleFieldChanges(data: UTSJSONObject): RuleFieldChange[] {
	const changes: RuleFieldChange[] = []
	const initial = initialData.value

	const taxBefore = stringValue(initial['tax_rate'])
	const taxAfter = stringValue(data['tax_rate'])
	if (taxAfter != '' && taxAfter != taxBefore) {
		changes.push({ field: 'tax_rate', label: '税率', newValue: taxAfter } as RuleFieldChange)
	}

	const formulaBefore = normalizeNullableId(initial['default_pricing_formula_id'])
	const formulaAfter = normalizeNullableId(data['default_pricing_formula_id'])
	if (formulaAfter != formulaBefore) {
		changes.push({
			field: 'default_pricing_formula',
			label: '默认价格公式',
			newValue: formulaAfter == null ? null : parseInt(formulaAfter as string),
		} as RuleFieldChange)
	}

	const templateBefore = normalizeNullableId(initial['default_print_template_id'])
	const templateAfter = normalizeNullableId(data['default_print_template_id'])
	if (templateAfter != templateBefore) {
		changes.push({
			field: 'default_print_template',
			label: '默认打印模板',
			newValue: templateAfter == null ? null : parseInt(templateAfter as string),
		} as RuleFieldChange)
	}

	const posBefore = booleanValue(initial['pos_sale_enabled'], true)
	const posAfter = booleanValue(data['pos_sale_enabled'], true)
	if (posAfter != posBefore) {
		changes.push({ field: 'pos_sale_enabled', label: 'POS 可售', newValue: posAfter } as RuleFieldChange)
	}

	const minStockBefore = intValue(initial['default_min_stock_level'], 0)
	const minStockAfter = intValue(data['default_min_stock_level'], 0)
	if (minStockAfter != minStockBefore) {
		changes.push({ field: 'default_min_stock_level', label: '默认最低库存', newValue: minStockAfter } as RuleFieldChange)
	}

	const reorderBefore = intValue(initial['default_reorder_point'], 0)
	const reorderAfter = intValue(data['default_reorder_point'], 0)
	if (reorderAfter != reorderBefore) {
		changes.push({ field: 'default_reorder_point', label: '默认补货点', newValue: reorderAfter } as RuleFieldChange)
	}

	return changes
}

// 规则变更后先预览影响面，用户确认后才同步到未覆盖商品
async function maybeOfferRuleSync(changes: RuleFieldChange[]): Promise<void> {
	let labels = ''
	for (let index = 0; index < changes.length; index += 1) {
		if (labels != '') {
			labels = labels + '、'
		}
		labels = labels + changes[index].label
	}
	const proceed = await showConfirmDialog(
		'同步分类规则',
		'本次修改了' + labels + '。是否检查这些默认规则在分类商品上的同步情况？（已单独覆盖的商品不会被改动）',
		'查看预览',
		'暂不同步',
	)
	if (!proceed) {
		return
	}
	for (let index = 0; index < changes.length; index += 1) {
		const change = changes[index]
		try {
			const preview = await previewCategoryRuleSync(categoryId.value, change.field, change.newValue, false)
			let willUpdate = 0
			let willKeep = 0
			const summaryText = JSON.stringify(preview['summary'])
			if (summaryText != null && summaryText != '') {
				const summary = JSON.parseObject<UTSJSONObject>(summaryText)
				if (summary != null) {
					willUpdate = intValue(summary['will_update'], 0)
					willKeep = intValue(summary['will_keep_override'], 0)
				}
			}
			if (willUpdate <= 0) {
				uni.showToast({ title: change.label + '：商品无需同步', icon: 'none', duration: 2500 })
				continue
			}
			const confirmed = await showConfirmDialog(
				change.label + '同步预览',
				willUpdate.toString() + ' 个商品使用分类默认值（将被更新），' + willKeep.toString() + ' 个已单独覆盖（保持不变）。确认同步吗？',
				'确认同步',
				'跳过',
			)
			if (!confirmed) {
				continue
			}
			await commitCategoryRuleSync(categoryId.value, change.field, change.newValue, willUpdate, false)
			uni.showToast({ title: change.label + '已同步到商品', icon: 'success' })
		} catch (error) {
			showErrorToast(parseErrorMessage(error, change.label + '同步失败'))
		}
	}
}

async function persistForm(payload: UTSJSONObject): Promise<void> {
	if (submitting.value) {
		return
	}
	const formDataValue = payload['formData']
	const data = formDataValue == null ? ({} as UTSJSONObject) : (formDataValue as UTSJSONObject)
	const name = stringValue(data['name']).trim()
	if (name == '') {
		uni.showToast({
			title: '分类名称不能为空',
			icon: 'none', duration: 3500,
		})
		return
	}

	submitting.value = true
	const isEditing = formMode.value == 'edit' && categoryId.value != ''
	savingText.value = isEditing ? '保存分类中...' : '创建分类中...'
	savingVisible.value = true
	uni.showLoading({
		title: savingText.value,
		mask: true,
	})

	try {
		const body = buildMutationPayload(data)
		const previousParentId = normalizeNullableId(initialData.value['parent_id'])
		const currentParentId = normalizeNullableId(data['parent_id'])
		// 在保存前基于原始数据收集规则字段变更，保存后提示同步
		const ruleChanges = isEditing ? collectRuleFieldChanges(data) : ([] as RuleFieldChange[])
		let refreshPayload: UTSJSONObject | null = null
		let successMessage = isEditing ? '分类保存成功' : '分类创建成功'
		if (isEditing) {
			const updated = await updateCategory(categoryId.value, body)
			successMessage = takeLatestResponseMessage(successMessage)
			const action = previousParentId == currentParentId ? 'edit' : 'reload'
			refreshPayload = buildRefreshPayload(action, updated, previousParentId, currentParentId)
		} else {
			const created = await createCategory(body)
			successMessage = takeLatestResponseMessage(successMessage)
			categoryId.value = created.id.toString()
			formMode.value = 'edit'
			refreshPayload = buildRefreshPayload('reload', created, previousParentId, currentParentId)
		}
		markListRefreshNeeded(refreshPayload)
		uni.showToast({
			title: successMessage,
			icon: 'success',
		})
		if (isEditing && ruleChanges.length > 0) {
			uni.hideLoading()
			savingVisible.value = false
			await maybeOfferRuleSync(ruleChanges)
		}
		goBackToList()
	} catch (error) {
		showErrorToast(parseErrorMessage(error, isEditing ? '分类保存失败' : '分类创建失败'))
	} finally {
		savingVisible.value = false
		uni.hideLoading()
		submitting.value = false
	}
}

async function handleSubmit(payload: UTSJSONObject) {
	await persistForm(payload)
}

async function handleSaveRequest(payload: UTSJSONObject) {
	await persistForm(payload)
}

function handleCancel(payload: UTSJSONObject) {
	const hasChangesValue = payload['hasChanges']
	const changed = hasChangesValue != null && (hasChangesValue as boolean)
	if (changed) {
		return
	}
	goBackToList()
}

function handleDiscardLeave(payload: UTSJSONObject) {
	goBackToList()
}

function handleDirtyChange(value: boolean) {
}

function handleFormChange(payload: UTSJSONObject) {
	const rawData = payload['formData']
	if (rawData == null) return
	currentFormData.value = cloneFormData(rawData as UTSJSONObject)
}

async function handleInputAction(payload: UTSJSONObject) {
	const action = stringValue(payload['action'])
	if (action == 'copy-ai-translation-prompt') {
		copyAiTranslationPrompt()
		return
	}
	if (action == 'server-translate-name') {
		await fillServerTranslation()
	}
}

function handleBottomSelectAdd(payload: UTSJSONObject) {
	uni.showToast({
		title: '当前字段不支持新增',
		icon: 'none', duration: 3500,
	})
}

function handleBottomSelectEdit(payload: UTSJSONObject) {
	uni.showToast({
		title: '当前字段不支持编辑',
		icon: 'none', duration: 3500,
	})
}

