	background-color: #FFFFFF;
	border-radius: 14px;
	border-width: 1px;
	border-style: solid;
	border-color: #E2E8F0;
	padding: 11px;
	margin-bottom: 10px;
}

.card-head {
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}

.card-title-wrap {
	flex: 1;
	padding-right: 10px;
}

