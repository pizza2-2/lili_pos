	background-color: #0F766E;
}

.chip-text {
	font-size: 12px;
	line-height: 16px;
	color: #475569;
}

.chip-text-active {
	color: #FFFFFF;
	font-weight: bold;
}

.empty-state {
	padding-top: 12px;
	padding-bottom: 12px;
	align-items: center;
}

.empty-text {
	font-size: 13px;
	line-height: 18px;
	color: #94A3B8;
}

.selected-wrap {
	margin-top: 8px;
	flex-direction: row;
	flex-wrap: wrap;
}

.selected-chip {
	padding-left: 10px;
	padding-right: 10px;
	padding-top: 5px;
	padding-bottom: 5px;
	border-radius: 999px;
	background-color: #CCFBF1;
	margin-right: 8px;
	margin-bottom: 8px;
}

.selected-chip-text {
	font-size: 12px;
	line-height: 16px;
	color: #115E59;
	font-weight: bold;
}

.action-primary {
	margin-top: 10px;
	height: 42px;
	border-radius: 12px;
	background-color: #0F766E;
	align-items: center;
	justify-content: center;
}

.action-primary-disabled {
	opacity: 0.5;
}

.action-primary-text {
	font-size: 14px;
	line-height: 20px;
	color: #FFFFFF;
	font-weight: bold;
}

