	margin-top: 6px;
	margin-bottom: 6px;
	font-size: 13px;
	line-height: 18px;
	color: #DC2626;
}

.result-period-row {
	padding-left: 2px;
	padding-bottom: 6px;
}

.result-period-text {
	font-size: 12px;
	line-height: 16px;
	color: #64748B;
}

.result-head {
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}

.result-title-wrap {
	flex: 1;
	flex-direction: row;
	align-items: center;
	flex-wrap: wrap;
	padding-right: 8px;
}

.result-name {
	font-size: 15px;
	line-height: 21px;
	color: #0F172A;
	font-weight: bold;
}

.lifecycle-tag {
	margin-left: 6px;
	padding-left: 6px;
	padding-right: 6px;
	padding-top: 2px;
	padding-bottom: 2px;
	border-radius: 999px;
	background-color: #E0F2FE;
}

.lifecycle-tag-text {
	font-size: 11px;
	line-height: 15px;
	color: #0369A1;
}

.rank-chip-row {
	margin-top: 8px;
	flex-direction: row;
	flex-wrap: wrap;
}

.rank-chip {
	padding-left: 8px;
	padding-right: 8px;
	padding-top: 3px;
	padding-bottom: 3px;
	border-radius: 999px;
	background-color: #F1F5F9;
	margin-right: 6px;
	margin-bottom: 4px;
}

.rank-chip-top {
	background-color: #FEF9C3;
}

