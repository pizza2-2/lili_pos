<template>
	<view class="page">
		<lili-universal-filter
			title="问题清单"
			:showBack="true"
			:showSearch="false"
			:showFilter="false"
			:showHome="true"
			homePath="/pages/tabbar/reports"
		></lili-universal-filter>

		<!-- #ifdef APP -->
		<scroll-view style="flex:1" class="page-scroll">
		<!-- #endif -->
			<view class="page-content">
				<view v-if="pageError != '' && !isLoading" class="state-card state-card-error">
					<text class="state-title">数据加载失败</text>
					<text class="state-desc">{{ pageError }}</text>
					<button class="state-btn" @click="loadAll">
						<text class="state-btn-text">重新加载</text>
					</button>
				</view>

				<view v-else-if="isLoading && !hasLoadedOnce" class="state-card">
					<text class="state-title">加载中</text>
					<text class="state-desc">正在获取问题清单...</text>
				</view>

				<view v-else>
					<!-- 存量问题清单：同父分类同类型 ≥3 条合并为聚合卡，按影响金额排序 -->
					<view class="card">
						<view class="card-head">
							<view class="card-title-wrap">
								<text class="card-label">问题清单</text>
								<text class="card-title">共 {{ insightSourceCount.toString() }} 个问题 · 归并为 {{ insightItems.length.toString() }} 行</text>
							</view>
							<view class="mini-action" @click="loadInsights">
								<text class="mini-action-text">{{ insightsLoading ? '加载中' : '刷新' }}</text>
							</view>
						</view>
						<text v-if="insightsError != ''" class="error-text">{{ insightsError }}</text>
						<view v-if="insightItems.length == 0 && !insightsLoading" class="empty-state">
							<text class="empty-text">暂无待处理问题，运营状态良好</text>
						</view>
						<view v-for="(item, idx) in visibleInsights()" :key="'insight-' + idx.toString()">
							<!-- 聚合卡：默认收拢样例，展开后逐条渲染成员明细（可单独查看/处置） -->
							<view v-if="isGroup(item)" class="insight-row">
								<view class="insight-head">
									<view :class="severityDotClass(item)"></view>
									<text class="insight-title">{{ groupTitle(item) }}</text>
								</view>
								<text class="insight-meta">{{ groupMeta(item) }}</text>
								<view v-if="!isGroupExpanded(item)">
									<text v-for="(line, sIdx) in groupSampleLines(item)" :key="'sample-' + sIdx.toString()" class="insight-suggestion">{{ line }}</text>
								</view>
								<view class="insight-actions">
									<view class="insight-btn insight-btn-primary" @click="toggleGroupExpanded(item)">
										<text class="insight-btn-primary-text">{{ groupExpandLabel(item) }}</text>
									</view>
									<view class="insight-btn" @click="goGroupAnalytics(item)">
										<text class="insight-btn-text">查看父分类</text>
									</view>
									<view class="insight-btn" @click="confirmHandleGroup(item)">
										<text class="insight-btn-text">批量已处理</text>
									</view>
								</view>
								<view v-if="isGroupExpanded(item)" class="group-members">
									<lili-insight-card
										v-for="member in groupMembers(item)"
										:key="'member-' + memberKey(member)"
										:insight="member"
										@view="goInsightAction(member)"
										@handle="markInsight(member, 'handle')"
										@dismiss="confirmDismissInsight(member)"
									></lili-insight-card>
									<text v-if="groupOverflowText(item) != ''" class="group-overflow-text">{{ groupOverflowText(item) }}</text>
								</view>
							</view>
							<!-- 单条：统一洞察卡（含影响金额/判定依据/证据文案） -->
							<lili-insight-card
								v-else
								:insight="item"
								@view="goInsightAction(item)"
								@handle="markInsight(item, 'handle')"
								@dismiss="confirmDismissInsight(item)"
							></lili-insight-card>
						</view>
						<view v-if="insightItems.length > 3" class="expand-row" @click="toggleInsightsExpanded">
							<text class="expand-text">{{ insightsExpanded ? '收起' : '查看全部 ' + insightItems.length.toString() + ' 行' }}</text>
						</view>
					</view>

					<!-- 健康评分排名已迁至「报表」tab 的分类健康区块，本页专注问题处置 -->
					<view class="hint-row">
						<text class="hint-text">健康评分排名请到「报表」查看；本页只保留待处置的问题。</text>
					</view>
				</view>
			</view>
		<!-- #ifdef APP -->
		</scroll-view>
		<!-- #endif -->

		<view v-if="isOperating" class="operate-mask">
			<view class="operate-card">
				<text class="operate-text">处理中...</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { getCategoryInsightsGrouped, updateCategoryInsightStatus } from '@/pkg/api/modules/category'
import { showErrorToast } from '@/pkg/util/toast.uts'
import { formatMoney } from '@/pkg/util/format.uts'

const isLoading = ref(false)
const isOperating = ref(false)
const hasLoadedOnce = ref(false)
const pageError = ref('')

const insightsLoading = ref(false)
const insightsError = ref('')
const insightItems = ref<UTSJSONObject[]>([] as UTSJSONObject[])
const insightsExpanded = ref(false)
const insightSourceCount = ref(0)

// ── 解析辅助 ────────────────────────────────────────────────────

function parseErrorMessage(error: any): string {
	let message = '数据加载失败'
	if (error != null) {
		const errorText = JSON.stringify(error)
		if (errorText != null && errorText != '') {
			const parsedError = JSON.parseObject<UTSJSONObject>(errorText)
			if (parsedError != null) {
				const rawMessage = parsedError['message']
				if (rawMessage != null) {
					const parsedMessage = rawMessage as string
					if (parsedMessage != '') {
						message = parsedMessage
					}
				}
			}
			if (message == '数据加载失败') {
				message = errorText
			}
		}
	}
	return message
}

function stringValue(value: any | null, fallback: string = ''): string {
	if (value == null) {
		return fallback
	}
	const text = '' + value
	return text == '' ? fallback : text
}

function intValue(value: any | null, fallback: number = 0): number {
	if (value == null) {
		return fallback
	}
	const text = '' + value
	if (text == '') {
		return fallback
	}
	const parsed = parseInt(text)
	if (isNaN(parsed)) {
		return fallback
	}
	return parsed
}

function objectValue(value: any | null): UTSJSONObject {
	if (value == null) {
		return {} as UTSJSONObject
	}
	const text = JSON.stringify(value)
	if (text == null || text == '') {
		return {} as UTSJSONObject
	}
	if (!text.startsWith('{')) {
		return {} as UTSJSONObject
	}
	try {
		const parsed = JSON.parseObject<UTSJSONObject>(text)
		if (parsed == null) {
			return {} as UTSJSONObject
		}
		return parsed as UTSJSONObject
	} catch (error) {
		return {} as UTSJSONObject
	}
}

function objectArrayValue(value: any | null): UTSJSONObject[] {
	if (value == null) {
		return [] as UTSJSONObject[]
	}
	const text = JSON.stringify(value)
	if (text == null || text == '') {
		return [] as UTSJSONObject[]
	}
	if (!text.startsWith('[')) {
		return [] as UTSJSONObject[]
	}
	try {
		const parsed = JSON.parseArray<UTSJSONObject>(text)
		if (parsed == null) {
			return [] as UTSJSONObject[]
		}
		return parsed
	} catch (error) {
		return [] as UTSJSONObject[]
	}
}

// ── 洞察 ────────────────────────────────────────────────────────

function insightId(item: UTSJSONObject): number {
	return intValue(item['id'])
}

function insightTitle(item: UTSJSONObject): string {
	return stringValue(item['title'], stringValue(item['insight_type_label'], '经营洞察'))
}

function insightAction(item: UTSJSONObject): UTSJSONObject {
	return objectValue(item['action'])
}

function insightCategory(item: UTSJSONObject): UTSJSONObject {
	return objectValue(item['category'])
}

// ── 聚合卡辅助 ──────────────────────────────────────────────────

function isGroup(item: UTSJSONObject): boolean {
	return stringValue(item['kind']) == 'group'
}

function groupParent(item: UTSJSONObject): UTSJSONObject {
	return objectValue(item['parent_category'])
}

function groupTitle(item: UTSJSONObject): string {
	const parent = groupParent(item)
	const parentName = stringValue(parent['name'], '未知分类')
	const typeLabel = stringValue(item['insight_type_label'], '问题')
	return parentName + '：' + intValue(item['count']).toString() + ' 个子分类' + typeLabel
}

function groupMeta(item: UTSJSONObject): string {
	let text = '合计影响约 ' + formatMoney(stringValue(item['impact_amount'], '0'))
	const duration = intValue(item['max_duration_days'])
	if (duration > 1) {
		text = text + ' · 最长持续 ' + duration.toString() + ' 天'
	}
	return text
}

function groupSampleLines(item: UTSJSONObject): string[] {
	const lines: string[] = []
	const samples = objectArrayValue(item['sample'])
	for (let i = 0; i < samples.length; i += 1) {
		const sample = samples[i]
		lines.push('· ' + stringValue(sample['title']) + '（' + formatMoney(stringValue(sample['impact_amount'], '0')) + '）')
	}
	return lines
}

// ── 聚合卡展开 ──────────────────────────────────────────────────

// 展开状态用 "父分类id:类型" 字符串键记录（刷新后仍保持展开）
const expandedGroupKeys = ref<string[]>([] as string[])

function groupKey(item: UTSJSONObject): string {
	const parent = groupParent(item)
	return intValue(parent['id']).toString() + ':' + stringValue(item['insight_type'])
}

function isGroupExpanded(item: UTSJSONObject): boolean {
	return expandedGroupKeys.value.includes(groupKey(item))
}

function toggleGroupExpanded(item: UTSJSONObject): void {
	const key = groupKey(item)
	const next: string[] = []
	let removed = false
	for (let index = 0; index < expandedGroupKeys.value.length; index += 1) {
		const existing = expandedGroupKeys.value[index]
		if (existing == key) {
			removed = true
			continue
		}
		next.push(existing)
	}
	if (!removed) {
		next.push(key)
	}
	expandedGroupKeys.value = next
}

function groupExpandLabel(item: UTSJSONObject): string {
	if (isGroupExpanded(item)) {
		return '收起明细'
	}
	return '展开 ' + intValue(item['count']).toString() + ' 条明细'
}

function groupMembers(item: UTSJSONObject): UTSJSONObject[] {
	return objectArrayValue(item['items'])
}

function memberKey(member: UTSJSONObject): string {
	return intValue(member['id']).toString()
}

function groupOverflowText(item: UTSJSONObject): string {
	const total = intValue(item['count'])
	const embedded = intValue(item['embedded_count'], groupMembers(item).length)
	if (total > embedded && embedded > 0) {
		return '仅展示影响最大的前 ' + embedded.toString() + ' 条，其余请进入父分类查看'
	}
	return ''
}

function groupInsightIds(item: UTSJSONObject): number[] {
	const ids: number[] = []
	const raw = item.getArray('insight_ids')
	if (raw == null) {
		return ids
	}
	for (let i = 0; i < raw.length; i += 1) {
		const id = intValue(raw[i])
		if (id > 0) {
			ids.push(id)
		}
	}
	return ids
}

function severityDotClass(item: UTSJSONObject): string {
	const severity = stringValue(item['severity'])
	if (severity == 'high') return 'severity-dot severity-dot-high'
	if (severity == 'medium') return 'severity-dot severity-dot-medium'
	return 'severity-dot severity-dot-low'
}

function visibleInsights(): UTSJSONObject[] {
	if (insightsExpanded.value || insightItems.value.length <= 3) {
		return insightItems.value
	}
	const result: UTSJSONObject[] = []
	for (let index = 0; index < 3; index += 1) {
		result.push(insightItems.value[index])
	}
	return result
}

function toggleInsightsExpanded(): void {
	insightsExpanded.value = !insightsExpanded.value
}

// 曝光即已读：清单已经展示给用户，静默批量标记，失败下次打开再补
function autoMarkListRead(items: UTSJSONObject[]): void {
	const ids: number[] = []
	for (let index = 0; index < items.length; index += 1) {
		const item = items[index]
		if (isGroup(item)) {
			const groupIds = groupInsightIds(item)
			for (let g = 0; g < groupIds.length; g += 1) {
				ids.push(groupIds[g])
			}
		} else {
			const id = insightId(item)
			if (id > 0) {
				ids.push(id)
			}
		}
	}
	if (ids.length == 0) {
		return
	}
	updateCategoryInsightStatus(ids, 'read').catch((_err) => {})
}

async function loadInsights(): Promise<void> {
	if (insightsLoading.value) {
		return
	}
	insightsLoading.value = true
	insightsError.value = ''
	try {
		// 分组清单：同父分类同类型问题合并为聚合卡，按影响金额排序
		const response = await getCategoryInsightsGrouped('problem', '', 100)
		insightItems.value = objectArrayValue(response['items'])
		insightSourceCount.value = intValue(response['source_count'], insightItems.value.length)
		autoMarkListRead(insightItems.value)
	} catch (error) {
		insightsError.value = parseErrorMessage(error)
	} finally {
		insightsLoading.value = false
	}
}

async function executeMarkInsight(item: UTSJSONObject, action: string): Promise<void> {
	const id = insightId(item)
	if (id <= 0) {
		return
	}
	try {
		isOperating.value = true
		await updateCategoryInsightStatus([id], action)
		await loadInsights()
	} catch (error) {
		showErrorToast(parseErrorMessage(error))
	} finally {
		isOperating.value = false
	}
}

function markInsight(item: UTSJSONObject, action: string): void {
	executeMarkInsight(item, action)
}

function confirmDismissInsight(item: UTSJSONObject): void {
	uni.showModal({
		title: '忽略洞察',
		content: '忽略后此条洞察不再出现在列表中，确定吗？',
		success: (res) => {
			if (res.confirm) {
				executeMarkInsight(item, 'dismiss')
			}
		},
	})
}

async function executeHandleGroup(item: UTSJSONObject): Promise<void> {
	const ids = groupInsightIds(item)
	if (ids.length == 0) {
		return
	}
	try {
		isOperating.value = true
		await updateCategoryInsightStatus(ids, 'handle')
		await loadInsights()
	} catch (error) {
		showErrorToast(parseErrorMessage(error))
	} finally {
		isOperating.value = false
	}
}

function confirmHandleGroup(item: UTSJSONObject): void {
	const count = intValue(item['count'])
	uni.showModal({
		title: '批量已处理',
		content: '将该组 ' + count.toString() + ' 条洞察全部标记为已处理，确定吗？',
		success: (res) => {
			if (res.confirm) {
				executeHandleGroup(item)
			}
		},
	})
}

function goGroupAnalytics(item: UTSJSONObject): void {
	const parent = groupParent(item)
	const id = intValue(parent['id'])
	if (id <= 0) {
		return
	}
	uni.navigateTo({
		url: '/pages/category/analytics?id=' + id.toString() + '&name=' + encodeURIComponent(stringValue(parent['name'], '分类')),
	})
}

// ── 导航 ────────────────────────────────────────────────────────

function goAnalytics(id: number, name: string): void {
	uni.navigateTo({
		url: '/pages/category/analytics?id=' + id.toString() + '&name=' + encodeURIComponent(name),
	})
}

function goInsightAnalytics(item: UTSJSONObject): void {
	const category = insightCategory(item)
	const id = intValue(category['id'])
	if (id <= 0) {
		return
	}
	goAnalytics(id, stringValue(category['name']))
}

// 洞察跳转：后端 action 为 product_list 时带语义筛选跳商品页，其余跳分类分析页
function goInsightAction(item: UTSJSONObject): void {
	const action = insightAction(item)
	if (stringValue(action['type']) != 'product_list') {
		goInsightAnalytics(item)
		return
	}
	const params = objectValue(action['params'])
	const payload = {} as UTSJSONObject
	const categoryId = intValue(params['category'])
	if (categoryId > 0) {
		payload['category_id'] = categoryId.toString()
		payload['category_name'] = stringValue(insightCategory(item)['name'])
	}
	const semanticParams = ['stock_warning', 'no_sales', 'cost_missing', 'cost_inversion']
	for (let index = 0; index < semanticParams.length; index += 1) {
		const key = semanticParams[index]
		if (stringValue(params[key]) == 'true') {
			payload[key] = 'true'
		}
	}
	payload['label'] = insightTitle(item)
	// 处置闭环：商品页据此显示来源横幅 + 「标记已处理」按钮
	payload['insight_id'] = insightId(item).toString()
	payload['insight_title'] = insightTitle(item)
	try {
		uni.setStorageSync('pending:pages:products:category-filter', JSON.stringify(payload))
	} catch (error) {
	}
	uni.navigateTo({
		url: '/pages/tabbar/products',
		fail: (_) => {
			try {
				uni.removeStorageSync('pending:pages:products:category-filter')
			} catch (error) {
			}
			uni.showToast({ title: '页面层级过深，请先返回', icon: 'none', duration: 3000 })
		},
	})
}

// ── 生命周期 ────────────────────────────────────────────────────

async function loadAll(): Promise<void> {
	if (isLoading.value) {
		return
	}
	isLoading.value = true
	pageError.value = ''
	try {
		await loadInsights()
		if (insightsError.value != '' && insightItems.value.length == 0) {
			pageError.value = insightsError.value
		}
		hasLoadedOnce.value = true
	} finally {
		isLoading.value = false
	}
}

onLoad(() => {
	loadAll()
})

onShow(() => {
	if (hasLoadedOnce.value) {
		loadInsights()
	}
})
</script>

<style>
.page {
	flex: 1;
	background-color: #F4F6F8;
}

.page-scroll {
	background-color: #F4F6F8;
}

.page-content {
	padding-left: 16px;
	padding-right: 16px;
	padding-top: 12px;
	padding-bottom: 60px;
	background-color: #F4F6F8;
}

.state-card {
	background-color: #FFFFFF;
	border-radius: 18px;
	padding: 18px;
	border-width: 1px;
	border-style: solid;
	border-color: #E2E8F0;
}

.state-card-error {
	border-color: #FECACA;
}

.state-title {
	font-size: 16px;
	line-height: 22px;
	color: #0F172A;
	font-weight: bold;
}

.state-desc {
	font-size: 14px;
	line-height: 21px;
	color: #64748B;
	margin-top: 8px;
}

.state-btn {
	height: 40px;
	margin-top: 14px;
	background-color: #0F766E;
	border-radius: 12px;
	border-width: 0px;
}

.state-btn-text {
	font-size: 14px;
	line-height: 20px;
	color: #FFFFFF;
	font-weight: bold;
}

.hint-row {
	padding: 10px 4px;
	align-items: center;
}

.hint-text {
	font-size: 12px;
	line-height: 17px;
	color: #94A3B8;
}

.card {
	background-color: #FFFFFF;
	border-radius: 14px;
	border-width: 1px;
	border-style: solid;
	border-color: #E2E8F0;
	padding: 11px;
	margin-bottom: 10px;
}

.card-head {
	flex-direction: row;
	align-items: flex-start;
	justify-content: space-between;
}

.card-title-wrap {
	flex: 1;
	padding-right: 10px;
}

.card-label {
	font-size: 12px;
	line-height: 16px;
	color: #64748B;
}

.card-title {
	margin-top: 3px;
	font-size: 16px;
	line-height: 22px;
	color: #0F172A;
	font-weight: bold;
}

.mini-action {
	padding-left: 10px;
	padding-right: 10px;
	padding-top: 6px;
	padding-bottom: 6px;
	border-radius: 10px;
	background-color: #F1F5F9;
}

.mini-action-text {
	font-size: 12px;
	line-height: 16px;
	color: #334155;
	font-weight: bold;
}

.error-text {
	margin-top: 8px;
	font-size: 13px;
	line-height: 18px;
	color: #DC2626;
}

.empty-state {
	padding-top: 16px;
	padding-bottom: 16px;
	align-items: center;
}

.empty-text {
	font-size: 13px;
	line-height: 18px;
	color: #94A3B8;
}

.insight-row {
	padding-top: 9px;
	padding-bottom: 9px;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: #F1F5F9;
}

.insight-head {
	flex-direction: row;
	align-items: center;
}

.severity-dot {
	width: 8px;
	height: 8px;
	border-radius: 4px;
	margin-right: 8px;
}

.severity-dot-high {
	background-color: #DC2626;
}

.severity-dot-medium {
	background-color: #F59E0B;
}

.severity-dot-low {
	background-color: #22C55E;
}

.insight-title {
	flex: 1;
	font-size: 14px;
	line-height: 20px;
	color: #0F172A;
	font-weight: bold;
}

.insight-meta {
	margin-top: 3px;
	padding-left: 16px;
	font-size: 12px;
	line-height: 16px;
	color: #64748B;
}

.insight-suggestion {
	margin-top: 4px;
	padding-left: 16px;
	font-size: 12px;
	line-height: 17px;
	color: #0369A1;
}

.insight-actions {
	margin-top: 8px;
	padding-left: 16px;
	flex-direction: row;
}

.insight-btn {
	padding-left: 12px;
	padding-right: 12px;
	padding-top: 5px;
	padding-bottom: 5px;
	border-radius: 8px;
	background-color: #F1F5F9;
