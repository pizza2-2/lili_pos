<template>
	<view class="page">
		<lili-universal-filter
			:title="pageTitle"
			:showBack="true"
			:showSearch="false"
			:showHome="true"
			homePath="/pages/orders/index"
		/>

		<!-- #ifdef APP -->
		<scroll-view style="flex:1" class="page-scroll">
		<!-- #endif -->
			<view class="page-content">
				<view v-if="isLoading" class="state-card">
					<text class="state-title">正在加载订单详情</text>
					<text class="state-desc">订单 ID：{{ displayText(orderId) }}</text>
				</view>

				<view v-if="errorMessage != '' && !isLoading" class="error-card">
					<text class="error-title">加载失败</text>
					<text class="error-desc">{{ errorMessage }}</text>
					<view class="retry-btn" @click="loadDetail">
						<text class="retry-btn-text">重新加载</text>
					</view>
				</view>

				<view v-if="orderDetail == null && !isLoading && errorMessage == ''" class="state-card">
					<text class="state-title">暂无订单数据</text>
					<text class="state-desc">没有读取到当前订单详情</text>
				</view>

				<view v-if="orderDetail != null && !isLoading" class="summary-card">
					<view class="summary-head">
						<view class="summary-main">
							<text class="summary-title">{{ orderNumberText }}</text>
							<text class="summary-subtitle">{{ orderTimeText }}</text>
						</view>
						<view :class="statusPillClass">
							<text :class="statusTextClass">{{ statusDisplayText }}</text>
						</view>
					</view>
					<view class="amount-line">
						<text class="amount-label">订单金额</text>
						<text class="amount-value">{{ totalAmountText }} zł</text>
					</view>
					<view class="action-row">
						<view class="action-btn action-btn-primary" @click="copyOrderNumber">
							<text class="action-btn-primary-text">复制订单号</text>
						</view>
						<view class="action-btn action-btn-light" @click="copyPayload">
							<text class="action-btn-light-text">复制 Payload</text>
						</view>
					</view>
					<view v-if="showRetryDeduction" class="retry-deduct-btn" @click="handleRetryDeduction">
						<text class="retry-deduct-text">{{ retrying ? '正在重试扣减...' : '重试库存扣减' }}</text>
					</view>
				</view>

				<view v-if="orderDetail != null && !isLoading" class="metric-grid">
					<view class="metric-cell">
						<text class="metric-label">支付方式</text>
						<text class="metric-value">{{ paymentDisplayText }}</text>
					</view>
					<view class="metric-cell">
						<text class="metric-label">库存状态</text>
						<text class="metric-value">{{ inventoryStatusText }}</text>
					</view>
					<view class="metric-cell">
						<text class="metric-label">商品项</text>
						<text class="metric-value">{{ itemCountText }}</text>
					</view>
					<view class="metric-cell">
						<text class="metric-label">商品件数</text>
						<text class="metric-value">{{ quantityCountText }}</text>
					</view>
				</view>

				<view v-if="orderDetail != null && !isLoading" class="section-head-row">
					<text class="section-head-title">商品明细</text>
					<text class="section-head-note">{{ itemListItems.length.toString() }} 项{{ itemSourceNote }} · 点击行跳转商品管理</text>
				</view>
				<lili-UniversalList
					v-if="orderDetail != null && !isLoading"
					:items="itemListItems"
					keyField="id"
					titleField="title"
					subtitleField="subtitle"
					metaField="amountText"
					tagField="tags"
					:fields="itemFieldConfig"
					:showImage="false"
					:showChevron="true"
					emptyText="该订单没有可展示的商品行"
					emptyIcon="◎"
					@item-click="handleItemTap"
				/>

				<view v-if="orderDetail != null && !isLoading && returnListItems.length > 0" class="section-head-row">
					<text class="section-head-title">关联退货</text>
					<text class="section-head-note">{{ returnListItems.length.toString() }} 笔 · 点击查看详情</text>
				</view>
				<lili-UniversalList
					v-if="orderDetail != null && !isLoading && returnListItems.length > 0"
					:items="returnListItems"
					keyField="id"
					titleField="title"
					subtitleField="subtitle"
					metaField="amountText"
					tagField="tags"
					:fields="returnFieldConfig"
					:showImage="false"
					:showChevron="true"
					@item-click="handleReturnTap"
				/>

				<view v-if="orderDetail != null && !isLoading" class="section-card">
					<text class="section-title">订单信息</text>
					<view v-for="row in baseRows" :key="row['key']" class="info-row" @click="copyRowValue(row)">
						<text class="info-label">{{ row['label'] }}</text>
						<text class="info-value">{{ row['value'] }}</text>
					</view>
				</view>

				<view v-if="orderDetail != null && !isLoading" class="section-card">
					<text class="section-title">金额信息</text>
					<view v-for="row in amountRows" :key="row['key']" class="info-row" @click="copyRowValue(row)">
						<text class="info-label">{{ row['label'] }}</text>
						<text class="info-value">{{ row['value'] }}</text>
					</view>
				</view>

				<view v-if="orderDetail != null && !isLoading" class="section-card">
					<text class="section-title">处理与库存状态</text>
					<view v-for="row in statusRows" :key="row['key']" class="info-row" @click="copyRowValue(row)">
						<text class="info-label">{{ row['label'] }}</text>
						<text class="info-value">{{ row['value'] }}</text>
					</view>
				</view>

				<view v-if="orderDetail != null && !isLoading" class="section-card">
					<view class="section-head">
						<text class="section-title">原始 Payload</text>
						<view class="small-copy-btn" @click="copyPayload">
							<text class="small-copy-text">复制</text>
						</view>
					</view>
					<text class="payload-text">{{ payloadText }}</text>
				</view>
			</view>
		<!-- #ifdef APP -->
		</scroll-view>
		<!-- #endif -->
	</view>
</template>

<script setup lang="uts">
import { computed } from 'vue'
import { getOrderDetail, OrderItem, OrderLine, OrderReturnBrief, retryOrderDeduction } from '@/pkg/api/modules/orders.uts'

const orderId = ref('')
const orderDetail = ref<OrderItem | null>(null)
const isLoading = ref(false)
const errorMessage = ref('')
const retrying = ref(false)

const itemFieldConfig = ref<UTSJSONObject[]>([
	{ key: 'unitPriceText', label: '单价:' } as UTSJSONObject,
	{ key: 'quantityText', label: '数量:' } as UTSJSONObject,
] as UTSJSONObject[])

const returnFieldConfig = ref<UTSJSONObject[]>([
	{ key: 'itemsText', label: '商品数:' } as UTSJSONObject,
	{ key: 'inventoryText', label: '库存:' } as UTSJSONObject,
	{ key: 'reasonText', label: '原因:' } as UTSJSONObject,
] as UTSJSONObject[])

function stringValue(value: any | null, fallback: string = ''): string {
	if (value == null) return fallback
	const text = '' + value
	if (text == '') return fallback
	return text
}

function displayText(value: string): string {
	if (value == '') return '-'
	return value
}

function parseErrorMessage(error: any, fallback: string): string {
	let message = fallback
	if (error != null) {
		const errorText = JSON.stringify(error)
		if (errorText != null && errorText != '') {
			const parsedError = JSON.parseObject<UTSJSONObject>(errorText)
			if (parsedError != null) {
				const rawMessage = parsedError['message']
				if (rawMessage != null) {
					const parsedMessage = rawMessage as string
					if (parsedMessage != '') message = parsedMessage
				}
			}
			if (message == fallback) message = errorText
		}
	}
	return message
}

function parseObjectArray(value: any | null): UTSJSONObject[] {
	if (value == null) return [] as UTSJSONObject[]
	const text = JSON.stringify(value)
	if (text == null || text == '') return [] as UTSJSONObject[]
	const parsed = JSON.parseArray<UTSJSONObject>(text)
	if (parsed == null) return [] as UTSJSONObject[]
	return parsed!
}

function parseObject(value: any | null): UTSJSONObject | null {
	if (value == null) return null
	const text = JSON.stringify(value)
	if (text == null || text == '') return null
	return JSON.parseObject<UTSJSONObject>(text)
}

function boolText(value: boolean): string {
	return value ? '是' : '否'
}

function statusText(item: OrderItem): string {
	const text = stringValue(item.status_display, item.status)
	if (text != '') return text
	return '-'
}

function paymentText(item: OrderItem): string {
	const text = stringValue(item.payment_method_display, item.payment_method)
	if (text != '') return text
	return '-'
}

// ISO 时间简化为 "YYYY-MM-DD HH:MM"
function formatDateTime(raw: string): string {
	if (raw == '') return '-'
	const text = raw.replace('T', ' ')
	if (text.length >= 16) return text.substring(0, 16)
	return text
}

function currencyText(value: string): string {
	return stringValue(value, '0.00')
}

function quantityText(value: number): string {
	if (value == Math.floor(value)) return value.toString()
	return value.toFixed(2)
}

function payloadTextValue(payload: UTSJSONObject): string {
	const text = JSON.stringify(payload)
	if (text == null || text == '') return '{}'
	return text
}

function payloadOrderData(payload: UTSJSONObject): UTSJSONObject {
	const snake = parseObject(payload['order_data'])
	if (snake != null) return snake!
	const camel = parseObject(payload['orderData'])
	if (camel != null) return camel!
	return payload
}

function getPayloadItems(payload: UTSJSONObject): UTSJSONObject[] {
	const orderData = payloadOrderData(payload)
	let rows = parseObjectArray(orderData['items'])
	if (rows.length > 0) return rows
	rows = parseObjectArray(orderData['products'])
	if (rows.length > 0) return rows
	rows = parseObjectArray(orderData['cart'])
	if (rows.length > 0) return rows
	rows = parseObjectArray(payload['items'])
	if (rows.length > 0) return rows
	rows = parseObjectArray(payload['products'])
	if (rows.length > 0) return rows
	return parseObjectArray(payload['cart'])
}

function copyText(text: string, successTitle: string, emptyTitle: string) {
	if (text == '' || text == '-') {
		uni.showToast({ title: emptyTitle, icon: 'none', duration: 3500 })
		return
	}
	uni.setClipboardData({
		data: text,
		success: () => {
			uni.showToast({ title: successTitle, icon: 'success' })
		},
	})
}

async function loadDetail() {
	if (orderId.value == '') {
		errorMessage.value = '缺少订单 ID'
		return
	}
	if (isLoading.value) return
	isLoading.value = true
	errorMessage.value = ''
	try {
		const detail = await getOrderDetail(orderId.value)
		orderDetail.value = detail
	} catch (error) {
		orderDetail.value = null
		errorMessage.value = parseErrorMessage(error, '订单详情加载失败')
	} finally {
		isLoading.value = false
	}
}

function copyOrderNumber() {
	if (orderDetail.value == null) {
		copyText('', '订单号已复制', '暂无订单号')
		return
	}
	const detail = orderDetail.value as OrderItem
	copyText(stringValue(detail.order_number, '订单 #' + detail.id.toString()), '订单号已复制', '暂无订单号')
}

function copyPayload() {
	if (orderDetail.value == null) {
		copyText('', 'Payload 已复制', '暂无 Payload')
		return
	}
	const detail = orderDetail.value as OrderItem
	copyText(payloadTextValue(detail.payload), 'Payload 已复制', '暂无 Payload')
}

function copyRowValue(row: UTSJSONObject) {
	copyText(stringValue(row['value']), '内容已复制', '暂无内容')
}

async function handleRetryDeduction() {
	if (retrying.value || orderDetail.value == null) return
	retrying.value = true
	try {
		await retryOrderDeduction(orderId.value)
		uni.showToast({ title: '库存扣减成功', icon: 'success' })
	} catch (error) {
		uni.showToast({ title: parseErrorMessage(error, '重试失败'), icon: 'none', duration: 3500 })
	} finally {
		retrying.value = false
		loadDetail()
	}
}

// 跳转商品管理并预置搜索该条码（复用分类页的 storage 预筛选通道）
function jumpToProductSearch(barcode: string) {
	if (barcode == '' || barcode == '-') {
		uni.showToast({ title: '该商品行没有条码', icon: 'none', duration: 2500 })
		return
	}
	const payload = { keyword: barcode } as UTSJSONObject
	uni.setStorageSync('pending:pages:products:category-filter', JSON.stringify(payload))
	uni.navigateTo({ url: '/pages/tabbar/products' })
}

function handleItemTap(payload: UTSJSONObject) {
	jumpToProductSearch(stringValue(payload['barcode']))
}

function handleReturnTap(payload: UTSJSONObject) {
	const id = stringValue(payload['rawId'])
	if (id == '') return
	uni.navigateTo({ url: '/pages/returns/from?id=' + id })
}

const pageTitle = computed((): string => {
	if (orderDetail.value == null) return '订单详情'
	const detail = orderDetail.value as OrderItem
	return stringValue(detail.order_number, '订单 #' + detail.id.toString())
})

const orderNumberText = computed((): string => {
	if (orderDetail.value == null) return '-'
	const detail = orderDetail.value as OrderItem
	return stringValue(detail.order_number, '订单 #' + detail.id.toString())
})

const orderTimeText = computed((): string => {
	if (orderDetail.value == null) return '-'
	const detail = orderDetail.value as OrderItem
	return formatDateTime(stringValue(detail.order_time, detail.created_at))
})

const statusDisplayText = computed((): string => {
	if (orderDetail.value == null) return '-'
	return statusText(orderDetail.value as OrderItem)
})

const paymentDisplayText = computed((): string => {
	if (orderDetail.value == null) return '-'
	return paymentText(orderDetail.value as OrderItem)
})

const inventoryStatusText = computed((): string => {
	if (orderDetail.value == null) return '-'
	const detail = orderDetail.value as OrderItem
	return detail.inventory_deducted ? '已扣减' : '未扣减'
})

const totalAmountText = computed((): string => {
	if (orderDetail.value == null) return '0.00'
	return currencyText((orderDetail.value as OrderItem).total_amount)
})

const itemCountText = computed((): string => {
	if (orderDetail.value == null) return '0'
	return (orderDetail.value as OrderItem).item_count.toString()
})

const quantityCountText = computed((): string => {
	if (orderDetail.value == null) return '0'
	return quantityText((orderDetail.value as OrderItem).quantity_count)
})

const cashierDisplayText = computed((): string => {
	if (orderDetail.value == null) return '-'
	const detail = orderDetail.value as OrderItem
	const name = stringValue(detail.cashier_name)
	if (name != '') return name + ' (' + stringValue(detail.cashier_id, '-') + ')'
	return stringValue(detail.cashier_id, '-')
})

const payloadText = computed((): string => {
	if (orderDetail.value == null) return '{}'
	const detail = orderDetail.value as OrderItem
	return payloadTextValue(detail.payload)
})

const statusPillClass = computed((): string => {
	if (orderDetail.value == null) return 'status-pill'
	const status = (orderDetail.value as OrderItem).status
	if (status == 'processed') return 'status-pill status-pill-ok'
	if (status == 'failed') return 'status-pill status-pill-error'
	return 'status-pill status-pill-warn'
})

const statusTextClass = computed((): string => {
	if (orderDetail.value == null) return 'status-pill-text'
	const status = (orderDetail.value as OrderItem).status
	if (status == 'processed') return 'status-pill-text status-pill-text-ok'
	if (status == 'failed') return 'status-pill-text status-pill-text-error'
	return 'status-pill-text status-pill-text-warn'
})

const showRetryDeduction = computed((): boolean => {
	if (orderDetail.value == null || isLoading.value) return false
	const detail = orderDetail.value as OrderItem
	return !detail.inventory_deducted || detail.status == 'failed'
})

const hasStructuredItems = computed((): boolean => {
	if (orderDetail.value == null) return false
	return (orderDetail.value as OrderItem).items.length > 0
})

const itemSourceNote = computed((): string => {
	if (orderDetail.value == null) return ''
	return hasStructuredItems.value ? '' : ' (payload 解析)'
})

const itemListItems = computed((): UTSJSONObject[] => {
	const result: UTSJSONObject[] = []
	if (orderDetail.value == null) return result
	const detail = orderDetail.value as OrderItem

	// 优先使用后端落库的结构化明细行
	if (detail.items.length > 0) {
		for (let index = 0; index < detail.items.length; index += 1) {
			const line: OrderLine = detail.items[index]
			const title = line.name != '' ? line.name : (line.barcode != '' ? '商品 ' + line.barcode : '商品行 ' + line.line_no.toString())
			result.push({
				id: 'line-' + line.line_no.toString(),
				title: title,
				subtitle: '条码 ' + stringValue(line.barcode, '-'),
				barcode: line.barcode,
				amountText: (line.amount == '' ? '-' : line.amount + ' zł'),
				unitPriceText: stringValue(line.unit_price, '-'),
				quantityText: 'x ' + quantityText(line.quantity),
				tags: [stringValue(line.match_type_display, line.match_type)] as string[],
			} as UTSJSONObject)
		}
		return result
	}

	// 历史订单兜底：从 payload 解析
	const rows = getPayloadItems(detail.payload)
	for (let index = 0; index < rows.length; index += 1) {
		const row = rows[index]
		const name = stringValue(row['name'], stringValue(row['product_name'], stringValue(row['title'])))
		const barcode = stringValue(row['barcode'])
		const amount = stringValue(row['lineTotal'], stringValue(row['amount'], stringValue(row['total'], stringValue(row['total_amount'], '-'))))
		result.push({
			id: 'payload-' + index.toString(),
			title: name != '' ? name : (barcode != '' ? '商品 ' + barcode : '商品行 ' + (index + 1).toString()),
			subtitle: '条码 ' + stringValue(barcode, '-'),
			barcode: barcode,
			amountText: amount == '-' ? '-' : amount + ' zł',
			unitPriceText: stringValue(row['price'], stringValue(row['unit_price'], '-')),
			quantityText: 'x ' + stringValue(row['quantity'], '0'),
			tags: [] as string[],
		} as UTSJSONObject)
	}
	return result
})

const returnListItems = computed((): UTSJSONObject[] => {
	const result: UTSJSONObject[] = []
	if (orderDetail.value == null) return result
	const detail = orderDetail.value as OrderItem
	for (let index = 0; index < detail.returns.length; index += 1) {
		const item: OrderReturnBrief = detail.returns[index]
		result.push({
			id: 'return-' + item.id.toString(),
			rawId: item.id.toString(),
			title: item.return_number,
			subtitle: '时间：' + formatDateTime(item.return_time),
			amountText: '-' + item.gross_amount + ' zł',
			itemsText: item.items_count.toString() + ' 件',
			inventoryText: item.inventory_restored ? '已回补' : '未回补',
			reasonText: stringValue(item.reason, '-'),
			tags: [stringValue(item.status_display, item.status)] as string[],
		} as UTSJSONObject)
	}
	return result
})

const baseRows = computed((): UTSJSONObject[] => {
	if (orderDetail.value == null) return [] as UTSJSONObject[]
	const detail = orderDetail.value as OrderItem
	return [
		{ key: 'order_number', label: '订单号', value: orderNumberText.value } as UTSJSONObject,
		{ key: 'shop', label: '店铺', value: stringValue(detail.shop_name, detail.shop > 0 ? '店铺 #' + detail.shop.toString() : '-') } as UTSJSONObject,
		{ key: 'cashier', label: '收银员', value: cashierDisplayText.value } as UTSJSONObject,
		{ key: 'kasa_number', label: '收银台', value: stringValue(detail.kasa_number, '-') } as UTSJSONObject,
		{ key: 'order_time', label: '订单时间', value: formatDateTime(detail.order_time) } as UTSJSONObject,
		{ key: 'created_at', label: '接收时间', value: formatDateTime(detail.created_at) } as UTSJSONObject,
		{ key: 'updated_at', label: '更新时间', value: formatDateTime(detail.updated_at) } as UTSJSONObject,
	]
})

const amountRows = computed((): UTSJSONObject[] => {
	if (orderDetail.value == null) return [] as UTSJSONObject[]
	const detail = orderDetail.value as OrderItem
	return [
		{ key: 'subtotal', label: '小计', value: currencyText(detail.subtotal) } as UTSJSONObject,
		{ key: 'discount_amount', label: '折扣', value: currencyText(detail.discount_amount) } as UTSJSONObject,
		{ key: 'tax_amount', label: '税额', value: currencyText(detail.tax_amount) } as UTSJSONObject,
		{ key: 'total_amount', label: '总金额', value: currencyText(detail.total_amount) } as UTSJSONObject,
	]
})

const statusRows = computed((): UTSJSONObject[] => {
	if (orderDetail.value == null) return [] as UTSJSONObject[]
	const detail = orderDetail.value as OrderItem
	return [
		{ key: 'payment_method', label: '支付方式', value: paymentText(detail) } as UTSJSONObject,
		{ key: 'status', label: '订单状态', value: statusText(detail) } as UTSJSONObject,
		{ key: 'error_message', label: '订单错误', value: stringValue(detail.error_message, '-') } as UTSJSONObject,
		{ key: 'inventory_deducted', label: '库存已扣减', value: boolText(detail.inventory_deducted) } as UTSJSONObject,
		{ key: 'inventory_deduct_time', label: '扣减时间', value: formatDateTime(stringValue(detail.inventory_deduct_time)) } as UTSJSONObject,
		{ key: 'inventory_deduct_error', label: '扣减错误', value: stringValue(detail.inventory_deduct_error, '-') } as UTSJSONObject,
	]
})

onLoad((event: OnLoadOptions) => {
	const idValue = event['id']
	orderId.value = idValue == null ? '' : ('' + idValue)
	loadDetail()
})
</script>

<style>
.page {
	flex: 1;
	background-color: #F6F7FB;
}

.page-scroll {
	flex: 1;
	background-color: #F6F7FB;
}

.page-content {
	padding: 10px;
	padding-bottom: 96px;
}

.summary-card,
.section-card,
.state-card,
.error-card {
	background-color: #FFFFFF;
	border-radius: 8px;
	border-width: 1px;
	border-style: solid;
	border-color: #E5EAF1;
	padding: 14px;
	margin-bottom: 10px;
}

.summary-head,
.amount-line,
.action-row,
.metric-grid,
.section-head,
.info-row {
	flex-direction: row;
	align-items: center;
}

.summary-head,
.section-head,
.info-row {
	justify-content: space-between;
}

.summary-main {
	flex: 1;
	padding-right: 10px;
}

.summary-title {
	font-size: 20px;
	line-height: 26px;
	font-weight: bold;
	color: #0F172A;
}

.summary-subtitle {
	font-size: 13px;
	line-height: 18px;
	color: #64748B;
	margin-top: 4px;
}

.status-pill {
	min-width: 62px;
	height: 30px;
