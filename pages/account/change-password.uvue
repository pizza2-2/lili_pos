<template>
	<view class="page">
		<lili-universal-filter title="修改密码" :showBack="true" :showSearch="false" :showHome="false" backgroundColor="#EEF2F7" />
		<view class="page-content">
			<view class="card">
				<view class="field-row">
					<text class="field-label">当前密码</text>
					<input class="field-input" :value="oldPassword" placeholder="请输入当前密码" :password="true" @input="onOldInput" />
				</view>
				<view class="field-row">
					<text class="field-label">新密码</text>
					<input class="field-input" :value="newPassword" placeholder="至少 6 位" :password="true" @input="onNewInput" />
				</view>
				<view class="field-row">
					<text class="field-label">确认新密码</text>
					<input class="field-input" :value="confirmPassword" placeholder="再次输入新密码" :password="true" @input="onConfirmInput" />
				</view>
			</view>
			<view class="save-btn" @click="handleSubmit">
				<text class="save-btn-text">确认修改</text>
			</view>
			<text class="hint-text">修改成功后需要用新密码重新登录</text>
		</view>
	</view>
</template>

<script setup lang="uts">
import { changeMyPassword } from '@/pkg/api/modules/accounts'
import { clearAuthState } from '@/store/auth'
import { showErrorToast } from '@/pkg/util/toast.uts'

const oldPassword = ref('')
const newPassword = ref('')
const confirmPassword = ref('')
const submitting = ref(false)

function onOldInput(event: UniInputEvent) { oldPassword.value = event.detail.value }
function onNewInput(event: UniInputEvent) { newPassword.value = event.detail.value }
function onConfirmInput(event: UniInputEvent) { confirmPassword.value = event.detail.value }

function parseErrorMessage(error: any, fallback: string): string {
	if (error == null) return fallback
	const text = JSON.stringify(error)
	if (text == null || text == '' || text == '{}') return fallback
	try {
		const parsed = JSON.parseObject<UTSJSONObject>(text)
		if (parsed != null) {
			const message = parsed!['message']
			if (message != null && ('' + message) != '') return '' + message
		}
	} catch (parseError) {
		return text
	}
	return text
}

async function executeSubmit() {
	if (submitting.value) return
	if (oldPassword.value == '') {
		uni.showToast({ title: '请输入当前密码', icon: 'none', duration: 3000 })
		return
	}
	if (newPassword.value.length < 6) {
		uni.showToast({ title: '新密码至少 6 位', icon: 'none', duration: 3000 })
		return
	}
	if (newPassword.value != confirmPassword.value) {
		uni.showToast({ title: '两次输入的新密码不一致', icon: 'none', duration: 3000 })
		return
	}
	submitting.value = true
	try {
		await changeMyPassword(oldPassword.value, newPassword.value, confirmPassword.value)
		uni.showToast({ title: '密码已修改，请重新登录', icon: 'success' })
		clearAuthState()
		setTimeout(() => {
			uni.reLaunch({ url: '/pages/login/login' })
		}, 600)
	} catch (error) {
		showErrorToast(parseErrorMessage(error, '密码修改失败'))
	} finally {
		submitting.value = false
	}
}

function handleSubmit() {
	executeSubmit()
}
</script>

<style>
.page { flex: 1; background-color: #EEF2F7; }
.page-content { padding: 10px; }
.card { background-color: #FFFFFF; border-radius: 10px; padding: 14px; margin-bottom: 12px; }
.field-row { flex-direction: row; align-items: center; margin-top: 10px; }
.field-label { width: 90px; font-size: 14px; line-height: 20px; color: #475569; }
.field-input { flex: 1; height: 40px; border-radius: 8px; background-color: #F8FAFC; border-width: 1px; border-style: solid; border-color: #E2E8F0; padding-left: 10px; padding-right: 10px; font-size: 14px; }
.save-btn { height: 46px; border-radius: 10px; background-color: #0F172A; align-items: center; justify-content: center; }
.save-btn-text { font-size: 15px; color: #FFFFFF; font-weight: bold; }
.hint-text { font-size: 12px; line-height: 17px; color: #94A3B8; margin-top: 10px; text-align: center; }
</style>
