<template>
	<view class="page">
		<lili-universal-filter
			:title="pageTitle"
			searchPlaceholder="模板名称、说明"
			:searchValue="keyword"
			:showBack="true"
			:showSearch="true"
			:showHome="true"
			:homePath="homePath"
			@searchInput="handleSearchInput"
			@searchConfirm="handleSearchConfirm"
			@searchClear="handleSearchClear"
		/>

		<scroll-view class="page-scroll" scroll-y="true">
			<view class="page-content">
				<view v-if="errorMessage != '' && !isLoading" class="error-card">
					<text class="error-title">加载失败</text>
					<text class="error-desc">{{ errorMessage }}</text>
					<view class="retry-btn" @click="loadTemplates()">
						<text class="retry-btn-text">重新加载</text>
					</view>
				</view>

				<lili-UniversalList
					:items="listItems"
					keyField="id"
					titleField="name"
					subtitleField="subtitle"
					metaField="statusText"
					tagField="tags"
					:fields="fieldConfig"
					:loading="isLoading"
					loadingText="正在加载标签模板"
					:keepContentOnLoading="true"
					inlineLoadingText="标签模板刷新中..."
					:emptyText="emptyText"
					emptyIcon="◎"
					:showMenu="true"
					:menuActions="menuActions"
					:showChevron="false"
					:showPagination="true"
					:currentPage="currentPage"
					:totalPages="totalPages"
					:totalCount="totalCount"
					summaryTitle="模板概览"
					:summaryItems="summaryItems"
					:summaryCollapsedByDefault="true"
					:showFloatingAdd="pageMode != 'print'"
					floatingAddText="新增"
					@item-click="handleItemClick"
					@menu="handleMenu"
					@page-change="handlePageChange"
					@floating-add="handleCreateTemplate"
				/>
			</view>
		</scroll-view>

		<page-container
			:show="printPopupVisible"
			position="bottom"
			:round="true"
			:overlay="true"
			:duration="240"
			overlay-style="background-color: rgba(15, 23, 42, 0.42);"
			custom-style="background-color: #FFFFFF;"
			@clickoverlay="closePrintPopup"
		>
			<view class="print-panel">
				<view class="print-handle"></view>
				<view class="print-head">
					<view>
						<text class="print-title">确认打印</text>
						<text class="print-subtitle">{{ selectedTemplateName }}</text>
					</view>
					<view class="print-close" @click="closePrintPopup">
						<text class="print-close-text">关闭</text>
					</view>
				</view>
				<view class="print-content-card">
					<view v-if="printPreviewFields.length == 0" class="print-empty-row">
						<text class="print-empty-text">当前模板没有需要核对的字段</text>
					</view>
					<view v-for="field in printPreviewFields" :key="field.key" class="print-row">
						<text class="print-label">{{ field.label }}</text>
						<text :class="field.emphasis ? 'print-value print-value-emphasis' : 'print-value'">{{ field.value }}</text>
					</view>
				</view>
				<view class="print-copies-wrap">
					<lili-print-copies-stepper
						:value="printCopiesText"
						title="打印页数"
						desc="一个商品可一次贴上多张价格"
						@change="handlePrintCopiesChange"
					/>
				</view>
				<view class="print-actions">
					<view class="print-secondary-btn" @click="closePrintPopup">
						<text class="print-secondary-text">取消</text>
					</view>
					<view class="print-primary-btn" @click="confirmPrintProduct">
						<text class="print-primary-text">{{ printing ? '打印中...' : '打印' }}</text>
					</view>
				</view>
			</view>
		</page-container>
	</view>
</template>

<script setup lang="uts">
import { computed } from 'vue'
import { takeLatestResponseMessage } from '@/pkg/api/index.uts'
import { ProductItem, PrintTemplateItem, PrintTemplateListResponse, getProductDetail, getPrintTemplateList, setDefaultPrintTemplate } from '@/pkg/api/modules/products.uts'
import { getConnectedPrinter, printLabelBitmap } from '@/uni_modules/lili-label-printer/index.uts'
import { showErrorToast } from '@/pkg/util/toast.uts'

type PrintPreviewField = {
	key: string
	label: string
	value: string
	emphasis: boolean
}

const templateListRefreshStorageKey = 'refresh:pages:label-templates:index'

const keyword = ref('')
const isLoading = ref(false)
const errorMessage = ref('')
const templates = ref<PrintTemplateItem[]>([])
const currentPage = ref(1)
const totalPages = ref(1)
const totalCount = ref(0)
const pageSize = ref(20)
const pageMode = ref('manage')
const productId = ref('')
const printProduct = ref<ProductItem | null>(null)
const printPopupVisible = ref(false)
const selectedPrintTemplate = ref<PrintTemplateItem | null>(null)
const printing = ref(false)
const printCopiesText = ref('1')

const fieldConfig = computed((): UTSJSONObject[] => {
	const config: UTSJSONObject[] = [
		{ key: 'typeText', label: '类型' } as UTSJSONObject,
		{ key: 'sizeText', label: '纸张' } as UTSJSONObject,
		{ key: 'densityText', label: '密度' } as UTSJSONObject,
		{ key: 'elementText', label: '元素' } as UTSJSONObject,
		{ key: 'updatedText', label: '更新' } as UTSJSONObject,
	]
	if (pageMode.value == 'print') {
		config.push({ key: 'printText', label: '操作' } as UTSJSONObject)
	}
	return config
})

const menuActions = computed((): UTSJSONObject[] => {
	if (pageMode.value == 'print') {
		return [
			{ key: 'print', text: '打印' } as UTSJSONObject,
			{ key: 'reload', text: '刷新' } as UTSJSONObject,
		]
	}
	return [
		{ key: 'detail', text: '详情' } as UTSJSONObject,
		{ key: 'edit', text: '编辑' } as UTSJSONObject,
		{ key: 'set-default', text: '设为默认' } as UTSJSONObject,
		{ key: 'reload', text: '刷新' } as UTSJSONObject,
	]
})

function stringValue(value: any | null, fallback: string = ''): string {
	if (value == null) return fallback
	const text = '' + value
	return text == '' ? fallback : text
}

function parseErrorMessage(error: any, fallback: string): string {
	const text = stringValue(error)
	if (text == '' || text == '[object Object]') return fallback
	if (text.startsWith('Error: ')) return text.substring(7)
	return text
}

function numberValue(value: any | null, fallback: number): number {
	const text = stringValue(value)
	if (text == '') return fallback
	const result = parseFloat(text)
	if (isNaN(result)) return fallback
	return result
}

function intValue(value: any | null, fallback: number): number {
	const text = stringValue(value)
	if (text == '') return fallback
	const result = parseInt(text)
	if (isNaN(result)) return fallback
	return result
}

function boolValue(value: any | null, fallback: boolean): boolean {
	if (value == null) return fallback
	const text = '' + value
	if (text == 'true') return true
	if (text == 'false') return false
	return fallback
}

function activeProduct(): ProductItem | null {
	return printProduct.value
}

function productNameRawText(): string {
	const product = activeProduct()
	if (product == null) return ''
	if (product.name_cn != '') return product.name_cn
	if (product.name_en != '') return product.name_en
	if (product.name_other != '') return product.name_other
	return ''
}

function productNameText(): string {
	const name = productNameRawText()
	if (name != '') return name
	return '未命名商品'
}

function productOriginalPriceText(): string {
	const product = activeProduct()
	if (product == null) return '0.00'
	return stringValue(product.base_sales_price, '0.00')
}

function productDiscountPriceText(): string {
	const product = activeProduct()
	if (product == null) return '0.00'
	const discount = product.discount_info
	if (discount != null && discount.has_discount && discount.final_price != '') {
		return discount.final_price
	}
	return stringValue(product.base_sales_price, '0.00')
}

function productPriceRawText(source: string): string {
	const product = activeProduct()
	if (product == null) return ''
	if (source == 'discount_price') {
		const discount = product.discount_info
		if (discount != null && discount.has_discount && discount.final_price != '') return discount.final_price
		return stringValue(product.base_sales_price)
	}
	return stringValue(product.base_sales_price)
}

function productBarcodeRawText(): string {
	const product = activeProduct()
	if (product == null) return ''
	if (product.barcode != '') return product.barcode
	if (product.sku != '') return product.sku
	return ''
}

function productBarcodeText(): string {
	const barcode = productBarcodeRawText()
	if (barcode != '') return barcode
	return '-'
}

function productSkuText(): string {
	const product = activeProduct()
	if (product == null) return '-'
	return product.sku == '' ? '-' : product.sku
}

function onlyDigits(value: string): string {
	let result = ''
	for (let index = 0; index < value.length; index += 1) {
		const char = value.substring(index, index + 1)
		if (char >= '0' && char <= '9') result = result + char
	}
	return result
}

function isValidEan13Input(value: string): boolean {
	const digits = onlyDigits(value)
	if (digits.length == 12) return true
	if (digits.length != 13) return false
	let sum = 0
	for (let index = 0; index < 12; index += 1) {
		const digit = parseInt(digits.substring(index, index + 1))
		sum += index % 2 == 0 ? digit : digit * 3
	}
	const check = (10 - (sum % 10)) % 10
	return check.toString() == digits.substring(12, 13)
}

function isPriceSource(source: string): boolean {
	return source == 'price' || source == 'base_sales_price' || source == 'discount_price'
}

function isGraphicElementType(type: string): boolean {
	return type == 'hline' || type == 'vline' || type == 'rect'
}

function isSupportedPrintElementType(type: string): boolean {
	return type == 'text' || type == 'barcode' || isGraphicElementType(type)
}

function isBlankPrintText(value: string): boolean {
	const text = value.trim()
	return text == '' || text == '-'
}

function isValidMoneyText(value: string): boolean {
	const text = value.trim()
	if (text == '') return false
	const parsed = parseFloat(text)
	return !isNaN(parsed) && parsed >= 0
}

function isValidCode128Text(value: string): boolean {
	const text = value.trim()
	if (text == '') return false
	if (text.length > 80) return false
	for (let index = 0; index < text.length; index += 1) {
		const code = text.charCodeAt(index)!
		if (code < 32 || code > 126) return false
	}
	return true
}

function elementDisplayName(source: UTSJSONObject, index: number): string {
	const label = stringValue(source['label'])
	if (label != '') return label
	const key = stringValue(source['key'])
	if (key != '') return key
	return '元素 ' + (index + 1).toString()
}

function validateElementNumber(source: UTSJSONObject, index: number, key: string, minValue: number): string {
	const raw = stringValue(source[key])
	if (raw == '') return elementDisplayName(source, index) + ' 缺少 ' + key
	const value = parseFloat(raw)
	if (isNaN(value)) return elementDisplayName(source, index) + ' 的 ' + key + ' 必须是数字'
	if (value < minValue) return elementDisplayName(source, index) + ' 的 ' + key + ' 不能小于 ' + minValue.toString()
	return ''
}

function validateElementLayout(source: UTSJSONObject, index: number, paperWidth: number, paperHeight: number): string {
	const type = stringValue(source['type'], 'text')
	if (!isSupportedPrintElementType(type)) return elementDisplayName(source, index) + ' 类型不支持'
	const numberKeys = ['x', 'y', 'width', 'height']
	for (let numberIndex = 0; numberIndex < numberKeys.length; numberIndex += 1) {
		const minValue = numberKeys[numberIndex] == 'x' || numberKeys[numberIndex] == 'y' ? 0 : 0.01
		const error = validateElementNumber(source, index, numberKeys[numberIndex], minValue)
		if (error != '') return error
	}
	const x = numberValue(source['x'], 0)
	const y = numberValue(source['y'], 0)
	const width = numberValue(source['width'], 0)
	const height = numberValue(source['height'], 0)
	if (x + width > paperWidth + 0.05) return elementDisplayName(source, index) + ' 超出纸张宽度'
	if (y + height > paperHeight + 0.05) return elementDisplayName(source, index) + ' 超出纸张高度'
	if (isGraphicElementType(type)) {
		const lineWidth = numberValue(source['lineWidth'], numberValue(source['line_width'], 0.4))
		if (lineWidth <= 0) return elementDisplayName(source, index) + ' 线宽必须大于 0'
		if (type == 'hline' && width < 0.5) return elementDisplayName(source, index) + ' 横线长度过短'
		if (type == 'vline' && height < 0.5) return elementDisplayName(source, index) + ' 竖线长度过短'
	}
	return ''
}

function productRequiredValueForSource(source: string): string {
	if (source == 'name') return productNameRawText()
	if (isPriceSource(source)) return productPriceRawText(source)
	if (source == 'barcode') return productBarcodeRawText()
	if (source == 'sku' || source == 'kod') return productSkuText()
	return ''
}

function printValueForSource(source: string, fallback: string): string {
	if (source == 'name') return productNameText()
	if (source == 'price') return productDiscountPriceText()
	if (source == 'base_sales_price') return productOriginalPriceText()
	if (source == 'discount_price') return productDiscountPriceText()
	if (source == 'barcode') return productBarcodeText()
	if (source == 'sku') return productSkuText()
	if (source == 'kod') return productSkuText()
	return fallback
}

function validatePrintElements(item: PrintTemplateItem): string {
	if (item.elements.length == 0) return '模板没有可打印元素'
	const paperWidth = numberValue(item.paper_width_mm, 0)
	const paperHeight = numberValue(item.paper_height_mm, 0)
	if (paperWidth <= 0 || paperHeight <= 0) return '模板纸张尺寸无效'
	if (item.dots_per_mm != 8 && item.dots_per_mm != 12) return '模板打印密度无效'
	for (let index = 0; index < item.elements.length; index += 1) {
		const source = item.elements[index]
		const layoutError = validateElementLayout(source, index, paperWidth, paperHeight)
		if (layoutError != '') return layoutError
		const elementSource = stringValue(source['source'])
		const type = stringValue(source['type'], 'text')
		const fallbackContent = stringValue(source['content'])
		if (!isGraphicElementType(type) && elementSource != '' && elementSource != 'custom') {
			const requiredValue = productRequiredValueForSource(elementSource)
			if (isBlankPrintText(requiredValue)) return elementDisplayName(source, index) + ' 缺失，无法打印'
			if (isPriceSource(elementSource) && !isValidMoneyText(requiredValue)) return elementDisplayName(source, index) + ' 不是有效金额'
		}
		const content = printValueForSource(elementSource, fallbackContent)
		if (!isGraphicElementType(type) && isBlankPrintText(content)) return elementDisplayName(source, index) + ' 内容为空'
		const barcodeType = stringValue(source['barcodeType'], stringValue(source['barcode_type'], 'EAN13')).toUpperCase()
		if (type == 'barcode' && barcodeType == 'EAN13' && !isValidEan13Input(content)) {
			return elementDisplayName(source, index) + ' 不是有效 EAN13，请使用 12 位数字或正确校验位的 13 位数字'
		}
		if (type == 'barcode' && barcodeType != 'EAN13' && !isValidCode128Text(content)) {
			return elementDisplayName(source, index) + ' 不是有效 CODE128 内容'
		}
	}
	return ''
}

function printLabelForSource(source: UTSJSONObject, index: number): string {
	const elementLabel = stringValue(source['label'])
	if (elementLabel != '') return elementLabel
	const elementSource = stringValue(source['source'])
	if (elementSource == 'name') return '商品名称'
	if (elementSource == 'price') return '打印价格'
	if (elementSource == 'base_sales_price') return '原价'
	if (elementSource == 'discount_price') return '折扣价'
	if (elementSource == 'barcode') return '条码'
	if (elementSource == 'sku' || elementSource == 'kod') return 'KOD'
	return '字段 ' + (index + 1).toString()
}

function printFieldKey(source: UTSJSONObject, index: number): string {
	const elementSource = stringValue(source['source'])
	if (elementSource != '' && elementSource != 'custom') return elementSource
	const elementKey = stringValue(source['key'])
	return elementKey == '' ? ('custom-' + index.toString()) : elementKey
}

function isEmphasisPrintSource(source: string): boolean {
	return source == 'price' || source == 'discount_price' || source == 'base_sales_price'
}

function hasPreviewField(fields: PrintPreviewField[], key: string): boolean {
	for (let index = 0; index < fields.length; index += 1) {
		if (fields[index].key == key) return true
	}
	return false
}

function buildPrintPreviewFields(): PrintPreviewField[] {
	const item = selectedPrintTemplate.value
	if (item == null) return [] as PrintPreviewField[]
	const result: PrintPreviewField[] = []
	for (let index = 0; index < item.elements.length; index += 1) {
		const source = item.elements[index]
		const type = stringValue(source['type'])
		if (type == 'hline' || type == 'vline' || type == 'rect') continue
		const key = printFieldKey(source, index)
		if (hasPreviewField(result, key)) continue
		const elementSource = stringValue(source['source'])
		const fallbackContent = stringValue(source['content'])
		result.push({
			key: key,
			label: printLabelForSource(source, index),
			value: printValueForSource(elementSource, fallbackContent),
			emphasis: isEmphasisPrintSource(elementSource),
		} as PrintPreviewField)
	}
	return result
}

function selectedTemplateText(): string {
	const item = selectedPrintTemplate.value
	if (item == null) return '未选择模板'
	return item.name
}

const pageTitle = computed((): string => {
	return pageMode.value == 'print' ? '选择打印模板' : '标签模板'
})

const homePath = computed((): string => {
	return pageMode.value == 'print' ? '/pages/tabbar/products' : '/pages/tabbar/settings'
})

const selectedTemplateName = computed((): string => {
	return selectedTemplateText()
})

const printPreviewFields = computed((): PrintPreviewField[] => {
	return buildPrintPreviewFields()
})

function formatDateText(value: string): string {
	if (value == '') return '-'
	if (value.length >= 16) return value.substring(0, 16)
	return value
}

function templateTypeText(item: PrintTemplateItem): string {
	if (item.template_type_display != '') return item.template_type_display
	if (item.template_type == 'product_label') return '商品标签'
	if (item.template_type == 'price_label') return '价格标签'
	if (item.template_type == 'barcode_label') return '条码标签'
	return '自定义'
}

function sizeText(item: PrintTemplateItem): string {
	return stringValue(item.paper_width_mm, '0') + ' x ' + stringValue(item.paper_height_mm, '0') + ' mm'
}

function elementCountText(item: PrintTemplateItem): string {
	return item.elements.length.toString() + ' 个元素'
}

function templateToListItem(item: PrintTemplateItem): UTSJSONObject {
	const tags: string[] = []
	if (item.is_default) tags.push('默认')
	if (item.is_active) tags.push('启用')
	else tags.push('停用')
	if (pageMode.value == 'print') tags.push('打印')
	return {
		id: item.id.toString(),
		rawId: item.id.toString(),
		name: item.name,
		subtitle: item.description == '' ? '无说明' : item.description,
		statusText: item.is_default ? '默认模板' : (item.is_active ? '启用' : '停用'),
		typeText: templateTypeText(item),
		sizeText: sizeText(item),
		densityText: item.dots_per_mm.toString() + ' dots/mm · ' + item.printer_language,
		elementText: elementCountText(item),
		updatedText: formatDateText(item.updated_at),
		printText: pageMode.value == 'print' ? '点击打印' : '',
		tags: tags,
	} as UTSJSONObject
}

const listItems = computed((): UTSJSONObject[] => {
	const result: UTSJSONObject[] = []
	for (let i = 0; i < templates.value.length; i += 1) {
		result.push(templateToListItem(templates.value[i]))
	}
	return result
})

const summaryItems = computed((): UTSJSONObject[] => {
	let defaultCount = 0
	let activeCount = 0
	for (let i = 0; i < templates.value.length; i += 1) {
		const item = templates.value[i]
		if (item.is_default) defaultCount += 1
		if (item.is_active) activeCount += 1
	}
	return [
		{ key: 'total', label: '记录数', value: totalCount.value.toString() } as UTSJSONObject,
		{ key: 'active', label: '本页启用', value: activeCount.toString() } as UTSJSONObject,
		{ key: 'default', label: '本页默认', value: defaultCount.toString() } as UTSJSONObject,
	]
})

const emptyText = computed((): string => {
	if (keyword.value != '') return '没有匹配的标签模板'
	if (pageMode.value == 'print') return '暂无可打印标签模板'
	return '暂无标签模板'
})

function applyTemplateResponse(response: PrintTemplateListResponse) {
	templates.value = response.results
	currentPage.value = response.current_page
	totalPages.value = response.total_pages
	totalCount.value = response.total_count
	pageSize.value = response.page_size
}

async function loadTemplates() {
	if (isLoading.value) return
	isLoading.value = true
	errorMessage.value = ''
	try {
		const response = await getPrintTemplateList({
			search: keyword.value == '' ? null : keyword.value,
			page: currentPage.value,
			page_size: pageSize.value,
			template_type: null,
			is_active: null,
			is_default: null,
		})
		applyTemplateResponse(response)
	} catch (error) {
		templates.value = [] as PrintTemplateItem[]
		currentPage.value = 1
		totalPages.value = 1
		totalCount.value = 0
		errorMessage.value = parseErrorMessage(error, '标签模板列表加载失败')
	} finally {
		isLoading.value = false
	}
}

function openTemplateForm(id: string) {
	if (id == '') {
		uni.navigateTo({ url: '/pages/label-templates/from' })
		return
	}
	uni.navigateTo({ url: '/pages/label-templates/from?id=' + id })
}

function openTemplateDetail(id: string) {
	if (id == '') return
	uni.navigateTo({ url: '/pages/label-templates/details/index?id=' + id })
}

function templateById(id: string): PrintTemplateItem | null {
	for (let index = 0; index < templates.value.length; index += 1) {
		const item = templates.value[index]
		if (item.id.toString() == id) {
			return item
		}
	}
	return null
}

async function loadPrintProduct() {
	if (productId.value == '') return
	try {
		printProduct.value = await getProductDetail(productId.value)
	} catch (error) {
		showErrorToast(parseErrorMessage(error, '商品信息加载失败'))
	}
}

function openPrintConfirm(id: string) {
	const item = templateById(id)
	if (item == null) return
	selectedPrintTemplate.value = item
	printCopiesText.value = item.copies_default <= 0 ? '1' : item.copies_default.toString()
	printPopupVisible.value = true
}

function closePrintPopup() {
	if (printing.value) return
	printPopupVisible.value = false
}

function mappedPrintElement(source: UTSJSONObject): UTSJSONObject {
	const elementSource = stringValue(source['source'])
	const fallbackContent = stringValue(source['content'])
	return {
		type: stringValue(source['type'], 'text'),
		x: numberValue(source['x'], 0),
		y: numberValue(source['y'], 0),
		width: numberValue(source['width'], 10),
		height: numberValue(source['height'], 6),
		fontSize: numberValue(source['fontSize'], 4),
		content: printValueForSource(elementSource, fallbackContent),
		source: elementSource,
		barcodeType: stringValue(source['barcodeType'], stringValue(source['barcode_type'], 'EAN13')),
		showText: boolValue(source['showText'], true),
		lineWidth: numberValue(source['lineWidth'], 1),
	} as UTSJSONObject
}

function buildProductPrintElements(item: PrintTemplateItem): UTSJSONObject[] {
	const result: UTSJSONObject[] = []
	for (let index = 0; index < item.elements.length; index += 1) {
		result.push(mappedPrintElement(item.elements[index]))
	}
	return result
}

function handlePrintCopiesChange(value: string) {
	printCopiesText.value = value
}

function printCopiesValue(): number {
	const copies = intValue(printCopiesText.value, 1)
	if (copies <= 0) return 1
	if (copies > 999) return 999
	return copies
}

function connectedPrinterAddress(): string {
	const connected = getConnectedPrinter()
	if (!connected.success || connected.data == null) {
		return ''
	}
	const data = connected.data as UTSJSONObject
	return stringValue(data['address'])
}

function goPrinterSettings() {
	uni.showToast({ title: '请先连接打印机', icon: 'none', duration: 3500 })
	setTimeout(() => {
		uni.navigateTo({
			url: '/pages/printer-settings/index',
		})
	}, 450)
}

function confirmPrintProduct() {
	if (printing.value) return
	const item = selectedPrintTemplate.value
	if (item == null) return
	const validationMessage = validatePrintElements(item)
	if (validationMessage != '') {
		uni.showToast({ title: validationMessage, icon: 'none', duration: 3500 })
		return
	}
	const address = connectedPrinterAddress()
	if (address == '') {
		closePrintPopup()
		goPrinterSettings()
		return
	}
	printing.value = true
	const response = printLabelBitmap({
		address: address,
		paperWidthMm: numberValue(item.paper_width_mm, 30),
		paperHeightMm: numberValue(item.paper_height_mm, 20),
		dotsPerMm: item.dots_per_mm,
		elements: buildProductPrintElements(item),
		chunkSize: 1024,
		delayMs: 20,
		copies: printCopiesValue(),
	})
	printing.value = false
	if (response.success) {
		uni.showToast({ title: '已发送打印', icon: 'success' })
		closePrintPopup()
		return
	}
	showErrorToast(response.message == '' ? '打印失败' : response.message)
}

function handleSearchInput(value: string) {
	keyword.value = value
}

function handleSearchConfirm(value: string) {
	keyword.value = value
	currentPage.value = 1
	loadTemplates()
}

function handleSearchClear() {
	keyword.value = ''
	currentPage.value = 1
	loadTemplates()
}

function handlePageChange(payload: UTSJSONObject) {
	const pageValue = payload['page']
	if (pageValue == null) return
	const nextPage = parseInt('' + pageValue)
	if (isNaN(nextPage) || nextPage <= 0 || nextPage == currentPage.value) return
	currentPage.value = nextPage
	loadTemplates()
}

function handleItemClick(payload: UTSJSONObject) {
	const item = payload['item']
	if (item == null) return
	const itemObject = item as UTSJSONObject
	const templateId = stringValue(itemObject['rawId'])
	if (pageMode.value == 'print') {
		openPrintConfirm(templateId)
		return
	}
	openTemplateDetail(templateId)
}

async function runSetDefault(id: string) {
	if (id == '') return
	try {
		await setDefaultPrintTemplate(id)
		uni.showToast({ title: takeLatestResponseMessage('已设置默认模板'), icon: 'success' })
		loadTemplates()
	} catch (error) {
		showErrorToast(parseErrorMessage(error, '设置默认模板失败'))
	}
}

function handleMenu(payload: UTSJSONObject) {
	const action = payload['action']
	const item = payload['item']
	if (action == null || item == null) return
	const actionObject = action as UTSJSONObject
	const itemObject = item as UTSJSONObject
	const key = stringValue(actionObject['key'])
	const templateId = stringValue(itemObject['rawId'])
	if (key == 'print') {
		openPrintConfirm(templateId)
		return
	}
	if (key == 'detail') {
		openTemplateDetail(templateId)
		return
	}
	if (key == 'edit') {
		openTemplateForm(templateId)
		return
	}
	if (key == 'set-default') {
		runSetDefault(templateId)
		return
	}
	if (key == 'reload') {
		loadTemplates()
	}
}

function handleCreateTemplate() {
	openTemplateForm('')
}

function consumeRefreshFlag() {
	const value = uni.getStorageSync(templateListRefreshStorageKey)
	if (value == '1') {
		uni.removeStorageSync(templateListRefreshStorageKey)
		loadTemplates()
	}
}

onLoad((query: OnLoadOptions) => {
	const modeValue = stringValue(query['mode'])
	const productValue = stringValue(query['product'], stringValue(query['id']))
	if (modeValue == 'print') {
		pageMode.value = 'print'
		productId.value = productValue
		loadPrintProduct()
	}
	loadTemplates()
})

onShow(() => {
	consumeRefreshFlag()
})
</script>

<style>
.page { flex: 1; background-color: #EEF2F7; }
.page-scroll { flex: 1; }
.page-content { padding: 12px; }
.error-card { border-radius: 14px; background-color: #FFFFFF; border: 1px solid #FCA5A5; padding: 16px; margin-bottom: 10px; align-items: center; }
.error-title { font-size: 18px; color: #B91C1C; font-weight: 700; }
.error-desc { font-size: 13px; color: #7F1D1D; margin-top: 8px; text-align: center; }
.retry-btn { margin-top: 12px; height: 38px; padding-left: 18px; padding-right: 18px; border-radius: 10px; background-color: #0F172A; align-items: center; justify-content: center; }
.retry-btn-text { color: #FFFFFF; font-size: 13px; font-weight: 700; }
.print-panel { padding: 12px 14px 22px; background-color: #FFFFFF; }
.print-handle { width: 42px; height: 4px; border-radius: 2px; background-color: #CBD5E1; align-self: center; margin-bottom: 14px; }
.print-head { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 14px; }
.print-title { font-size: 20px; color: #0F172A; font-weight: 700; line-height: 28px; }
.print-subtitle { margin-top: 3px; font-size: 13px; color: #64748B; line-height: 18px; }
.print-close { height: 34px; padding-left: 14px; padding-right: 14px; border-radius: 17px; background-color: #F1F5F9; align-items: center; justify-content: center; }
.print-close-text { font-size: 13px; color: #334155; }
.print-content-card { border-radius: 8px; border-width: 1px; border-color: #DDE6F2; background-color: #F8FAFC; padding: 12px; margin-bottom: 10px; }
.print-row { flex-direction: row; align-items: flex-start; justify-content: space-between; padding-top: 9px; padding-bottom: 9px; border-bottom-width: 1px; border-bottom-color: #E2E8F0; }
.last-print-row { border-bottom-width: 0; }
.print-empty-row { min-height: 42px; align-items: center; justify-content: center; }
.print-empty-text { font-size: 13px; color: #64748B; }
.print-label { width: 78px; font-size: 13px; color: #64748B; line-height: 20px; }
.print-value { flex: 1; font-size: 14px; color: #0F172A; line-height: 20px; text-align: right; }
.print-value-emphasis { color: #B91C1C; font-weight: 700; }
.print-copies-wrap { margin-bottom: 14px; }
.print-actions { flex-direction: row; }
.print-secondary-btn { flex: 1; height: 44px; border-radius: 14px; background-color: #F1F5F9; align-items: center; justify-content: center; margin-right: 12px; }
.print-secondary-text { font-size: 15px; color: #334155; font-weight: 700; }
.print-primary-btn { flex: 1; height: 44px; border-radius: 14px; background-color: #111827; align-items: center; justify-content: center; }
.print-primary-text { font-size: 15px; color: #FFFFFF; font-weight: 700; }
</style>

