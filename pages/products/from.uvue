function applyCalculatedPrice() {
	if (productId.value == '') {
		return
	}
	const storageKey = 'calc_result:' + productId.value
	const calculatedPrice = readStorageText(storageKey)
	if (calculatedPrice == '') {
		return
	}
	uni.removeStorageSync(storageKey)
	const nextBaseSalesPrice = calculatedPrice.trim()
	productFormRef.value?.$callMethod('setFieldValue', 'base_sales_price', nextBaseSalesPrice == '' ? '0.00' : nextBaseSalesPrice)
	uni.showToast({
		title: '基础售价已填入计算结果',
		icon: 'success',
	})
}

// ── 分类规则继承状态与分类变更历史 ────────────────────────────────

const ruleOverrides = ref<UTSJSONObject>({} as UTSJSONObject)
const ruleEffective = ref<UTSJSONObject>({} as UTSJSONObject)
const categoryHistoryItems = ref<UTSJSONObject[]>([] as UTSJSONObject[])

const ruleFieldRows = ref<RuleFieldRow[]>([
	{ key: 'tax_rate', label: '税率' } as RuleFieldRow,
	{ key: 'pricing_formula', label: '价格公式' } as RuleFieldRow,
	{ key: 'print_template', label: '打印模板' } as RuleFieldRow,
	{ key: 'pos_sale_enabled', label: 'POS 可售' } as RuleFieldRow,
	{ key: 'default_min_stock_level', label: '最低库存' } as RuleFieldRow,
	{ key: 'default_reorder_point', label: '补货点' } as RuleFieldRow,
])

function isRuleOverridden(field: string): boolean {
	const value = ruleOverrides.value[field]
	if (value == null) {
		return false
	}
	const text = ('' + value).toLowerCase()
	return text == 'true' || text == '1'
}

function ruleStatusText(field: string): string {
	if (!isRuleOverridden(field)) {
		return '继承分类'
	}
	const effectiveText = stringValue(ruleEffective.value[field])
	return effectiveText == '' ? '已覆盖' : '已覆盖 · ' + effectiveText
}

function ruleTagClass(field: string): string {
	return isRuleOverridden(field) ? 'rules-tag rules-tag-override' : 'rules-tag'
}

function ruleTagTextClass(field: string): string {
	return isRuleOverridden(field) ? 'rules-tag-text rules-tag-text-override' : 'rules-tag-text'
}

async function loadCategoryRuleStatus(): Promise<void> {
	if (productId.value == '') {
		return
	}
	try {
		const raw = await request('/api/products/products/' + productId.value + '/', 'GET', {} as UTSJSONObject, false)
		const rawObject = parseObject(raw)
		if (rawObject == null) {
			return
		}
		const overridesObject = parseObject(rawObject['rule_overrides'])
		ruleOverrides.value = overridesObject == null ? {} as UTSJSONObject : overridesObject as UTSJSONObject
		const effective = {} as UTSJSONObject
		effective['tax_rate'] = stringValue(rawObject['tax_rate'])
		effective['pricing_formula'] = stringValue(rawObject['pricing_formula_name'])
		effective['print_template'] = stringValue(rawObject['print_template_name'])
		const posEnabled = rawObject['pos_sale_enabled']
		effective['pos_sale_enabled'] = posEnabled == null ? '' : (('' + posEnabled) == 'true' ? '允许' : '禁止')
		effective['default_min_stock_level'] = stringValue(rawObject['default_min_stock_level'])
		effective['default_reorder_point'] = stringValue(rawObject['default_reorder_point'])
		ruleEffective.value = effective
	} catch (error) {
	}
}

async function loadCategoryHistoryData(): Promise<void> {
	if (productId.value == '') {
		return
	}
	try {
		const response = await getProductCategoryHistory(productId.value)
		const itemsText = JSON.stringify(response['items'])
		if (itemsText == null || itemsText == '' || !itemsText.startsWith('[')) {
			categoryHistoryItems.value = [] as UTSJSONObject[]
			return
		}
		const parsed = JSON.parseArray<UTSJSONObject>(itemsText)
		categoryHistoryItems.value = parsed == null ? [] as UTSJSONObject[] : parsed
	} catch (error) {
		categoryHistoryItems.value = [] as UTSJSONObject[]
	}
}

function categoryLogName(value: any | null): string {
	const logObject = parseObject(value)
	if (logObject == null) {
		return '未分类'
	}
	const fullName = stringValue(logObject['full_name'])
	if (fullName != '') {
		return fullName
	}
	return stringValue(logObject['name'], '未分类')
}

function categoryHistoryTitle(item: UTSJSONObject): string {
	return categoryLogName(item['from_category']) + ' → ' + categoryLogName(item['to_category'])
}

function categoryHistoryReasonLabel(reason: string): string {
	if (reason == 'manual') return '手动调整'
	if (reason == 'merge') return '分类合并'
	if (reason == 'split') return '分类拆分'
	if (reason == 'import') return '批量导入'
	if (reason == 'auto_classify') return '智能归类'
	if (reason == 'batch') return '批量操作'
	return reason
}

function categoryHistoryMeta(item: UTSJSONObject): string {
	let text = categoryHistoryReasonLabel(getStringField(item, 'reason'))
	const changedBy = getStringField(item, 'changed_by')
	if (changedBy != '') {
		text = text + ' · ' + changedBy
	}
	const createdAt = getStringField(item, 'created_at')
	if (createdAt.length >= 16) {
		text = text + ' · ' + createdAt.substring(0, 16).replace('T', ' ')
	}
	return text
}

async function executeRestoreTaxRate(): Promise<void> {
	if (productId.value == '') {
		return
	}
	try {
		uni.showLoading({ title: '恢复继承中...', mask: true })
		await batchUpdateProductTaxRate([productId.value] as string[], 'inherit')
		uni.showToast({ title: '已恢复继承分类税率', icon: 'success' })
		await loadCategoryRuleStatus()
	} catch (error) {
		showErrorToast(parseErrorMessage(error, '恢复继承失败'))
	} finally {
		uni.hideLoading()
	}
}

function confirmRestoreTaxRate(): void {
	uni.showModal({
		title: '恢复继承税率',
		content: '清空该商品的税率覆盖，改为继承分类默认税率。确定吗？',
		success: (res) => {
			if (res.confirm) {
				executeRestoreTaxRate()
			}
		},
	})
}

// ── 智能归类候选区 ───────────────────────────────────────────────

function currentFormValue(key: string): string {
	const mirrored = stringValue(formMirror.value[key])
	if (mirrored != '') {
		return mirrored
	}
	return stringValue(initialData.value[key])
}

function suggestCategoryId(item: UTSJSONObject): string {
	return stringValue(item['id'])
}

function suggestCategoryName(item: UTSJSONObject): string {
	const fullName = stringValue(item['full_name'])
	return fullName == '' ? stringValue(item['name'], '推荐分类') : fullName
}

function suggestStringArray(value: any | null): string[] {
	const result: string[] = []
	if (value == null) {
		return result
	}
	const text = JSON.stringify(value)
	if (text == null || text == '' || !text.startsWith('[')) {
		return result
	}
	try {
		const parsed = JSON.parseArray<any>(text)
		if (parsed != null) {
			for (let index = 0; index < parsed.length; index += 1) {
				const itemText = stringValue(parsed[index])
				if (itemText != '') {
					result.push(itemText)
				}
			}
		}
	} catch (error) {
	}
	return result
}

function suggestReasonText(item: UTSJSONObject): string {
	const reasons = suggestStringArray(item['reasons'])
	let reasonText = ''
	for (let index = 0; index < reasons.length; index += 1) {
		if (reasonText != '') {
			reasonText = reasonText + '、'
		}
		reasonText = reasonText + reasons[index]
	}
	const score = stringValue(item['score'])
	if (score != '' && reasonText != '') {
		return '匹配度 ' + score + ' · ' + reasonText
	}
	if (score != '') {
		return '匹配度 ' + score
	}
	return reasonText
}

function suggestFirstStrategy(item: UTSJSONObject): string {
	const strategies = suggestStringArray(item['strategies'])
	return strategies.length > 0 ? strategies[0] : 'auto'
}

async function loadCategorySuggestions(): Promise<void> {
	if (suggestLoading.value) {
		return
	}
	const nameValue = currentFormValue('name_cn') != '' ? currentFormValue('name_cn') : currentFormValue('name_en')
	const barcodeValue = currentFormValue('barcode')
	const supplierValue = currentFormValue('supplier_id')
	if (productId.value == '' && nameValue == '' && barcodeValue == '') {
		uni.showToast({ title: '请先填写商品名称或条码', icon: 'none', duration: 3000 })
		return
	}
	suggestLoading.value = true
	suggestError.value = ''
	try {
		const response = await getCategoryRecommendations({
			product: productId.value == '' ? null : productId.value,
			product_id: productId.value == '' ? null : productId.value,
			name: nameValue == '' ? null : nameValue,
			query: nameValue == '' ? null : nameValue,
			barcode: barcodeValue == '' ? null : barcodeValue,
			supplier: supplierValue == '' ? null : supplierValue,
			limit: 4,
		} as CategoryRecommendationQuery)
		const itemsText = JSON.stringify(response['items'])
		if (itemsText == null || itemsText == '' || !itemsText.startsWith('[')) {
			categorySuggestions.value = [] as UTSJSONObject[]
		} else {
			const parsed = JSON.parseArray<UTSJSONObject>(itemsText)
			categorySuggestions.value = parsed == null ? [] as UTSJSONObject[] : parsed
		}
		if (categorySuggestions.value.length == 0) {
			suggestError.value = '暂无可推荐的分类，可补充商品名称后重试'
		} else {
			lastRejectReportedCategory.value = ''
			// 曝光事件：补齐推荐采纳率的分母（top1 代表本次曝光），失败不影响主流程
			if (productId.value != '') {
				const top = categorySuggestions.value[0]
				try {
					await recordCategoryRecommendationEvent({
						product: productId.value,
						recommended_category: stringValue(top['id']),
						accepted: false,
						strategy: suggestFirstStrategy(top),
						score: stringValue(top['score'], '0'),
						reasons: top['reasons'],
						context: { event: 'exposure' } as UTSJSONObject,
					} as UTSJSONObject)
				} catch (error) {
				}
			}
		}
	} catch (error) {
		suggestError.value = parseErrorMessage(error, '分类推荐失败')
	} finally {
		suggestLoading.value = false
	}
}

// 采纳记录用于推荐算法优化，失败不影响主流程
async function recordSuggestionAdoption(item: UTSJSONObject): Promise<void> {
	if (productId.value == '') {
		return
	}
	try {
		const body = {
			product: productId.value,
			recommended_category: suggestCategoryId(item),
			actual_category: suggestCategoryId(item),
			accepted: true,
			strategy: suggestFirstStrategy(item),
			score: stringValue(item['score'], '0'),
			reasons: item['reasons'],
			context: { event: 'adopted' } as UTSJSONObject,
		} as UTSJSONObject
		await recordCategoryRecommendationEvent(body)
	} catch (error) {
	}
}

function applyCategorySuggestion(item: UTSJSONObject): void {
	const idText = suggestCategoryId(item)
	if (idText == '') {
		return
	}
	const nameText = suggestCategoryName(item)
	productFormRef.value?.$callMethod('setFieldValue', 'category_id', idText)
	productFormRef.value?.$callMethod('setFieldValue', 'category_text', nameText)
	uni.showToast({ title: '已选择：' + nameText, icon: 'success' })
	recordSuggestionAdoption(item)
}

onLoad((event: OnLoadOptions) => {
	pageTaskGuard.reset()
	leaveSignal.value = 0
	const idValue = event['id']
	const copyValue = event['copy_id']
	productId.value = idValue == null ? '' : (idValue as string)
	copySourceId.value = copyValue == null ? '' : (copyValue as string)
	formMode.value = productId.value == '' ? 'create' : 'edit'
	if (formMode.value == 'edit') {
		loadProductDetailData(productId.value)
		loadCategoryRuleStatus()
		loadCategoryHistoryData()
		// 编辑模式自动生成候选分类（后端按商品 id 自行取名称/条码/供应商）
		loadCategorySuggestions()
	} else if (copySourceId.value != '') {
		loadCopiedProductData(copySourceId.value)
	}
})

onUnload(() => {
	pageTaskGuard.leave()
	uni.hideLoading()
})

onShow(() => {
	applyCalculatedPrice()
	applySelectedDiscount()
	if (consumeVariantCountRefreshFlag()) {
		refreshVariantCount()
	}
})
</script>

