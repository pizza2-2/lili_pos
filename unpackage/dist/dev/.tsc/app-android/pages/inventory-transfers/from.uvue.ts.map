<template>
	<view class="page">
		<lili-universal-filter
			:title="pageTitle"
			:showBack="true"
			:showSearch="false"
			:showHome="true"
			homePath="/pages/inventory-transfers/index"
			backgroundColor="#EEF2F7"
		/>
		<view class="page-content">
			<lili-UniversaForm
				:mode="formMode"
				:formSections="formSections"
				:initialData="initialData"
				:leaveSignal="leaveSignal"
				@submit="handleSubmit"
				@cancel="handleCancel"
				@discard-leave="handleDiscardLeave"
				@save-request="handleSaveRequest"
				@dirty-change="handleDirtyChange"
				@form-change="handleFormChange"
				@bottom-select-add="handleBottomSelectAdd"
				@bottom-select-edit="handleBottomSelectEdit"
			>
				<template #field-transfer_overview="{ value }">
					<view class="transfer-card">
						<view class="transfer-card-head">
							<view class="transfer-title-wrap">
								<text class="transfer-title">{{ transferNumberText }}</text>
								<text class="transfer-subtitle">{{ transferRouteText }}</text>
							</view>
							<text class="transfer-status">{{ transferStatusText }}</text>
						</view>
						<view class="transfer-metrics">
							<view class="transfer-metric">
								<text class="transfer-metric-label">调拨总数</text>
								<text class="transfer-metric-value">{{ totalQuantityText }}</text>
							</view>
							<view class="transfer-metric">
								<text class="transfer-metric-label">已调拨</text>
								<text class="transfer-metric-value">{{ transferredQuantityText }}</text>
							</view>
							<view class="transfer-metric transfer-metric-last">
								<text class="transfer-metric-label">明细数</text>
								<text class="transfer-metric-value">{{ itemsCountText }}</text>
							</view>
						</view>
					</view>
				</template>
			</lili-UniversaForm>
		</view>
	</view>
</template>

<script setup lang="uts">
import { computed } from 'vue'
import { request, takeLatestResponseMessage } from '@/pkg/api/index.uts'
import { getInventoryTransferDetail, InventoryMutationData, updateInventoryTransfer } from '@/pkg/api/modules/inventory'

function normalizeDateNumber(value: number): string {
	if (value < 10) return '0' + value
	return '' + value
}

function todayDateText(): string {
	const now = new Date()
	return now.getFullYear().toString() + '-' + normalizeDateNumber(now.getMonth() + 1) + '-' + normalizeDateNumber(now.getDate())
}

function initialFormData(): UTSJSONObject {
	return {
		transfer_overview: '',
		transfer_number: '',
		status: 'DRAFT',
		status_text: '草稿',
		total_quantity: '0',
		transferred_quantity: '0',
		items_count: '0',
		from_location: '',
		from_location_text: '',
		to_location: '',
		to_location_text: '',
		transfer_date: todayDateText(),
		remark: '',
		item_product: '',
		item_product_text: '',
		item_product_image: '',
		item_quantity: '1',
		item_notes: '',
	} as UTSJSONObject
}

function stringValue(value: any | null, fallback: string = ''): string {
	if (value == null) return fallback
	const text = '' + value
	if (text == '') return fallback
	return text
}

function intValue(value: any | null): number {
	const parsed = parseInt(stringValue(value))
	if (isNaN(parsed)) return 0
	return parsed
}

function parseErrorMessage(error: any, fallback: string): string {
	let message = fallback
	if (error != null) {
		const directMessage = (error as Error).message
		if (directMessage != null && directMessage != '') message = directMessage
		const text = JSON.stringify(error)
		if (text != null && text != '') {
			let parsedError: UTSJSONObject | null = null
			try {
				parsedError = JSON.parseObject<UTSJSONObject>(text)
			} catch (parseError) {
				parsedError = null
			}
			if (parsedError != null) {
				const rawMessage = parsedError!['message']
				if (rawMessage != null) {
					const parsedMessage = rawMessage as string
					if (parsedMessage != '') message = parsedMessage
				}
			}
			if (message == fallback && text != '{}') message = text
		}
	}
	return message
}

function parseObject(value: any | null): UTSJSONObject | null {
	if (value == null) return null
	const text = JSON.stringify(value)
	if (text == null || text == '') return null
	const trimmedText = text.trim()
	if (trimmedText == '' || trimmedText.substring(0, 1) != '{') return null
	try {
		return JSON.parseObject<UTSJSONObject>(trimmedText)
	} catch (error) {
		return null
	}
}

function parseObjectArray(value: any | null): UTSJSONObject[] {
	if (value == null) return [] as UTSJSONObject[]
	const text = JSON.stringify(value)
	if (text == null || text == '') return [] as UTSJSONObject[]
	const trimmedText = text.trim()
	if (trimmedText == '' || trimmedText.substring(0, 1) != '[') return [] as UTSJSONObject[]
	let parsed: UTSJSONObject[] | null = null
	try {
		parsed = JSON.parseArray<UTSJSONObject>(trimmedText)
	} catch (error) {
		return [] as UTSJSONObject[]
	}
	if (parsed == null) return [] as UTSJSONObject[]
	return parsed!
}

function extractRows(raw: any | null): UTSJSONObject[] {
	const directArray = parseObjectArray(raw)
	if (directArray.length > 0) return directArray
	const rawObject = parseObject(raw)
	if (rawObject == null) return [] as UTSJSONObject[]
	const dataArray = parseObjectArray(rawObject!['data'])
	if (dataArray.length > 0) return dataArray
	const resultsArray = parseObjectArray(rawObject!['results'])
	if (resultsArray.length > 0) return resultsArray
	const itemsArray = parseObjectArray(rawObject!['items'])
	if (itemsArray.length > 0) return itemsArray
	const dataObject = parseObject(rawObject!['data'])
	if (dataObject != null) {
		const nestedResults = parseObjectArray(dataObject!['results'])
		if (nestedResults.length > 0) return nestedResults
	}
	return [] as UTSJSONObject[]
}

function firstStringField(obj: UTSJSONObject, keys: string[]): string {
	for (let index = 0; index < keys.length; index += 1) {
		const text = stringValue(obj[keys[index]])
		if (text != '') return text
	}
	return ''
}

function firstImageFromStock(stock: UTSJSONObject): string {
	const direct = stringValue(stock['product_image'])
	if (direct != '') return direct
	const mediaFiles = parseObjectArray(stock['product_media_files'])
	for (let index = 0; index < mediaFiles.length; index += 1) {
		const image = firstStringField(mediaFiles[index], ['signed_thumbnail_url', 'signed_download_url', 'file_url', 'url', 'image'])
		if (image != '') return image
	}
	return ''
}

function statusLabel(status: string, display: string): string {
	if (display != '') return display
	if (status == 'APPROVED') return '已审核'
	if (status == 'COMPLETED') return '已完成'
	if (status == 'CANCELLED') return '已取消'
	return '草稿'
}

function buildOptionQuery(params: UTSJSONObject): UTSJSONObject {
	const pageValue = intValue(params['page'])
	const pageSizeValue = intValue(params['pageSize'])
	const query = {
		page: pageValue <= 0 ? 1 : pageValue,
		page_size: pageSizeValue <= 0 ? 50 : pageSizeValue,
	} as UTSJSONObject
	const keywordValue = stringValue(params['keyword'])
	if (keywordValue != '') {
		query['search'] = keywordValue
		query['keyword'] = keywordValue
	}
	return query
}

function locationOption(item: UTSJSONObject): UTSJSONObject {
	const value = firstStringField(item, ['value', 'id', 'pk'])
	let text = firstStringField(item, ['text', 'label', 'name', 'name_cn', 'title'])
	if (text == '') text = value
	const code = stringValue(item['code'])
	return {
		value: value,
		text: text,
		subtitle: code == '' ? '' : '编码 ' + code,
	} as UTSJSONObject
}

function stockOption(item: UTSJSONObject): UTSJSONObject {
	const productValue = firstStringField(item, ['product', 'product_id'])
	const title = stringValue(item['product_name'], productValue)
	const barcode = stringValue(item['product_barcode'])
	const sku = stringValue(item['product_sku'])
	const location = stringValue(item['location_name'])
	let subtitle = '可用 ' + stringValue(item['available_quantity'], stringValue(item['quantity'], '0'))
	if (location != '') subtitle = '位置 ' + location + ' / ' + subtitle
	if (barcode != '') subtitle = subtitle + ' / 条码 ' + barcode
	else if (sku != '') subtitle = subtitle + ' / SKU ' + sku
	return {
		value: productValue,
		text: title,
		subtitle: subtitle,
		image: firstImageFromStock(item),
	} as UTSJSONObject
}

function buildSelectResponse(rows: UTSJSONObject[]): UTSJSONObject {
	return {
		data: rows,
		results: rows,
		total: rows.length,
		total_count: rows.length,
	} as UTSJSONObject
}

const refreshStorageKey = 'refresh:pages:inventory-transfers:index'
const formMode = ref('edit')
const itemId = ref('')
const leaveSignal = ref(0)
const submitting = ref(false)
const initialData = ref<UTSJSONObject>(initialFormData())
const liveFormData = ref<UTSJSONObject>(initialFormData())

async function fetchLocationOptions(params: UTSJSONObject): Promise<UTSJSONObject> {
	const raw = await request('/api/inventory/locations/', 'GET', buildOptionQuery(params), true)
	const sourceRows = extractRows(raw)
	const rows: UTSJSONObject[] = []
	for (let index = 0; index < sourceRows.length; index += 1) rows.push(locationOption(sourceRows[index]))
	return buildSelectResponse(rows)
}

async function fetchProductStockOptions(params: UTSJSONObject): Promise<UTSJSONObject> {
	const query = buildOptionQuery(params)
	const fromLocation = stringValue(liveFormData.value['from_location'], stringValue(initialData.value['from_location']))
	if (fromLocation != '') query['location'] = fromLocation
	const raw = await request('/api/inventory/stocks/', 'GET', query, true)
	const sourceRows = extractRows(raw)
	const rows: UTSJSONObject[] = []
	for (let index = 0; index < sourceRows.length; index += 1) {
		const row = stockOption(sourceRows[index])
		if (stringValue(row['value']) != '') rows.push(row)
	}
	return buildSelectResponse(rows)
}

const formSections = ref<UTSJSONObject[]>([
	{
		key: 'summary',
		title: '调拨概览',
		description: '',
		defaultOpen: true,
		fields: [
			{ key: 'transfer_overview', label: '调拨信息', type: 'custom', readonly: true } as UTSJSONObject,
			{ key: 'transfer_number', label: '调拨单号', type: 'input', readonly: true, hidden: true } as UTSJSONObject,
			{ key: 'status', label: '状态值', type: 'input', readonly: true, hidden: true } as UTSJSONObject,
			{ key: 'status_text', label: '调拨状态', type: 'input', readonly: true, hidden: true } as UTSJSONObject,
			{ key: 'total_quantity', label: '调拨总数', type: 'input', readonly: true, hidden: true } as UTSJSONObject,
			{ key: 'transferred_quantity', label: '已调拨数量', type: 'input', readonly: true, hidden: true } as UTSJSONObject,
			{ key: 'items_count', label: '明细数', type: 'input', readonly: true, hidden: true } as UTSJSONObject,
		] as UTSJSONObject[],
	} as UTSJSONObject,
	{
		key: 'route',
		title: '调拨位置',
		description: '',
		defaultOpen: true,
		fields: [
			{ key: 'from_location', textKey: 'from_location_text', label: '调出位置', type: 'bottomSelect', required: true, title: '选择调出位置', placeholder: '请选择调出位置', subtitleKey: 'subtitle', showAddAction: false, showEditAction: false, fetchData: fetchLocationOptions } as UTSJSONObject,
			{ key: 'to_location', textKey: 'to_location_text', label: '调入位置', type: 'bottomSelect', required: true, title: '选择调入位置', placeholder: '请选择调入位置', subtitleKey: 'subtitle', showAddAction: false, showEditAction: false, fetchData: fetchLocationOptions } as UTSJSONObject,
		] as UTSJSONObject[],
	} as UTSJSONObject,
	{
		key: 'date_remark',
		title: '日期与备注',
		description: '',
		defaultOpen: true,
		fields: [
			{ key: 'transfer_date', label: '调拨日期', type: 'datetime', required: true, showTime: false, defaultToToday: true, placeholder: '请选择调拨日期' } as UTSJSONObject,
			{ key: 'remark', label: '备注', type: 'textarea', placeholder: '请输入备注' } as UTSJSONObject,
		] as UTSJSONObject[],
	} as UTSJSONObject,
])

const pageTitle = computed((): string => '编辑调拨单')
const transferNumberText = computed((): string => stringValue(initialData.value['transfer_number'], '调拨单'))
const transferStatusText = computed((): string => stringValue(initialData.value['status_text'], '草稿'))
const totalQuantityText = computed((): string => stringValue(initialData.value['total_quantity'], '0'))
const transferredQuantityText = computed((): string => stringValue(initialData.value['transferred_quantity'], '0'))
const itemsCountText = computed((): string => stringValue(initialData.value['items_count'], '0'))
const transferRouteText = computed((): string => {
	const fromName = stringValue(liveFormData.value['from_location_text'], stringValue(initialData.value['from_location_text'], '调出位置'))
	const toName = stringValue(liveFormData.value['to_location_text'], stringValue(initialData.value['to_location_text'], '调入位置'))
	return fromName + ' -> ' + toName
})

function markRefreshNeeded() {
	uni.setStorageSync(refreshStorageKey, '1')
}

function goBackToList() {
	leaveSignal.value = leaveSignal.value + 1
	setTimeout(() => {
		uni.navigateBack({
			delta: 1,
			fail: () => {
				uni.navigateTo({ url: '/pages/inventory-transfers/index' })
			},
		})
	}, 16)
}

function buildInitialDataFromDetail(detail: UTSJSONObject): UTSJSONObject {
	const data = initialFormData()
	data['transfer_number'] = stringValue(detail['transfer_number'])
	data['status'] = stringValue(detail['status'], 'DRAFT')
	data['status_text'] = statusLabel(stringValue(detail['status']), stringValue(detail['status_display']))
	data['total_quantity'] = stringValue(detail['total_quantity'], '0')
	data['transferred_quantity'] = stringValue(detail['transferred_quantity'], '0')
	data['from_location'] = stringValue(detail['from_location'])
	data['from_location_text'] = stringValue(detail['from_location_name'])
	data['to_location'] = stringValue(detail['to_location'])
	data['to_location_text'] = stringValue(detail['to_location_name'])
	data['transfer_date'] = stringValue(detail['transfer_date'], todayDateText())
	data['remark'] = stringValue(detail['remark'])
	const detailItems = parseObjectArray(detail['items'])
	data['items_count'] = detailItems.length.toString()
	if (detailItems.length > 0) {
		const firstItem = detailItems[0]
		const productName = stringValue(firstItem['product_name'], stringValue(firstItem['product']))
		const sku = stringValue(firstItem['product_sku'])
		data['item_product'] = stringValue(firstItem['product'])
		data['item_product_text'] = sku == '' ? productName : productName + ' / SKU ' + sku
		data['item_quantity'] = stringValue(firstItem['quantity'], '1')
		data['item_notes'] = stringValue(firstItem['notes'])
	}
	return data
}

async function loadDetail(idText: string) {
	if (idText == '') return
	try {
		const detail = await getInventoryTransferDetail(idText)
		const data = buildInitialDataFromDetail(detail)
		initialData.value = data
		liveFormData.value = data
	} catch (error) {
		uni.showToast({ title: parseErrorMessage(error, '调拨单详情加载失败'), icon: 'none' })
	}
}

function buildPayload(data: UTSJSONObject): InventoryMutationData | null {
	const fromLocation = intValue(data['from_location'])
	const toLocation = intValue(data['to_location'])
	const transferDate = stringValue(data['transfer_date'], todayDateText())
	if (fromLocation <= 0) {
		uni.showToast({ title: '请选择调出位置', icon: 'none' })
		return null
	}
	if (toLocation <= 0) {
		uni.showToast({ title: '请选择调入位置', icon: 'none' })
		return null
	}
	if (fromLocation == toLocation) {
		uni.showToast({ title: '调入位置不能与调出位置相同', icon: 'none' })
		return null
	}
	const payload = {
		from_location: fromLocation,
		to_location: toLocation,
		transfer_date: transferDate,
		remark: stringValue(data['remark']),
	} as UTSJSONObject
	return {
		payload: payload,
	} as InventoryMutationData
}

async function persistForm(payload: UTSJSONObject) {
	if (submitting.value) return
	const rawData = payload['formData']
	const data = rawData == null ? ({} as UTSJSONObject) : (rawData as UTSJSONObject)
	const body = buildPayload(data)
	if (body == null) return
	if (itemId.value == '') {
		uni.showToast({ title: '缺少调拨单 ID', icon: 'none' })
		return
	}
	const actionText = '保存调拨单'
	submitting.value = true
	uni.showLoading({ title: actionText + '中...', mask: true })
	try {
		await updateInventoryTransfer(itemId.value, body!)
		markRefreshNeeded()
		uni.showToast({ title: takeLatestResponseMessage(actionText + '成功'), icon: 'success' })
		goBackToList()
	} catch (error) {
		uni.showToast({ title: parseErrorMessage(error, actionText + '失败'), icon: 'none' })
	} finally {
		uni.hideLoading()
		submitting.value = false
	}
}

async function handleSubmit(payload: UTSJSONObject) { await persistForm(payload) }
async function handleSaveRequest(payload: UTSJSONObject) { await persistForm(payload) }
function handleCancel(payload: UTSJSONObject) { const changed = payload['hasChanges']; if (changed != null && (changed as boolean)) return; goBackToList() }
function handleDiscardLeave(payload: UTSJSONObject) { goBackToList() }
function handleDirtyChange(value: boolean) {}
function handleFormChange(payload: UTSJSONObject) {
	const rawData = payload['formData']
	if (rawData != null) liveFormData.value = rawData as UTSJSONObject
}
function handleBottomSelectAdd(payload: UTSJSONObject) { uni.showToast({ title: '该字段不支持新增', icon: 'none' }) }
function handleBottomSelectEdit(payload: UTSJSONObject) { uni.showToast({ title: '该字段不支持编辑', icon: 'none' }) }

onLoad((query: OnLoadOptions) => {
	const idValue = query['id']
	const idText = idValue == null ? '' : ('' + idValue)
	if (idText != '') {
		itemId.value = idText
		loadDetail(idText)
		return
	}
	uni.redirectTo({ url: '/pages/inventory-transfers/create' })
})
</script>

<style>
.page { flex: 1; background-color: #EEF2F7; }
.page-content { flex: 1; padding-bottom: 0; }
.transfer-card { background-color: #FFFFFF; border-width: 1px; border-style: solid; border-color: #E2E8F0; border-radius: 8px; padding: 12px; }
.transfer-card-head { flex-direction: row; align-items: flex-start; justify-content: space-between; }
.transfer-title-wrap { flex: 1; padding-right: 8px; }
.transfer-title { font-size: 16px; line-height: 22px; color: #0F172A; font-weight: bold; }
.transfer-subtitle { margin-top: 3px; font-size: 12px; line-height: 17px; color: #475569; }
.transfer-status { height: 24px; line-height: 24px; padding-left: 8px; padding-right: 8px; border-radius: 12px; background-color: #E0F2FE; color: #0369A1; font-size: 11px; font-weight: bold; }
.transfer-metrics { flex-direction: row; margin-top: 12px; }
.transfer-metric { flex: 1; min-height: 54px; border-radius: 8px; background-color: #F8FAFC; align-items: center; justify-content: center; margin-right: 6px; }
.transfer-metric-last { margin-right: 0; }
.transfer-metric-label { font-size: 11px; line-height: 15px; color: #64748B; }
.transfer-metric-value { margin-top: 4px; font-size: 18px; line-height: 24px; color: #0F172A; font-weight: bold; }
</style>
