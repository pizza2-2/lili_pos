<template>
	<view class="page">
		<lili-universal-filter :title="pageTitle" :showBack="true" :showSearch="false" :showHome="true" homePath="/pages/inventory-transfers/index" backgroundColor="#EEF2F7" />
		<view class="page-content">
			<lili-UniversaForm :mode="formMode" :formSections="formSections" :initialData="initialData" :leaveSignal="leaveSignal" @submit="handleSubmit" @cancel="handleCancel" @discard-leave="handleDiscardLeave" @save-request="handleSaveRequest" @dirty-change="handleDirtyChange" />
		</view>
	</view>
</template>

<script setup lang="uts">
import { computed } from 'vue'
import { takeLatestResponseMessage } from '@/pkg/api/index.uts'
import { createInventoryTransfer, getInventoryTransferDetail, InventoryMutationData, updateInventoryTransfer } from '@/pkg/api/modules/inventory'

const refreshStorageKey = 'refresh:pages:inventory-transfers:index'
const formMode = ref('create')
const itemId = ref('')
const leaveSignal = ref(0)
const submitting = ref(false)
const initialData = ref<UTSJSONObject>({ from_location: '', to_location: '', transfer_date: '', remark: '', item_stock: '', item_quantity: '' } as UTSJSONObject)

function getStringField(obj: UTSJSONObject, key: string, fallback: string = ''): string { const value = obj[key]; if (value == null) return fallback; return '' + value }
function parseErrorMessage(error: any, fallback: string): string { if (error == null) return fallback; const text = JSON.stringify(error); if (text == null || text == '') return fallback; return text }

const formSections = ref<UTSJSONObject[]>([
	{
		key: 'base',
		title: '调拨信息',
		description: '',
		defaultOpen: true,
		fields: [
			{ key: 'from_location', label: '调出位置ID', type: 'input', required: true, placeholder: '请输入调出库存位置ID' } as UTSJSONObject,
			{ key: 'to_location', label: '调入位置ID', type: 'input', required: true, placeholder: '请输入调入库存位置ID' } as UTSJSONObject,
			{ key: 'transfer_date', label: '调拨日期', type: 'input', placeholder: '例如 2026-05-03' } as UTSJSONObject,
			{ key: 'remark', label: '备注', type: 'textarea', placeholder: '请输入备注' } as UTSJSONObject,
		] as UTSJSONObject[],
	} as UTSJSONObject,
	{
		key: 'items',
		title: '调拨明细',
		description: '',
		defaultOpen: true,
		fields: [
			{ key: 'item_stock', label: '库存ID', type: 'input', required: true, placeholder: '请输入要调拨的库存ID' } as UTSJSONObject,
			{ key: 'item_quantity', label: '调拨数量', type: 'input', required: true, placeholder: '请输入调拨数量' } as UTSJSONObject,
		] as UTSJSONObject[],
	} as UTSJSONObject,
])

const pageTitle = computed((): string => formMode.value == 'edit' ? '编辑调拨单' : '新建调拨单')
function markRefreshNeeded() { uni.setStorageSync(refreshStorageKey, '1') }
function goBackToList() { leaveSignal.value = leaveSignal.value + 1; setTimeout(() => { uni.navigateBack({ delta: 1, fail: () => { uni.navigateTo({ url: '/pages/inventory-transfers/index' }) } }) }, 16) }

function buildPayload(data: UTSJSONObject): InventoryMutationData {
	const itemStockText = getStringField(data, 'item_stock')
	const itemQuantityText = getStringField(data, 'item_quantity')
	const items: UTSJSONObject[] = [
		{ stock: parseInt(itemStockText), quantity: parseInt(itemQuantityText), notes: '' } as UTSJSONObject,
	]
	return {
		payload: {
			from_location: parseInt(getStringField(data, 'from_location')),
			to_location: parseInt(getStringField(data, 'to_location')),
			transfer_date: getStringField(data, 'transfer_date'),
			remark: getStringField(data, 'remark'),
			items: items,
		} as UTSJSONObject,
	} as InventoryMutationData
}

async function loadDetail(idText: string) {
	if (idText == '') return
	try {
		const detail = await getInventoryTransferDetail(idText)
		initialData.value = {
			from_location: getStringField(detail, 'from_location'),
			to_location: getStringField(detail, 'to_location'),
			transfer_date: getStringField(detail, 'transfer_date'),
			remark: getStringField(detail, 'remark'),
			item_stock: '',
			item_quantity: '',
		} as UTSJSONObject
	} catch (error) {
		uni.showToast({ title: parseErrorMessage(error, '调拨单详情加载失败'), icon: 'none' })
	}
}

async function persistForm(payload: UTSJSONObject) {
	if (submitting.value) return
	const rawData = payload['formData']
	const data = rawData == null ? ({} as UTSJSONObject) : (rawData as UTSJSONObject)
	const body = buildPayload(data)
	const actionText = formMode.value == 'edit' ? '保存调拨单' : '创建调拨单'
	submitting.value = true
	uni.showLoading({ title: actionText + '中...', mask: true })
	try {
		if (formMode.value == 'edit' && itemId.value != '') await updateInventoryTransfer(itemId.value, body)
		else await createInventoryTransfer(body)
		markRefreshNeeded()
		uni.showToast({ title: takeLatestResponseMessage(actionText + '成功'), icon: 'success' })
		goBackToList()
	} catch (error) {
		uni.showToast({ title: parseErrorMessage(error, actionText + '失败'), icon: 'none' })
	} finally {
		uni.hideLoading()
		submitting.value = false
	}
}

async function handleSubmit(payload: UTSJSONObject) { await persistForm(payload) }
async function handleSaveRequest(payload: UTSJSONObject) { await persistForm(payload) }
function handleCancel(payload: UTSJSONObject) { const changed = payload['hasChanges']; if (changed != null && (changed as boolean)) return; goBackToList() }
function handleDiscardLeave(payload: UTSJSONObject) { goBackToList() }
function handleDirtyChange(value: boolean) {}

onLoad((query: OnLoadOptions) => {
	const idValue = query['id']
	if (idValue != null && idValue != '') {
		formMode.value = 'edit'
		itemId.value = idValue
		loadDetail(idValue)
	}
})
</script>

<style>
.page { flex: 1; background-color: #EEF2F7; }
.page-content { flex: 1; padding-bottom: 0; }
</style>
