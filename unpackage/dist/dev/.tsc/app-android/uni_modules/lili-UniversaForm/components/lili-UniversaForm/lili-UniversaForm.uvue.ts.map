	margin-bottom: 8px;
	border-radius: 12px;
	background-color: #FFFFFF;
}

.uf-section-header {
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	padding: 14px 16px;
}

.uf-section-title-wrap {
	flex: 1;
}

.uf-section-title {
	font-size: 16px;
	font-weight: 600;
	color: #1F2937;
	line-height: 20px;
}

.uf-section-desc {
	margin-top: 4px;
	font-size: 12px;
	color: #9CA3AF;
	line-height: 16px;
}

.uf-section-arrow {
	font-size: 18px;
	color: #9CA3AF;
	line-height: 18px;
}

.uf-section-body {
	padding: 0 16px 12px 16px;
}

.uf-field {
	padding-top: 12px;
	padding-bottom: 12px;
	border-top-width: 1px;
	border-top-style: solid;
	border-top-color: #F1F5F9;
}

.uf-field-head {
	margin-bottom: 8px;
}

.uf-field-title-line {
	flex-direction: row;
	align-items: center;
}

.uf-field-label {
	font-size: 14px;
	color: #111827;
	line-height: 18px;
}

.uf-required {
	margin-left: 4px;
	font-size: 14px;
	color: #DC2626;
	line-height: 18px;
}

.uf-mode-tag {
	margin-left: 8px;
	padding: 2px 8px;
	border-radius: 999px;
	font-size: 11px;
	color: #92400E;
	line-height: 14px;
	background-color: #FEF3C7;
}

.uf-field-desc {
	margin-top: 4px;
	font-size: 12px;
	color: #6B7280;
	line-height: 16px;
}

.uf-control {
	min-height: 44px;
}

.uf-input {
	flex: 1;
	height: 40px;
	padding-left: 10px;
	padding-right: 10px;
	border-radius: 0;
	background-color: transparent;
	font-size: 14px;
	color: #111827;
}

.uf-textarea {
	height: 96px;
	padding: 12px;
	border-radius: 10px;
	background-color: #F8FAFC;
	font-size: 14px;
	color: #111827;
}

.uf-datetime-wrap {
	min-height: 44px;
}

.uf-bottom-select-wrap {
	min-height: 44px;
}

.uf-upload-wrap {
	padding-top: 4px;
}

.uf-input-wrap {
	flex-direction: row;
	align-items: center;
	height: 44px;
	border-radius: 22px;
	background-color: #FFFFFF;
	border-width: 1px;
	border-style: solid;
	border-color: #E2E8F0;
	padding-left: 6px;
	padding-right: 6px;
}

.uf-number-control {
	min-height: 44px;
}

.uf-input-icon-btn {
	width: 36px;
	height: 36px;
	flex-shrink: 0;
	align-items: center;
	justify-content: center;
	border-radius: 18px;
}

