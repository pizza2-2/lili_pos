                if (keyword != '' && option.text.toLowerCase().indexOf(keyword) < 0 && option.value.toLowerCase().indexOf(keyword) < 0) {
                    continue;
                }
                result.push({
                    value: option.value,
                    text: option.text,
                } as UTSJSONObject);
