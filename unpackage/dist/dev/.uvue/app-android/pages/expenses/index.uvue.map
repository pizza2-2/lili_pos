<template>
	<view class="page">
		<lili-universal-filter
			title="支出管理"
			searchPlaceholder="支出类型、供应商、发票号、备注"
			:searchValue="keyword"
			:filterVisible="filterVisible"
			:showBack="true"
			:showSearch="true"
			:showFilter="true"
			:showHome="true"
			:filterActive="hasActiveFilter"
			homePath="/pages/tabbar/settings"
			@searchInput="handleSearchInput"
			@searchConfirm="handleSearchConfirm"
			@searchClear="handleSearchClear"
			@update:filterVisible="handleFilterVisibleChange"
			@filter-open="handleFilterOpen"
		>
			<template #filter-panel>
				<view class="expense-filter-panel" :style="filterPanelStyle">
					<scroll-view scroll-y="true" class="expense-filter-content-scroll" :style="filterContentScrollStyle">
						<view class="expense-filter-scroll-inner">
							<view v-if="filterOptionsLoading" class="expense-filter-state">
								<text class="expense-filter-state-text">筛选选项加载中...</text>
							</view>

							<view v-else-if="filterOptionsError != ''" class="expense-filter-state">
								<text class="expense-filter-state-text">{{ filterOptionsError }}</text>
							</view>

							<view v-else-if="filterDefinitions.length == 0" class="expense-filter-state">
								<text class="expense-filter-state-text">暂无可用筛选项</text>
							</view>

							<view v-else class="expense-filter-groups">
								<view
									v-for="filter in filterDefinitions"
									:key="filter.key"
									class="expense-filter-group"
								>
									<text class="expense-filter-group-title">{{ filter.label }}</text>
									<view class="expense-filter-options">
										<view
											v-for="option in filter.options"
											:key="filter.key + '-' + option.value"
											:class="isFilterOptionSelected(filter.param, option.value) ? 'expense-filter-option expense-filter-option-active' : 'expense-filter-option'"
											@click="toggleFilterOption(filter.param, option.value)"
										>
											<text :class="isFilterOptionSelected(filter.param, option.value) ? 'expense-filter-option-text expense-filter-option-text-active' : 'expense-filter-option-text'">{{ option.label }}</text>
										</view>
									</view>
								</view>
							</view>
						</view>
					</scroll-view>

					<view class="expense-filter-actions">
						<view class="expense-filter-btn expense-filter-btn-light" @click="handleFilterReset">
							<text class="expense-filter-btn-light-text">重置</text>
						</view>
						<view class="expense-filter-btn expense-filter-btn-primary" @click="applySelectedFilters">
							<text class="expense-filter-btn-primary-text">应用</text>
						</view>
					</view>
				</view>
			</template>
		</lili-universal-filter>


		<scroll-view style="flex:1" class="page-scroll">

			<view class="page-content">
				<view v-if="errorMessage != '' && !isLoading" class="error-card">
					<text class="error-title">加载失败</text>
					<text class="error-desc">{{ errorMessage }}</text>
					<view class="retry-btn" @click="loadExpenses"><text class="retry-btn-text">重新加载</text></view>
				</view>

				<lili-UniversalList
					:items="listItems"
					keyField="id"
					titleField="title"
					subtitleField="subtitle"
					metaField="amountText"
					imageField="cover"
					imageListField="images"
					tagField="tags"
					:fields="fieldConfig"
					:loading="isLoading"
					loadingText="正在加载支出记录"
					:keepContentOnLoading="true"
					inlineLoadingText="支出数据刷新中..."
					:emptyText="emptyText"
					emptyIcon="◎"
					:showMenu="true"
					:menuActions="menuActions"
					:showChevron="false"
					:showPagination="true"
					:currentPage="currentPage"
					:totalPages="totalPages"
					:totalCount="totalCount"
					summaryTitle="支出概览"
					:summaryItems="summaryItems"
					:summaryCollapsedByDefault="false"
					:showFloatingAdd="true"
					floatingAddText="新增"
					@item-click="handleItemClick"
					@subtitle-click="handleSubtitleClick"
					@meta-click="handleMetaClick"
					@field-click="handleFieldClick"
					@menu="handleMenu"
					@page-change="handlePageChange"
					@floating-add="handleCreateExpense"
				/>
			</view>

		</scroll-view>

	</view>
</template>

<script setup lang="uts">
import { computed } from 'vue'
import { takeLatestResponseMessage } from '@/pkg/api/index.uts'
import { deleteExpense, ExpenseFilterDefinition, ExpenseFilterOptionsResponse, ExpenseItem, ExpenseListResponse, ExpenseMediaFile, getExpenseFilterOptions, getExpenseList } from '@/pkg/api/modules/expenses.uts'

type ExpenseSelectedFilter = {
	param: string
	value: string
}

const expenseListRefreshStorageKey = 'refresh:pages:expenses:index'

const keyword = ref('')
const filterVisible = ref(false)
const expenses = ref<ExpenseItem[]>([])
const isLoading = ref(false)
const errorMessage = ref('')
const currentPage = ref(1)
const totalPages = ref(1)
const totalCount = ref(0)
const pageSize = ref(20)
const pageTotalAmount = ref('0.00')
const filterOptionsLoading = ref(false)
const filterOptionsError = ref('')
const filterOptions = ref<ExpenseFilterOptionsResponse | null>(null)
const selectedFilters = ref<ExpenseSelectedFilter[]>([])
const filterPanelHeight = ref(400)
const filterContentHeight = ref(336)

const fieldConfig = ref<UTSJSONObject[]>([
	{ key: 'typeText', label: '类型:' } as UTSJSONObject,
	{ key: 'supplierText', label: '供应商:' } as UTSJSONObject,
	{ key: 'invoiceText', label: '发票:' } as UTSJSONObject,
	{ key: 'noteText', label: '备注:' } as UTSJSONObject,
])

const menuActions = ref<UTSJSONObject[]>([
	{ key: 'edit', text: '编辑' } as UTSJSONObject,
	{ key: 'delete', text: '删除' } as UTSJSONObject,
])

function stringValue(value: any | null, fallback: string = ''): string {
	if (value == null) return fallback
	const text = '' + value
	if (text == '') return fallback
	return text
}

function parseErrorMessage(error: any, fallback: string): string {
	const text = stringValue(error)
	if (text == '' || text == '[object Object]') return fallback
	if (text.startsWith('Error: ')) return text.substring(7)
	return text
}

function updateFilterPanelLayout() {
	const info = uni.getWindowInfo()
	let nextPanelHeight = info.windowHeight - 168
	if (nextPanelHeight > 400) nextPanelHeight = 400
	if (nextPanelHeight < 300) nextPanelHeight = 300
	let nextContentHeight = nextPanelHeight - 64
	if (nextContentHeight < 220) nextContentHeight = 220
	filterPanelHeight.value = nextPanelHeight
	filterContentHeight.value = nextContentHeight
}

function closeFilterDrawer() {
	filterVisible.value = false
}

function handleFilterVisibleChange(value: boolean) {
	filterVisible.value = value
}

function setSelectedFilterValue(param: string, value: string) {
	const nextFilters: ExpenseSelectedFilter[] = []
	let updated = false
	for (let index = 0; index < selectedFilters.value.length; index += 1) {
		const filter = selectedFilters.value[index]
		if (filter.param == param) {
			if (value != '') {
				nextFilters.push({ param: param, value: value } as ExpenseSelectedFilter)
			}
			updated = true
			continue
		}
		nextFilters.push(filter)
	}
	if (!updated && value != '') {
		nextFilters.push({ param: param, value: value } as ExpenseSelectedFilter)
	}
	selectedFilters.value = nextFilters
}

function selectedFilterValue(param: string): string {
	for (let index = 0; index < selectedFilters.value.length; index += 1) {
		const filter = selectedFilters.value[index]
		if (filter.param == param) return filter.value
	}
	return ''
}

function isFilterOptionSelected(param: string, value: string): boolean {
	return selectedFilterValue(param) == value
}

function toggleFilterOption(param: string, value: string) {
	const currentValue = selectedFilterValue(param)
	setSelectedFilterValue(param, currentValue == value ? '' : value)
}

function copyText(text: string, successTitle: string, emptyTitle: string) {
	if (text == '' || text == '-') {
		uni.showToast({ title: emptyTitle, icon: 'none' })
		return
	}
	uni.setClipboardData({ data: text, success: () => { uni.showToast({ title: successTitle, icon: 'success' }) } })
}

function applyExpenseResponse(response: ExpenseListResponse) {
	expenses.value = response.results
	currentPage.value = response.current_page
	totalPages.value = response.total_pages
	totalCount.value = response.total_count
	pageSize.value = response.page_size
	let total = 0.0
	for (let index = 0; index < response.results.length; index += 1) {
		const amount = parseFloat(response.results[index].amount)
		if (!isNaN(amount)) total = total + amount
	}
	pageTotalAmount.value = total.toFixed(2)
}

async function loadExpenses() {
	if (isLoading.value) return
	isLoading.value = true
	errorMessage.value = ''
	try {
		const response = await getExpenseList({
			search: keyword.value == '' ? null : keyword.value,
			page: currentPage.value,
			page_size: pageSize.value,
			expenditure_type: selectedFilterValue('expenditure_type') == '' ? null : selectedFilterValue('expenditure_type'),
			expenditure_type_id: null,
			supplier: selectedFilterValue('supplier') == '' ? null : selectedFilterValue('supplier'),
			supplier_id: null,
			date_from: null,
			date_to: null,
			amount_min: null,
			amount_max: null,
		})
		applyExpenseResponse(response)
	} catch (error) {
		expenses.value = []
		currentPage.value = 1
		totalPages.value = 1
		totalCount.value = 0
		pageTotalAmount.value = '0.00'
		errorMessage.value = parseErrorMessage(error, '支出记录加载失败')
	} finally {
		isLoading.value = false
	}
}

function markExpenseListRefreshNeeded() {
	uni.setStorageSync(expenseListRefreshStorageKey, '1')
}

function consumeExpenseListRefreshNeeded(): boolean {
	const storedValue = uni.getStorageSync(expenseListRefreshStorageKey)
	if (storedValue == null || ('' + storedValue) == '') return false
	uni.removeStorageSync(expenseListRefreshStorageKey)
	return true
}

function getDisplayText(value: string | null, fallback: string = '-'): string {
	if (value == null || value == '') return fallback
	return value
}

function expenseThumbnailUrl(mediaFile: ExpenseMediaFile): string {
	if (mediaFile.signed_thumbnail_url != '') return mediaFile.signed_thumbnail_url
	if (mediaFile.thumbnail_url != '') return mediaFile.thumbnail_url
	if (mediaFile.signed_url != '') return mediaFile.signed_url
	return mediaFile.file_url
}

function expenseFullUrl(mediaFile: ExpenseMediaFile): string {
	if (mediaFile.signed_url != '') return mediaFile.signed_url
	if (mediaFile.file_url != '') return mediaFile.file_url
	return expenseThumbnailUrl(mediaFile)
}

function buildImages(item: ExpenseItem): string[] {
	const result: string[] = []
	for (let index = 0; index < item.media_files.length; index += 1) {
		const mediaFile = item.media_files[index]
		const imageUrl = expenseThumbnailUrl(mediaFile)
		if (imageUrl != '') result.push(imageUrl)
	}
	return result
}

function buildPreviewImages(item: ExpenseItem): string[] {
	const result: string[] = []
	for (let index = 0; index < item.media_files.length; index += 1) {
		const imageUrl = expenseFullUrl(item.media_files[index])
		if (imageUrl != '') result.push(imageUrl)
	}
	return result
}

function buildMediaIds(item: ExpenseItem): string[] {
	const result: string[] = []
	for (let index = 0; index < item.media_files.length; index += 1) {
		const mediaId = item.media_files[index].id
		if (mediaId != '') result.push(mediaId)
	}
	return result
}

function expenseToListItem(item: ExpenseItem): UTSJSONObject {
	const typeText = getDisplayText(item.expenditure_type_name, '未分类')
	const supplierText = getDisplayText(item.supplier_name, '-')
	const invoiceText = getDisplayText(item.invoice_number, '-')
	const noteText = getDisplayText(item.note, getDisplayText(item.description, '-'))
	const images = buildImages(item)
	const previewImages = buildPreviewImages(item)
	return {
		id: item.id.toString(),
		rawId: item.id.toString(),
		title: typeText,
		subtitle: '日期：' + getDisplayText(item.expenditure_date, '-'),
		amountText: '¥ ' + getDisplayText(item.amount, '0.00'),
		typeText: typeText,
		supplierText: supplierText,
		invoiceText: invoiceText,
		noteText: noteText,
		cover: images.length > 0 ? images[0] : '',
		images: images,
		previewCover: previewImages.length > 0 ? previewImages[0] : '',
		previewImages: previewImages,
		mediaIds: buildMediaIds(item),
		tags: [item.files_count > 0 ? '附件 ' + item.files_count.toString() : '无附件'] as string[],
	} as UTSJSONObject
}

function handleSearchInput(value: string) { keyword.value = value }
function handleSearchConfirm(value: string) { keyword.value = value; currentPage.value = 1; loadExpenses() }
function handleSearchClear() { keyword.value = ''; currentPage.value = 1; loadExpenses() }

async function handleFilterOpen() {
	if (filterOptions.value != null || filterOptionsLoading.value) return
	filterOptionsLoading.value = true
	filterOptionsError.value = ''
	try {
		filterOptions.value = await getExpenseFilterOptions()
	} catch (error) {
		filterOptionsError.value = parseErrorMessage(error, '筛选选项加载失败')
	} finally {
		filterOptionsLoading.value = false
	}
}

function handleFilterReset() {
	selectedFilters.value = [] as ExpenseSelectedFilter[]
	keyword.value = ''
	currentPage.value = 1
	closeFilterDrawer()
	loadExpenses()
}

function applySelectedFilters() {
	currentPage.value = 1
	closeFilterDrawer()
	loadExpenses()
}

function handlePageChange(payload: UTSJSONObject) {
	const pageValue = payload['page']
	if (pageValue == null) return
	const nextPage = parseInt('' + pageValue)
	if (isNaN(nextPage) || nextPage <= 0 || nextPage == currentPage.value) return
	currentPage.value = nextPage
	loadExpenses()
}

function handleCreateExpense(payload: UTSJSONObject) {
	uni.navigateTo({ url: '/pages/expenses/from' })
}

function handleItemClick(payload: UTSJSONObject) {
	const id = stringValue(payload['rawId'], stringValue(payload['id']))
	if (id == '') return
	uni.navigateTo({ url: '/pages/expenses/from?id=' + id })
}

function handleSubtitleClick(payload: UTSJSONObject) {
	copyText(stringValue(payload['value']), '日期已复制', '暂无日期')
}

function handleMetaClick(payload: UTSJSONObject) {
	copyText(stringValue(payload['value']), '金额已复制', '暂无金额')
}

function handleFieldClick(payload: UTSJSONObject) {
	copyText(stringValue(payload['value']), '内容已复制', '暂无内容')
}

async function runDelete(id: string) {
	try {
		await deleteExpense(id)
		markExpenseListRefreshNeeded()
		uni.showToast({ title: takeLatestResponseMessage('删除成功'), icon: 'success' })
		loadExpenses()
	} catch (error) {
		uni.showToast({ title: parseErrorMessage(error, '删除失败'), icon: 'none' })
	}
}

function handleMenu(payload: UTSJSONObject) {
	const action = payload['action']
	const item = payload['item']
	if (action == null || item == null) return
	const actionKey = stringValue((action as UTSJSONObject)['key'])
	const id = stringValue((item as UTSJSONObject)['rawId'])
	if (id == '') return
	if (actionKey == 'edit') {
		uni.navigateTo({ url: '/pages/expenses/from?id=' + id })
		return
	}
	if (actionKey == 'delete') {
		uni.showModal({
			title: '删除支出',
			content: '确定删除这条支出记录吗？',
			success: (res) => {
				if (res.confirm) runDelete(id)
			},
		})
	}
}

const listItems = computed((): UTSJSONObject[] => {
	const result: UTSJSONObject[] = []
	for (let index = 0; index < expenses.value.length; index += 1) result.push(expenseToListItem(expenses.value[index]))
	return result
})

const hasActiveFilter = computed((): boolean => {
	return keyword.value != '' || selectedFilters.value.length > 0
})

const emptyText = computed((): string => {
	if (isLoading.value) return '正在加载'
	if (hasActiveFilter.value) return '没有匹配的支出记录'
	return '暂无支出记录'
})

const summaryItems = computed((): UTSJSONObject[] => {
	return [
		{ key: 'total', label: '记录数', value: totalCount.value.toString() } as UTSJSONObject,
		{ key: 'pageAmount', label: '本页合计', value: '¥ ' + pageTotalAmount.value } as UTSJSONObject,
		{ key: 'page', label: '页码', value: currentPage.value.toString() + '/' + totalPages.value.toString() } as UTSJSONObject,
	]
})

const filterPanelStyle = computed((): string => {
	return 'height:' + filterPanelHeight.value.toString() + 'px;'
})

const filterContentScrollStyle = computed((): string => {
	return 'height:' + filterContentHeight.value.toString() + 'px;'
})

const filterDefinitions = computed((): ExpenseFilterDefinition[] => {
	if (filterOptions.value == null) return [] as ExpenseFilterDefinition[]
	return filterOptions.value!.filters
})

onLoad(() => { updateFilterPanelLayout(); loadExpenses() })
onShow(() => {
	updateFilterPanelLayout()
	if (consumeExpenseListRefreshNeeded()) loadExpenses()
})
</script>

<style>
.page { flex: 1; background-color: #F6F7FB; }
.page-scroll { flex: 1; background-color: #F6F7FB; }
.page-content { padding-top: 6px; padding-right: 6px; padding-bottom: 96px; padding-left: 6px; }
.error-card { background-color: #FFFFFF; border-radius: 8px; padding: 18px; margin-bottom: 10px; border-width: 1px; border-style: solid; border-color: #FECACA; align-items: center; }
.error-title { font-size: 18px; line-height: 24px; color: #B42318; font-weight: bold; }
.error-desc { font-size: 14px; line-height: 20px; color: #7F1D1D; margin-top: 8px; text-align: center; }
.retry-btn { margin-top: 14px; height: 40px; border-radius: 8px; background-color: #0F172A; padding-left: 18px; padding-right: 18px; align-items: center; justify-content: center; }
.retry-btn-text { font-size: 14px; color: #FFFFFF; }
.expense-filter-panel { position: relative; padding-top: 2px; }
.expense-filter-content-scroll { padding-right: 2px; }
.expense-filter-scroll-inner { padding-bottom: 58px; }
.expense-filter-state { height: 112px; border-radius: 12px; background-color: #F8FAFC; align-items: center; justify-content: center; }
.expense-filter-state-text { font-size: 12px; line-height: 17px; color: #64748B; }
.expense-filter-groups { margin-bottom: 6px; }
.expense-filter-group { padding-left: 10px; padding-right: 10px; padding-top: 10px; padding-bottom: 10px; border-radius: 12px; background-color: #FFFFFF; border-width: 1px; border-style: solid; border-color: #E5EAF1; margin-bottom: 6px; }
.expense-filter-group-title { font-size: 13px; line-height: 18px; color: #0F172A; font-weight: bold; }
.expense-filter-options { flex-direction: row; flex-wrap: wrap; margin-top: 8px; }
.expense-filter-option { min-width: 48px; height: 30px; padding-left: 10px; padding-right: 10px; border-radius: 15px; background-color: #F8FAFC; border-width: 1px; border-style: solid; border-color: #E2E8F0; align-items: center; justify-content: center; margin-right: 6px; margin-bottom: 6px; }
.expense-filter-option-active { background-color: #0F172A; border-color: #0F172A; }
.expense-filter-option-text { font-size: 12px; line-height: 17px; color: #334155; }
.expense-filter-option-text-active { color: #FFFFFF; }
.expense-filter-actions { position: absolute; left: 0; right: 0; bottom: 0; flex-direction: row; padding-top: 6px; padding-left: 2px; padding-right: 2px; padding-bottom: 4px; border-top-width: 1px; border-top-style: solid; border-top-color: rgba(226, 232, 240, 0.78); background-color: #FFFFFF; }
.expense-filter-btn { flex: 1; height: 38px; border-radius: 11px; align-items: center; justify-content: center; }
.expense-filter-btn-light { background-color: #F3F6FA; border-width: 1px; border-style: solid; border-color: #E2E8F0; margin-right: 8px; }
.expense-filter-btn-primary { background-color: #0F172A; }
.expense-filter-btn-light-text { font-size: 13px; line-height: 18px; color: #475569; }
.expense-filter-btn-primary-text { font-size: 13px; line-height: 18px; color: #FFFFFF; }
</style>
