						<view class="quantity-quick-row">
							<view class="quantity-quick quantity-quick-out" @click="setAdjustQuantityQuick(-10)">
								<text class="quantity-quick-out-text">-10</text>
							</view>
							<view class="quantity-quick quantity-quick-out" @click="setAdjustQuantityQuick(-5)">
								<text class="quantity-quick-out-text">-5</text>
							</view>
							<view class="quantity-quick quantity-quick-out" @click="setAdjustQuantityQuick(-1)">
								<text class="quantity-quick-out-text">-1</text>
							</view>
							<view class="quantity-quick quantity-quick-in" @click="setAdjustQuantityQuick(1)">
								<text class="quantity-quick-in-text">+1</text>
							</view>
							<view class="quantity-quick quantity-quick-in" @click="setAdjustQuantityQuick(5)">
								<text class="quantity-quick-in-text">+5</text>
							</view>
							<view class="quantity-quick quantity-quick-in quantity-quick-last" @click="setAdjustQuantityQuick(10)">
								<text class="quantity-quick-in-text">+10</text>
							</view>
						</view>
					</view>
					<view class="field">
						<text class="field-label">单位成本</text>
						<input class="input" type="digit" :value="adjustUnitCostText" placeholder="0.00" @input="handleAdjustUnitCostInput" />
