                return;
            }
            uni.navigateTo({ url: buildInventoryDetailUrl(stockId, mode, productName) });
        }
        function navigateToCreateStock() {
            if (productFilterId.value == '') {
                uni.showToast({ title: '请先从商品页进入库存', icon: 'none', duration: 3500 });
                return;
