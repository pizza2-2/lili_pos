                return;
            currentPage.value = nextPage;
            loadStocks();
        }
        function buildInventoryDetailUrl(stockId: string, mode: string, productName: string): string {
            let url = '/pages/inventory-management/from';
            let separator = '?';
            if (productFilterId.value != '') {
                url = url + separator + 'product=' + productFilterId.value;
                separator = '&';
            }
            if (stockId != '') {
                url = url + separator + 'stock=' + stockId;
                separator = '&';
            }
            if (mode != '') {
                url = url + separator + 'mode=' + mode;
                separator = '&';
