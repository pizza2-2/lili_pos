                const filter = selectedFilters.value[index];
                if (filter.param == param) {
                    if (value != '') {
                        nextFilters.push({ param: param, value: value } as PurchaseDetailSelectedFilter);
                    }
                    updated = true;
                    continue;
                }
                nextFilters.push(filter);
