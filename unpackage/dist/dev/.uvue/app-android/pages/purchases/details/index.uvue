                skuText: stringValue(item.product_sku, '-'),
                quantityText: item.received_quantity.toString(10) + '/' + item.quantity.toString(10) + '，剩余 ' + item.remaining_quantity.toString(10),
                progressText: stringValue(item.receive_progress, '0') + '%',
