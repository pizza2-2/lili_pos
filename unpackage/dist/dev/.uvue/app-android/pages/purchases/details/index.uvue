            currentPage.value = 1;
            closeFilterDrawer();
            loadDetails();
        }
        async function handleScannedBarcode(scanResult: string): Promise<void> {
            const barcode = scanResult.trim();
            if (barcode == '' || scanLookupRunning.value)
                return;
            if (purchaseId.value == '') {
                searchByScannedBarcode(barcode);
                return;
            }
            scanLookupRunning.value = true;
            try {
                const result = await checkPurchaseProduct(purchaseId.value, barcode, '');
                if (result.exists && result.purchase_detail_id > 0) {
                    closeFilterDrawer();
                    uni.navigateTo({ url: '/pages/purchases/details/from?purchase=' + purchaseId.value + '&id=' + result.purchase_detail_id.toString(10) });
                    return;
