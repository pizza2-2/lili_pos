<template>
	<view class="lp-root">
		<view v-if="props.showList && imageList.length > 0" class="lp-list">
			<view
				v-for="(item, index) in imageList"
				:key="item + '-' + index"
				class="lp-item"
				:style="itemStyle"
				@click="openPreview(index)"
			>
				<image class="lp-image" :style="imageStyle" :src="item" mode="aspectFill"></image>
			</view>
		</view>

		<view v-else-if="props.showList" class="lp-empty">
			<text class="lp-empty-text">{{ props.emptyText }}</text>
		</view>

	</view>
</template>

<script setup lang="uts">
import { computed, ref, watch } from 'vue'

type Props = {
	images?: string[]
	initialIndex?: number
	visible?: boolean
	thumbSize?: number
	radius?: number
	gap?: number
	emptyText?: string
	showList?: boolean
}

const props = withDefaults(defineProps<Props>(), {
	images: () : string[] => [],
	initialIndex: 0,
	visible: false,
	thumbSize: 72,
	radius: 12,
	gap: 12,
	emptyText: '暂无图片',
	showList: true,
})

const emit = defineEmits<{
	(e: 'preview', payload: UTSJSONObject): void
	(e: 'close', payload: UTSJSONObject): void
	(e: 'update:visible', value: boolean): void
	(e: 'update:index', value: number): void
}>()

const imageList = ref<string[]>([])
const currentIndex = ref<number>(0)

const itemStyle = computed<string>(() : string => {
	return 'width:' + props.thumbSize + 'px;height:' + props.thumbSize + 'px;margin-right:' + props.gap + 'px;margin-bottom:' + props.gap + 'px;border-radius:' + props.radius + 'px;'
})

const imageStyle = computed<string>(() : string => {
	return 'border-radius:' + props.radius + 'px;'
})

function cloneStringArray(list: string[]) : string[] {
	const result: string[] = []
	for (let i = 0; i < list.length; i++) {
		result.push(list[i])
	}
	return result
}

function clampIndex(index: number, length: number) : number {
	if (length <= 0) {
		return 0
	}
	if (index < 0) {
		return 0
	}
	if (index >= length) {
		return length - 1
	}
	return index
}

function syncImages(list: string[]) {
	imageList.value = cloneStringArray(list)
	currentIndex.value = clampIndex(currentIndex.value, imageList.value.length)
}

function buildPayload(action: string, path: string) : UTSJSONObject {
	return {
		action: action,
		index: currentIndex.value,
		path: path,
		list: cloneStringArray(imageList.value),
	} as UTSJSONObject
}

function getCurrentImagePath() : string {
	if (imageList.value.length == 0) {
		return ''
	}
	if (currentIndex.value < 0 || currentIndex.value >= imageList.value.length) {
		return ''
	}
	return imageList.value[currentIndex.value]
}

function openPreview(index: number) {
	if (index < 0 || index >= imageList.value.length) {
		return
	}
	currentIndex.value = index
	emit('update:index', currentIndex.value)
	emit('update:visible', true)
	const currentPath = getCurrentImagePath()
	emit('preview', buildPayload('preview', currentPath))
	uni.previewImage({
		current: currentPath,
		urls: cloneStringArray(imageList.value),
		complete: () => {
			emit('update:visible', false)
			emit('close', buildPayload('close', getCurrentImagePath()))
		},
	})
}

function closePreview() {
	const currentPath = getCurrentImagePath()
	emit('update:visible', false)
	emit('close', buildPayload('close', currentPath))
}

watch(
	() : string[] => props.images,
	(newVal: string[]) => {
		syncImages(newVal)
	},
	{
		immediate: true,
	}
)

watch(
	() : number => props.initialIndex,
	(newVal: number) => {
		currentIndex.value = clampIndex(newVal, imageList.value.length)
	},
	{
		immediate: true,
	}
)

watch(
	() : boolean => props.visible,
	(newVal: boolean) => {
		if (newVal) {
			openPreview(currentIndex.value)
		}
	},
	{
		immediate: true,
	}
)
</script>

<style>
.lp-root {
	width: 100%;
}

.lp-list {
	flex-direction: row;
	flex-wrap: wrap;
}

.lp-item {
	overflow: hidden;
	background-color: #F3F4F6;
}

.lp-image {
	width: 100%;
	height: 100%;
}

.lp-empty {
	width: 100%;
	padding-top: 16px;
	padding-bottom: 16px;
	align-items: center;
	justify-content: center;
	background-color: #F8FAFC;
	border-radius: 12px;
}

.lp-empty-text {
	font-size: 14px;
	color: #64748B;
}

</style>
