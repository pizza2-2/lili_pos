import { request } from '../index.uts'

export type InventoryListQuery = {
	search: string | null
	page: number
	page_size: number
	status: string | null
	alert_status: string | null
	transaction_type: string | null
	location_type: string | null
	is_active: string | null
}

export type InventoryListResponse = {
	results: UTSJSONObject[]
	total_count: number
	total_pages: number
	current_page: number
	page_size: number
}

export type StockAdjustmentData = {
	stock_id: number
	quantity_change: number
	transaction_type: string
	unit_cost: string
	notes: string
}

export type InventoryMutationData = {
	payload: UTSJSONObject
}

function stringValue(value: any | null): string {
	if (value == null) return ''
	return '' + value
}

function intValue(value: any | null): number {
	if (value == null) return 0
	const parsed = parseInt('' + value)
	if (isNaN(parsed)) return 0
	return parsed
}

function buildQuery(data: InventoryListQuery): UTSJSONObject {
	const query = {
		page: data.page,
		page_size: data.page_size,
	} as UTSJSONObject
	if (data.search != null && data.search != '') query['search'] = data.search
	if (data.status != null && data.status != '') query['status'] = data.status
	if (data.alert_status != null && data.alert_status != '') query['alert_status'] = data.alert_status
	if (data.transaction_type != null && data.transaction_type != '') query['transaction_type'] = data.transaction_type
	if (data.location_type != null && data.location_type != '') query['location_type'] = data.location_type
	if (data.is_active != null && data.is_active != '') query['is_active'] = data.is_active
	return query
}

function parseObjectArray(value: any | null): UTSJSONObject[] {
	if (value == null) return [] as UTSJSONObject[]
	const text = JSON.stringify(value)
	const parsed = text == null || text == '' ? null : JSON.parseArray<UTSJSONObject>(text)
	if (parsed == null) return [] as UTSJSONObject[]
	return parsed!
}

function parseObject(value: any | null): UTSJSONObject | null {
	if (value == null) return null
	const text = JSON.stringify(value)
	if (text == null || text == '') return null
	return JSON.parseObject<UTSJSONObject>(text)
}

function buildListResponse(raw: any, query: InventoryListQuery): InventoryListResponse {
	const rawObject = parseObject(raw)
	if (rawObject == null) {
		throw new Error('库存列表响应解析失败')
	}
	let paginationObject: UTSJSONObject | null = null
	const rawPagination = rawObject!['pagination']
	if (rawPagination != null) {
		paginationObject = parseObject(rawPagination)
	}
	const results = parseObjectArray(rawObject!['results'])
	let totalCount = intValue(rawObject!['count'])
	if (totalCount <= 0) totalCount = intValue(rawObject!['total_count'])
	if (totalCount <= 0 && paginationObject != null) totalCount = intValue(paginationObject!['total'])
	if (totalCount <= 0 && paginationObject != null) totalCount = intValue(paginationObject!['count'])
	if (totalCount <= 0) totalCount = results.length
	let currentPage = intValue(rawObject!['current_page'])
	if (currentPage <= 0) currentPage = intValue(rawObject!['page'])
	if (currentPage <= 0 && paginationObject != null) currentPage = intValue(paginationObject!['page'])
	if (currentPage <= 0) currentPage = query.page
	let pageSize = intValue(rawObject!['page_size'])
	if (pageSize <= 0 && paginationObject != null) pageSize = intValue(paginationObject!['page_size'])
	if (pageSize <= 0) pageSize = query.page_size
	let totalPages = intValue(rawObject!['total_pages'])
	if (totalPages <= 0 && paginationObject != null) totalPages = intValue(paginationObject!['total_pages'])
	if (totalPages <= 0 && pageSize > 0) totalPages = Math.ceil(totalCount / pageSize)
	if (totalPages <= 0) totalPages = 1
	return {
		results: results,
		total_count: totalCount,
		total_pages: totalPages,
		current_page: currentPage,
		page_size: pageSize,
	} as InventoryListResponse
}

function stockAdjustmentBody(data: StockAdjustmentData): UTSJSONObject {
	return {
		stock_id: data.stock_id,
		quantity_change: data.quantity_change,
		transaction_type: data.transaction_type,
		unit_cost: data.unit_cost,
		notes: data.notes,
		reference_type: '',
		reference_id: '',
	} as UTSJSONObject
}

export async function getInventoryStocks(data: InventoryListQuery): Promise<InventoryListResponse> {
	const raw = await request('/api/inventory/stocks/', 'GET', buildQuery(data), true)
	return buildListResponse(raw, data)
}

export async function getInventoryLocations(data: InventoryListQuery): Promise<InventoryListResponse> {
	const raw = await request('/api/inventory/locations/', 'GET', buildQuery(data), true)
