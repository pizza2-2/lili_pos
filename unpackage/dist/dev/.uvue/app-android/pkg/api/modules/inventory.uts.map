export async function getInventoryStockDetail(id: string): Promise<UTSJSONObject> {
	const raw = await request('/api/inventory/stocks/' + stringValue(id) + '/', 'GET', {} as UTSJSONObject, true)
	const parsed = parseObject(raw)
	if (parsed == null) throw new Error('库存详情响应解析失败')
	return parsed!
}

