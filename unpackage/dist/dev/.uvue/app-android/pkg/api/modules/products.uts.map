	purchase_price: string
	cost_price: string
	base_sales_price: string
	status: string
	is_featured: boolean
	is_new: boolean
	is_bestseller: boolean
	sort_order: number
	rating: string
	variant_count: number
	total_sales_quantity: number
	total_sales_amount: string
	last_sale_date: string | null
	created_at: string
	updated_at: string
