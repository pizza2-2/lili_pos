export type ProductMutationData = {
	sku: string | null
	barcode: string | null
	name_cn: string
	name_en: string | null
	description: string | null
	category: string | null
	supplier: string | null
	purchase_price: string
	cost_price: string
	base_sales_price: string
	status: string
	is_featured: boolean
	is_new: boolean
