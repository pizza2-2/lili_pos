			:round="true"
			:overlay="true"
			:duration="240"
			overlay-style="background-color: rgba(15, 23, 42, 0.38);"
			custom-style="background-color: #FFFFFF;"
			@clickoverlay="closeMovementPeriodPanel"
		>
			<view class="movement-panel">
				<view class="movement-panel-handle"></view>
				<view class="movement-panel-head">
					<text class="movement-panel-title">库存时间</text>
					<view class="movement-panel-close" @click="closeMovementPeriodPanel">
						<text class="movement-panel-close-text">关闭</text>
					</view>
				</view>
				<view class="movement-options">
					<view
						v-for="option in movementPeriodOptions"
						:key="option.value"
						:class="draftMovementPeriod == option.value ? 'movement-option movement-option-active' : 'movement-option'"
						@click="selectDraftMovementPeriod(option.value)"
					>
						<text :class="draftMovementPeriod == option.value ? 'movement-option-text movement-option-text-active' : 'movement-option-text'">{{ option.label }}</text>
					</view>
				</view>
				<view class="movement-panel-actions">
					<view class="movement-panel-btn movement-panel-btn-light" @click="resetMovementPeriod">
						<text class="movement-panel-btn-light-text">全部</text>
					</view>
					<view class="movement-panel-btn movement-panel-btn-primary" @click="applyMovementPeriod">
						<text class="movement-panel-btn-primary-text">应用</text>
					</view>
				</view>
			</view>
