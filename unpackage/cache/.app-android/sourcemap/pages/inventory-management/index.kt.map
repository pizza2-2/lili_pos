								<view class="inventory-filter-options">
									<view
										v-for="option in listedStatusOptions"
										:key="'listed-' + option.value"
										:class="draftListedStatus == option.value ? 'inventory-filter-option inventory-filter-option-active' : 'inventory-filter-option'"
