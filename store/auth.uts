// 定义模型
export type AuthState = {
	token:string;
	userInfo:UserInfoState | null;
	// 当前用户权限码集合；可选：旧版本地缓存无此字段，解析后为 null 需兜底空数组
	permissions?:string[];
}

export type UserInfoState = {
	id:number;
	name:string;
	avatar:string;
	//其它字段
}

const loginPageUrl = '/pages/login/login'
let redirectingToLogin = false

// 实例化为authState
export const authState = reactive({
	token:'',
	userInfo: {
		id:0,
		name:"",
		avatar:"",
		//其它字段
	},
	permissions: [] as string[],
} as AuthState)

// 本地存储(转为字符串存储)
function authLocalStorage(){
	uni.setStorageSync('authStateKey', JSON.stringify(authState))
}

// 清除token和userInfo
export const clearAuthState = () => {
	authState.token = ''
	authState.userInfo = null
	authState.permissions = [] as string[]
	//移除本地存储
	uni.removeStorageSync('authStateKey')
}

function isLoginPageActive(): boolean {
	const pages = getCurrentPages()
	if (pages.length == 0) {
		return false
	}
	const currentPage = pages[pages.length - 1]
	const currentRoute = currentPage.route
	if (currentRoute == null) {
		return false
	}
	return '/' + currentRoute == loginPageUrl
}

function resetRedirectFlagWithDelay() {
	setTimeout(() => {
		redirectingToLogin = false
	}, 1500)
}

export function redirectToLogin(message: string = '登录已过期，请重新登录') {
	clearAuthState()
	if (redirectingToLogin) {
		return
	}
	if (isLoginPageActive()) {
		return
	}
	redirectingToLogin = true
	if (message != '') {
		uni.showToast({
			title: message,
			icon: 'none'
		})
	}
	uni.hideLoading()
	setTimeout(() => {
		uni.reLaunch({
			url: loginPageUrl,
			fail: () => {
				uni.redirectTo({
					url: loginPageUrl,
					fail: () => {
						uni.navigateTo({
							url: loginPageUrl
						})
					}
				})
			},
			complete: () => {
				resetRedirectFlagWithDelay()
			}
		})
	}, 30)
}

// 设置token,本地存储token
export const setAuthToken = (value: string) => {
	authState.token = value
	authLocalStorage()	//存储到本地
}

// 设置userInfo，本地存储userInfo
export const setAuthUserInfo = (value: UserInfoState) => {
	authState.userInfo = value
	authLocalStorage()	//存储到本地
}

// 读取当前权限码集合（旧版缓存缺字段时兜底空数组）
export function getAuthPermissions(): string[] {
	const perms: string[] | null = authState.permissions
	return perms == null ? ([] as string[]) : perms
}

// 是否拥有指定权限码
export function hasPerm(code: string): boolean {
	return getAuthPermissions().includes(code)
}

// 设置权限码集合并持久化；冷启动先用上次的权限集渲染，profile 刷新后覆盖
export const setAuthPermissions = (codes: string[]) => {
	// 防御：调用方传入运行时 null（服务端异常字段）时兜底空数组
	const next: string[] | null = codes
	authState.permissions = next == null ? ([] as string[]) : next
	authLocalStorage()	//存储到本地
}

// 设置所有数据本地存储
export function setAuthState (value: AuthState){
	authState.token = value.token
	authState.userInfo = value.userInfo
	// 旧版本地缓存无 permissions 字段，兜底空数组
	const perms: string[] | null = value.permissions
	authState.permissions = perms == null ? ([] as string[]) : perms
	authLocalStorage()	//存储到本地
}

// 同步从本地存储中获取authState的值
export function getAuthStateByStorageSync(){
	// 程序启动从本地存储中值(同步)
	let authStateString = uni.getStorageSync('authStateKey') as string
	if(authStateString != ''){
	let storageResult = JSON.parse<AuthState>(authStateString)		//字符串为AuthState类型
		setAuthState(storageResult as AuthState)					//赋值给store
	}
}
