export type LabelPrinterDevice = {
	name: string
	address: string
	type: string
	bondState: string
	rssi: number
	connected: boolean
}

export type LabelPrinterResult = {
	success: boolean
	code: string
	message: string
	data: UTSJSONObject | null
}

export type PrintTsplOptions = {
	address: string
	tspl: string
	charset?: string
	chunkSize?: number
	delayMs?: number
}

export type LabelBitmapPrintOptions = {
	address: string
	paperWidthMm: number
	paperHeightMm: number
	dotsPerMm: number
	elements: UTSJSONObject[]
	chunkSize?: number
	delayMs?: number
}

