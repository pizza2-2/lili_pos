<template>
	<view class="lte-root">
		<view class="lte-toolbar">
			<view class="lte-tool" @click="addNameCnField"><text class="lte-tool-text">中文名</text></view>
			<view class="lte-tool" @click="addNameEnField"><text class="lte-tool-text">英文名</text></view>
			<view class="lte-tool" @click="addNameOtherField"><text class="lte-tool-text">其他名</text></view>
			<view class="lte-tool" @click="addOriginalPriceField"><text class="lte-tool-text">原价</text></view>
			<view class="lte-tool" @click="addDiscountPriceField"><text class="lte-tool-text">折扣价</text></view>
			<view class="lte-tool" @click="addBarcodeField"><text class="lte-tool-text">条码</text></view>
			<view class="lte-tool" @click="addSkuField"><text class="lte-tool-text">SKU</text></view>
			<view class="lte-tool" @click="addKodField"><text class="lte-tool-text">KOD</text></view>
			<view class="lte-tool" @click="addHorizontalLine"><text class="lte-tool-text">横线</text></view>
			<view class="lte-tool" @click="addVerticalLine"><text class="lte-tool-text">竖线</text></view>
			<view class="lte-tool" @click="addRectFrame"><text class="lte-tool-text">边框</text></view>
			<view class="lte-tool" @click="addTextElement"><text class="lte-tool-text">自定义</text></view>
			<view class="lte-tool" @click="resizeSelected(1)"><text class="lte-tool-text">字号+</text></view>
			<view class="lte-tool" @click="resizeSelected(-1)"><text class="lte-tool-text">字号-</text></view>
			<view :class="selectedBold ? 'lte-tool lte-tool-active' : 'lte-tool'" @click="toggleSelectedBold">
				<text :class="selectedBold ? 'lte-tool-active-text' : 'lte-tool-text'">加粗</text>
			</view>
			<view class="lte-tool lte-tool-primary" @click="printTestLabel"><text class="lte-tool-primary-text">测试打印</text></view>
			<view class="lte-tool lte-tool-danger" @click="deleteSelectedElement"><text class="lte-tool-danger-text">删除</text></view>
		</view>

		<scroll-view scroll-x="true" class="lte-board-scroll">
			<view
				class="lte-board-shell"
				@touchstart="handleCanvasTouchStart($event)"
				@touchmove.stop.prevent="handleCanvasTouchMove($event)"
				@touchend="handleCanvasTouchEnd($event)"
				@touchcancel="handleCanvasTouchEnd($event)"
			>
				<view ref="canvasRef" class="lte-canvas" :style="boardStyle"></view>
			</view>
		</scroll-view>

		<view class="lte-tabs">
			<view v-for="item in elements" :key="item.key" :class="selectedKey == item.key ? 'lte-tab lte-tab-active' : 'lte-tab'" @click="selectElement(item.key)">
				<text :class="selectedKey == item.key ? 'lte-tab-text lte-tab-text-active' : 'lte-tab-text'">{{ item.label }}</text>
			</view>
		</view>

		<view class="lte-nudge-grid">
			<view class="lte-nudge" @click="moveSelected(0, -0.5)"><text class="lte-nudge-text">上</text></view>
			<view class="lte-nudge" @click="moveSelected(-0.5, 0)"><text class="lte-nudge-text">左</text></view>
			<view class="lte-nudge" @click="moveSelected(0.5, 0)"><text class="lte-nudge-text">右</text></view>
			<view class="lte-nudge" @click="moveSelected(0, 0.5)"><text class="lte-nudge-text">下</text></view>
		</view>

		<view class="lte-editor">
			<view class="lte-editor-head">
				<text class="lte-editor-title">当前字段</text>
				<text class="lte-editor-subtitle">{{ selectedElementSummary }}</text>
			</view>
			<view class="lte-source-row">
				<text class="lte-source-label">数据库映射</text>
				<text class="lte-source-value">{{ selectedSourceText }}</text>
			</view>
			<view v-if="selectedType == 'barcode'" class="lte-barcode-options">
				<text class="lte-input-label">条码类型</text>
				<view class="lte-type-row">
					<view :class="selectedBarcodeType == 'CODE128' ? 'lte-type-chip lte-type-chip-active' : 'lte-type-chip'" @click="setBarcodeType('CODE128')">
						<text :class="selectedBarcodeType == 'CODE128' ? 'lte-type-text lte-type-text-active' : 'lte-type-text'">CODE128</text>
					</view>
					<view :class="selectedBarcodeType == 'EAN13' ? 'lte-type-chip lte-type-chip-active' : 'lte-type-chip'" @click="setBarcodeType('EAN13')">
						<text :class="selectedBarcodeType == 'EAN13' ? 'lte-type-text lte-type-text-active' : 'lte-type-text'">EAN13</text>
					</view>
				</view>
				<view class="lte-switch-line">
					<view class="lte-switch-copy">
						<text class="lte-switch-title">显示底部数字</text>
						<text class="lte-switch-desc">关闭后只显示条码图形</text>
					</view>
					<switch :checked="selectedShowText" color="#111827" @change="handleShowTextChange" />
				</view>
			</view>
			<view v-if="selectedType == 'hline' || selectedType == 'vline' || selectedType == 'rect'" class="lte-input-row">
				<text class="lte-input-label">线宽(mm)</text>
				<input class="lte-input" :value="selectedLineWidth" type="digit" placeholder="0.4" @input="handleLineWidthInput" />
			</view>
			<view v-if="selectedType != 'hline' && selectedType != 'vline' && selectedType != 'rect'" class="lte-input-row">
				<text class="lte-input-label">显示内容</text>
				<input class="lte-input" :value="selectedContent" placeholder="请输入标签文字或条码" @input="handleContentInput" />
			</view>
			<view v-if="selectedType == 'text'" class="lte-switch-line lte-bold-line">
				<view class="lte-switch-copy">
					<text class="lte-switch-title">加粗</text>
					<text class="lte-switch-desc">打印和预览都会使用粗体</text>
				</view>
				<switch :checked="selectedBold" color="#111827" @change="handleBoldChange" />
			</view>
			<view v-if="selectedType == 'text'" class="lte-barcode-options">
				<text class="lte-input-label">文字对齐</text>
				<view class="lte-type-row">
					<view :class="selectedTextAlign == 'left' ? 'lte-type-chip lte-type-chip-active' : 'lte-type-chip'" @click="setTextAlign('left')">
						<text :class="selectedTextAlign == 'left' ? 'lte-type-text lte-type-text-active' : 'lte-type-text'">左对齐</text>
					</view>
					<view :class="selectedTextAlign == 'center' ? 'lte-type-chip lte-type-chip-active' : 'lte-type-chip'" @click="setTextAlign('center')">
						<text :class="selectedTextAlign == 'center' ? 'lte-type-text lte-type-text-active' : 'lte-type-text'">居中</text>
					</view>
					<view :class="selectedTextAlign == 'right' ? 'lte-type-chip lte-type-chip-active' : 'lte-type-chip'" @click="setTextAlign('right')">
						<text :class="selectedTextAlign == 'right' ? 'lte-type-text lte-type-text-active' : 'lte-type-text'">右对齐</text>
					</view>
				</view>
			</view>
			<view class="lte-input-row">
				<text class="lte-input-label">字段名称</text>
				<input class="lte-input" :value="selectedLabel" placeholder="字段名称" @input="handleLabelInput" />
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import { computed, nextTick, onMounted, watch } from 'vue'
import { getPreferredPrinterAddress, printLabelBitmapAsync } from '@/uni_modules/lili-label-printer/index.uts'

type Props = {
	elements: UTSJSONObject[]
	paperWidth: string
	paperHeight: string
	dotsPerMm?: number
}

type LabelElement = {
	key: string
	label: string
	type: string
	source: string
	content: string
	barcodeType: string
	showText: boolean
	lineWidth: number
	x: number
	y: number
	width: number
	height: number
	fontSize: number
	isBold: boolean
	textAlign: string
}

type ElementBounds = {
	x: number
	y: number
	width: number
	height: number
}

type PreviewTextFit = {
	lines: string[]
	fontSize: number
	lineHeight: number
}

const props = withDefaults(defineProps<Props>(), {
	elements: () : UTSJSONObject[] => [],
	paperWidth: '30',
	paperHeight: '20',
	dotsPerMm: 8,
})

const emit = defineEmits<{
	(e: 'change', payload: UTSJSONObject[]): void
}>()

let labelCanvasContext: DrawableContext | null = null
let canvasLeftPx = 0
let canvasTopPx = 0
const previewScale = ref(10)
const canvasRef = ref<UniElement | null>(null)
const elements = ref<LabelElement[]>([])
const selectedKey = ref('')
const internalChange = ref(false)
const dragging = ref(false)
const resizing = ref(false)
const dragStartX = ref(0)
const dragStartY = ref(0)
const dragElementX = ref(0)
const dragElementY = ref(0)
const resizeStartWidth = ref(0)
const resizeStartHeight = ref(0)
const nextIndex = ref(1)
const testPrinting = ref(false)
const selectedElementSummaryText = ref('未选择字段')
let moveDirty = false

function stringValue(value: any | null, fallback: string = ''): string {
	if (value == null) return fallback
	return '' + value
}

function numberValue(value: string, fallback: number = 0): number {
	const parsed = parseFloat(value)
	if (isNaN(parsed)) return fallback
	return parsed
}

function intValue(value: string, fallback: number = 0): number {
	const parsed = parseInt(value)
	if (isNaN(parsed)) return fallback
	return parsed
}

function safeText(value: string): string {
	return value.replace(/"/g, "'")
}

function boolValue(value: any | null, fallback: boolean = false): boolean {
	if (value == null) return fallback
	const text = stringValue(value).toLowerCase()
	if (text == 'true' || text == '1') return true
	if (text == 'false' || text == '0') return false
	return fallback
}

function boldValue(item: UTSJSONObject): boolean {
	const fontWeight = stringValue(item['fontWeight'], stringValue(item['font_weight'])).toLowerCase()
	return boolValue(item['isBold'], boolValue(item['bold'], fontWeight == 'bold' || fontWeight == '700'))
}

function labelWidthMm(): number {
	return numberValue(props.paperWidth, 30)
}

function labelHeightMm(): number {
	return numberValue(props.paperHeight, 20)
}

function canvasWidthPx(): number {
	return labelWidthMm() * previewScale.value
}

function canvasHeightPx(): number {
	return labelHeightMm() * previewScale.value
}

function dot(valueMm: number): number {
	return Math.round(valueMm * props.dotsPerMm)
}

function tsplTextScale(fontSize: number): number {
	if (fontSize >= 96) return 6
	if (fontSize >= 76) return 5
	if (fontSize >= 56) return 4
	if (fontSize >= 36) return 3
	if (fontSize >= 24) return 2
	return 1
}

function previewDotsToPx(value: number): number {
	const density = props.dotsPerMm <= 0 ? 8 : props.dotsPerMm
	return value * previewScale.value / density
}

function barcodeCommandType(item: LabelElement): string {
	if (item.barcodeType == 'EAN13') return 'EAN13'
	return '128'
}

function normalizeBarcodeText(item: LabelElement): string {
	const raw = item.content.trim()
	if (item.barcodeType != 'EAN13') return raw
	let digits = ''
	for (let index = 0; index < raw.length; index += 1) {
		const char = raw.substring(index, index + 1)
		if (char >= '0' && char <= '9') digits = digits + char
	}
	if (digits.length >= 13) return digits.substring(0, 13)
	if (digits.length == 12) return digits
	return '5901234123457'
}

function onlyDigits(value: string): string {
	let result = ''
	for (let index = 0; index < value.length; index += 1) {
		const char = value.substring(index, index + 1)
		if (char >= '0' && char <= '9') result = result + char
	}
	return result
}

function isValidEan13Input(value: string): boolean {
	const digits = onlyDigits(value)
	if (digits.length == 12) return true
	if (digits.length != 13) return false
	let sum = 0
	for (let index = 0; index < 12; index += 1) {
		const digit = parseInt(digits.substring(index, index + 1))
		sum += index % 2 == 0 ? digit : digit * 3
	}
	const check = (10 - (sum % 10)) % 10
	return check.toString() == digits.substring(12, 13)
}

function isBlankTemplateText(value: string): boolean {
	return value.trim() == ''
}

function isValidCode128Text(value: string): boolean {
	const text = value.trim()
	if (text == '') return false
	if (text.length > 80) return false
	for (let index = 0; index < text.length; index += 1) {
		const code = text.charCodeAt(index)!
		if (code < 32 || code > 126) return false
	}
	return true
}

function validationElementName(item: LabelElement, index: number): string {
	if (item.label != '') return item.label
	if (item.key != '') return item.key
	return '元素 ' + (index + 1).toString()
}

function buildPrintTspl(): string {
	let command = ''
	command = command + 'SIZE ' + labelWidthMm().toString() + ' mm,' + labelHeightMm().toString() + ' mm\r\n'
	command = command + 'GAP 2 mm,0\r\n'
	command = command + 'DENSITY 8\r\n'
	command = command + 'DIRECTION 1\r\n'
	command = command + 'CLS\r\n'
	for (let index = 0; index < elements.value.length; index += 1) {
		const item = elements.value[index]
		if (item.type == 'barcode') {
			const humanReadable = item.showText ? 1 : 0
			command = command + 'BARCODE ' + dot(item.x).toString() + ',' + dot(item.y).toString() + ',"' + barcodeCommandType(item) + '",' + dot(item.height).toString() + ',' + humanReadable.toString() + ',0,2,2,"' + safeText(normalizeBarcodeText(item)) + '"\r\n'
		} else if (item.type == 'hline') {
			const lineWidth = dot(item.lineWidth)
			command = command + 'BAR ' + dot(item.x).toString() + ',' + dot(item.y).toString() + ',' + dot(item.width).toString() + ',' + Math.max(1, lineWidth).toString() + '\r\n'
		} else if (item.type == 'vline') {
			const lineWidth = dot(item.lineWidth)
			command = command + 'BAR ' + dot(item.x).toString() + ',' + dot(item.y).toString() + ',' + Math.max(1, lineWidth).toString() + ',' + dot(item.height).toString() + '\r\n'
		} else if (item.type == 'rect') {
			const lineWidth = Math.max(1, dot(item.lineWidth))
			const x = dot(item.x)
			const y = dot(item.y)
			const width = dot(item.width)
			const height = dot(item.height)
			command = command + 'BOX ' + x.toString() + ',' + y.toString() + ',' + (x + width).toString() + ',' + (y + height).toString() + ',' + lineWidth.toString() + '\r\n'
		} else {
			const scale = tsplTextScale(item.fontSize)
			command = command + 'TEXT ' + dot(item.x).toString() + ',' + dot(item.y).toString() + ',"TSS24.BF2",0,' + scale.toString() + ',' + scale.toString() + ',"' + safeText(item.content) + '"\r\n'
		}
	}
	command = command + 'PRINT 1\r\n'
	return command
}

function connectedPrinterAddress(): string {
	return getPreferredPrinterAddress()
}

function goPrinterSettings() {
	uni.showToast({ title: '请先连接打印机', icon: 'none', duration: 3500 })
	setTimeout(() => {
		uni.navigateTo({
			url: '/pages/printer-settings/index',
		})
	}, 450)
}

function promptChoosePrinterAfterPrintFailure(message: string) {
	const detail = message == '' ? '打印机连接失败，请确认打印机在附近并已开机。' : message
	uni.showModal({
		title: '打印失败',
		content: detail + '\n是否选择新的打印机？',
		confirmText: '选择打印机',
		cancelText: '取消',
		success: (modal) => {
			if (modal.confirm) {
				uni.navigateTo({ url: '/pages/printer-settings/index' })
			}
		}
	})
}

function elementKeyExists(key: string): boolean {
	for (let index = 0; index < elements.value.length; index += 1) {
		if (elements.value[index].key == key) return true
	}
	return false
}

function keyInList(key: string, keys: string[]): boolean {
	for (let index = 0; index < keys.length; index += 1) {
		if (keys[index] == key) return true
	}
	return false
}

function bumpNextIndexFromKey(key: string) {
	const prefix = 'field-'
	if (!key.startsWith(prefix)) return
	const numberText = key.substring(prefix.length)
	const parsed = parseInt(numberText)
	if (!isNaN(parsed) && parsed >= nextIndex.value) {
		nextIndex.value = parsed + 1
	}
}

function makeKey(): string {
	let key = 'field-' + nextIndex.value.toString()
	while (elementKeyExists(key)) {
		nextIndex.value = nextIndex.value + 1
		key = 'field-' + nextIndex.value.toString()
	}
	nextIndex.value = nextIndex.value + 1
	return key
}

function reserveElementKey(preferred: string, usedKeys: string[]): string {
	let key = preferred.trim()
	if (key != '' && !keyInList(key, usedKeys)) {
		usedKeys.push(key)
		bumpNextIndexFromKey(key)
		return key
	}
	key = 'field-' + nextIndex.value.toString()
	while (keyInList(key, usedKeys)) {
		nextIndex.value = nextIndex.value + 1
		key = 'field-' + nextIndex.value.toString()
	}
	usedKeys.push(key)
	nextIndex.value = nextIndex.value + 1
	return key
}

function normalizeElementType(value: string): string {
	if (value == 'barcode') return 'barcode'
	if (value == 'hline') return 'hline'
	if (value == 'vline') return 'vline'
	if (value == 'rect') return 'rect'
	return 'text'
}

function normalizeTextAlign(value: string): string {
	const next = value.toLowerCase()
	if (next == 'center') return 'center'
	if (next == 'right') return 'right'
	return 'left'
}

function elementFromObject(item: UTSJSONObject, index: number): LabelElement {
	const key = stringValue(item['key'], 'field-' + (index + 1).toString())
	const label = stringValue(item['label'], '字段 ' + (index + 1).toString())
	const type = normalizeElementType(stringValue(item['type'], 'text'))
	const source = stringValue(item['source'], 'custom')
	const content = stringValue(item['content'], label)
	const barcodeType = stringValue(item['barcodeType'], stringValue(item['barcode_type'], 'CODE128')).toUpperCase() == 'EAN13' ? 'EAN13' : 'CODE128'
	const showText = boolValue(item['showText'], boolValue(item['show_text'], true))
	const x = numberValue(stringValue(item['x']), 2)
	const y = numberValue(stringValue(item['y']), 2 + index * 3)
	const width = numberValue(stringValue(item['width']), 18)
	const height = numberValue(stringValue(item['height']), type == 'barcode' ? 5 : 4)
	const fontSize = intValue(stringValue(item['fontSize']), type == 'barcode' ? 12 : 18)
	const lineWidth = numberValue(stringValue(item['lineWidth'], stringValue(item['line_width'])), 1)
	const isBold = boldValue(item)
	const textAlign = normalizeTextAlign(stringValue(item['textAlign'], stringValue(item['text_align'], 'left')))
	return { key: key, label: label, type: type, source: source, content: content, barcodeType: barcodeType, showText: showText, lineWidth: lineWidth, x: x, y: y, width: width, height: height, fontSize: fontSize, isBold: isBold, textAlign: textAlign } as LabelElement
}

function objectFromElement(item: LabelElement): UTSJSONObject {
	const result = {} as UTSJSONObject
	result['key'] = item.key
	result['label'] = item.label
	result['type'] = item.type
	result['source'] = item.source
	result['content'] = item.content
	result['barcodeType'] = item.barcodeType
	result['showText'] = item.showText
	result['lineWidth'] = item.lineWidth
	result['x'] = Math.round(item.x * 10) / 10
	result['y'] = Math.round(item.y * 10) / 10
	result['width'] = Math.round(item.width * 10) / 10
	result['height'] = Math.round(item.height * 10) / 10
	result['fontSize'] = item.fontSize
	result['isBold'] = item.isBold
	result['fontWeight'] = item.isBold ? 'bold' : 'normal'
	result['textAlign'] = item.textAlign
	return result
}

function emitChange() {
	const payload: UTSJSONObject[] = []
	for (let index = 0; index < elements.value.length; index += 1) {
		payload.push(objectFromElement(elements.value[index]))
	}
	internalChange.value = true
	emit('change', payload)
}

function getElement(key: string): LabelElement | null {
	for (let index = 0; index < elements.value.length; index += 1) {
		if (elements.value[index].key == key) return elements.value[index]
	}
	return null
}

function getSelectedElement(): LabelElement | null {
	return getElement(selectedKey.value)
}

function updateSelectedSummary() {
	const item = getSelectedElement()
	if (item == null) {
		selectedElementSummaryText.value = '未选择字段'
		return
	}
	const current = item as LabelElement
	selectedElementSummaryText.value = current.type + ' · x ' + current.x.toString() + ' / y ' + current.y.toString()
}

function textWidthFactor(value: string, index: number): number {
	const code = value.charCodeAt(index)!
	if (code >= 48 && code <= 57) return 0.54
	const char = value.substring(index, index + 1)
	if (char == '.' || char == ',' || char == ':' || char == ';') return 0.24
	if (char == ' ' || char == '-') return 0.32
	if (code >= 65 && code <= 90) {
		if (char == 'W' || char == 'M') return 0.72
		if (char == 'I') return 0.34
		return 0.6
	}
	if (code >= 97 && code <= 122) {
		if (char == 'w' || char == 'm') return 0.72
		if (char == 'i' || char == 'l') return 0.28
		return 0.52
	}
	if (code < 128) return 0.48
	return 0.94
}

function textContentForMeasure(item: LabelElement): string {
	if (item.content != '') return item.content
	if (item.label != '') return item.label
	return ' '
}

function estimateTextContentWidthPx(content: string, displayFontSize: number, isBold: boolean): number {
	let units = 0
	for (let index = 0; index < content.length; index += 1) {
		units += textWidthFactor(content, index)
	}
	const boldFactor = isBold ? 1.04 : 1
	return units * displayFontSize * boldFactor
}

function estimateTextWidthPx(item: LabelElement, displayFontSize: number): number {
	const content = textContentForMeasure(item)
	const textWidth = estimateTextContentWidthPx(content, displayFontSize, item.isBold)
	const padding = Math.max(4, displayFontSize * 0.05)
	return textWidth + padding * 2
}

function previewTextLineHeight(fontSize: number): number {
	return Math.max(fontSize + 2, fontSize * 1.15)
}

function wrapPreviewTextLines(content: string, displayFontSize: number, isBold: boolean, maxWidth: number): string[] {
	const lines: string[] = []
	let current = ''
	for (let index = 0; index < content.length; index += 1) {
		const char = content.substring(index, index + 1)
		if (char == '\r') continue
		if (char == '\n') {
			lines.push(current)
			current = ''
			continue
		}
		const next = current + char
		if (current != '' && estimateTextContentWidthPx(next, displayFontSize, isBold) > maxWidth) {
			lines.push(current)
			current = char
		} else {
			current = next
		}
	}
	lines.push(current)
	return lines
}

function truncatePreviewTextLine(line: string, displayFontSize: number, isBold: boolean, maxWidth: number): string {
	if (estimateTextContentWidthPx(line, displayFontSize, isBold) <= maxWidth) return line
	const suffix = '...'
	let result = line
	while (result.length > 0 && estimateTextContentWidthPx(result + suffix, displayFontSize, isBold) > maxWidth) {
		result = result.substring(0, result.length - 1)
	}
	if (result == '' && estimateTextContentWidthPx(suffix, displayFontSize, isBold) > maxWidth) return ''
	return result + suffix
}

function fitPreviewText(item: LabelElement, maxWidth: number, maxHeight: number): PreviewTextFit {
	let fontSize = Math.round(Math.max(10, previewDotsToPx(item.fontSize)))
	let minSize = Math.round(Math.max(8, fontSize * 0.55))
	if (minSize > fontSize) minSize = fontSize
	while (fontSize >= minSize) {
		const lines = wrapPreviewTextLines(item.content, fontSize, item.isBold, maxWidth)
		const lineHeight = previewTextLineHeight(fontSize)
		if (lines.length * lineHeight <= maxHeight + 0.5) {
			return { lines: lines, fontSize: fontSize, lineHeight: lineHeight } as PreviewTextFit
		}
		fontSize -= 1
	}
	const lineHeight = previewTextLineHeight(minSize)
	const wrapped = wrapPreviewTextLines(item.content, minSize, item.isBold, maxWidth)
	let maxLines = Math.floor(maxHeight / lineHeight)
	if (maxLines < 1) maxLines = 1
	const lines: string[] = []
	for (let index = 0; index < wrapped.length && index < maxLines; index += 1) {
		lines.push(wrapped[index])
	}
	if (wrapped.length > maxLines && lines.length > 0) {
		const lastIndex = lines.length - 1
		lines[lastIndex] = truncatePreviewTextLine(lines[lastIndex], minSize, item.isBold, maxWidth)
	}
	return { lines: lines, fontSize: minSize, lineHeight: lineHeight } as PreviewTextFit
}

function alignedPreviewTextX(item: LabelElement, line: string, displayFontSize: number, boxX: number, boxWidth: number): number {
	const padding = 3
	const lineWidth = estimateTextContentWidthPx(line, displayFontSize, item.isBold)
	if (item.textAlign == 'center') return boxX + Math.max(padding, (boxWidth - lineWidth) / 2)
	if (item.textAlign == 'right') return boxX + Math.max(padding, boxWidth - lineWidth - padding)
	return boxX + padding
}

function textWidthMm(item: LabelElement): number {
	const displayFontSize = Math.max(10, previewDotsToPx(item.fontSize))
	return Math.max(2, estimateTextWidthPx(item, displayFontSize) / previewScale.value)
}

function textHeightMm(item: LabelElement): number {
	const displayFontSize = Math.max(10, previewDotsToPx(item.fontSize))
	return Math.max(1.5, (displayFontSize * 0.92 + 6) / previewScale.value)
}

function elementBounds(item: LabelElement): ElementBounds {
	return { x: item.x, y: item.y, width: item.width, height: item.height } as ElementBounds
}

function fitTextElement(item: LabelElement) {
	if (item.width < 2) item.width = 2
	if (item.height < 1.5) item.height = 1.5
}

function clampElement(item: LabelElement) {
	if (item.type == 'text') {
		fitTextElement(item)
	}
	if (item.type == 'hline') {
		if (item.lineWidth < 0.2) item.lineWidth = 0.2
		item.height = item.lineWidth
	}
	if (item.type == 'vline') {
		if (item.lineWidth < 0.2) item.lineWidth = 0.2
		item.width = item.lineWidth
	}
	if (item.type != 'vline' && item.width < 2) item.width = 2
	if (item.type != 'hline' && item.height < 1.5) item.height = 1.5
	if (item.type == 'barcode' && item.height < 3) item.height = 3
	if (item.fontSize < 8) item.fontSize = 8
	if (item.x < 0) item.x = 0
	if (item.y < 0) item.y = 0
	if (item.x + item.width > labelWidthMm()) item.x = labelWidthMm() - item.width
	if (item.y + item.height > labelHeightMm()) item.y = labelHeightMm() - item.height
	if (item.x < 0) item.x = 0
	if (item.y < 0) item.y = 0
}

function drawCanvasText(context: DrawableContext, item: LabelElement) {
	const x = item.x * previewScale.value
	const y = item.y * previewScale.value
	const width = Math.max(1, item.width * previewScale.value)
	const height = Math.max(1, item.height * previewScale.value)
	const fit = fitPreviewText(item, Math.max(1, width - 6), height)
	context.fillStyle = '#111827'
	context.strokeStyle = '#111827'
	context.font = fit.fontSize.toString() + 'px'
	context.textAlign = 'left'
	for (let index = 0; index < fit.lines.length; index += 1) {
		const textY = y + fit.fontSize * 0.78 + index * fit.lineHeight
		if (textY <= y + height + 0.5) {
			const textX = alignedPreviewTextX(item, fit.lines[index], fit.fontSize, x, width)
			context.fillText(fit.lines[index], textX, textY)
			if (item.isBold) {
				const offset = Math.max(1, fit.fontSize * 0.025)
				context.fillText(fit.lines[index], textX + offset, textY)
			}
		}
	}
}

function drawCanvasBarcode(context: DrawableContext, item: LabelElement) {
	const x = item.x * previewScale.value
	const y = item.y * previewScale.value
	const width = item.width * previewScale.value
	const height = item.height * previewScale.value
	context.fillStyle = '#111827'
	const count = item.barcodeType == 'EAN13' ? 59 : 38
	const barWidth = width / count
	const bottomTextHeight = item.showText ? previewDotsToPx(14) : 0
	for (let index = 0; index < count; index += 1) {
		if (index % 3 != 1) context.fillRect(x + index * barWidth, y + 4, Math.max(1, barWidth * 0.65), Math.max(4, height - 6 - bottomTextHeight))
	}
	if (item.showText) {
		context.font = Math.max(8, previewDotsToPx(12)).toString() + 'px'
		context.textAlign = 'left'
		context.fillText(item.content, x + 4, y + height - 4)
	}
}

function drawCanvasGraphic(context: DrawableContext, item: LabelElement) {
	const x = item.x * previewScale.value
	const y = item.y * previewScale.value
	const width = item.width * previewScale.value
	const height = item.height * previewScale.value
	const linePx = Math.max(1, item.lineWidth * previewScale.value)
	context.fillStyle = '#111827'
	context.strokeStyle = '#111827'
	context.lineWidth = linePx
	if (item.type == 'hline') {
		context.fillRect(x, y, Math.max(1, width), Math.max(1, linePx))
		return
	}
	if (item.type == 'vline') {
		context.fillRect(x, y, Math.max(1, linePx), Math.max(1, height))
		return
	}
	if (item.type == 'rect') {
		context.strokeRect(x + linePx / 2, y + linePx / 2, Math.max(1, width - linePx), Math.max(1, height - linePx))
	}
}

function drawCanvasElement(context: DrawableContext, item: LabelElement) {
	const bounds = elementBounds(item)
	const x = bounds.x * previewScale.value
	const y = bounds.y * previewScale.value
	const width = bounds.width * previewScale.value
	const height = bounds.height * previewScale.value
	context.strokeStyle = selectedKey.value == item.key ? '#2563EB' : '#CBD5E1'
	context.lineWidth = selectedKey.value == item.key ? 2 : 1
	if (selectedKey.value == item.key) {
		context.fillStyle = 'rgba(37,99,235,0.06)'
		context.fillRect(x, y, width, height)
	}
	context.strokeRect(x + 0.5, y + 0.5, Math.max(1, width - 1), Math.max(1, height - 1))
	if (selectedKey.value == item.key) {
		const handleSize = 12
		context.fillStyle = '#2563EB'
		context.fillRect(x + width - handleSize, y + height - handleSize, handleSize, handleSize)
		context.fillStyle = '#FFFFFF'
		context.fillRect(x + width - 8, y + height - 8, 4, 4)
	}
	if (item.type == 'barcode') {
		drawCanvasBarcode(context, item)
	} else if (item.type == 'hline' || item.type == 'vline' || item.type == 'rect') {
		drawCanvasGraphic(context, item)
	} else {
		drawCanvasText(context, item)
	}
}

function renderCanvas() {
	if (labelCanvasContext == null) return
	const context = labelCanvasContext as DrawableContext
	const width = canvasWidthPx()
	const height = canvasHeightPx()
	context.reset()
	context.fillStyle = '#FFFFFF'
	context.fillRect(0, 0, width, height)
	context.strokeStyle = '#CBD5E1'
	context.lineWidth = 1
	context.strokeRect(0.5, 0.5, width - 1, height - 1)
	for (let index = 0; index < elements.value.length; index += 1) {
		drawCanvasElement(context, elements.value[index])
	}
	context.update()
}

function renderSoon() {
	nextTick(() => {
		renderCanvas()
	})
}

function initCanvas() {
	if (canvasRef.value == null) return
	const canvas = canvasRef.value as UniElement
	const context = canvas.getDrawableContext()
	if (context == null) return
	labelCanvasContext = context as DrawableContext
	canvas.getBoundingClientRectAsync()?.then((rect) => {
		canvasLeftPx = rect.left
		canvasTopPx = rect.top
	})
	renderCanvas()
}

function updateCanvasBounds() {
	if (canvasRef.value == null) return
	const canvas = canvasRef.value as UniElement
	canvas.getBoundingClientRectAsync()?.then((rect) => {
		canvasLeftPx = rect.left
		canvasTopPx = rect.top
	})
}

function updatePreviewScale() {
	const info = uni.getSystemInfoSync()
	const text = JSON.stringify(info)
	const object = JSON.parseObject<UTSJSONObject>(text)
	if (object == null) return
	const windowWidth = numberValue(stringValue(object!['windowWidth']), 375)
	const available = windowWidth - 64
	const widthMm = labelWidthMm()
	if (available > 0 && widthMm > 0) {
		const nextScale = Math.floor(available / widthMm)
		if (nextScale >= 4) {
			previewScale.value = nextScale
		}
	}
}

function initCanvasSoon() {
	updatePreviewScale()
	nextTick(() => {
		initCanvas()
	})
	setTimeout(() => {
		initCanvas()
	}, 120)
}

function loadElements(value: UTSJSONObject[]) {
	const next: LabelElement[] = []
	const previousKey = selectedKey.value
	const usedKeys: string[] = []
	let normalizedKeys = false
	nextIndex.value = 1
	for (let index = 0; index < value.length; index += 1) {
		const item = elementFromObject(value[index], index)
		const originalKey = item.key
		item.key = reserveElementKey(originalKey, usedKeys)
		if (item.key != originalKey) normalizedKeys = true
		clampElement(item)
		next.push(item)
	}
	if (next.length == 0) {
		next.push({ key: reserveElementKey('field-1', usedKeys), label: '文本', type: 'text', source: 'custom', content: 'TEXT', barcodeType: 'CODE128', showText: true, lineWidth: 1, x: 2, y: 2, width: 18, height: 4, fontSize: 18, isBold: false, textAlign: 'left' } as LabelElement)
	}
	elements.value = next
	let nextKey = next[0].key
	for (let index = 0; index < next.length; index += 1) {
		if (next[index].key == previousKey) nextKey = previousKey
	}
	selectedKey.value = nextKey
	updateSelectedSummary()
	if (normalizedKeys) emitChange()
	renderSoon()
}

const boardStyle = computed((): string => {
	return 'width:' + canvasWidthPx().toString() + 'px;height:' + canvasHeightPx().toString() + 'px;'
})

const selectedElementSummary = computed((): string => selectedElementSummaryText.value)

const selectedContent = computed((): string => {
	const item = getSelectedElement()
	if (item == null) return ''
	return (item as LabelElement).content
})

const selectedLabel = computed((): string => {
	const item = getSelectedElement()
	if (item == null) return ''
	return (item as LabelElement).label
})

const selectedSourceText = computed((): string => {
	const item = getSelectedElement()
	if (item == null) return '未选择字段'
	const current = item as LabelElement
	if (current.type == 'hline') return '图形：横线'
	if (current.type == 'vline') return '图形：竖线'
	if (current.type == 'rect') return '图形：边框'
	if (current.source == 'custom') return '自定义字段'
	if (current.source == 'name') return '商品名称 name'
	if (current.source == 'name_cn') return '中文名 name_cn'
	if (current.source == 'name_en') return '英文名 name_en'
	if (current.source == 'name_other') return '其他名 name_other'
	if (current.source == 'base_sales_price') return '原价 base_sales_price'
	if (current.source == 'discount_price') return '折扣价 discount_price'
	if (current.source == 'barcode') return '条码 barcode'
	if (current.source == 'sku') return 'SKU sku'
	if (current.source == 'kod') return 'KOD kod'
	if (current.source == 'specification') return '规格 specification'
	return current.source
})

const selectedType = computed((): string => {
	const item = getSelectedElement()
	if (item == null) return ''
	return (item as LabelElement).type
})

const selectedBarcodeType = computed((): string => {
	const item = getSelectedElement()
	if (item == null) return 'CODE128'
	return (item as LabelElement).barcodeType
})

const selectedBold = computed((): boolean => {
	const item = getSelectedElement()
	if (item == null) return false
	return (item as LabelElement).isBold
})

const selectedTextAlign = computed((): string => {
	const item = getSelectedElement()
	if (item == null) return 'left'
	return (item as LabelElement).textAlign
})

const selectedShowText = computed((): boolean => {
	const item = getSelectedElement()
	if (item == null) return true
	return (item as LabelElement).showText
})

const selectedLineWidth = computed((): string => {
	const item = getSelectedElement()
	if (item == null) return '0.4'
	return (item as LabelElement).lineWidth.toString()
})

function selectElement(key: any) {
	selectedKey.value = stringValue(key)
	updateSelectedSummary()
	renderCanvas()
}

function moveSelected(dx: number, dy: number) {
	const item = getSelectedElement()
	if (item == null) return
	const current = item as LabelElement
	current.x = current.x + dx
	current.y = current.y + dy
	clampElement(current)
	updateSelectedSummary()
	emitChange()
	renderCanvas()
}

function resizeSelected(delta: number) {
	const item = getSelectedElement()
	if (item == null) return
	const current = item as LabelElement
	if (current.type != 'text') return
	current.fontSize = current.fontSize + delta * 2
	clampElement(current)
	updateSelectedSummary()
	emitChange()
	renderCanvas()
}

function makeMappedElement(type: string, label: string, source: string, content: string, x: number, y: number, width: number, height: number, fontSize: number, isBold: boolean = false, textAlign: string = 'left'): LabelElement {
	return { key: makeKey(), label: label, type: type, source: source, content: content, barcodeType: type == 'barcode' ? 'EAN13' : 'CODE128', showText: type == 'barcode' ? false : true, lineWidth: 0.4, x: x, y: y, width: width, height: height, fontSize: fontSize, isBold: isBold, textAlign: normalizeTextAlign(textAlign) } as LabelElement
}

function makeElement(type: string, label: string, content: string, x: number, y: number, width: number, height: number, fontSize: number): LabelElement {
	return makeMappedElement(type, label, 'custom', content, x, y, width, height, fontSize)
}

function addElement(item: LabelElement) {
	clampElement(item)
	elements.value.push(item)
	selectedKey.value = item.key
	updateSelectedSummary()
	emitChange()
	renderSoon()
}

function addTextElement() {
	addElement(makeElement('text', '文本', 'TEXT', 2, 2, 18, 4, 18))
}

function addBarcodeElement() {
