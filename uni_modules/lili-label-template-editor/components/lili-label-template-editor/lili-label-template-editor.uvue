.lte-tabs { flex-direction: row; flex-wrap: wrap; margin-top: 16rpx; }
.lte-tab { height: 54rpx; padding: 0 18rpx; border-radius: 16rpx; border-width: 1rpx; border-color: #D8E2EF; background-color: #F8FAFC; align-items: center; justify-content: center; margin-right: 10rpx; margin-bottom: 10rpx; }
.lte-tab-active { background-color: #111827; border-color: #111827; }
.lte-tab-text { font-size: 23rpx; color: #334155; }
.lte-tab-text-active { color: #FFFFFF; font-weight: 700; }
.lte-nudge-grid { flex-direction: row; justify-content: space-between; margin-top: 8rpx; }
.lte-nudge { width: 23%; height: 56rpx; border-radius: 16rpx; background-color: #F8FAFC; border-width: 1rpx; border-color: #D8E2EF; align-items: center; justify-content: center; }
.lte-nudge-text { font-size: 23rpx; color: #334155; font-weight: 700; }
.lte-editor { margin-top: 16rpx; border-radius: 18rpx; background-color: #F8FAFC; border-width: 1rpx; border-color: #D8E2EF; padding: 18rpx; }
