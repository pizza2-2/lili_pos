.lte-tool-danger-text { font-size: 23rpx; color: #B91C1C; font-weight: 700; }
.lte-board-scroll { width: 100%; }
.lte-board-shell { width: 100%; min-height: 300px; border-radius: 22rpx; background-color: #E8EEF7; align-items: center; justify-content: center; padding: 18rpx; box-sizing: border-box; }
.lte-canvas { background-color: #FFFFFF; border-radius: 12rpx; }
.lte-tabs { flex-direction: row; flex-wrap: wrap; margin-top: 16rpx; }
.lte-tab { height: 54rpx; padding: 0 18rpx; border-radius: 16rpx; border-width: 1rpx; border-color: #D8E2EF; background-color: #F8FAFC; align-items: center; justify-content: center; margin-right: 10rpx; margin-bottom: 10rpx; }
.lte-tab-active { background-color: #111827; border-color: #111827; }
.lte-tab-text { font-size: 23rpx; color: #334155; }
.lte-tab-text-active { color: #FFFFFF; font-weight: 700; }
.lte-nudge-grid { flex-direction: row; justify-content: space-between; margin-top: 8rpx; }
.lte-nudge { width: 23%; height: 56rpx; border-radius: 16rpx; background-color: #F8FAFC; border-width: 1rpx; border-color: #D8E2EF; align-items: center; justify-content: center; }
.lte-nudge-text { font-size: 23rpx; color: #334155; font-weight: 700; }
.lte-editor { margin-top: 16rpx; border-radius: 18rpx; background-color: #F8FAFC; border-width: 1rpx; border-color: #D8E2EF; padding: 18rpx; }
.lte-editor-head { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 14rpx; }
.lte-editor-title { font-size: 26rpx; font-weight: 700; color: #0F172A; }
.lte-editor-subtitle { font-size: 21rpx; color: #64748B; }
.lte-barcode-options { margin-bottom: 14rpx; }
.lte-type-row { flex-direction: row; margin-top: 8rpx; margin-bottom: 12rpx; }
.lte-type-chip { height: 54rpx; padding: 0 18rpx; border-radius: 16rpx; border-width: 1rpx; border-color: #D8E2EF; background-color: #FFFFFF; align-items: center; justify-content: center; margin-right: 12rpx; }
.lte-type-chip-active { background-color: #111827; border-color: #111827; }
.lte-type-text { font-size: 22rpx; color: #334155; font-weight: 700; }
.lte-type-text-active { color: #FFFFFF; }
.lte-switch-line { flex-direction: row; align-items: center; justify-content: space-between; border-radius: 16rpx; background-color: #FFFFFF; border-width: 1rpx; border-color: #D8E2EF; padding: 14rpx 16rpx; }
.lte-switch-copy { flex: 1; padding-right: 14rpx; }
.lte-switch-title { font-size: 23rpx; font-weight: 700; color: #0F172A; line-height: 32rpx; }
.lte-switch-desc { font-size: 20rpx; color: #64748B; line-height: 28rpx; }
.lte-input-row { margin-bottom: 14rpx; }
.lte-input-label { font-size: 22rpx; color: #64748B; margin-bottom: 8rpx; }
.lte-input { height: 62rpx; border-radius: 16rpx; background-color: #FFFFFF; border-width: 1rpx; border-color: #D8E2EF; padding: 0 18rpx; font-size: 24rpx; color: #0F172A; }
</style>
