.lte-source-row { flex-direction: row; align-items: center; justify-content: space-between; min-height: 52rpx; border-radius: 14rpx; background-color: #FFFFFF; border-width: 1rpx; border-color: #D8E2EF; padding: 0 16rpx; margin-bottom: 14rpx; }
.lte-source-label { font-size: 22rpx; color: #64748B; }
.lte-source-value { font-size: 22rpx; color: #0F172A; font-weight: 700; }
.lte-barcode-options { margin-bottom: 14rpx; }
.lte-type-row { flex-direction: row; margin-top: 8rpx; margin-bottom: 12rpx; }
.lte-type-chip { height: 54rpx; padding: 0 18rpx; border-radius: 16rpx; border-width: 1rpx; border-color: #D8E2EF; background-color: #FFFFFF; align-items: center; justify-content: center; margin-right: 12rpx; }
.lte-type-chip-active { background-color: #111827; border-color: #111827; }
.lte-type-text { font-size: 22rpx; color: #334155; font-weight: 700; }
