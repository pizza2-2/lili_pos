import Activity from 'android.app.Activity'
import Bitmap from 'android.graphics.Bitmap'
import Color from 'android.graphics.Color'
import PdfRenderer from 'android.graphics.pdf.PdfRenderer'
import ParcelFileDescriptor from 'android.os.ParcelFileDescriptor'
import File from 'java.io.File'
import FileOutputStream from 'java.io.FileOutputStream'
import { PdfRenderPagesOptions, PdfRenderResult, RenderPdfPages } from '../interface.uts'
import { makePdfRenderFail } from '../unierror.uts'

function normalizeLocalPath(filePath: string): string {
	let nextPath = filePath.trim()
	if (nextPath.startsWith('file://')) {
		nextPath = nextPath.substring(7)
	}
	try {
		const convertedPath = UTSAndroid.convert2AbsFullPath(nextPath)
		if (convertedPath != '') {
			nextPath = convertedPath
		}
		if (nextPath.startsWith('file://')) {
			nextPath = nextPath.substring(7)
		}
	} catch (error) {}
	return nextPath
}

function optionScale(value: number | null): number {
	if (value == null || value <= 0) return 2.0
	if (value < 1.0) return 1.0
	if (value > 4.0) return 4.0
	return value
}

function optionMaxPages(value: number | null): number {
	if (value == null || value <= 0) return 20
	if (value > 60) return 60
	return Math.floor(value)
}

function makeResult(filePath: string, pageCount: number, pages: string[]): PdfRenderResult {
	return {
		success: true,
		code: 'OK',
		message: 'PDF渲染完成',
		filePath: filePath,
		pageCount: pageCount,
		pages: pages,
	} as PdfRenderResult
}

export const renderPdfPages: RenderPdfPages = function (options: PdfRenderPagesOptions) {
	const inputPath = normalizeLocalPath(options.filePath)
	if (inputPath == '') {
		const err = makePdfRenderFail('EMPTY_PATH', 'PDF文件地址为空')
		options.fail?.(err)
		options.complete?.(err)
		return
	}

	const activity = UTSAndroid.getUniActivity() as Activity
	if (activity == null) {
		const err = makePdfRenderFail('NO_ACTIVITY', '当前页面无法渲染PDF')
		options.fail?.(err)
		options.complete?.(err)
		return
	}

	const sourceFile = new File(inputPath)
	if (!sourceFile.exists()) {
		const err = makePdfRenderFail('FILE_NOT_FOUND', 'PDF文件不存在')
		options.fail?.(err)
		options.complete?.(err)
		return
	}

	let descriptor: ParcelFileDescriptor | null = null
	let renderer: PdfRenderer | null = null
	try {
		descriptor = ParcelFileDescriptor.open(sourceFile, ParcelFileDescriptor.MODE_READ_ONLY)
		if (descriptor == null) {
			const err = makePdfRenderFail('OPEN_FAILED', 'PDF文件打开失败')
			options.fail?.(err)
			options.complete?.(err)
			return
		}

		renderer = new PdfRenderer(descriptor!)
		const pageCount = renderer!.getPageCount()
		const renderScale = optionScale(options.scale ?? null)
		const renderLimit = optionMaxPages(options.maxPages ?? null)
		const renderCount = Math.min(pageCount, renderLimit)
		const pages: string[] = []
		const outputDir = new File(activity.getCacheDir(), 'pdf-preview')
		if (!outputDir.exists()) {
			outputDir.mkdirs()
		}
		const prefix = 'pdf-' + new Date().getTime().toString() + '-'

		let index = 0
		while (index < renderCount) {
			let page: PdfRenderer.Page | null = null
			let bitmap: Bitmap | null = null
			let output: FileOutputStream | null = null
			try {
				page = renderer!.openPage(index.toInt())
				const width = Math.max(1, Math.round(page!.getWidth() * renderScale))
				const height = Math.max(1, Math.round(page!.getHeight() * renderScale))
				bitmap = Bitmap.createBitmap(width.toInt(), height.toInt(), Bitmap.Config.ARGB_8888)
				bitmap!.eraseColor(Color.WHITE)
				page!.render(bitmap!, null, null, PdfRenderer.Page.RENDER_MODE_FOR_DISPLAY.toInt())

				const targetFile = new File(outputDir, prefix + index.toString() + '.png')
				output = new FileOutputStream(targetFile)
				bitmap!.compress(Bitmap.CompressFormat.PNG, 100, output!)
				output!.flush()
				pages.push(targetFile.getAbsolutePath())
			} catch (pageError) {
				const err = makePdfRenderFail('RENDER_FAILED', 'PDF第' + (index + 1).toString() + '页渲染失败')
				options.fail?.(err)
				options.complete?.(err)
				return
			} finally {
				if (output != null) {
					try {
						output!.close()
					} catch (closeOutputError) {}
				}
				if (bitmap != null) {
					try {
						bitmap!.recycle()
					} catch (recycleError) {}
				}
				if (page != null) {
					try {
						page!.close()
					} catch (closePageError) {}
				}
			}
			index += 1
		}

		const res = makeResult(inputPath, pageCount, pages)
		options.success?.(res)
		options.complete?.(res)
	} catch (error) {
		const err = makePdfRenderFail('RENDER_FAILED', 'PDF渲染失败')
		options.fail?.(err)
		options.complete?.(err)
	} finally {
		if (renderer != null) {
			try {
				renderer!.close()
			} catch (closeRendererError) {}
		}
		if (descriptor != null) {
			try {
				descriptor!.close()
			} catch (closeDescriptorError) {}
		}
	}
}
