export async function getProductCategoryHistory(id: number | string): Promise<UTSJSONObject> {
	const raw = await request(
		productDetailPath(id) + 'category-history/',
		'GET',
		{} as UTSJSONObject,
		false
	)
	const text = JSON.stringify(raw)
	if (text == null || text == '' || !text.startsWith('{')) {
		return {} as UTSJSONObject
	}
	try {
		const parsed = JSON.parseObject<UTSJSONObject>(text)
		return parsed == null ? {} as UTSJSONObject : parsed as UTSJSONObject
	} catch (error) {
		return {} as UTSJSONObject
	}
}

