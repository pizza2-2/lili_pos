function parseProductDiscountInfo(value: any | null): ProductDiscountInfo | null {
	if (value == null) {
		return null
	}
	const source = parseObject(value)
	if (source == null) {
		return null
	}
	const discountIdValue = source['discount_id']
	let discountId: number | null = null
	if (discountIdValue != null) {
		const parsedDiscountId = parseInt('' + discountIdValue)
		if (!isNaN(parsedDiscountId)) {
			discountId = parsedDiscountId
		}
	}
	return {
		has_discount: booleanValue(source['has_discount']),
		discount_id: discountId,
		discount_name: stringValue(source['discount_name']),
		discount_type: stringValue(source['discount_type']),
		original_price: stringValue(source['original_price']),
		final_price: stringValue(source['final_price']),
		discount_amount: stringValue(source['discount_amount']),
		discount_percentage: stringValue(source['discount_percentage']),
		discount_amount_fixed: stringValue(source['discount_amount_fixed']),
		min_quantity: intValue(source['min_quantity']),
	} as ProductDiscountInfo
}

