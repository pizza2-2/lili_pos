function parsePrintTemplateObject(value: any | null): UTSJSONObject | null {
	if (value == null) return null
	const text = JSON.stringify(value)
	if (text == null || text == '') return null
	return JSON.parseObject<UTSJSONObject>(text)
}

function parsePrintTemplateArray(value: any | null): PrintTemplateItem[] {
	if (value == null) return [] as PrintTemplateItem[]
	const text = JSON.stringify(value)
	if (text == null || text == '') return [] as PrintTemplateItem[]
	const parsed = JSON.parseArray<PrintTemplateItem>(text)
	if (parsed == null) return [] as PrintTemplateItem[]
	return parsed!
}

function parsePrintTemplateItem(value: any | null): PrintTemplateItem {
	const text = JSON.stringify(value)
	const parsed = text == null || text == '' ? null : JSON.parseObject<PrintTemplateItem>(text)
	if (parsed == null) throw new Error('标签模板响应解析失败')
	return parsed!
}

function printTemplateIntValue(value: any | null, fallback: number): number {
	if (value == null) return fallback
	const parsed = parseInt('' + value)
	if (isNaN(parsed)) return fallback
	return parsed
}

function buildPrintTemplateListResponse(raw: any, query: PrintTemplateListQuery): PrintTemplateListResponse {
	const rawObject = parsePrintTemplateObject(raw)
	if (rawObject == null) throw new Error('标签模板列表响应解析失败')
	let paginationObject: UTSJSONObject | null = null
	const rawPagination = rawObject!['pagination']
	if (rawPagination != null) paginationObject = parsePrintTemplateObject(rawPagination)
	const results = parsePrintTemplateArray(rawObject!['results'])
	let totalCount = printTemplateIntValue(rawObject!['count'], 0)
	if (totalCount <= 0) totalCount = printTemplateIntValue(rawObject!['total_count'], 0)
	if (totalCount <= 0 && paginationObject != null) totalCount = printTemplateIntValue(paginationObject!['total'], 0)
	if (totalCount <= 0 && paginationObject != null) totalCount = printTemplateIntValue(paginationObject!['count'], 0)
	if (totalCount <= 0) totalCount = results.length
	let currentPage = printTemplateIntValue(rawObject!['current_page'], 0)
	if (currentPage <= 0) currentPage = printTemplateIntValue(rawObject!['page'], 0)
	if (currentPage <= 0 && paginationObject != null) currentPage = printTemplateIntValue(paginationObject!['page'], 0)
	if (currentPage <= 0) currentPage = query.page
	let pageSize = printTemplateIntValue(rawObject!['page_size'], 0)
	if (pageSize <= 0 && paginationObject != null) pageSize = printTemplateIntValue(paginationObject!['page_size'], 0)
	if (pageSize <= 0) pageSize = query.page_size
	let totalPages = printTemplateIntValue(rawObject!['total_pages'], 0)
	if (totalPages <= 0 && paginationObject != null) totalPages = printTemplateIntValue(paginationObject!['total_pages'], 0)
	if (totalPages <= 0 && pageSize > 0) totalPages = Math.ceil(totalCount / pageSize)
	if (totalPages <= 0) totalPages = 1
	return {
		results: results,
		count: totalCount,
		total_count: totalCount,
		total_pages: totalPages,
		current_page: currentPage,
		page_size: pageSize,
	} as PrintTemplateListResponse
}

export async function getPrintTemplateList(data: PrintTemplateListQuery): Promise<PrintTemplateListResponse> {
	const raw = await request('/api/products/print-templates/', 'GET', buildPrintTemplateListQuery(data), true)
	return buildPrintTemplateListResponse(raw, data)
}

export async function getPrintTemplateDetail(id: string): Promise<PrintTemplateItem> {
	const raw = await request('/api/products/print-templates/' + id + '/', 'GET', {} as UTSJSONObject, true)
	return parsePrintTemplateItem(raw)
}

function buildPrintTemplateMutationBody(data: PrintTemplateMutationData): UTSJSONObject {
	const body = {} as UTSJSONObject
	body['name'] = data.name
	body['template_type'] = data.template_type
	body['printer_language'] = data.printer_language
	body['paper_width_mm'] = data.paper_width_mm
	body['paper_height_mm'] = data.paper_height_mm
	body['dots_per_mm'] = data.dots_per_mm
	body['copies_default'] = data.copies_default
	body['elements'] = data.elements
	body['is_default'] = data.is_default
	body['is_active'] = data.is_active
	body['description'] = data.description
	return body
}

export function createPrintTemplate(data: PrintTemplateMutationData): Promise<any> {
	return request('/api/products/print-templates/', 'POST', buildPrintTemplateMutationBody(data), true)
}

export function updatePrintTemplate(id: string, data: PrintTemplateMutationData): Promise<any> {
	return request('/api/products/print-templates/' + id + '/', 'PUT', buildPrintTemplateMutationBody(data), true)
}

export function setDefaultPrintTemplate(id: string): Promise<any> {
	return request('/api/products/print-templates/' + id + '/set-default/', 'POST', {} as UTSJSONObject, true)
}

// 商品关键字段变更记录：返回原始响应对象，由页面自行解析列表；顶层数组响应兜底包一层 results
export async function getProductChangeLogs(productId: number): Promise<UTSJSONObject> {
	const raw = await request(
		productDetailPath(productId) + 'change-logs/',
		'GET',
		{} as UTSJSONObject,
		false
	)
	const text = JSON.stringify(raw)
	if (text == null || text == '') {
		return {} as UTSJSONObject
	}
	try {
		if (text.startsWith('[')) {
			const parsedArray = JSON.parseArray<UTSJSONObject>(text)
			const wrapper = {} as UTSJSONObject
			wrapper['results'] = parsedArray == null ? [] as UTSJSONObject[] : parsedArray as UTSJSONObject[]
			return wrapper
		}
		if (!text.startsWith('{')) {
			return {} as UTSJSONObject
		}
		const parsed = JSON.parseObject<UTSJSONObject>(text)
		return parsed == null ? {} as UTSJSONObject : parsed as UTSJSONObject
	} catch (error) {
		return {} as UTSJSONObject
	}
}
