import { request } from '../index.uts'

export type InventoryListQuery = {
	search: string | null
	page: number
	page_size: number
	status: string | null
	alert_status: string | null
	supplier?: string | null
	category?: string | null
	is_listed?: string | null
	location?: string | null
	from_location?: string | null
	to_location?: string | null
	transfer_order?: string | null
	inventory_check?: string | null
	product?: string | null
	stock?: string | null
	check_type?: string | null
	is_checked?: string | null
	discrepancy?: string | null
	sort_by?: string | null
	transaction_type: string | null
	location_type: string | null
	is_active: string | null
}

export type InventoryListResponse = {
	results: UTSJSONObject[]
	total_count: number
	total_pages: number
	current_page: number
	page_size: number
}

export type StockAdjustmentData = {
	stock_id: number
	quantity_change: number
	transaction_type: string
	unit_cost: string
	notes: string
}

export type InventoryStockCreateForProductData = {
	product: number
	location: number
	quantity: number
	transaction_type: string
	unit_cost: string
	notes: string
}

export type InventoryMutationData = {
	payload: UTSJSONObject
}

function stringValue(value: any | null): string {
	if (value == null) return ''
	return '' + value
}

function intValue(value: any | null): number {
	if (value == null) return 0
	const parsed = parseInt('' + value)
	if (isNaN(parsed)) return 0
	return parsed
}

function buildQuery(data: InventoryListQuery): UTSJSONObject {
	const query = {
		page: data.page,
		page_size: data.page_size,
	} as UTSJSONObject
	if (data.search != null && data.search != '') query['search'] = data.search
	if (data.status != null && data.status != '') query['status'] = data.status
	if (data.alert_status != null && data.alert_status != '') query['alert_status'] = data.alert_status
	if (data.supplier != null && data.supplier != '') query['supplier'] = data.supplier
	if (data.category != null && data.category != '') query['category'] = data.category
	if (data.is_listed != null && data.is_listed != '') query['is_listed'] = data.is_listed
	if (data.location != null && data.location != '') query['location'] = data.location
	if (data.from_location != null && data.from_location != '') query['from_location'] = data.from_location
	if (data.to_location != null && data.to_location != '') query['to_location'] = data.to_location
	if (data.transfer_order != null && data.transfer_order != '') query['transfer_order'] = data.transfer_order
	if (data.inventory_check != null && data.inventory_check != '') query['inventory_check'] = data.inventory_check
	if (data.product != null && data.product != '') query['product'] = data.product
	if (data.stock != null && data.stock != '') query['stock'] = data.stock
	if (data.check_type != null && data.check_type != '') query['check_type'] = data.check_type
	if (data.is_checked != null && data.is_checked != '') query['is_checked'] = data.is_checked
	if (data.discrepancy != null && data.discrepancy != '') query['discrepancy'] = data.discrepancy
	if (data.sort_by != null && data.sort_by != '') query['sort_by'] = data.sort_by
	if (data.transaction_type != null && data.transaction_type != '') query['transaction_type'] = data.transaction_type
	if (data.location_type != null && data.location_type != '') query['location_type'] = data.location_type
	if (data.is_active != null && data.is_active != '') query['is_active'] = data.is_active
	return query
}

function parseObjectArray(value: any | null): UTSJSONObject[] {
	if (value == null) return [] as UTSJSONObject[]
	const text = JSON.stringify(value)
	if (text == null || text == '') return [] as UTSJSONObject[]
	const trimmedText = text.trim()
	if (trimmedText == '' || trimmedText.substring(0, 1) != '[') return [] as UTSJSONObject[]
	let parsed: UTSJSONObject[] | null = null
	try {
		parsed = JSON.parseArray<UTSJSONObject>(trimmedText)
	} catch (error) {
		return [] as UTSJSONObject[]
	}
	if (parsed == null) return [] as UTSJSONObject[]
	return parsed!
}

function parseObject(value: any | null): UTSJSONObject | null {
	if (value == null) return null
	const text = JSON.stringify(value)
	if (text == null || text == '') return null
	const trimmedText = text.trim()
	if (trimmedText == '' || trimmedText.substring(0, 1) != '{') return null
	try {
		return JSON.parseObject<UTSJSONObject>(trimmedText)
	} catch (error) {
		return null
	}
}

function buildListResponse(raw: any, query: InventoryListQuery): InventoryListResponse {
	const directRows = parseObjectArray(raw)
	const rawObject = parseObject(raw)
	if (rawObject == null) {
		return {
			results: directRows,
			total_count: directRows.length,
			total_pages: 1,
			current_page: query.page,
			page_size: query.page_size,
		} as InventoryListResponse
	}
	let sourceObject = rawObject!
	const nestedDataObject = parseObject(rawObject!['data'])
	if (parseObjectArray(sourceObject['results']).length == 0 && nestedDataObject != null) sourceObject = nestedDataObject!
	let paginationObject: UTSJSONObject | null = null
	let rawPagination = sourceObject['pagination']
	if (rawPagination == null) rawPagination = rawObject!['pagination']
	if (rawPagination != null) {
		paginationObject = parseObject(rawPagination)
	}
	let results = parseObjectArray(sourceObject['results'])
	if (results.length == 0) results = parseObjectArray(sourceObject['data'])
	if (results.length == 0) results = directRows
	let totalCount = intValue(sourceObject['count'])
	if (totalCount <= 0) totalCount = intValue(sourceObject['total_count'])
	if (totalCount <= 0 && paginationObject != null) totalCount = intValue(paginationObject!['total'])
	if (totalCount <= 0 && paginationObject != null) totalCount = intValue(paginationObject!['count'])
	if (totalCount <= 0) totalCount = results.length
	let currentPage = intValue(sourceObject['current_page'])
	if (currentPage <= 0) currentPage = intValue(sourceObject['page'])
	if (currentPage <= 0 && paginationObject != null) currentPage = intValue(paginationObject!['page'])
	if (currentPage <= 0) currentPage = query.page
	let pageSize = intValue(sourceObject['page_size'])
	if (pageSize <= 0 && paginationObject != null) pageSize = intValue(paginationObject!['page_size'])
	if (pageSize <= 0) pageSize = query.page_size
	let totalPages = intValue(sourceObject['total_pages'])
	if (totalPages <= 0 && paginationObject != null) totalPages = intValue(paginationObject!['total_pages'])
	if (totalPages <= 0 && pageSize > 0) totalPages = Math.ceil(totalCount / pageSize)
	if (totalPages <= 0) totalPages = 1
	return {
		results: results,
		total_count: totalCount,
		total_pages: totalPages,
		current_page: currentPage,
		page_size: pageSize,
	} as InventoryListResponse
}

function stockAdjustmentBody(data: StockAdjustmentData): UTSJSONObject {
	return {
		stock_id: data.stock_id,
		quantity_change: data.quantity_change,
		transaction_type: data.transaction_type,
		unit_cost: data.unit_cost,
		notes: data.notes,
		reference_type: '',
		reference_id: '',
	} as UTSJSONObject
}

function stockCreateForProductBody(data: InventoryStockCreateForProductData): UTSJSONObject {
	return {
		product: data.product,
		location: data.location,
		quantity: data.quantity,
		transaction_type: data.transaction_type,
		unit_cost: data.unit_cost,
		notes: data.notes,
	} as UTSJSONObject
}

export async function getInventoryStocks(data: InventoryListQuery): Promise<InventoryListResponse> {
	const raw = await request('/api/inventory/stocks/', 'GET', buildQuery(data), true)
	return buildListResponse(raw, data)
}

export async function getInventoryLocations(data: InventoryListQuery): Promise<InventoryListResponse> {
	const raw = await request('/api/inventory/locations/', 'GET', buildQuery(data), true)
	return buildListResponse(raw, data)
}

