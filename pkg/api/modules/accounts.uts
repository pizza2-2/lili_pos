import { request } from '../index.uts'

// 成员管理 / 权限 / 公司设置（App 单公司口径）
// request 已直接 resolve 服务器返回的 data 字段

function toObject(raw: any | null, errorMessage: string): UTSJSONObject {
	if (raw == null) {
		throw new Error(errorMessage)
	}
	const text = JSON.stringify(raw)
	if (text == null || text == '' || !text.startsWith('{')) {
		throw new Error(errorMessage)
	}
	const parsed = JSON.parseObject<UTSJSONObject>(text!)
	if (parsed == null) {
		throw new Error(errorMessage)
	}
	return parsed!
}

function toObjectArray(raw: any | null): UTSJSONObject[] {
	if (raw == null) {
		return [] as UTSJSONObject[]
	}
	const text = JSON.stringify(raw)
	if (text == null || text == '' || !text.startsWith('[')) {
		return [] as UTSJSONObject[]
	}
	const parsed = JSON.parseArray<UTSJSONObject>(text!)
	if (parsed == null) {
		return [] as UTSJSONObject[]
	}
	return parsed!
}

// ── 成员管理 ────────────────────────────────────────────────────

// 解析成员数据里的可访问店铺限制 restricted_shop_ids
// 空数组 = 未限制（全公司可见）；旧服务端缺字段时兜底空数组
export function parseRestrictedShopIds(item: UTSJSONObject): number[] {
	const raw = item['restricted_shop_ids']
	if (raw == null) {
		return [] as number[]
	}
	const text = JSON.stringify(raw)
	if (text == null || !text.startsWith('[')) {
		return [] as number[]
	}
	const parsed = JSON.parseArray<number>(text!)
	return parsed == null ? ([] as number[]) : parsed!
}

export async function getStaffList(): Promise<UTSJSONObject[]> {
	const raw = await request('/api/accounts/staff/', 'GET', {} as UTSJSONObject, false)
	return toObjectArray(raw)
}

// 详情响应含 restricted_shop_ids（编辑回显用 parseRestrictedShopIds 解析）
export async function getStaffDetail(id: number): Promise<UTSJSONObject> {
	const raw = await request('/api/accounts/staff/' + id.toString() + '/', 'GET', {} as UTSJSONObject, false)
	return toObject(raw, '成员详情解析失败')
}

// body 可选 shop_ids: number[]（可访问店铺，整体替换：空数组=清空限制；不传=不动）
export async function createStaff(body: UTSJSONObject): Promise<UTSJSONObject> {
	const raw = await request('/api/accounts/staff/create/', 'POST', body, true)
	return toObject(raw, '成员创建响应解析失败')
}

// body 可选 shop_ids: number[]（可访问店铺，整体替换：空数组=清空限制；不传=不动）
export async function updateStaff(id: number, body: UTSJSONObject): Promise<UTSJSONObject> {
	const raw = await request('/api/accounts/staff/' + id.toString() + '/', 'PATCH', body, true)
	return toObject(raw, '成员更新响应解析失败')
}

export async function resetStaffPassword(id: number, password: string): Promise<any> {
	const body = { password: password } as UTSJSONObject
	return request('/api/accounts/staff/' + id.toString() + '/reset-password/', 'POST', body, true)
}

// ── 当前账号 ────────────────────────────────────────────────────

export async function changeMyPassword(oldPassword: string, newPassword: string, confirmPassword: string): Promise<any> {
	const body = {
		old_password: oldPassword,
		new_password: newPassword,
		new_password_confirm: confirmPassword,
	} as UTSJSONObject
	return request('/api/accounts/auth/password/change/', 'POST', body, true)
}

// ── 权限 ────────────────────────────────────────────────────────

export async function getPermissionCatalog(): Promise<UTSJSONObject> {
	const raw = await request('/api/accounts/permissions/catalog/', 'GET', {} as UTSJSONObject, false)
	return toObject(raw, '权限目录解析失败')
}

export async function grantPermissions(userId: number, codes: string[]): Promise<any> {
	const body = { user_id: userId, permissions: codes } as UTSJSONObject
	return request('/api/accounts/permissions/grant/', 'POST', body, false)
}

export async function revokePermissions(userId: number, codes: string[]): Promise<any> {
	const body = { user_id: userId, permissions: codes } as UTSJSONObject
	return request('/api/accounts/permissions/revoke/', 'POST', body, false)
}

// ── 公司设置 ────────────────────────────────────────────────────

export async function getCompanySettings(): Promise<UTSJSONObject> {
	const raw = await request('/api/accounts/company/me/', 'GET', {} as UTSJSONObject, false)
	return toObject(raw, '公司设置解析失败')
}

export async function updateCompanySettings(body: UTSJSONObject): Promise<UTSJSONObject> {
	const raw = await request('/api/accounts/company/me/', 'PATCH', body, true)
	return toObject(raw, '公司设置更新响应解析失败')
}
