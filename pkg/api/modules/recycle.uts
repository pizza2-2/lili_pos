import { request } from '../index.uts'

// 回收站：已删除数据的列表与恢复（商品 / 分类 / 收银分类）

function toItems(raw: any | null): UTSJSONObject[] {
	if (raw == null) {
		return [] as UTSJSONObject[]
	}
	const text = JSON.stringify(raw)
	if (text == null || text == '' || !text.startsWith('{')) {
		return [] as UTSJSONObject[]
	}
	const parsed = JSON.parseObject<UTSJSONObject>(text!)
	if (parsed == null) {
		return [] as UTSJSONObject[]
	}
	const rawItems = parsed!['items']
	if (rawItems == null) {
		return [] as UTSJSONObject[]
	}
	const itemsText = JSON.stringify(rawItems)
	if (itemsText == null || !itemsText.startsWith('[')) {
		return [] as UTSJSONObject[]
	}
	const items = JSON.parseArray<UTSJSONObject>(itemsText!)
	return items == null ? ([] as UTSJSONObject[]) : items!
}

function buildQuery(search: string): UTSJSONObject {
	const query = {} as UTSJSONObject
	if (search != '') {
		query['search'] = search
	}
	return query
}

export async function getDeletedProducts(search: string): Promise<UTSJSONObject[]> {
	const raw = await request('/api/products/products/deleted/', 'GET', buildQuery(search), false)
	return toItems(raw)
}

export async function restoreProduct(id: number): Promise<any> {
	return request('/api/products/products/' + id.toString() + '/restore/', 'POST', {} as UTSJSONObject, true)
}

export async function getDeletedCategories(search: string): Promise<UTSJSONObject[]> {
	const raw = await request('/api/categories/categories/deleted/', 'GET', buildQuery(search), false)
	return toItems(raw)
}

