export type CategoryListResponse = {
	results: CategoryItem[]
	count: number
	total_count: number
	total_pages: number
	current_page: number
	page_size: number
}

// 全量轻量树节点（tree/ 端点）：只含列表渲染与本地搜索所需的最小字段，
// kasa 绑定 / 价格公式 / 打印模板等重字段仍走 detail 按需获取
export type CategoryTreeNode = {
	id: number
	parent_id: number
	name: string
	name_en: string
	code: string
	level: number
	is_active: boolean
	sort_order: number
	tax_rate: string
	health_score: string
	products_count: number
}

export type CategoryTreeResponse = {
	items: CategoryTreeNode[]
	count: number
	max_level: number
}

export type CategoryMutationData = UTSJSONObject

export type CategorySortItem = UTSJSONObject

export type CategoryStatisticsResponse = {
