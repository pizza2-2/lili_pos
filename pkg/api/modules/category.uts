export async function getCategoryRecommendations(data: CategoryRecommendationQuery): Promise<UTSJSONObject> {
	const query = {} as UTSJSONObject
	if (data.product != null && data.product != '') query['product'] = data.product
	if (data.product_id != null && data.product_id != '') query['product_id'] = data.product_id
	if (data.name != null && data.name != '') query['name'] = data.name
	if (data.query != null && data.query != '') query['query'] = data.query
	if (data.barcode != null && data.barcode != '') query['barcode'] = data.barcode
	if (data.supplier != null && data.supplier != '') query['supplier'] = data.supplier
	if (data.limit != null && data.limit > 0) query['limit'] = data.limit
	const raw = await request(categoryBasePath + 'recommend-categories/', 'GET', query, true)
	return buildObjectResponse(raw, '分类推荐响应解析失败')
}

export async function mergeDuplicateCategories(ids: string[], target: string): Promise<UTSJSONObject> {
	const nextIds: any[] = []
	for (let index = 0; index < ids.length; index += 1) {
		const text = stringValue(ids[index])
		const parsed = parseInt(text)
		if (!isNaN(parsed) && '' + parsed == text) {
			nextIds.push(parsed)
		} else {
			nextIds.push(text)
		}
	}
	const body = {
		ids: nextIds,
		target: target,
		target_id: target,
	} as UTSJSONObject
	const raw = await request(categoryBasePath + 'merge-duplicates/', 'POST', body, true)
	return buildObjectResponse(raw, '重复分类合并响应解析失败')
}

// ── 分类经营分析（健康评分 / 趋势 / 洞察 / 规则同步） ─────────────────

function buildHealthScoreItem(rawObject: UTSJSONObject): CategoryHealthScoreItem {
	return {
		id: intValue(rawObject['id']),
		name: stringValue(rawObject['name']),
		full_name: stringValue(rawObject['full_name']),
		level: intValue(rawObject['level']),
		lifecycle_stage: stringValue(rawObject['lifecycle_stage']),
		lifecycle_stage_label: stringValue(rawObject['lifecycle_stage_label']),
		health_score: stringValue(rawObject['health_score']),
		snapshot_date: stringValue(rawObject['snapshot_date']),
		sales_amount: stringValue(rawObject['sales_amount']),
		gross_profit: stringValue(rawObject['gross_profit']),
		stock_warning_count: intValue(rawObject['stock_warning_count']),
		product_count: intValue(rawObject['product_count']),
	} as CategoryHealthScoreItem
}

export async function getCategoryHealthScores(limit: number = 100, date: string | null = null): Promise<CategoryHealthScoresResponse> {
	const query = {} as UTSJSONObject
	if (limit > 0) {
		query['limit'] = limit
	}
	if (date != null && date != '') {
		query['date'] = date
	}
	const raw = await request(categoryBasePath + 'health-scores/', 'GET', query, false)
	const rawObject = buildObjectResponse(raw, '分类健康评分响应解析失败')
	const rawItems = parseObjectArray(rawObject['items'])
	const items: CategoryHealthScoreItem[] = []
	for (let index = 0; index < rawItems.length; index += 1) {
		items.push(buildHealthScoreItem(rawItems[index]))
	}
	const rawSummary = parseObject(rawObject['summary'])
	const summary: CategoryHealthSummary = rawSummary == null ? {
		total_scored: 0,
		healthy_count: 0,
		warning_count: 0,
		risk_count: 0,
		unscored_count: 0,
	} as CategoryHealthSummary : {
		total_scored: intValue(rawSummary['total_scored']),
		healthy_count: intValue(rawSummary['healthy_count']),
		warning_count: intValue(rawSummary['warning_count']),
		risk_count: intValue(rawSummary['risk_count']),
		unscored_count: intValue(rawSummary['unscored_count']),
	} as CategoryHealthSummary
	return {
		snapshot_date: stringValue(rawObject['snapshot_date']),
		items: items,
		count: intValue(rawObject['count']),
		summary: summary,
	} as CategoryHealthScoresResponse
}

function buildTrendPoint(rawObject: UTSJSONObject): CategoryTrendPoint {
	return {
		date: stringValue(rawObject['date']),
		sales_amount: stringValue(rawObject['sales_amount']),
		sales_quantity: stringValue(rawObject['sales_quantity']),
		gross_profit: stringValue(rawObject['gross_profit']),
		order_count: intValue(rawObject['order_count']),
		stock_warning_count: intValue(rawObject['stock_warning_count']),
	} as CategoryTrendPoint
}

function buildTrendSummary(rawObject: UTSJSONObject | null): CategoryTrendSummary {
	if (rawObject == null) {
		return {
			sales_amount: '0.00',
			gross_profit: '0.00',
			sales_quantity: '0',
			order_count: 0,
			stock_warning_count: 0,
		} as CategoryTrendSummary
	}
	return {
		sales_amount: stringValue(rawObject['sales_amount']),
		gross_profit: stringValue(rawObject['gross_profit']),
		sales_quantity: stringValue(rawObject['sales_quantity']),
		order_count: intValue(rawObject['order_count']),
		stock_warning_count: intValue(rawObject['stock_warning_count']),
	} as CategoryTrendSummary
}

export async function getCategoryTrend(id: number | string, days: number = 30, includeDescendants: boolean = true, dateTo: string | null = null, shopId: number = 0): Promise<CategoryTrendResponse> {
	const query = {
		days: days,
		include_descendants: includeDescendants,
	} as UTSJSONObject
	if (dateTo != null && dateTo != '') {
		query['date_to'] = dateTo
	}
	if (shopId > 0) {
		query['shop_id'] = shopId
	}
	const raw = await request(categoryDetailPath(id) + 'trend/', 'GET', query, false)
	const rawObject = buildObjectResponse(raw, '分类趋势响应解析失败')
	const rawPoints = parseObjectArray(rawObject['trend'])
	const points: CategoryTrendPoint[] = []
	for (let index = 0; index < rawPoints.length; index += 1) {
		points.push(buildTrendPoint(rawPoints[index]))
	}
	return {
		category_id: intValue(rawObject['category_id']),
		date_from: stringValue(rawObject['date_from']),
		date_to: stringValue(rawObject['date_to']),
		days: intValue(rawObject['days']),
		trend: points,
		summary: buildTrendSummary(parseObject(rawObject['summary'])),
	} as CategoryTrendResponse
}

