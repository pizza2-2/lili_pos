	limit: number | null
}
function stringValue(value: any | null): string {
	if (value == null) {
		return ''
	}
	return '' + value
}

function intValue(value: any | null): number {
	if (value == null) {
		return 0
	}

	const text = stringValue(value)
	if (text == '') {
		return 0
	}

	const parsed = parseInt(text)
	if (isNaN(parsed)) {
		return 0
	}

	return parsed
}

function booleanValue(value: any | null): boolean {
	const text = stringValue(value).toLowerCase()
	return text == 'true' || text == '1' || text == 'yes'
}

function parseObject(value: any | null): UTSJSONObject | null {
	if (value == null) {
		return null
	}

	const text = JSON.stringify(value)
	if (text == null || text == '') {
		return null
	}
	// Android 端 JSON.parseObject 对非对象文本会抛异常而非返回 null
	if (!text.startsWith('{')) {
		return null
	}

	try {
		return JSON.parseObject<UTSJSONObject>(text)
	} catch (error) {
		return null
	}
}

function parseObjectArray(value: any | null): UTSJSONObject[] {
	if (value == null) {
		return []
	}

	const text = JSON.stringify(value)
	if (text == null || text == '') {
		return []
	}
	// Android 端 JSON.parseArray 对非数组文本会抛异常而非返回 null
	if (!text.startsWith('[')) {
		return []
	}

	try {
		const parsed = JSON.parseArray<UTSJSONObject>(text)
		if (parsed == null) {
			return []
		}
		return parsed!
	} catch (error) {
		return [] as UTSJSONObject[]
	}
}

function buildCategoryItemFromObject(rawObject: UTSJSONObject): CategoryItem {
	return {
		id: intValue(rawObject['id']),
		name: stringValue(rawObject['name']),
		code: stringValue(rawObject['code']),
		level: intValue(rawObject['level']),
		parent_id: intValue(rawObject['parent_id'] != null ? rawObject['parent_id'] : rawObject['parent']),
		sort_order: intValue(rawObject['sort_order']),
		tax_rate: stringValue(rawObject['tax_rate']),
		kasa_category_id: intValue(rawObject['kasa_category_id'] != null ? rawObject['kasa_category_id'] : rawObject['kasa_category']),
		default_pricing_formula_id: intValue(rawObject['default_pricing_formula_id'] != null ? rawObject['default_pricing_formula_id'] : rawObject['default_pricing_formula']),
		default_pricing_formula_name: stringValue(rawObject['default_pricing_formula_name']),
		default_print_template_id: intValue(rawObject['default_print_template_id'] != null ? rawObject['default_print_template_id'] : rawObject['default_print_template']),
		default_print_template_name: stringValue(rawObject['default_print_template_name']),
		pos_sale_enabled: rawObject['pos_sale_enabled'] == null ? true : booleanValue(rawObject['pos_sale_enabled']),
		default_min_stock_level: intValue(rawObject['default_min_stock_level']),
		default_reorder_point: intValue(rawObject['default_reorder_point']),
		products_count: intValue(rawObject['products_count']),
		children_count: intValue(rawObject['children_count']),
		has_children: booleanValue(rawObject['has_children']),
		is_active: booleanValue(rawObject['is_active']),
		is_leaf: booleanValue(rawObject['is_leaf']) || stringValue(rawObject['status']) == 'leaf',
		can_add_child: booleanValue(rawObject['can_add_child']),
		can_select_product: booleanValue(rawObject['can_select_product']),
		full_name: stringValue(rawObject['full_name']),
		path: stringValue(rawObject['path']),
		lifecycle_stage: stringValue(rawObject['lifecycle_stage']),
		health_score: stringValue(rawObject['health_score']),
		created_at: stringValue(rawObject['created_at']),
		updated_at: stringValue(rawObject['updated_at']),
		raw: rawObject,
	} as CategoryItem
}

function buildCategoryArrayFromValue(value: any | null): CategoryItem[] {
	const rawObject = parseObject(value)
	if (rawObject != null) {
		if (rawObject['results'] != null) {
			return buildCategoryArrayFromValue(rawObject['results'])
		}
		if (rawObject['items'] != null) {
			return buildCategoryArrayFromValue(rawObject['items'])
		}
		if (rawObject['children'] != null) {
			return buildCategoryArrayFromValue(rawObject['children'])
		}
		if (rawObject['descendants'] != null) {
			return buildCategoryArrayFromValue(rawObject['descendants'])
		}
		if (rawObject['siblings'] != null) {
			return buildCategoryArrayFromValue(rawObject['siblings'])
		}
		if (rawObject['ancestors'] != null) {
			return buildCategoryArrayFromValue(rawObject['ancestors'])
		}
		if (rawObject['data'] != null) {
			return buildCategoryArrayFromValue(rawObject['data'])
		}
	}

	const rawArray = parseObjectArray(value)
	const result: CategoryItem[] = []
	for (let index = 0; index < rawArray.length; index += 1) {
		result.push(buildCategoryItemFromObject(rawArray[index]))
	}
	return result
}

function buildCategoryListQuery(data: CategoryListQuery): UTSJSONObject {
	const query = {
		page: data.page,
		page_size: data.page_size,
	} as UTSJSONObject

	if (data.search != null && data.search != '') {
		query['search'] = data.search
	}
	if (data.id != null && stringValue(data.id) != '') {
		query['id'] = data.id
	}
	if (data.is_active != null && stringValue(data.is_active) != '') {
		query['is_active'] = data.is_active
	}
	if (data.level != null && stringValue(data.level) != '') {
		query['level'] = data.level
	}
	if (data.parent != null) {
		query['parent'] = data.parent
	}
	if (data.parent_id != null && stringValue(data.parent_id) != '') {
		query['parent_id'] = data.parent_id
	}
	if (data.code != null && data.code != '') {
		query['code'] = data.code
	}
	if (data.tax_rate != null && stringValue(data.tax_rate) != '') {
		query['tax_rate'] = data.tax_rate
	}
	if (data.kasa_category != null && stringValue(data.kasa_category) != '') {
		query['kasa_category'] = data.kasa_category
	}
	if (data.kasa_category_id != null && stringValue(data.kasa_category_id) != '') {
		query['kasa_category_id'] = data.kasa_category_id
	}
	if (data.status != null && data.status != '') {
		query['status'] = data.status
	}
	if (data.ordering != null && data.ordering != '') {
		query['ordering'] = data.ordering
	}
	if (data.simple != null) {
		query['simple'] = data.simple
	}

	return query
}

function buildCategoryListResponse(raw: any, query: CategoryListQuery): CategoryListResponse {
	const rawObject = parseObject(raw)
	if (rawObject == null) {
		const results = buildCategoryArrayFromValue(raw)
		return {
			results: results,
			count: results.length,
			total_count: results.length,
			total_pages: 1,
			current_page: query.page > 0 ? query.page : 1,
			page_size: query.page_size > 0 ? query.page_size : results.length,
		} as CategoryListResponse
	}

	let paginationObject: UTSJSONObject | null = null
	if (rawObject['pagination'] != null) {
		paginationObject = parseObject(rawObject['pagination'])
	}

	let results: CategoryItem[] = []
	if (rawObject['results'] != null) {
		results = buildCategoryArrayFromValue(rawObject['results'])
	} else if (rawObject['items'] != null) {
		results = buildCategoryArrayFromValue(rawObject['items'])
	} else {
		results = buildCategoryArrayFromValue(raw)
	}

	let totalCount = intValue(rawObject['count'])
	if (totalCount <= 0) {
		totalCount = intValue(rawObject['total'])
	}
	if (totalCount <= 0) {
		totalCount = intValue(rawObject['total_count'])
	}
	if (totalCount <= 0 && paginationObject != null) {
		totalCount = intValue(paginationObject['total'])
	}
	if (totalCount <= 0 && paginationObject != null) {
		totalCount = intValue(paginationObject['count'])
	}
	if (totalCount <= 0) {
		totalCount = results.length
	}

	let currentPage = intValue(rawObject['page'])
	if (currentPage <= 0) {
		currentPage = intValue(rawObject['current_page'])
	}
	if (currentPage <= 0 && paginationObject != null) {
		currentPage = intValue(paginationObject['page'])
	}
	if (currentPage <= 0) {
		currentPage = query.page > 0 ? query.page : 1
	}

	let pageSize = intValue(rawObject['page_size'])
	if (pageSize <= 0) {
		pageSize = intValue(rawObject['per_page'])
	}
	if (pageSize <= 0 && paginationObject != null) {
		pageSize = intValue(paginationObject['page_size'])
	}
	if (pageSize <= 0 && paginationObject != null) {
		pageSize = intValue(paginationObject['per_page'])
	}
	if (pageSize <= 0) {
		pageSize = query.page_size > 0 ? query.page_size : results.length
	}

	let totalPages = intValue(rawObject['total_pages'])
	if (totalPages <= 0) {
		totalPages = intValue(rawObject['num_pages'])
	}
	if (totalPages <= 0 && paginationObject != null) {
		totalPages = intValue(paginationObject['total_pages'])
	}
	if (totalPages <= 0 && paginationObject != null) {
		totalPages = intValue(paginationObject['num_pages'])
	}
	if (totalPages <= 0 && pageSize > 0) {
		totalPages = Math.ceil(totalCount / pageSize)
	}
	if (totalPages <= 0) {
		totalPages = 1
	}

	return {
		results: results,
		count: totalCount,
		total_count: totalCount,
		total_pages: totalPages,
		current_page: currentPage,
		page_size: pageSize,
	} as CategoryListResponse
}

function buildCategoryItemResponse(raw: any, errorMessage: string): CategoryItem {
	const rawObject = parseObject(raw)
	if (rawObject == null) {
		throw new Error(errorMessage)
	}
	return buildCategoryItemFromObject(rawObject)
}

function buildObjectResponse(raw: any, errorMessage: string): UTSJSONObject {
	const rawObject = parseObject(raw)
	if (rawObject == null) {
		throw new Error(errorMessage)
	}
	return rawObject
}

function buildSearchQuery(search: string | null): UTSJSONObject {
	const query = {} as UTSJSONObject
	if (search != null && search != '') {
		query['search'] = search
	}
	return query
}

function buildCategoryRootsQuery(data: CategoryRootsQuery): UTSJSONObject {
	const query = {} as UTSJSONObject
	if (data.search != null && data.search != '') {
		query['search'] = data.search
	}
	if (data.level != null && stringValue(data.level) != '') {
		query['level'] = data.level
	}
	if (data.status != null && data.status != '') {
		query['status'] = data.status
	}
	if (data.ordering != null && data.ordering != '') {
		query['ordering'] = data.ordering
	}
	return query
}

function buildCategoryGovernanceQuery(data: CategoryGovernanceQuery | null): UTSJSONObject {
	const query = {} as UTSJSONObject
	if (data == null) {
		return query
	}
	if (data.type != null && data.type != '') {
		query['type'] = data.type
	}
	if (data.limit != null && data.limit > 0) {
		query['limit'] = data.limit
	}
	if (data.too_many_threshold != null && data.too_many_threshold > 0) {
		query['too_many_threshold'] = data.too_many_threshold
	}
	return query
}

function buildIncludeSelfQuery(includeSelf: boolean): UTSJSONObject {
	return {
		include_self: includeSelf,
	} as UTSJSONObject
}



function categoryDetailPath(id: number | string): string {
	return categoryBasePath + stringValue(id) + '/'
}

function buildMoveBody(parentId: number | string | null): UTSJSONObject {
	return {
		parent_id: parentId,
	} as UTSJSONObject
}

function buildTranslateBody(force: boolean): UTSJSONObject {
	return {
		force: force,
	} as UTSJSONObject
}

function buildTranslateBodyWithMode(force: boolean, sync: boolean): UTSJSONObject {
	return {
		force: force,
		sync: sync,
		source_lang: 'zh',
		target_lang: 'pl',
	} as UTSJSONObject
}

function buildTranslateTextBody(text: string): UTSJSONObject {
	return {
		text: text,
		source_lang: 'zh',
		target_lang: 'pl',
	} as UTSJSONObject
}

function buildBatchUpdateSortBody(sortData: CategorySortItem[]): UTSJSONObject {
	return {
		sort_data: sortData,
	} as UTSJSONObject
}

export async function getCategoryList(data: CategoryListQuery): Promise<CategoryListResponse> {
	const raw = await request(categoryBasePath, 'GET', buildCategoryListQuery(data), true)
	return buildCategoryListResponse(raw, data)
}

export async function getCategoryDetail(id: number | string): Promise<CategoryItem> {
	const raw = await request(categoryDetailPath(id), 'GET', {} as UTSJSONObject, true)
	return buildCategoryItemResponse(raw, '分类详情响应解析失败')
}

export async function createCategory(data: CategoryMutationData): Promise<CategoryItem> {
	const raw = await request(categoryBasePath, 'POST', data, true)
	return buildCategoryItemResponse(raw, '创建分类响应解析失败')
}

export async function updateCategory(id: number | string, data: CategoryMutationData): Promise<CategoryItem> {
	const raw = await request(categoryDetailPath(id), 'PUT', data, true)
	return buildCategoryItemResponse(raw, '更新分类响应解析失败')
}

export async function patchCategory(id: number | string, data: CategoryMutationData): Promise<CategoryItem> {
	const raw = await request(categoryDetailPath(id), 'PATCH', data, true)
	return buildCategoryItemResponse(raw, '部分更新分类响应解析失败')
}

export function deleteCategory(id: number | string): Promise<any> {
	return request(categoryDetailPath(id), 'DELETE', {} as UTSJSONObject, true)
}

function buildCategoryTreeNode(rawObject: UTSJSONObject): CategoryTreeNode {
	return {
		id: intValue(rawObject['id']),
		parent_id: intValue(rawObject['parent_id']),
		name: stringValue(rawObject['name']),
		name_en: stringValue(rawObject['name_en']),
		code: stringValue(rawObject['code']),
		level: intValue(rawObject['level']),
		is_active: booleanValue(rawObject['is_active']),
		sort_order: intValue(rawObject['sort_order']),
		tax_rate: stringValue(rawObject['tax_rate']),
		health_score: stringValue(rawObject['health_score']),
		products_count: intValue(rawObject['products_count']),
	} as CategoryTreeNode
}

// 快路径构造：request 已返回解析好的 UTSJSONObject，用类型化 getter 直读，
// 避免通用防御式解析（stringify→parse 往返 + 逐字段字符串转换）。
// 整树约1500节点且解析发生在主线程，这条路径的性能直接决定页面是否卡顿。
function buildCategoryTreeNodeFast(rawObject: UTSJSONObject): CategoryTreeNode {
	const id = rawObject.getNumber('id')
	const parentId = rawObject.getNumber('parent_id')
	const name = rawObject.getString('name')
	const nameEn = rawObject.getString('name_en')
	const code = rawObject.getString('code')
	const level = rawObject.getNumber('level')
	const isActive = rawObject.getBoolean('is_active')
	const sortOrder = rawObject.getNumber('sort_order')
	const taxRate = rawObject.getString('tax_rate')
	const healthScore = rawObject.getString('health_score')
	const productsCount = rawObject.getNumber('products_count')
	return {
		id: id == null ? 0 : id,
		parent_id: parentId == null ? 0 : parentId,
		name: name == null ? '' : name,
		name_en: nameEn == null ? '' : nameEn,
		code: code == null ? '' : code,
		level: level == null ? 0 : level,
		is_active: isActive == null ? true : isActive,
		sort_order: sortOrder == null ? 0 : sortOrder,
		tax_rate: taxRate == null ? '' : taxRate,
		health_score: healthScore == null ? '' : healthScore,
		products_count: productsCount == null ? 0 : productsCount,
	} as CategoryTreeNode
}

export async function getCategoryTree(): Promise<CategoryTreeResponse> {
	const raw = await request(categoryBasePath + 'tree/', 'GET', {} as UTSJSONObject, true)
	// 快路径：类型化直读
	try {
		const fastObject = raw as UTSJSONObject
		const fastItems = fastObject.getArray('items')
		if (fastItems != null) {
			const items: CategoryTreeNode[] = []
			for (let index = 0; index < fastItems.length; index += 1) {
				items.push(buildCategoryTreeNodeFast(fastItems[index] as UTSJSONObject))
			}
			const rawCount = fastObject.getNumber('count')
			let maxLevel = 2
			const rawMaxLevel = fastObject.getNumber('max_level')
			if (rawMaxLevel != null) {
				if (rawMaxLevel > 0) {
					maxLevel = rawMaxLevel
				}
			}
			return {
				items: items,
				count: rawCount == null ? items.length : rawCount,
				max_level: maxLevel,
			} as CategoryTreeResponse
		}
	} catch (error) {
	}
	// 慢路径兜底：响应结构异常时按通用防御式解析
	const rawObject = buildObjectResponse(raw, '分类树响应解析失败')
	const rawItems = parseObjectArray(rawObject['items'])
	const items: CategoryTreeNode[] = []
	for (let index = 0; index < rawItems.length; index += 1) {
		items.push(buildCategoryTreeNode(rawItems[index]))
	}
	let maxLevel = intValue(rawObject['max_level'])
	if (maxLevel <= 0) {
		maxLevel = 2
	}
	return {
		items: items,
		count: intValue(rawObject['count']),
		max_level: maxLevel,
	} as CategoryTreeResponse
}

export async function getCategoryRoots(query: CategoryRootsQuery | null = null): Promise<CategoryItem[]> {
	const requestQuery = query == null ? buildCategoryRootsQuery({
		search: null,
		level: null,
		status: null,
		ordering: null,
	} as CategoryRootsQuery) : buildCategoryRootsQuery(query)
	const raw = await request(categoryBasePath + 'roots/', 'GET', requestQuery, true)
	return buildCategoryArrayFromValue(raw)
}

