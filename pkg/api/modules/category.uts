export async function getCategoryInsights(query: CategoryInsightsQuery | null = null): Promise<UTSJSONObject> {
	const requestQuery = {} as UTSJSONObject
	if (query != null) {
		if (query.severity != null && query.severity != '') {
			requestQuery['severity'] = query.severity
		}
		if (query.insight_type != null && query.insight_type != '') {
			requestQuery['type'] = query.insight_type
		}
		if (query.category_id != null && query.category_id > 0) {
			requestQuery['category'] = query.category_id
		}
		if (query.status != null && query.status != '') {
			requestQuery['status'] = query.status
		}
		if (query.limit != null && query.limit > 0) {
			requestQuery['limit'] = query.limit
		}
	}
	const raw = await request(categoryBasePath + 'insights/', 'GET', requestQuery, false)
	return buildObjectResponse(raw, '分类洞察响应解析失败')
}

