	level: number
	parent_id: number
	sort_order: number
	tax_rate: string
	kasa_category_id: number
	default_pricing_formula_id: number
	default_pricing_formula_name: string
	default_print_template_id: number
	default_print_template_name: string
	pos_sale_enabled: boolean
	default_min_stock_level: number
	default_reorder_point: number
	products_count: number
	children_count: number
	has_children: boolean
	is_active: boolean
	is_leaf: boolean
	can_add_child: boolean
	can_select_product: boolean
	full_name: string
	path: string
	lifecycle_stage: string
	health_score: string
	created_at: string
	updated_at: string
