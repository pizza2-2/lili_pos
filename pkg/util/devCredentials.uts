/**
 * ⚠️ 开发测试凭据 —— 全项目唯一允许出现明文凭据的文件
 *
 * 保护机制（两层）：
 * 1. NODE_ENV 门：HBuilderX「发行」打包（production）时 getter 一律返回空串，
 *    登录页账号密码为空、由用户手动输入；
 * 2. 编译器不保证把死分支里的字符串从安装包常量池中剔除，
 *    因此对外发布的正式版打包前，请把下方 DEV_ 常量清成空串（只改这一个文件）。
 */

const DEV_LOGIN_USERNAME = '733063605'
const DEV_LOGIN_PASSWORD = 'Luochaowei88'

/** 开发环境返回测试账号；发行包恒为空串 */
export function getDevLoginUsername(): string {
	if (process.env.NODE_ENV == 'production') return ''
	return DEV_LOGIN_USERNAME
}

/** 开发环境返回测试密码；发行包恒为空串 */
export function getDevLoginPassword(): string {
	if (process.env.NODE_ENV == 'production') return ''
	return DEV_LOGIN_PASSWORD
}
